import Mathlib

/-!
# Bourbaki, rédaction n° 596, §§ 7 and 12: three statements missing a hypothesis

Rédaction 596 of the Bourbaki archive (Archives Henri Poincaré, item 1142) is a draft of *Algèbre*,
ch. VIII. Its § 12, « Représentations des groupes » (August 1974), states two results over an
algebraically closed field `k` without assuming that the representations are semisimple, that
is, without excluding that the characteristic of `k` divides the order of the group. Both fail.
Its § 7 drops a finiteness hypothesis in the corollary of Prop. 10.

**Prop. 4 (d), p. 258.** A finite-dimensional `G`-module `E` would be simple if and only if
`⟨E, E⟩ = dim End_G(E) = 1`. The proof deduces from `End_G(E) ≅ k` that `E` is semisimple, which
does not follow. Counterexample: over a field of characteristic `3`, the group generated by
`A = diag(1, -1)` and `N = [[1, 1], [0, 1]]` (the upper triangular subgroup of `GL₂(𝔽₃)`, of
order `12`) acts on `k²`; only the scalars commute with it, yet the line `k e₁` is stable.

* `eq_scalar_of_commute`: if `(2 : k) ≠ 0`, a matrix commuting with `A` and `N` is scalar;
* `A_mulVec_e1`, `N_mulVec_e1`: `k e₁` is stable under `A` and `N`;
* `prop4d_fails`: the case of the algebraic closure of `𝔽₃`.

**Remark after (2), p. 249.** The map `Tr' : k ⊗ R_k(G) → FC(G, k)` would be an isomorphism when
`k` is algebraically closed. Counterexample: `G = ℤ/2` and `k` of characteristic `2`. If `g² = 1`
then `(ρ g - 1)² = 0`, so `ρ g - 1` has trace `0`: every character is constant, and the class
function that is `1` at the identity and `0` at the generator is not a combination of characters.

* `character_eq_of_sq_eq_one`: in characteristic `2`, `χ(g) = χ(1)` whenever `g² = 1`;
* `single_one_not_mem_span_characters`: for any family of finite-dimensional representations of
  `Multiplicative (ZMod 2)`, the indicator of `1` is not in the span of their characters.

**§ 7, corollary of Prop. 10, p. 111.** Over an algebraically closed `K`, the tensor product
`S₀ ⊗ S₁` of simple modules over `K`-algebras `A₀`, `A₁` would be a simple `A₀ ⊗ A₁`-module.
Prop. 10 and the proof (Burnside) need `S₀`, `S₁` finite-dimensional; the corollary omits
it.
Counterexample: `A₀ = A₁ = S₀ = S₁ = ℂ(t)`.

* `tmul_one_ne_one_tmul`: if `x ∉ K`, then `x ⊗ 1 ≠ 1 ⊗ x` in `L ⊗_K L`;
* `not_isSimpleModule_tensor`: if `L ≠ K`, `L ⊗_K L` is not a simple module over itself;
* `cor_prop10_fails`: the case `K = ℂ`, `L = ℂ(t)`.

The § 12 statements hold when `k[G]` is semisimple (Maschke), which is presumably what the page
has in mind;
that case is classical and not formalised here.
-/

namespace Bourbaki.Redaction596Characters

open Matrix

section Prop4d

variable {k : Type*} [Field k]

/-- `A = diag(1, -1)`. -/
def A : Matrix (Fin 2) (Fin 2) k := !![1, 0; 0, -1]

/-- `N = [[1, 1], [0, 1]]`. -/
def N : Matrix (Fin 2) (Fin 2) k := !![1, 1; 0, 1]

/-- If `2 ≠ 0` in `k`, the only matrices commuting with `A` and `N` are the scalars. -/
theorem eq_scalar_of_commute (h2 : (2 : k) ≠ 0) (M : Matrix (Fin 2) (Fin 2) k)
    (hA : M * A = A * M) (hN : M * N = N * M) : M = M 0 0 • (1 : Matrix (Fin 2) (Fin 2) k) := by
  have e01 := congrFun₂ hA 0 1
  have e10 := congrFun₂ hA 1 0
  have n01 := congrFun₂ hN 0 1
  simp [A, N, Matrix.mul_apply, Fin.sum_univ_two] at e01 e10 n01
  have h01 : M 0 1 = 0 := by
    have : (2 : k) * M 0 1 = 0 := by linear_combination -e01
    exact (mul_eq_zero.mp this).resolve_left h2
  have h10 : M 1 0 = 0 := by
    have : (2 : k) * M 1 0 = 0 := by linear_combination e10
    exact (mul_eq_zero.mp this).resolve_left h2
  have h11 : M 1 1 = M 0 0 := by linear_combination -n01
  ext i j
  fin_cases i <;> fin_cases j <;> simp [h01, h10, h11]

/-- `A e₁ = e₁`. -/
theorem A_mulVec_e1 : (A : Matrix (Fin 2) (Fin 2) k) *ᵥ ![1, 0] = ![1, 0] := by
  ext i; fin_cases i <;> simp [A, mulVec, dotProduct, Fin.sum_univ_two]

/-- `N e₁ = e₁`. -/
theorem N_mulVec_e1 : (N : Matrix (Fin 2) (Fin 2) k) *ᵥ ![1, 0] = ![1, 0] := by
  ext i; fin_cases i <;> simp [N, mulVec, dotProduct, Fin.sum_univ_two]

/-- **Prop. 4 (d) fails** over the algebraic closure of `𝔽₃`: the commutant of `{A, N}` is `k`
(so `⟨E, E⟩ = 1`), while the proper nonzero subspace `k e₁` is stable. -/
theorem prop4d_fails :
    (∀ M : Matrix (Fin 2) (Fin 2) (AlgebraicClosure (ZMod 3)),
        M * A = A * M → M * N = N * M →
          ∃ c : AlgebraicClosure (ZMod 3), M = c • (1 : Matrix (Fin 2) (Fin 2) _)) ∧
      A *ᵥ ![1, 0] = (![1, 0] : Fin 2 → AlgebraicClosure (ZMod 3)) ∧
      N *ᵥ ![1, 0] = (![1, 0] : Fin 2 → AlgebraicClosure (ZMod 3)) := by
  have h2 : (2 : AlgebraicClosure (ZMod 3)) ≠ 0 := by
    intro h
    have := (CharP.cast_eq_zero_iff (AlgebraicClosure (ZMod 3)) 3 2).mp (by exact_mod_cast h)
    omega
  exact ⟨fun M hA hN => ⟨M 0 0, eq_scalar_of_commute h2 M hA hN⟩, A_mulVec_e1, N_mulVec_e1⟩

end Prop4d

section TrPrime

variable {k : Type*} [Field k] [CharP k 2] {V : Type*} [AddCommGroup V] [Module k V]
  [FiniteDimensional k V]

omit [FiniteDimensional k V] in
/-- In characteristic `2`, an involution `f` has the trace of the identity: `(f - 1)² = 0`. -/
theorem trace_eq_of_mul_self_eq_one {f : V →ₗ[k] V} (hf : f * f = 1) :
    LinearMap.trace k V f = LinearMap.trace k V 1 := by
  have h2 : (2 : k) = 0 := CharTwo.two_eq_zero
  have hnil : IsNilpotent (f - 1) := by
    refine ⟨2, ?_⟩
    have hff : f + f = 0 := by rw [← two_smul k f, h2, zero_smul]
    have : (f - 1) ^ 2 = f * f - (f + f) + 1 := by noncomm_ring
    rw [this, hf, hff, sub_zero, ← two_smul k (1 : V →ₗ[k] V), h2, zero_smul]
  have := (LinearMap.isNilpotent_trace_of_isNilpotent hnil).eq_zero
  rwa [map_sub, sub_eq_zero] at this

omit [FiniteDimensional k V] in
/-- In characteristic `2`, `χ(g) = χ(1)` when `g² = 1`. -/
theorem character_eq_of_sq_eq_one {G : Type*} [Monoid G] (ρ : Representation k G V) {g : G}
    (hg : g * g = 1) : ρ.character g = ρ.character 1 := by
  rw [Representation.character, Representation.character, map_one]
  exact trace_eq_of_mul_self_eq_one (by rw [← map_mul, hg, map_one])

/-- **The remark after (2) fails** for `G = ℤ/2` in characteristic `2`: the indicator of `1` is not
in the span of the characters of any family of finite-dimensional representations. -/
theorem single_one_not_mem_span_characters {ι : Type*} (V : ι → Type*)
    [∀ i, AddCommGroup (V i)] [∀ i, Module k (V i)] [∀ i, FiniteDimensional k (V i)]
    (ρ : ∀ i, Representation k (Multiplicative (ZMod 2)) (V i)) :
    (Pi.single 1 1 : Multiplicative (ZMod 2) → k) ∉
      Submodule.span k (Set.range fun i => (ρ i).character) := by
  set g : Multiplicative (ZMod 2) := Multiplicative.ofAdd 1
  have hg1 : g ≠ 1 := by decide
  -- the functions with `f g = f 1` form a submodule containing every character
  let S : Submodule k (Multiplicative (ZMod 2) → k) :=
    { carrier := {f | f g = f 1}
      add_mem' := fun {a b} ha hb => by simp_all
      zero_mem' := rfl
      smul_mem' := fun c f hf => by simp_all }
  have hsub : Submodule.span k (Set.range fun i => (ρ i).character) ≤ S := by
    rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    exact character_eq_of_sq_eq_one (ρ i) (by decide)
  intro h
  have := hsub h
  simp [S, hg1] at this

end TrPrime

section Prop10

open TensorProduct

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- If `x ∉ K`, then `x ⊗ 1 ≠ 1 ⊗ x` in `L ⊗_K L`: apply `id ⊗ f` for a linear form `f` with
`f(x) = 0` and `f(1) ≠ 0`. -/
theorem tmul_one_ne_one_tmul {x : L} (hx : x ∉ Set.range (algebraMap K L)) :
    x ⊗ₜ[K] (1 : L) ≠ (1 : L) ⊗ₜ[K] x := by
  have h1 : (1 : L) ∉ K ∙ x := by
    intro h
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp h
    have hc0 : c ≠ 0 := by rintro rfl; simp at hc
    exact hx ⟨c⁻¹, by rw [Algebra.algebraMap_eq_smul_one, ← hc, smul_smul, inv_mul_cancel₀ hc0,
      one_smul]⟩
  obtain ⟨f, hf1, hfx⟩ := Submodule.exists_dual_map_eq_bot_of_notMem h1 inferInstance
  have hfx' : f x = 0 := by
    have : f x ∈ (K ∙ x).map f := Submodule.mem_map_of_mem (Submodule.mem_span_singleton_self x)
    rwa [hfx, Submodule.mem_bot] at this
  intro h
  have := congrArg ((TensorProduct.rid K L).toLinearMap ∘ₗ LinearMap.lTensor L f) h
  simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.lTensor_tmul, hfx',
    LinearEquiv.coe_coe, TensorProduct.rid_tmul, zero_smul] at this
  have hx0 : x ≠ 0 := by rintro rfl; exact hx ⟨0, map_zero _⟩
  exact hx0 ((smul_eq_zero.mp this).resolve_left hf1)

/-- If `L ≠ K`, the `K`-algebra `L ⊗_K L` is not simple as a module over itself: the kernel of
the multiplication `L ⊗ L → L` is a proper nonzero ideal. -/
theorem not_isSimpleModule_tensor {x : L} (hx : x ∉ Set.range (algebraMap K L)) :
    ¬ IsSimpleModule (L ⊗[K] L) (L ⊗[K] L) := by
  intro hs
  let m := Algebra.TensorProduct.lmul' (S := L) K
  let I : Ideal (L ⊗[K] L) := RingHom.ker m.toRingHom
  rcases IsSimpleOrder.eq_bot_or_eq_top I with h | h
  · apply tmul_one_ne_one_tmul hx
    rw [← sub_eq_zero]
    have : x ⊗ₜ[K] (1 : L) - 1 ⊗ₜ[K] x ∈ I := by
      simp [I, RingHom.mem_ker, m, Algebra.TensorProduct.lmul'_apply_tmul]
    rwa [h, Submodule.mem_bot] at this
  · have : (1 : L ⊗[K] L) ∈ I := h ▸ Submodule.mem_top
    simp [I, RingHom.mem_ker, m] at this

/-- **The corollary of Prop. 10 fails** without finite dimension: over the algebraically closed
field `ℂ`, the simple `ℂ(t)`-module `ℂ(t)` has a tensor square that is not simple over
`ℂ(t) ⊗ ℂ(t)`. -/
theorem cor_prop10_fails :
    ¬ IsSimpleModule (RatFunc ℂ ⊗[ℂ] RatFunc ℂ) (RatFunc ℂ ⊗[ℂ] RatFunc ℂ) := by
  refine not_isSimpleModule_tensor (x := RatFunc.X) ?_
  rintro ⟨c, hc⟩
  have := congrArg RatFunc.intDegree hc
  rw [RatFunc.algebraMap_eq_C, RatFunc.intDegree_C, RatFunc.intDegree_X] at this
  exact absurd this (by decide)

end Prop10

end Bourbaki.Redaction596Characters
