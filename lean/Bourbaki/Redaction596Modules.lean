import Mathlib

/-!
# Bourbaki, rédaction n° 596, §§ 1, 2, 4, 5: five statements on modules to be corrected

Rédaction 596 of the Bourbaki archive (Archives Henri Poincaré, item 1142) is a draft of *Algèbre*,
ch. VIII (1973–74). Its first sections, on modules and rings of finite length, Morita theory and
simple rings, contain the following slips. We write `A_s` (resp. `A_d`) for the ring `A` viewed
as a left (resp. right) module over itself, and `A°` for the opposite ring.

**§ 4 n° 3, Example 1, p. 54.** With `S = A_s^n` and `D = M_n(A°) = End_A(S)`, the page says that
the `D`-module `S` is artinian (resp. noetherian) if and only if the `A`-module `A_s` is. The
`D`-submodules of `S` correspond to the *right* ideals of `A`, so the condition is on `A_d`. Take
`n = 1`: then `D = A°` and the `A°`-submodules of `A` are the right ideals. Counterexample: the
triangular ring `T = [[ℝ, ℝ], [0, ℚ]]`, a subring of `M₂(ℝ)`. As a left module over itself it is
of finite length (it is generated by three elements over the diagonal subring `ℝ × ℚ`, acting by
left multiplication); but each `ℚ`-subspace `V` of `ℝ` gives a right ideal `[[0, V], [0, 0]]`, so
`T` is neither artinian nor noetherian on the right.

* `T`, `diagHom`: the ring `T` and the diagonal embedding `ℝ × ℚ → T`;
* `isArtinianRing_T`, `isNoetherianRing_T`: `T_s` is artinian and noetherian;
* `corner`, `cornerEmb`: `ℚ`-subspaces of `ℝ` embed, as an ordered set, in the right ideals of `T`;
* `not_isArtinian_op`, `not_isNoetherian_op`: the `T°`-module `T` is neither artinian nor
  noetherian;
* `example1_fails`: the four facts together.

**§ 4, Remark 4 (starred), p. 55.** The isomorphism classes of autoequivalences of the category of
`A`-modules form a group, which for commutative `A ≠ 0` would be isomorphic to the group of
classes of projective modules of rank `1`, `Pic(A)`. This holds for the `A`-linear
autoequivalences; in general a ring automorphism `σ` of `A` gives the restriction of scalars
along `σ`, an autoequivalence which is not isomorphic to the identity when `σ ≠ id`, so the group
is `Pic(A) ⋊ Aut(A)`. Witness: `ℂ` with complex conjugation, while `Pic(ℂ)` is trivial.

* `eq_of_iso_id`: if restriction of scalars along `σ` is isomorphic to the identity functor
  of the category of `K`-modules (`K` commutative), then `σ = id`;
* `restrictScalars_conj_not_iso_id`: the case of `ℂ` and conjugation;
* `pic_complex_subsingleton`: `Pic(ℂ)` is trivial.

**§ 5 n° 6, Definition 5 and Prop. 16 a), pp. 72–73.** For a simple subring `B` of a ring `A` and a
nonzero `A`-module `M` of finite length over `B`, the commutant `A'` of the `A`-module `M` would
be a simple ring. The proof uses that `M` is a semisimple isotypic `A`-module, which needs `A`
simple; the number does not assume it. Counterexample: `A = ℚ[ε]` (`ε² = 0`), `B = ℚ`, `M = A`;
then `A' = End_A(A) ≅ A` is not simple.

* `eps_ne_zero`: `ε ≠ 0`;
* `finite_dualNumber`: `M = ℚ[ε]` has finite length over `ℚ`;
* `prop16a_fails`: `End_A(A)` is not a simple ring.

**§ 2 n° 2, Example 5, p. 33.** Over a principal ideal domain `A` that is not a field, a module
would be semisimple if it is torsion with elementary divisors « of multiplicity 1 ». The word
is ambiguous. If it means that each elementary divisor occurs once, `ℤ/4` (one elementary divisor,
`4`) is a counterexample, and `ℤ/2 ⊕ ℤ/2` (the divisor `2` twice) is semisimple all the same.
The intended condition is that each elementary divisor is a prime element, that is, has exponent
`1` in its factorisation.

* `not_isSemisimpleModule_zmod_four`: `ℤ/4` is not a semisimple `ℤ`-module;
* `isSemisimpleModule_zmod_two_sq`: `ℤ/2 × ℤ/2` is a semisimple `ℤ`-module.

**§ 1 n° 1, Example 3, p. 9.** The `ℤ`-module `ℤ/nℤ` would be indecomposable if and only if
`n = p^m` with `p` prime and `m ≥ 1`. This fails for `n = 0`: `ℤ/0ℤ = ℤ` (`ZMod 0` is `ℤ` by
definition) is indecomposable, two nonzero ideals of `ℤ` always meeting. The statement holds for
`n ≥ 1`.

* `int_indecomposable`: a decomposition of `ℤ` into two complementary submodules is trivial;
* `zero_ne_prime_pow`: `0` is not of the form `p^m`.
-/

namespace Bourbaki.Redaction596Modules

open MulOpposite CategoryTheory

section Example1

/-- The ring `T = [[ℝ, ℝ], [0, ℚ]]` of upper triangular real matrices with rational lower right
entry. -/
def T : Subring (Matrix (Fin 2) (Fin 2) ℝ) where
  carrier := {M | M 1 0 = 0 ∧ M 1 1 ∈ Set.range ((↑) : ℚ → ℝ)}
  mul_mem' := by
    rintro M N ⟨hM, q, hq⟩ ⟨hN, r, hr⟩
    refine ⟨?_, q * r, ?_⟩ <;> simp [Matrix.mul_apply, Fin.sum_univ_two, hM, hN, ← hq, ← hr]
  one_mem' := ⟨by simp, 1, by simp⟩
  add_mem' := by
    rintro M N ⟨hM, q, hq⟩ ⟨hN, r, hr⟩
    exact ⟨by simp [hM, hN], q + r, by simp [hq, hr]⟩
  zero_mem' := ⟨by simp, 0, by simp⟩
  neg_mem' := by
    rintro M ⟨hM, q, hq⟩
    exact ⟨by simp [hM], -q, by simp [hq]⟩

/-- The diagonal embedding `ℝ × ℚ → T`, `(r, q) ↦ diag(r, q)`. -/
noncomputable def diagHom : ℝ × ℚ →+* T where
  toFun c := ⟨!![c.1, 0; 0, (c.2 : ℝ)], by simp, c.2, by simp⟩
  map_one' := Subtype.ext (by simp [Matrix.one_fin_two])
  map_mul' c d := Subtype.ext (by simp)
  map_zero' := Subtype.ext (by ext i j; fin_cases i <;> fin_cases j <;> simp)
  map_add' c d := Subtype.ext (by ext i j; fin_cases i <;> fin_cases j <;> simp)

/-- `ℝ × ℚ` acts on `T` by left multiplication through `diagHom`. -/
noncomputable instance : Module (ℝ × ℚ) T := Module.compHom T diagHom

instance : IsScalarTower (ℝ × ℚ) T T where
  smul_assoc c s t := mul_assoc (diagHom c) s t

theorem smul_def (c : ℝ × ℚ) (t : T) : c • t = diagHom c * t := rfl

/-- The matrix unit `e₁₁`. -/
noncomputable def e11 : T := ⟨!![1, 0; 0, 0], by simp, 0, by simp⟩

/-- The matrix unit `e₁₂`. -/
noncomputable def e12 : T := ⟨!![0, 1; 0, 0], by simp, 0, by simp⟩

/-- The matrix unit `e₂₂`. -/
noncomputable def e22 : T := ⟨!![0, 0; 0, 1], by simp, 1, by simp⟩

/-- `e₁₁`, `e₁₂`, `e₂₂` generate `T` as a module over `ℝ × ℚ`. -/
theorem span_eq_top : Submodule.span (ℝ × ℚ) {e11, e12, e22} = ⊤ := by
  refine eq_top_iff.mpr fun t _ => ?_
  obtain ⟨h10, q, hq⟩ := t.2
  have ht : t = ((t : Matrix (Fin 2) (Fin 2) ℝ) 0 0, (0 : ℚ)) • e11
      + ((t : Matrix (Fin 2) (Fin 2) ℝ) 0 1, (0 : ℚ)) • e12 + ((0 : ℝ), q) • e22 := by
    apply Subtype.ext
    ext i j
    fin_cases i <;> fin_cases j <;> simp [smul_def, diagHom, e11, e12, e22, h10, hq]
  rw [ht]
  refine add_mem (add_mem ?_ ?_) ?_ <;>
    exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))

instance : Module.Finite (ℝ × ℚ) T := ⟨⟨{e11, e12, e22}, by simpa using span_eq_top⟩⟩

/-- `T` is left artinian: `T_s` is artinian. -/
theorem isArtinianRing_T : IsArtinianRing T := IsArtinianRing.of_finite (ℝ × ℚ) T

/-- `T` is left noetherian: `T_s` is noetherian. -/
theorem isNoetherianRing_T : IsNoetherianRing T := IsNoetherianRing.of_finite (ℝ × ℚ) T

/-- The right ideal `[[0, V], [0, 0]]` of `T` attached to a `ℚ`-subspace `V` of `ℝ`, as a
submodule of the `T°`-module `T`. -/
def corner (V : Submodule ℚ ℝ) : Submodule Tᵐᵒᵖ T where
  carrier := {t | (t : Matrix (Fin 2) (Fin 2) ℝ) 0 0 = 0 ∧ (t : Matrix (Fin 2) (Fin 2) ℝ) 1 1 = 0
    ∧ (t : Matrix (Fin 2) (Fin 2) ℝ) 0 1 ∈ V}
  add_mem' := by
    rintro s t ⟨h1, h2, h3⟩ ⟨k1, k2, k3⟩
    exact ⟨by simp [h1, k1], by simp [h2, k2], by simpa using V.add_mem h3 k3⟩
  zero_mem' := ⟨rfl, rfl, V.zero_mem⟩
  smul_mem' := by
    rintro c t ⟨h1, h2, h3⟩
    obtain ⟨h10, q, hq⟩ := (unop c).2
    have t10 := t.2.1
    refine ⟨?_, ?_, ?_⟩
    · simp [Matrix.mul_apply, Fin.sum_univ_two, h1, h10]
    · simp [Matrix.mul_apply, Fin.sum_univ_two, h2, t10]
    · have := V.smul_mem q h3
      simpa [Matrix.mul_apply, Fin.sum_univ_two, h1, ← hq, Rat.smul_def, mul_comm] using this

/-- The element `[[0, b], [0, 0]]` of `T`. -/
noncomputable def cornerElt (b : ℝ) : T := ⟨!![0, b; 0, 0], by simp, 0, by simp⟩

theorem cornerElt_mem_iff (V : Submodule ℚ ℝ) (b : ℝ) : cornerElt b ∈ corner V ↔ b ∈ V := by
  simp [corner, cornerElt]

/-- `V ↦ [[0, V], [0, 0]]` is an order embedding of the `ℚ`-subspaces of `ℝ` into the right
ideals of `T`. -/
noncomputable def cornerEmb : Submodule ℚ ℝ ↪o Submodule Tᵐᵒᵖ T :=
  OrderEmbedding.ofMapLEIff corner fun V W => by
    refine ⟨fun h b hb => ?_, fun h t ⟨h1, h2, h3⟩ => ⟨h1, h2, h h3⟩⟩
    exact (cornerElt_mem_iff W b).mp (h ((cornerElt_mem_iff V b).mpr hb))

/-- `ℝ` is not finite-dimensional over `ℚ`, being uncountable. -/
theorem not_finite_rat_real : ¬ Module.Finite ℚ ℝ := by
  intro _
  have : Countable ℝ := (Module.finBasis ℚ ℝ).equivFun.toEquiv.injective.countable
  exact not_countable this

/-- `T` is not right artinian: the `T°`-module `T` is not artinian. -/
theorem not_isArtinian_op : ¬ IsArtinian Tᵐᵒᵖ T := by
  intro _
  have : IsArtinian ℚ ℝ := cornerEmb.wellFoundedLT
  exact not_finite_rat_real (IsSemiprimaryRing.finite_of_isArtinian ℚ ℚ ℝ)

/-- `T` is not right noetherian: the `T°`-module `T` is not noetherian. -/
theorem not_isNoetherian_op : ¬ IsNoetherian Tᵐᵒᵖ T := by
  intro _
  have : IsNoetherian ℚ ℝ := isNoetherian_iff.mpr cornerEmb.wellFoundedGT
  exact not_finite_rat_real inferInstance

/-- **Example 1 of § 4 n° 3 fails** for `n = 1`: with `A = T` and `D = A°`, the `A`-module `A_s`
is artinian and noetherian, the `D`-module `A_s` is neither. -/
theorem example1_fails :
    IsArtinian T T ∧ ¬ IsArtinian Tᵐᵒᵖ T ∧ IsNoetherian T T ∧ ¬ IsNoetherian Tᵐᵒᵖ T :=
  ⟨isArtinianRing_T, not_isArtinian_op, isNoetherianRing_T, not_isNoetherian_op⟩

end Example1

section Remark4

universe u

/-- If the restriction of scalars along a ring automorphism `σ` of a commutative ring `K` is
isomorphic to the identity functor of the category of `K`-modules, then `σ = id`. The component
`f` of the isomorphism at `K` satisfies `f(σ(c) x) = c f(x)`; naturality with respect to the
multiplications gives `f(b x) = b f(x)`; and `f(1)` is a unit. -/
theorem eq_of_iso_id {K : Type u} [CommRing K] (σ : K ≃+* K)
    (α : ModuleCat.restrictScalars.{u} σ.toRingHom ≅ 𝟭 (ModuleCat.{u} K)) (c : K) : σ c = c := by
  let M := ModuleCat.of K K
  let f : K → K := fun x => (α.hom.app M).hom x
  have h1 : ∀ x, f (σ c * x) = c * f x := fun x => (α.hom.app M).hom.map_smul c x
  have h2 : ∀ b x, f (b * x) = b * f x := fun b x => by
    exact congrArg (fun g => ModuleCat.Hom.hom g x)
      (α.hom.naturality (ModuleCat.ofHom (LinearMap.mulLeft K b) : M ⟶ M))
  obtain ⟨m, hm⟩ : ∃ m, f m = 1 :=
    ⟨(α.inv.app M).hom (show ((𝟭 (ModuleCat K)).obj M : Type u) from (1 : K)),
      congrArg (fun g => ModuleCat.Hom.hom g (show ((𝟭 (ModuleCat K)).obj M : Type u) from (1 : K)))
        (α.inv_hom_id_app M)⟩
  have hu : m * f 1 = 1 := by rw [← h2, mul_one, hm]
  have : σ c * f 1 = c * f 1 := by rw [← h2, h1]
  calc σ c = σ c * f 1 * m := by rw [mul_assoc, mul_comm (f 1), hu, mul_one]
    _ = c := by rw [this, mul_assoc, mul_comm (f 1), hu, mul_one]

/-- Complex conjugation as a ring automorphism of `ℂ`. -/
noncomputable abbrev conj : ℂ ≃+* ℂ := Complex.conjAe.toRingEquiv

/-- Restriction of scalars along conjugation is an autoequivalence of the category of
`ℂ`-modules. -/
noncomputable example : (ModuleCat.restrictScalars.{0} conj.toRingHom).IsEquivalence :=
  inferInstance

/-- **Remark 4 of § 4**: restriction of scalars along complex conjugation is an autoequivalence
of the category of `ℂ`-modules not isomorphic to the identity. -/
theorem restrictScalars_conj_not_iso_id :
    IsEmpty (ModuleCat.restrictScalars.{0} conj.toRingHom ≅ 𝟭 (ModuleCat.{0} ℂ)) := by
  refine ⟨fun α => ?_⟩
  have := eq_of_iso_id conj α Complex.I
  simp [Complex.ext_iff] at this
  norm_num at this

/-- The Picard group of `ℂ` is trivial (`ℂ` is a local ring). -/
theorem pic_complex_subsingleton : Subsingleton (CommRing.Pic ℂ) := inferInstance

end Remark4

section Prop16

/-- `ε ≠ 0` in `ℚ[ε]`. -/
theorem eps_ne_zero : (DualNumber.eps : DualNumber ℚ) ≠ 0 := fun h => by
  simpa using congrArg TrivSqZeroExt.snd h

/-- `ℚ[ε]` is a finite-dimensional `ℚ`-vector space, hence of finite length over `B = ℚ`. -/
theorem finite_dualNumber : Module.Finite ℚ (DualNumber ℚ) :=
  inferInstanceAs (Module.Finite ℚ (ℚ × ℚ))

/-- **Prop. 16 a) of § 5 fails** without `A` simple: for `A = ℚ[ε]` and `M = A`, the commutant
`End_A(A) ≅ A°` is not a simple ring, since `A` is commutative and not a field. -/
theorem prop16a_fails : ¬ IsSimpleRing (Module.End (DualNumber ℚ) (DualNumber ℚ)) := by
  intro h
  have h1 : IsSimpleRing (DualNumber ℚ)ᵐᵒᵖ :=
    IsSimpleRing.of_ringEquiv (RingEquiv.moduleEndSelf _).symm h
  have h2 : IsSimpleRing (DualNumber ℚ) :=
    IsSimpleRing.of_ringEquiv (RingEquiv.toOpposite (DualNumber ℚ)).symm h1
  obtain ⟨b, hb⟩ := ((isSimpleRing_iff_isField _).mp h2).mul_inv_cancel eps_ne_zero
  apply eps_ne_zero
  calc (DualNumber.eps : DualNumber ℚ) = DualNumber.eps * (DualNumber.eps * b) := by
        rw [hb, mul_one]
    _ = 0 := by rw [← mul_assoc, DualNumber.eps_mul_eps, zero_mul]

end Prop16

section Example5

/-- **Example 5 of § 2 n° 2**, first reading: `ℤ/4`, whose only elementary divisor `4` occurs
once, is not semisimple. The submodule `2ℤ/4` has no complement: writing `1 = p + n` with
`p ∈ 2ℤ/4` and `n` in a complement `N` gives `2 = 2n ∈ N`. -/
theorem not_isSemisimpleModule_zmod_four : ¬ IsSemisimpleModule ℤ (ZMod 4) := by
  intro _
  obtain ⟨N, hN⟩ := exists_isCompl (Submodule.span ℤ {(2 : ZMod 4)})
  obtain ⟨p, hp, n, hn, hpn⟩ :=
    Submodule.mem_sup.mp (hN.sup_eq_top ▸ Submodule.mem_top (x := (1 : ZMod 4)))
  obtain ⟨k, rfl⟩ := Submodule.mem_span_singleton.mp hp
  have h2 : (2 : ℤ) • n = 2 := by
    have : n = 1 - k • 2 := by rw [← hpn]; abel
    rw [this, zsmul_eq_mul, zsmul_eq_mul]
    generalize (k : ZMod 4) = x
    revert x; decide
  have hmem : (2 : ZMod 4) ∈ Submodule.span ℤ {(2 : ZMod 4)} ⊓ N :=
    ⟨Submodule.subset_span rfl, h2 ▸ N.smul_mem _ hn⟩
  rw [hN.inf_eq_bot] at hmem
  exact absurd ((Submodule.mem_bot ℤ).mp hmem) (by decide)

instance : RingHomSurjective (Int.castRingHom (ZMod 2)) := ⟨ZMod.ringHom_surjective _⟩

/-- **Example 5 of § 2 n° 2**, the other side: `ℤ/2 × ℤ/2`, whose elementary divisor `2` occurs
twice, is semisimple, being a vector space over `ℤ/2`. -/
theorem isSemisimpleModule_zmod_two_sq : IsSemisimpleModule ℤ (ZMod 2 × ZMod 2) := by
  let l : (ZMod 2 × ZMod 2) →ₛₗ[Int.castRingHom (ZMod 2)] (ZMod 2 × ZMod 2) :=
    { toFun := id, map_add' := fun _ _ => rfl, map_smul' := fun k x => by ext <;> simp }
  exact (l.isSemisimpleModule_iff_of_bijective Function.bijective_id).mpr inferInstance

end Example5

section Example3

/-- `ℤ = ℤ/0ℤ` is an indecomposable `ℤ`-module: if `ℤ = P ⊕ Q`, one of `P`, `Q` is zero, since
for `a ∈ P` and `b ∈ Q` nonzero, `ab ≠ 0` lies in `P ∩ Q`. -/
theorem int_indecomposable (P Q : Submodule ℤ ℤ) (h : IsCompl P Q) : P = ⊥ ∨ Q = ⊥ := by
  by_contra! hc
  obtain ⟨a, ha, ha0⟩ := P.ne_bot_iff.mp hc.1
  obtain ⟨b, hb, hb0⟩ := Q.ne_bot_iff.mp hc.2
  have hP : a * b ∈ P := by simpa [mul_comm] using P.smul_mem b ha
  have hQ : a * b ∈ Q := Q.smul_mem a hb
  have : a * b ∈ P ⊓ Q := ⟨hP, hQ⟩
  rw [h.inf_eq_bot, Submodule.mem_bot] at this
  exact mul_ne_zero ha0 hb0 this

/-- **Example 3 of § 1 n° 1 fails for `n = 0`**: `0` is not a prime power `p^m`, `m ≥ 1`, though
`ℤ/0ℤ` is indecomposable (`int_indecomposable`). -/
theorem zero_ne_prime_pow : ¬ ∃ p m : ℕ, p.Prime ∧ 1 ≤ m ∧ (0 : ℕ) = p ^ m := by
  rintro ⟨p, m, hp, -, h⟩
  exact pow_ne_zero m hp.ne_zero h.symm

end Example3

end Bourbaki.Redaction596Modules
