import Mathlib

/-!
# Folder 76, pages 26–28: flags of type `H` in a set with operators

The modernised reading `transcripts/76/76.modern.tex` (« Second exemple :
ensembles à opérateurs et drapeaux de type H », pages 26 to 29) takes a group
`G` with elements `σ₀, …, σₙ` such that `σᵢ` and `σⱼ` commute for `|i − j| ≥ 2`,
writes `G_K` for the subgroup generated by the `σᵢ`, `i ∈ K`, and
`N_H = G_{Δₙ ∖ H}`, and for a `G`-set `X` the presheaf of flags of type `H`,
`D(H) = X / N_H`, restriction along `H ⊆ H'` coming from `N_{H'} ⊆ N_H`. It states:

> **Lemme (pages 27 and 28).** Let `H, H' ⊆ Δₙ` be such that the largest element
> of `H` lies in `H'` and `H ∩ H'` is an initial segment of `H'`. Then
> `D(H ∪ H') → D(H) ×_{D(H ∩ H')} D(H')` is surjective.

and deduces that the relation `x ≺ y` on the vertices `D₀ = ∐ᵢ D({i})` —
`x ∈ D({i})`, `y ∈ D({j})`, `i < j`, `x` and `y` with a common majorant — is
transitive, for every `G`-set `X`, with no involution condition on the `σᵢ`.

This is finding `76-flag-presheaf-gset-lemma` of `src/content/findings.ts`.
Proving it says only that the claim holds as stated; whether it stands in the
literature is a separate question.

What is formalised.

* `mem_mul_of_split`: if `K ∪ K'` splits at an index `i ∉ K ∪ K'` into a part
  below `i` contained in `K'` and a part above `i` contained in `K`, then every
  element of `G_{K ∪ K'}` is a product `k' k` with `k' ∈ G_{K'}`, `k ∈ G_K` (the
  two parts are at distance `≥ 2`, so their subgroups commute elementwise).
* `flag_lemma`: the Lemme, under the margin's weakened hypotheses, as the
  surjectivity onto the fibre product, written as « two flags with the same
  restriction to `H ∩ H'` come from one flag of type `H ∪ H'` ».
* `prec_trans`: the vertex relation is transitive (the case `H = {i, j}`,
  `H' = {j, k}`); `prec_iff_pair` reduces the common majorant to one in
  `D({i, j})`; `prec_of_mem` and `not_prec_self` give (c) and irreflexivity.

The `σᵢ` are not assumed to be involutions; the group, the set `X` and the
action are arbitrary.
-/

namespace Grothendieck.Folder76

open MulAction

variable {G : Type*} [Group G] {n : ℕ}

/-- `G_K`, the subgroup generated by the `σᵢ`, `i ∈ K`. -/
def gen (σ : Fin (n + 1) → G) (K : Set (Fin (n + 1))) : Subgroup G :=
  Subgroup.closure (σ '' K)

/-- `N_H = G_{Δₙ ∖ H}`. -/
def N (σ : Fin (n + 1) → G) (H : Set (Fin (n + 1))) : Subgroup G := gen σ Hᶜ

lemma gen_mono (σ : Fin (n + 1) → G) {K K' : Set (Fin (n + 1))} (h : K ⊆ K') :
    gen σ K ≤ gen σ K' :=
  Subgroup.closure_mono (Set.image_mono h)

lemma N_anti (σ : Fin (n + 1) → G) {H H' : Set (Fin (n + 1))} (h : H ⊆ H') :
    N σ H' ≤ N σ H :=
  gen_mono σ (Set.compl_subset_compl.mpr h)

/-- If the generators of two subgroups commute pairwise, so do all their
elements. -/
lemma commute_of_closure {A B : Set G} (h : ∀ a ∈ A, ∀ b ∈ B, Commute a b) {a b : G}
    (ha : a ∈ Subgroup.closure A) (hb : b ∈ Subgroup.closure B) : Commute a b := by
  have hA : Subgroup.closure A ≤ Subgroup.centralizer (Subgroup.closure B : Set G) := by
    rw [Subgroup.centralizer_closure, Subgroup.closure_le]
    exact fun a ha => Subgroup.mem_centralizer_iff.2 fun b hb => (h a ha b hb).eq.symm
  exact (Subgroup.mem_centralizer_iff.1 (hA ha) b hb).symm

/-- The product decomposition of page 28: if `K ∪ K'` splits at `i ∉ K ∪ K'`,
the part below `i` lying in `K'` and the part above `i` in `K`, then
`G_{K ∪ K'} ⊆ G_{K'} · G_K`. -/
theorem mem_mul_of_split (σ : Fin (n + 1) → G)
    (hσ : ∀ i j : Fin (n + 1), (i : ℕ) + 2 ≤ j → Commute (σ i) (σ j))
    {K K' : Set (Fin (n + 1))} (i : Fin (n + 1)) (hi : i ∉ K ∪ K')
    (hlow : ∀ j ∈ K ∪ K', j < i → j ∈ K') (hhigh : ∀ j ∈ K ∪ K', i < j → j ∈ K)
    {g : G} (hg : g ∈ gen σ (K ∪ K')) :
    ∃ a ∈ gen σ K', ∃ b ∈ gen σ K, g = a * b := by
  set SA : Set (Fin (n + 1)) := {j | j ∈ K ∪ K' ∧ j < i}
  set SB : Set (Fin (n + 1)) := {j | j ∈ K ∪ K' ∧ i < j}
  have hAK : gen σ SA ≤ gen σ K' := gen_mono σ fun j hj => hlow j hj.1 hj.2
  have hBK : gen σ SB ≤ gen σ K := gen_mono σ fun j hj => hhigh j hj.1 hj.2
  have hcomm : ∀ {a b : G}, a ∈ gen σ SA → b ∈ gen σ SB → Commute a b := fun ha hb => by
    refine commute_of_closure ?_ ha hb
    rintro _ ⟨j, hj, rfl⟩ _ ⟨k, hk, rfl⟩
    apply hσ
    have h1 : (j : ℕ) < i := hj.2
    have h2 : (i : ℕ) < k := hk.2
    omega
  suffices h : ∃ a ∈ gen σ SA, ∃ b ∈ gen σ SB, g = a * b by
    obtain ⟨a, ha, b, hb, rfl⟩ := h
    exact ⟨a, hAK ha, b, hBK hb, rfl⟩
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨j, hj, rfl⟩ := hx
    rcases lt_trichotomy j i with h | h | h
    · exact ⟨σ j, Subgroup.subset_closure ⟨j, ⟨hj, h⟩, rfl⟩, 1, one_mem _, (mul_one _).symm⟩
    · exact absurd (h ▸ hj) hi
    · exact ⟨1, one_mem _, σ j, Subgroup.subset_closure ⟨j, ⟨hj, h⟩, rfl⟩, (one_mul _).symm⟩
  | one => exact ⟨1, one_mem _, 1, one_mem _, (one_mul _).symm⟩
  | mul x y _ _ hx hy =>
    obtain ⟨a, ha, b, hb, rfl⟩ := hx
    obtain ⟨a', ha', b', hb', rfl⟩ := hy
    refine ⟨a * a', mul_mem ha ha', b * b', mul_mem hb hb', ?_⟩
    rw [mul_assoc, ← mul_assoc b, ← (hcomm ha' hb).eq, mul_assoc, mul_assoc]
  | inv x _ hx =>
    obtain ⟨a, ha, b, hb, rfl⟩ := hx
    exact ⟨a⁻¹, inv_mem ha, b⁻¹, inv_mem hb,
      (mul_inv_rev a b).trans (hcomm (inv_mem ha) (inv_mem hb)).eq.symm⟩

variable (σ : Fin (n + 1) → G) (X : Type*) [MulAction G X]

/-- `D(H) = X / N_H`, the flags of type `H`. -/
abbrev D (H : Set (Fin (n + 1))) : Type _ := orbitRel.Quotient (N σ H) X

variable {σ X}

/-- The class in `D(H)` of a point of `X`. -/
def mk (H : Set (Fin (n + 1))) (x : X) : D σ X H := Quotient.mk'' x

lemma mk_eq_mk {H : Set (Fin (n + 1))} {x y : X} :
    mk (σ := σ) H x = mk H y ↔ ∃ g ∈ N σ H, g • y = x := by
  unfold mk
  rw [Quotient.eq'', orbitRel_apply]
  constructor
  · rintro ⟨g, rfl⟩
    exact ⟨g, g.2, rfl⟩
  · rintro ⟨g, hg, rfl⟩
    exact ⟨⟨g, hg⟩, rfl⟩

lemma mk_surjective (H : Set (Fin (n + 1))) : Function.Surjective (mk (σ := σ) (X := X) H) :=
  Quotient.mk''_surjective

/-- Restriction `D(H') → D(H)` for `H ⊆ H'`. -/
def res {H H' : Set (Fin (n + 1))} (h : H ⊆ H') : D σ X H' → D σ X H :=
  Quotient.map' id fun x y hxy => by
    rw [orbitRel_apply] at hxy ⊢
    obtain ⟨g, rfl⟩ := hxy
    exact ⟨⟨g, N_anti σ h g.2⟩, rfl⟩

@[simp] lemma res_mk {H H' : Set (Fin (n + 1))} (h : H ⊆ H') (x : X) :
    res h (mk (σ := σ) H' x) = mk H x := rfl

lemma res_res {H H' H'' : Set (Fin (n + 1))} (h : H ⊆ H') (h' : H' ⊆ H'') (d : D σ X H'') :
    res h (res h' d) = res (h.trans h') d := by
  obtain ⟨x, rfl⟩ := mk_surjective H'' d
  rfl

/-- **Lemme (pages 27–28)**, under the margin's hypotheses: the largest element
`i` of `H` lies in `H'`, and `H ∩ H'` is an initial segment of `H'`. Two flags
of types `H` and `H'` with the same restriction to `H ∩ H'` are the
restrictions of one flag of type `H ∪ H'`: `D(H ∪ H') → D(H) ×_{D(H ∩ H')} D(H')`
is surjective. -/
theorem flag_lemma (hσ : ∀ i j : Fin (n + 1), (i : ℕ) + 2 ≤ j → Commute (σ i) (σ j))
    {H H' : Set (Fin (n + 1))} (i : Fin (n + 1)) (hiH : i ∈ H) (hmax : ∀ j ∈ H, j ≤ i)
    (hiH' : i ∈ H') (hinit : ∀ j ∈ H', ∀ k ∈ H ∩ H', j ≤ k → j ∈ H)
    (a : D σ X H) (b : D σ X H')
    (hab : res Set.inter_subset_left a = res Set.inter_subset_right b) :
    ∃ c : D σ X (H ∪ H'), res Set.subset_union_left c = a ∧
      res Set.subset_union_right c = b := by
  obtain ⟨x, rfl⟩ := mk_surjective H a
  obtain ⟨y, rfl⟩ := mk_surjective H' b
  simp only [res_mk] at hab
  obtain ⟨g, hg, hgy⟩ := mk_eq_mk.mp hab
  -- `g⁻¹ ∈ N_{H ∩ H'} = G_{Hᶜ ∪ H'ᶜ}` splits as `k' k`.
  have hg' : g⁻¹ ∈ gen σ (Hᶜ ∪ H'ᶜ) := by
    rw [← Set.compl_inter]; exact inv_mem hg
  have hi : i ∉ Hᶜ ∪ H'ᶜ := by
    simp [hiH, hiH']
  have hlow : ∀ j ∈ Hᶜ ∪ H'ᶜ, j < i → j ∈ H'ᶜ := by
    intro j hj hji hjH'
    exact hj.elim (· (hinit j hjH' i ⟨hiH, hiH'⟩ hji.le)) (· hjH')
  have hhigh : ∀ j ∈ Hᶜ ∪ H'ᶜ, i < j → j ∈ Hᶜ := fun j _ hij hjH =>
    absurd (hmax j hjH) (not_le.mpr hij)
  obtain ⟨k', hk', k, hk, hkk⟩ := mem_mul_of_split σ hσ i hi hlow hhigh hg'
  refine ⟨mk _ (k • x), ?_, ?_⟩
  · exact mk_eq_mk.2 ⟨k, hk, rfl⟩
  · rw [res_mk, mk_eq_mk]
    refine ⟨k'⁻¹, inv_mem hk', ?_⟩
    rw [← inv_smul_smul g y, hgy, hkk, mul_smul, inv_smul_smul]

/-- The relation `≺` on vertices (page 27): for `x ∈ D({i})` and `y ∈ D({j})`,
`x ≺ y` if `i < j` and `x`, `y` have a common majorant in `D_* = ∐_H D(H)`. -/
def Prec {i j : Fin (n + 1)} (x : D σ X {i}) (y : D σ X {j}) : Prop :=
  i < j ∧ ∃ (H : Set (Fin (n + 1))) (hi : ({i} : Set (Fin (n + 1))) ⊆ H)
    (hj : ({j} : Set (Fin (n + 1))) ⊆ H) (d : D σ X H),
    res (σ := σ) (X := X) hi d = x ∧ res (σ := σ) (X := X) hj d = y

/-- A common majorant can always be taken in `D({i, j})`. -/
lemma prec_iff_pair {i j : Fin (n + 1)} (x : D σ X {i}) (y : D σ X {j}) :
    Prec x y ↔ i < j ∧ ∃ d : D σ X {i, j},
      res (by simp) d = x ∧ res (by simp) d = y := by
  refine ⟨?_, fun ⟨hij, d, hx, hy⟩ => ⟨hij, _, _, _, d, hx, hy⟩⟩
  rintro ⟨hij, H, hi, hj, d, rfl, rfl⟩
  have hsub : ({i, j} : Set (Fin (n + 1))) ⊆ H :=
    Set.insert_subset_iff.2 ⟨hi rfl, Set.singleton_subset_iff.2 (hj rfl)⟩
  exact ⟨hij, res hsub d, by rw [res_res], by rw [res_res]⟩

/-- (c): for `d ∈ D(H)` and `i < j` in `H`, the vertices of `d` of types `i`
and `j` satisfy `≺`. -/
lemma prec_of_mem {H : Set (Fin (n + 1))} (d : D σ X H) {i j : Fin (n + 1)}
    (hi : i ∈ H) (hj : j ∈ H) (hij : i < j) :
    Prec (res (Set.singleton_subset_iff.mpr hi) d) (res (Set.singleton_subset_iff.mpr hj) d) :=
  ⟨hij, H, _, _, d, rfl, rfl⟩

lemma not_prec_self {i : Fin (n + 1)} (x y : D σ X {i}) : ¬ Prec x y :=
  fun h => lt_irrefl _ h.1

/-- **Transitivity of `≺`** (page 27, by the Lemme with `H = {i, j}`,
`H' = {j, k}`), for every `G`-set `X` and no involution condition. -/
theorem prec_trans (hσ : ∀ i j : Fin (n + 1), (i : ℕ) + 2 ≤ j → Commute (σ i) (σ j))
    {i j k : Fin (n + 1)} {x : D σ X {i}} {y : D σ X {j}} {w : D σ X {k}}
    (hxy : Prec x y) (hyw : Prec y w) : Prec x w := by
  rw [prec_iff_pair] at hxy hyw ⊢
  obtain ⟨hij, d₁, rfl, hy₁⟩ := hxy
  obtain ⟨hjk, d₂, hy₂, rfl⟩ := hyw
  have hjm : ({i, j} : Set (Fin (n + 1))) ∩ {j, k} ⊆ {j} := by
    rintro m ⟨hm₁, hm₂⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hm₁ hm₂ ⊢
    rcases hm₁ with rfl | rfl
    · rcases hm₂ with rfl | rfl
      · rfl
      · exact absurd (hij.trans hjk) (lt_irrefl _)
    · rfl
  have hab : res Set.inter_subset_left d₁ = res Set.inter_subset_right d₂ := by
    have e₁ : res (Set.inter_subset_left : ({i, j} : Set (Fin (n + 1))) ∩ {j, k} ⊆ _) d₁ =
        res hjm (res (by simp) d₁) := by rw [res_res]
    have e₂ : res (Set.inter_subset_right : ({i, j} : Set (Fin (n + 1))) ∩ {j, k} ⊆ _) d₂ =
        res hjm (res (by simp) d₂) := by rw [res_res]
    rw [e₁, e₂, hy₁, hy₂]
  obtain ⟨c, hc₁, hc₂⟩ := flag_lemma hσ (H := {i, j}) (H' := {j, k}) j (by simp)
    (by simp [hij.le])
    (by simp)
    (by
      rintro m hm l ⟨hl₁, hl₂⟩ hml
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hm hl₁ hl₂ ⊢
      rcases hm with rfl | rfl
      · exact Or.inr rfl
      · exfalso
        rcases hl₁ with rfl | rfl
        · exact absurd (hij.trans_le (hjk.le.trans hml)) (lt_irrefl _)
        · exact absurd (hjk.trans_le hml) (lt_irrefl _))
    d₁ d₂ hab
  have hsub : ({i, k} : Set (Fin (n + 1))) ⊆ {i, j} ∪ {j, k} := by
    rintro m (rfl | rfl) <;> simp
  refine ⟨hij.trans hjk, res hsub c, ?_, ?_⟩
  · rw [res_res, ← hc₁, res_res]
  · rw [res_res, ← hc₂, res_res]

end Grothendieck.Folder76

/-!
# Folder 76, pages 20–24: semi-simplicial sets and orders on the vertices

The reading (« Ensembles semi-simpliciaux et ordre sur les sommets ») takes a semi-simplicial
set `D` satisfying (1) — the faces of a simplex are pairwise distinct — so that `D_* = ∐ D_m`,
ordered by « is a face of », satisfies (a): each `{δ ≤ d}` is the poset of non-empty subsets of
`Δ_m`. On `D₀` it sets `x ≺ y` iff some edge goes from `x` to `y`, transitive under (2 bis)
(composable edges bound a 2-simplex), and states the Proposition: semi-simplicial sets with (1)
and the transitivity (2°) correspond to posets with (a) carrying an order on `D₀` with (b) (`x ≺ y`
has a common majorant) and (c) (total on each `I_d`). The page's « (1) et (2) » has an uncertain
second numeral; the reading takes (2°), with the boundary of a triangle against (2 bis).

What is formalised (namespace `Grothendieck.Folder76.Sommets`):

* `NonSingular.isFlagGeom` — (1) gives (a), in vertex form (`IsFlagGeom`).
* `NonSingular.isCompatible_ord`, `NonSingular.edge_ord_iff` — the semi-simplicial structure
  gives compatible total orders on the simplices, whose edge relation is `≺`.
* `vertexOrderEquiv` — on any poset with (a), orders on `D₀` with (b), (c) are in bijection
  with compatible simplex orders whose edge relation is transitive, by restriction and `≺`.
* `NonSingular.trans_iff_vertexOrder`, `NonSingular.vertexOrder_unique` — the Proposition from
  the semi-simplicial side: (2°) holds iff the simplex orders come from one order on `D₀` with
  (b), (c), and that order is `≺`; `NonSingular.not_prec_self`: `x ≺ x` is impossible by (1).
* `NonSingular.trans_of_hornFill` — (2 bis) ⟹ (2°); `triangleBoundary_trans`,
  `triangleBoundary_not_hornFill` — the boundary of a triangle satisfies (1) and (2°) and not
  (2 bis), as the reading says.

The passage from compatible simplex orders back to a semi-simplicial set (pages 17–18) is not
redone here: it is the case `M = Δ_inj` of the equivalence `equivalence_page13` of
`Folder104.lean`. The remark on the opposite order and the realisations are not formalised.

**What the formalisation finds.** The Proposition holds with (2°), as the reading takes it. Of
condition (a) on the poset side only one consequence is used: two vertices of a simplex span an
edge below it (`IsFlagGeom.exists_face` for pairs); finiteness and the order isomorphism are not
needed for the correspondence.
-/

namespace Grothendieck.Folder76.Sommets

variable {P : Type*} [PartialOrder P]

/-- `I_d`: the vertices of `d`, the minimal elements below it. -/
def V (d : P) : Set P := {x | IsMin x ∧ x ≤ d}

variable (P) in
/-- Condition (a) of page 20, in vertex form: each `I_d` is finite and non-empty, and
`e ↦ I_e` is an order isomorphism from `{e ≤ d}` onto the non-empty subsets of `I_d`. -/
structure IsFlagGeom : Prop where
  finite : ∀ d : P, (V d).Finite
  nonempty : ∀ d : P, (V d).Nonempty
  le_iff : ∀ d e e' : P, e ≤ d → e' ≤ d → (e ≤ e' ↔ V e ⊆ V e')
  exists_face : ∀ (d : P) (S : Set P), S ⊆ V d → S.Nonempty → ∃ e ≤ d, V e = S

/-- An order on the vertices `D₀` (as a strict order) satisfying (b) and (c) of page 22. -/
structure IsVertexOrder (r : P → P → Prop) : Prop where
  irrefl : ∀ x, ¬ r x x
  trans : ∀ x y z, r x y → r y z → r x z
  isMin_left : ∀ x y, r x y → IsMin x
  isMin_right : ∀ x y, r x y → IsMin y
  /-- (b) -/
  majorant : ∀ x y, r x y → ∃ z, x ≤ z ∧ y ≤ z
  /-- (c) -/
  total : ∀ d, ∀ x ∈ V d, ∀ y ∈ V d, x ≠ y → r x y ∨ r y x

/-- Compatible total orders on the simplices `I_d` (pages 17–18), the datum the reading
identifies with a semi-simplicial structure satisfying (1): `o d` is a strict total order on
`I_d`, and for `e ≤ d` the order of `I_e` is the one induced by `I_d`. -/
structure IsCompatible (o : P → P → P → Prop) : Prop where
  support : ∀ d x y, o d x y → x ∈ V d ∧ y ∈ V d
  irrefl : ∀ d x, ¬ o d x x
  trans : ∀ d x y z, o d x y → o d y z → o d x z
  total : ∀ d, ∀ x ∈ V d, ∀ y ∈ V d, x ≠ y → o d x y ∨ o d y x
  restrict : ∀ e d, e ≤ d → ∀ x ∈ V e, ∀ y ∈ V e, (o e x y ↔ o d x y)

/-- The relation `x ≺ y` of page 22: there is an edge from `x` to `y`. -/
def edge (o : P → P → P → Prop) (x y : P) : Prop := ∃ z, V z = {x, y} ∧ x ≠ y ∧ o z x y

/-- The simplex orders induced by a vertex order. -/
def ofVertex (r : P → P → Prop) (d x y : P) : Prop := x ∈ V d ∧ y ∈ V d ∧ r x y

theorem V_mono {d d' : P} (h : d ≤ d') : V d ⊆ V d' := fun _ hx => ⟨hx.1, hx.2.trans h⟩

theorem mem_V_self {x : P} (hx : IsMin x) : x ∈ V x := ⟨hx, le_rfl⟩

theorem isCompatible_ofVertex {r : P → P → Prop} (hr : IsVertexOrder r) :
    IsCompatible (ofVertex r) where
  support _ _ _ h := ⟨h.1, h.2.1⟩
  irrefl _ x h := hr.irrefl x h.2.2
  trans _ _ _ _ h h' := ⟨h.1, h'.2.1, hr.trans _ _ _ h.2.2 h'.2.2⟩
  total d x hx y hy hxy := (hr.total d x hx y hy hxy).imp (fun h => ⟨hx, hy, h⟩)
    (fun h => ⟨hy, hx, h⟩)
  restrict _ _ hed _ hx _ hy := ⟨fun h => ⟨V_mono hed hx, V_mono hed hy, h.2.2⟩,
    fun h => ⟨hx, hy, h.2.2⟩⟩

section Flag

variable (hP : IsFlagGeom P)
include hP

/-- The edge relation of the simplex orders induced by a vertex order is that order: the order
is recovered, which is what (b) ensures (page 23). -/
theorem edge_ofVertex {r : P → P → Prop} (hr : IsVertexOrder r) : edge (ofVertex r) = r := by
  funext x y
  apply propext
  constructor
  · rintro ⟨z, -, -, h⟩
    exact h.2.2
  · intro h
    obtain ⟨z, hxz, hyz⟩ := hr.majorant x y h
    have hx : x ∈ V z := ⟨hr.isMin_left x y h, hxz⟩
    have hy : y ∈ V z := ⟨hr.isMin_right x y h, hyz⟩
    obtain ⟨e, -, he⟩ := hP.exists_face z {x, y} (Set.pair_subset hx hy) (Set.insert_nonempty _ _)
    exact ⟨e, he, fun hxy => hr.irrefl x (hxy ▸ h), he ▸ Set.mem_insert x {y},
      he ▸ Set.mem_insert_of_mem x rfl, h⟩

/-- Under (a), the edge relation of compatible simplex orders, when transitive, is a vertex order
satisfying (b) and (c) (page 22). -/
theorem isVertexOrder_edge {o : P → P → P → Prop} (ho : IsCompatible o)
    (htrans : ∀ x y z, edge o x y → edge o y z → edge o x z) : IsVertexOrder (edge o) where
  irrefl x h := by obtain ⟨_, _, hne, _⟩ := h; exact hne rfl
  trans := htrans
  isMin_left x y h := by
    obtain ⟨z, hz, -, -⟩ := h
    exact (hz.symm ▸ Set.mem_insert x {y} : x ∈ V z).1
  isMin_right x y h := by
    obtain ⟨z, hz, -, -⟩ := h
    exact (hz.symm ▸ Set.mem_insert_of_mem x rfl : y ∈ V z).1
  majorant x y h := by
    obtain ⟨z, hz, -, -⟩ := h
    exact ⟨z, (hz.symm ▸ Set.mem_insert x {y} : x ∈ V z).2,
      (hz.symm ▸ Set.mem_insert_of_mem x rfl : y ∈ V z).2⟩
  total d x hx y hy hxy := by
    obtain ⟨e, -, he⟩ := hP.exists_face d {x, y} (Set.pair_subset hx hy) (Set.insert_nonempty _ _)
    have hxe : x ∈ V e := he ▸ Set.mem_insert x {y}
    have hye : y ∈ V e := he ▸ Set.mem_insert_of_mem x rfl
    rcases ho.total e x hxe y hye hxy with h | h
    · exact Or.inl ⟨e, he, hxy, h⟩
    · exact Or.inr ⟨e, by rw [he, Set.pair_comm], hxy.symm, h⟩

/-- Under (a) and the transitivity (2°), the simplex orders are the ones induced by the edge
order: the vertex order determines the semi-simplicial structure (pages 23–24). -/
theorem ofVertex_edge {o : P → P → P → Prop} (ho : IsCompatible o)
    (htrans : ∀ x y z, edge o x y → edge o y z → edge o x z) : ofVertex (edge o) = o := by
  funext d x y
  apply propext
  constructor
  · rintro ⟨hx, hy, z, hz, hxy, hzo⟩
    obtain ⟨e, hed, he⟩ := hP.exists_face d {x, y} (Set.pair_subset hx hy) (Set.insert_nonempty _ _)
    have hxe : x ∈ V e := he ▸ Set.mem_insert x {y}
    have hye : y ∈ V e := he ▸ Set.mem_insert_of_mem x rfl
    refine (ho.restrict e d hed x hxe y hye).1 ?_
    rcases ho.total e x hxe y hye hxy with h | h
    · exact h
    · exfalso
      obtain ⟨_, _, hne, _⟩ := htrans x y x ⟨z, hz, hxy, hzo⟩ ⟨e, by rw [he, Set.pair_comm],
        hxy.symm, h⟩
      exact hne rfl
  · intro h
    obtain ⟨hx, hy⟩ := ho.support d x y h
    have hxy : x ≠ y := fun hxy => ho.irrefl d x (hxy ▸ h)
    obtain ⟨e, hed, he⟩ := hP.exists_face d {x, y} (Set.pair_subset hx hy) (Set.insert_nonempty _ _)
    have hxe : x ∈ V e := he ▸ Set.mem_insert x {y}
    have hye : y ∈ V e := he ▸ Set.mem_insert_of_mem x rfl
    exact ⟨hx, hy, e, he, hxy, (ho.restrict e d hed x hxe y hye).2 h⟩

/-- **The Proposition of pages 23–24**, on a poset satisfying (a): orders on `D₀` satisfying (b)
and (c) correspond bijectively to compatible total orders on the simplices whose edge relation is
transitive (2°), by `r ↦ (r restricted to each I_d)` and `o ↦ ≺`. -/
noncomputable def vertexOrderEquiv :
    {r : P → P → Prop // IsVertexOrder r} ≃
      {o : P → P → P → Prop // IsCompatible o ∧ ∀ x y z, edge o x y → edge o y z → edge o x z}
    where
  toFun r := ⟨ofVertex r.1, isCompatible_ofVertex r.2, by
    rw [edge_ofVertex hP r.2]; exact r.2.trans⟩
  invFun o := ⟨edge o.1, isVertexOrder_edge hP o.2.1 o.2.2⟩
  left_inv r := Subtype.ext (edge_ofVertex hP r.2)
  right_inv o := Subtype.ext (ofVertex_edge hP o.2.1 o.2.2)


end Flag

/-! ### Semi-simplicial sets satisfying (1) -/

/-- A semi-simplicial set: `D_m` for `m ∈ ℕ`, and `u^* : D_m → D_k` for every strictly increasing
`u : Δ_k → Δ_m`, contravariantly functorial. -/
structure SemiSimplicial where
  /-- `D_m` -/
  X : ℕ → Type
  /-- `u ↦ u^*` -/
  map : ∀ {k m : ℕ}, (Fin (k + 1) ↪o Fin (m + 1)) → X m → X k
  map_id : ∀ {m : ℕ} (x : X m), map (RelEmbedding.refl _) x = x
  map_comp : ∀ {k m n : ℕ} (u : Fin (k + 1) ↪o Fin (m + 1)) (v : Fin (m + 1) ↪o Fin (n + 1))
    (x : X n), map (u.trans v) x = map u (map v x)

/-- A semi-simplicial set satisfying (1) of page 18: the faces of a simplex are pairwise
distinct, `u ↦ u^*(d)` is injective. -/
structure NonSingular extends SemiSimplicial where
  cond1 : ∀ {k m : ℕ} (x : X m) (u v : Fin (k + 1) ↪o Fin (m + 1)), map u x = map v x → u = v

namespace NonSingular

variable (D : NonSingular)

/-- The vertex `i` of `Δ_m`, as a map `Δ_0 → Δ_m`. -/
def pt {m : ℕ} (i : Fin (m + 1)) : Fin 1 ↪o Fin (m + 1) :=
  OrderEmbedding.ofStrictMono (fun _ => i) fun a b h => by
    rw [Subsingleton.elim a b] at h; exact absurd h (lt_irrefl _)

/-- The relation `x ≺ y` of page 22 on `D₀`: an edge `z ∈ D₁` from `x` to `y`. -/
def Prec (x y : D.X 0) : Prop := ∃ z : D.X 1, D.map (pt 0) z = x ∧ D.map (pt 1) z = y

theorem le_of_emb {k m : ℕ} (u : Fin (k + 1) ↪o Fin (m + 1)) : k ≤ m := by
  have := Fintype.card_le_of_injective u u.injective
  simpa using this

theorem emb_self_eq {m : ℕ} (u : Fin (m + 1) ↪o Fin (m + 1)) : u = RelEmbedding.refl _ := by
  have h : (Finset.univ : Finset (Fin (m + 1))).card = m + 1 := by simp
  exact (Finset.orderEmbOfFin_unique' h (f := u) fun _ => Finset.mem_univ _).trans
    (Finset.orderEmbOfFin_unique' h (f := RelEmbedding.refl _) fun _ => Finset.mem_univ _).symm

/-- The poset `D_* = ∐ D_m` of page 20: `δ ≤ d` iff `δ` is a face of `d`. -/
instance : PartialOrder (Σ m, D.X m) where
  le a b := ∃ u : Fin (a.1 + 1) ↪o Fin (b.1 + 1), a.2 = D.map u b.2
  le_refl a := ⟨RelEmbedding.refl _, (D.map_id _).symm⟩
  le_trans a b c := by
    rintro ⟨u, hu⟩ ⟨v, hv⟩
    exact ⟨u.trans v, by rw [D.map_comp, ← hv, hu]⟩
  le_antisymm := by
    rintro ⟨k, y⟩ ⟨m, x⟩ ⟨u, hu⟩ ⟨v, hv⟩
    obtain rfl : k = m := le_antisymm (le_of_emb u) (le_of_emb v)
    rw [emb_self_eq u, D.map_id] at hu
    simp only at hu
    rw [hu]

theorem le_def {a b : Σ m, D.X m} :
    a ≤ b ↔ ∃ u : Fin (a.1 + 1) ↪o Fin (b.1 + 1), a.2 = D.map u b.2 := Iff.rfl

theorem isMin_iff (a : Σ m, D.X m) : IsMin a ↔ a.1 = 0 := by
  constructor
  · intro h
    by_contra hne
    have hle : (⟨0, D.map (pt 0) a.2⟩ : Σ m, D.X m) ≤ a := ⟨pt 0, rfl⟩
    have := congrArg Sigma.fst (le_antisymm hle (h hle))
    exact hne this.symm
  · obtain ⟨m, x⟩ := a
    rintro (rfl : m = 0) ⟨k, y⟩ ⟨u, hu⟩
    obtain rfl : k = 0 := Nat.le_zero.1 (le_of_emb u)
    refine ⟨RelEmbedding.refl _, ?_⟩
    simp only at hu ⊢
    rw [hu, emb_self_eq u, D.map_id, D.map_id]

/-- The vertices of `d ∈ D_m` are its `m + 1` vertex faces. -/
theorem V_eq (d : Σ m, D.X m) :
    V d = Set.range fun i : Fin (d.1 + 1) => (⟨0, D.map (pt i) d.2⟩ : Σ m, D.X m) := by
  ext a
  constructor
  · rintro ⟨ha, u, hu⟩
    obtain ⟨k, y⟩ := a
    obtain rfl : k = 0 := (D.isMin_iff _).1 ha
    refine ⟨u 0, ?_⟩
    simp only at hu ⊢
    rw [hu]
    congr 2
    exact RelEmbedding.ext (fun j => by rw [Subsingleton.elim j 0]; rfl)
  · rintro ⟨i, rfl⟩
    exact ⟨(D.isMin_iff _).2 rfl, pt i, rfl⟩

theorem vertex_inj {m : ℕ} (x : D.X m) {i j : Fin (m + 1)}
    (h : D.map (pt i) x = D.map (pt j) x) : i = j :=
  congrArg (fun u : Fin 1 ↪o Fin (m + 1) => u 0) (D.cond1 x _ _ h)

/-- The vertices of a face: the vertex `i` of `u^* x` is the vertex `u i` of `x`. -/
theorem map_pt {k m : ℕ} (u : Fin (k + 1) ↪o Fin (m + 1)) (x : D.X m) (i : Fin (k + 1)) :
    D.map (pt i) (D.map u x) = D.map (pt (u i)) x := by
  rw [← D.map_comp]; rfl

/-- The simplex orders of `D`: on the vertices of `d`, the order of their indices. -/
def ord (d a b : Σ m, D.X m) : Prop :=
  ∃ i j : Fin (d.1 + 1), i < j ∧ a = ⟨0, D.map (pt i) d.2⟩ ∧ b = ⟨0, D.map (pt j) d.2⟩


theorem vertex_eq_iff {p q : D.X 0} : (⟨0, p⟩ : Σ m, D.X m) = ⟨0, q⟩ ↔ p = q := by
  simp

/-- The vertex `i` of `d`, as an element of the poset. -/
def vert (d : Σ m, D.X m) (i : Fin (d.1 + 1)) : Σ m, D.X m := ⟨0, D.map (pt i) d.2⟩

theorem vert_inj (d : Σ m, D.X m) {i j : Fin (d.1 + 1)} (h : D.vert d i = D.vert d j) :
    i = j :=
  D.vertex_inj d.2 ((D.vertex_eq_iff).1 h)

theorem V_eq' (d : Σ m, D.X m) : V d = Set.range (D.vert d) := D.V_eq d

/-- The vertices of a face `e = u^* d`: vertex `i` of `e` is vertex `u i` of `d`. -/
theorem vert_face {e d : Σ m, D.X m} {u : Fin (e.1 + 1) ↪o Fin (d.1 + 1)} (hu : e.2 = D.map u d.2)
    (i : Fin (e.1 + 1)) : D.vert e i = D.vert d (u i) := by
  simp only [vert, hu, map_pt]

/-- Condition (1) gives (a) of page 20. -/
theorem isFlagGeom : IsFlagGeom (Σ m, D.X m) where
  finite d := by rw [D.V_eq']; exact Set.finite_range _
  nonempty d := by rw [D.V_eq']; exact Set.range_nonempty _
  le_iff d e e' he he' := by
    refine ⟨fun h => V_mono h, fun h => ?_⟩
    obtain ⟨u, hu⟩ := he
    obtain ⟨u', hu'⟩ := he'
    have key : ∀ i, ∃ j, u' j = u i := fun i => by
      have : D.vert e i ∈ V e' := h (by rw [D.V_eq']; exact ⟨i, rfl⟩)
      rw [D.V_eq'] at this
      obtain ⟨j, hj⟩ := this
      rw [D.vert_face hu', D.vert_face hu] at hj
      exact ⟨j, D.vert_inj d hj⟩
    choose w hw using key
    have hwm : StrictMono w := fun a b hab => by
      have := u.lt_iff_lt.2 hab
      rw [← hw a, ← hw b] at this
      exact u'.lt_iff_lt.1 this
    refine ⟨OrderEmbedding.ofStrictMono w hwm, ?_⟩
    rw [hu, hu', ← D.map_comp]
    congr 1
    exact RelEmbedding.ext fun i => (hw i).symm
  exists_face d S hS hne := by
    classical
    set T := Finset.univ.filter fun i => D.vert d i ∈ S
    obtain ⟨a, ha⟩ := hne
    obtain ⟨i₀, hi₀⟩ : a ∈ Set.range (D.vert d) := D.V_eq' d ▸ hS ha
    have hT : T.Nonempty := ⟨i₀, by simp [T, hi₀, ha]⟩
    obtain ⟨t, ht⟩ : ∃ t, T.card = t + 1 := ⟨T.card - 1, by
      have := hT.card_pos; omega⟩
    set f := T.orderEmbOfFin ht
    refine ⟨⟨t, D.map f d.2⟩, ⟨f, rfl⟩, ?_⟩
    rw [D.V_eq']
    ext b
    constructor
    · rintro ⟨i, rfl⟩
      rw [D.vert_face (u := f) rfl]
      have : f i ∈ T := Finset.orderEmbOfFin_mem T ht i
      simpa [T] using this
    · intro hb
      obtain ⟨j, rfl⟩ : b ∈ Set.range (D.vert d) := D.V_eq' d ▸ hS hb
      have hj : j ∈ T := by simp [T, hb]
      have : j ∈ Set.range f := by rw [Finset.range_orderEmbOfFin]; exact hj
      obtain ⟨i, hi⟩ := this
      exact ⟨i, by rw [D.vert_face (u := f) rfl, hi]⟩

/-- The simplex orders of `D` are compatible (pages 17–18). -/
theorem isCompatible_ord : IsCompatible D.ord where
  support d a b h := by
    obtain ⟨i, j, -, rfl, rfl⟩ := h
    rw [D.V_eq']
    exact ⟨⟨i, rfl⟩, ⟨j, rfl⟩⟩
  irrefl d a h := by
    obtain ⟨i, j, hij, rfl, h2⟩ := h
    exact hij.ne (D.vert_inj d h2)
  trans d a b c h h' := by
    obtain ⟨i, j, hij, rfl, rfl⟩ := h
    obtain ⟨j', k, hjk, h1, rfl⟩ := h'
    obtain rfl := D.vert_inj d h1
    exact ⟨i, k, hij.trans hjk, rfl, rfl⟩
  total d a ha b hb hab := by
    rw [D.V_eq'] at ha hb
    obtain ⟨i, rfl⟩ := ha
    obtain ⟨j, rfl⟩ := hb
    rcases lt_or_gt_of_ne (fun h : i = j => hab (h ▸ rfl)) with h | h
    · exact Or.inl ⟨i, j, h, rfl, rfl⟩
    · exact Or.inr ⟨j, i, h, rfl, rfl⟩
  restrict e d hed a ha b hb := by
    obtain ⟨u, hu⟩ := hed
    rw [D.V_eq'] at ha hb
    obtain ⟨i, rfl⟩ := ha
    obtain ⟨j, rfl⟩ := hb
    constructor
    · rintro ⟨i', j', hij, h1, h2⟩
      obtain rfl := D.vert_inj e h1
      obtain rfl := D.vert_inj e h2
      exact ⟨u i, u j, u.lt_iff_lt.2 hij, D.vert_face hu i, D.vert_face hu j⟩
    · rintro ⟨i', j', hij, h1, h2⟩
      change D.vert e i = D.vert d i' at h1
      change D.vert e j = D.vert d j' at h2
      rw [D.vert_face hu] at h1 h2
      obtain rfl := D.vert_inj d h1
      obtain rfl := D.vert_inj d h2
      exact ⟨i, j, u.lt_iff_lt.1 hij, rfl, rfl⟩


/-- The edge relation of the simplex orders is the relation `≺` of page 22. -/
theorem edge_ord_iff (a b : Σ m, D.X m) :
    edge D.ord a b ↔ ∃ z : D.X 1, a = ⟨0, D.map (pt 0) z⟩ ∧ b = ⟨0, D.map (pt 1) z⟩ := by
  constructor
  · rintro ⟨⟨n, w⟩, hV, hab, i, j, hij, rfl, rfl⟩
    have hmem : ∀ k : Fin (n + 1), D.vert ⟨n, w⟩ k = D.vert ⟨n, w⟩ i ∨
        D.vert ⟨n, w⟩ k = D.vert ⟨n, w⟩ j := fun k => by
      have : D.vert ⟨n, w⟩ k ∈ V (⟨n, w⟩ : Σ m, D.X m) := by rw [D.V_eq']; exact ⟨k, rfl⟩
      rw [hV] at this
      exact this
    have hn : n = 1 := by
      have h1 : 1 ≤ n := by
        have hj2 : (j : ℕ) < n + 1 := j.isLt
        have : (i : ℕ) < j := hij
        omega
      by_contra hne
      have h2 : 2 < n + 1 := by omega
      have e := fun k : Fin (n + 1) => (hmem k).imp (D.vert_inj _) (D.vert_inj _)
      rcases e ⟨0, by omega⟩ with h0 | h0 <;> rcases e ⟨1, by omega⟩ with h1' | h1' <;>
        rcases e ⟨2, h2⟩ with h2' | h2' <;>
        simp only [Fin.ext_iff] at h0 h1' h2' <;> omega
    subst hn
    have hij' : (i : ℕ) < j := hij
    have hj2 : (j : ℕ) < 2 := j.isLt
    have hi : i = 0 := Fin.ext (by simp; omega)
    have hj : j = 1 := Fin.ext (by simp; omega)
    subst hi hj
    exact ⟨w, rfl, rfl⟩
  · rintro ⟨z, rfl, rfl⟩
    refine ⟨⟨1, z⟩, ?_, fun h => absurd (D.vert_inj ⟨1, z⟩ h) (by simp), 0, 1,
      by simp, rfl, rfl⟩
    rw [D.V_eq']
    ext c
    constructor
    · rintro ⟨⟨k, hk⟩, rfl⟩
      change k < 2 at hk
      interval_cases k
      · exact Or.inl rfl
      · exact Or.inr rfl
    · rintro (rfl | rfl)
      · exact ⟨0, rfl⟩
      · exact ⟨1, rfl⟩

theorem prec_iff (x y : D.X 0) : D.Prec x y ↔ edge D.ord ⟨0, x⟩ ⟨0, y⟩ := by
  rw [edge_ord_iff]
  simp only [vertex_eq_iff, Prec]
  exact ⟨fun ⟨z, h1, h2⟩ => ⟨z, h1.symm, h2.symm⟩, fun ⟨z, h1, h2⟩ => ⟨z, h1.symm, h2.symm⟩⟩

/-- `x ≺ x` is impossible, by (1) (page 22). -/
theorem not_prec_self (x : D.X 0) : ¬ D.Prec x x := by
  rw [prec_iff]
  rintro ⟨_, _, h, _⟩
  exact h rfl

theorem trans_iff : (∀ x y w : D.X 0, D.Prec x y → D.Prec y w → D.Prec x w) ↔
    ∀ a b c, edge D.ord a b → edge D.ord b c → edge D.ord a c := by
  constructor
  · intro h a b c hab hbc
    obtain ⟨z, rfl, rfl⟩ := (D.edge_ord_iff _ _).1 hab
    obtain ⟨z', h1, rfl⟩ := (D.edge_ord_iff _ _).1 hbc
    rw [vertex_eq_iff] at h1
    rw [← prec_iff]
    exact h _ _ _ ⟨z, rfl, rfl⟩ ⟨z', h1.symm, rfl⟩
  · intro h x y w hxy hyw
    rw [prec_iff] at *
    exact h _ _ _ hxy hyw

/-- **The Proposition of pages 22–24, from the semi-simplicial side.** For a semi-simplicial set
satisfying (1), the poset `D_*` satisfies (a), and the transitivity (2°) of `≺` holds iff the
orders of the simplices all come from one order on `D₀` satisfying (b) and (c); that order is then
`≺`. -/
theorem trans_iff_vertexOrder :
    (∀ x y w : D.X 0, D.Prec x y → D.Prec y w → D.Prec x w) ↔
      ∃ r, IsVertexOrder r ∧ ofVertex r = D.ord := by
  rw [trans_iff]
  constructor
  · intro h
    exact ⟨edge D.ord, isVertexOrder_edge D.isFlagGeom D.isCompatible_ord h,
      ofVertex_edge D.isFlagGeom D.isCompatible_ord h⟩
  · rintro ⟨r, hr, hro⟩
    rw [← hro, edge_ofVertex D.isFlagGeom hr]
    exact hr.trans

theorem vertexOrder_unique {r : (Σ m, D.X m) → (Σ m, D.X m) → Prop} (hr : IsVertexOrder r)
    (hro : ofVertex r = D.ord) : r = edge D.ord := by
  rw [← hro, edge_ofVertex D.isFlagGeom hr]

/-- (2 bis) of page 22: every pair of composable edges bounds a 2-simplex. -/
def HornFill : Prop :=
  ∀ z z' : D.X 1, D.map (pt 1) z = D.map (pt 0) z' →
    ∃ u : D.X 2, D.map Fin.castSuccOrderEmb u = z ∧ D.map (Fin.succOrderEmb 2) u = z'

/-- (2 bis) implies (2°) (page 22). -/
theorem trans_of_hornFill (h : D.HornFill) (x y w : D.X 0) (hxy : D.Prec x y)
    (hyw : D.Prec y w) : D.Prec x w := by
  obtain ⟨z, rfl, rfl⟩ := hxy
  obtain ⟨z', h1, rfl⟩ := hyw
  obtain ⟨u, rfl, rfl⟩ := h z z' h1.symm
  refine ⟨D.map (Fin.succAboveOrderEmb 1) u, ?_, ?_⟩ <;> rw [map_pt, map_pt] <;> rfl

end NonSingular

/-! ### The boundary of a triangle: (2°) without (2 bis) -/

/-- The boundary of the triangle `{0 < 1 < 2}`: its simplices are the strictly increasing maps
`Δ_m → {0, 1, 2}` with `m ≤ 1`. -/
def triangleBoundary : NonSingular where
  X m := {_f : Fin (m + 1) ↪o Fin 3 // m ≤ 1}
  map u x := ⟨u.trans x.1, (NonSingular.le_of_emb u).trans x.2⟩
  map_id _ := rfl
  map_comp _ _ _ := rfl
  cond1 x _ _ h := RelEmbedding.ext fun i => x.1.injective (congrArg (fun g => g.1 i) h)

theorem triangleBoundary_trans (x y w : triangleBoundary.X 0) (hxy : triangleBoundary.Prec x y)
    (hyw : triangleBoundary.Prec y w) : triangleBoundary.Prec x w := by
  obtain ⟨z, rfl, rfl⟩ := hxy
  obtain ⟨z', h1, rfl⟩ := hyw
  have h1' : z.1 1 = z'.1 0 := (congrArg (fun g => g.1 0) h1).symm
  have ha : z.1 0 < z.1 1 := z.1.lt_iff_lt.2 (show (0 : Fin 2) < 1 by decide)
  have hb : z'.1 0 < z'.1 1 := z'.1.lt_iff_lt.2 (show (0 : Fin 2) < 1 by decide)
  have hlt : z.1 0 < z'.1 1 := ha.trans (h1' ▸ hb)
  refine ⟨⟨OrderEmbedding.ofStrictMono ![z.1 0, z'.1 1] ?_, le_rfl⟩, ?_, ?_⟩
  · intro a b hab
    fin_cases a <;> fin_cases b
    · exact absurd hab (lt_irrefl _)
    · exact hlt
    · exact absurd hab (by decide)
    · exact absurd hab (lt_irrefl _)
  · apply Subtype.ext; apply RelEmbedding.ext; intro i
    rw [Fin.fin_one_eq_zero i]; rfl
  · apply Subtype.ext; apply RelEmbedding.ext; intro i
    rw [Fin.fin_one_eq_zero i]; rfl

theorem triangleBoundary_not_hornFill : ¬ triangleBoundary.HornFill := by
  intro h
  let e : Fin 2 ↪o Fin 3 := Fin.castSuccOrderEmb
  let e' : Fin 2 ↪o Fin 3 := Fin.succOrderEmb 2
  obtain ⟨u, -, -⟩ := h ⟨e, le_rfl⟩ ⟨e', le_rfl⟩ (Subtype.ext (RelEmbedding.ext fun i => by
    rw [Fin.fin_one_eq_zero i]; rfl))
  exact absurd u.2 (by decide)

end Grothendieck.Folder76.Sommets

/-!
# Folder 76, page 27: the flag presheaf as a semi-simplicial set

The reading concludes (« Ainsi, pour tout `G`-ensemble `X` ») that `D_* = ∐_H D(H)`, ordered by
`d ≤ d'` iff `H ⊆ H'` and `d` is the restriction of `d'`, satisfies (a), and defines a
semi-simplicial set satisfying (1) with `D_m = ∐_{card H = m + 1} X / N_H`, whose vertex relation
is transitive. This is the « hence » of finding `76-flag-presheaf-gset-lemma`.

* `flagSS`: the semi-simplicial set, `u^*` sending a flag of type `H = {h₀ < ⋯ < h_m}` to its
  restriction to `{h_{u 0} < ⋯ < h_{u k}}`; its faces are pairwise distinct (condition (1)),
  since distinct `u` give distinct types.
* `flagSS_le_iff`: its poset of simplices is `∐_H D(H)` with the order above, and
  `flagSS_isFlagGeom` is condition (a) for it.
* `flagSS_prec_iff`: its edge relation on `D₀` is the relation `≺` of page 27; hence
  `flagSS_prec_trans` (transitivity) and `flagSS_vertexOrder`: the orders of the simplices all
  come from one order on `D₀` satisfying (b) and (c).
-/

namespace Grothendieck.Folder76

open Sommets

variable {G : Type*} [Group G] {n : ℕ} {σ : Fin (n + 1) → G} {X : Type} [MulAction G X]

lemma res_self {H : Set (Fin (n + 1))} (h : H ⊆ H) (d : D σ X H) : res h d = d := by
  obtain ⟨x, rfl⟩ := mk_surjective H d; rfl

lemma res_eq_res {L K A B : Set (Fin (n + 1))} (hL : L ⊆ K) {h₁ : K ⊆ A} {h₂ : K ⊆ B}
    {c : D σ X A} {a : D σ X B} (e : res h₁ c = res h₂ a) (h₃ : L ⊆ A) (h₄ : L ⊆ B) :
    res h₃ c = res h₄ a := by
  rw [← res_res hL h₁, e, res_res]

/-- The types of cardinality `m + 1`. -/
abbrev Typ (n m : ℕ) : Type := {H : Finset (Fin (n + 1)) // H.card = m + 1}

variable (σ X) in
/-- `D_m = ∐_{card H = m + 1} D(H)`. -/
abbrev Simp (m : ℕ) : Type := Σ H : Typ n m, D σ X (H.1 : Set (Fin (n + 1)))

lemma simp_eq_iff {k : ℕ} {H H' : Typ n k} (a : D σ X H.1) (b : D σ X H'.1) :
    (⟨H, a⟩ : Simp σ X k) = ⟨H', b⟩ ↔
      H.1 = H'.1 ∧ ∀ h : (H.1 : Set (Fin (n + 1))) ⊆ H'.1, a = res h b := by
  obtain ⟨H, hc⟩ := H
  obtain ⟨H', hc'⟩ := H'
  refine ⟨fun h => ?_, fun ⟨e, h⟩ => by subst e; rw [h subset_rfl, res_self]⟩
  cases h
  exact ⟨rfl, fun h => (res_self h a).symm⟩

/-- The type of the face `u^* d` of a flag `d` of type `H`: the image of `u` in `H`. -/
def faceType {k m : ℕ} (u : Fin (k + 1) ↪o Fin (m + 1)) (H : Typ n m) : Typ n k :=
  ⟨Finset.univ.map (u.trans (H.1.orderEmbOfFin H.2)).toEmbedding, by simp⟩

lemma faceType_sub {k m : ℕ} (u : Fin (k + 1) ↪o Fin (m + 1)) (H : Typ n m) :
    ((faceType u H).1 : Set (Fin (n + 1))) ⊆ H.1 := fun _ h => by
  obtain ⟨i, -, rfl⟩ := Finset.mem_map.1 h
  exact Finset.orderEmbOfFin_mem H.1 H.2 (u i)

lemma orderEmbOfFin_faceType {k m : ℕ} (u : Fin (k + 1) ↪o Fin (m + 1)) (H : Typ n m) :
    (faceType u H).1.orderEmbOfFin (faceType u H).2 = u.trans (H.1.orderEmbOfFin H.2) :=
  (Finset.orderEmbOfFin_unique' (faceType u H).2 fun i =>
    Finset.mem_map_of_mem _ (Finset.mem_univ i)).symm

lemma faceType_comp {k m l : ℕ} (u : Fin (k + 1) ↪o Fin (m + 1)) (v : Fin (m + 1) ↪o Fin (l + 1))
    (H : Typ n l) : (faceType (u.trans v) H).1 = (faceType u (faceType v H)).1 := by
  show _ = Finset.univ.map (u.trans ((faceType v H).1.orderEmbOfFin (faceType v H).2)).toEmbedding
  rw [orderEmbOfFin_faceType]; rfl

lemma map_univ_orderEmbOfFin {m : ℕ} (H : Typ n m) :
    Finset.univ.map (H.1.orderEmbOfFin H.2).toEmbedding = H.1 :=
  Finset.coe_injective (by simp)

variable (σ X) in
/-- **The semi-simplicial set of flags** (page 27): `D_m = ∐_{card H = m + 1} X / N_H`, with
`u^*` the restriction to the image of `u` in the type. It satisfies (1). -/
def flagSS : NonSingular where
  X := Simp σ X
  map u x := ⟨faceType u x.1, res (faceType_sub u x.1) x.2⟩
  map_id x := (simp_eq_iff _ _).2 ⟨map_univ_orderEmbOfFin x.1, fun _ => rfl⟩
  map_comp u v x :=
    (simp_eq_iff _ _).2 ⟨faceType_comp u v x.1, fun _ => by dsimp only; rw [res_res, res_res]⟩
  cond1 x u v h := by
    have hS := ((simp_eq_iff _ _).1 h).1
    have hu : u.trans (x.1.1.orderEmbOfFin x.1.2) = v.trans (x.1.1.orderEmbOfFin x.1.2) := by
      rw [← orderEmbOfFin_faceType u, ← orderEmbOfFin_faceType v]
      exact Finset.orderEmbOfFin_unique' (faceType v x.1).2 fun i => by
        rw [← hS]; exact Finset.orderEmbOfFin_mem _ _ i
    exact RelEmbedding.ext fun i => (x.1.1.orderEmbOfFin x.1.2).injective (congrArg (· i) hu)

/-- The poset of simplices of `flagSS` is `D_* = ∐_H D(H)`, with `d ≤ d'` iff `H ⊆ H'` and `d` is
the restriction of `d'`. -/
theorem flagSS_le_iff {k m : ℕ} {H : Typ n k} {H' : Typ n m} (a : D σ X H.1) (b : D σ X H'.1) :
    (⟨k, ⟨H, a⟩⟩ : Σ m, (flagSS σ X).X m) ≤ ⟨m, ⟨H', b⟩⟩ ↔
      ∃ h : (H.1 : Set (Fin (n + 1))) ⊆ H'.1, a = res h b := by
  constructor
  · rintro ⟨u, hu⟩
    obtain ⟨hH, hab⟩ := (simp_eq_iff _ _).1 hu
    exact ⟨hH ▸ faceType_sub u H', (hab (by rw [hH])).trans (by rw [res_res])⟩
  · rintro ⟨h, rfl⟩
    let e := H'.1.orderIsoOfFin H'.2
    let f := H.1.orderEmbOfFin H.2
    let u : Fin (k + 1) ↪o Fin (m + 1) := OrderEmbedding.ofStrictMono
      (fun i => e.symm ⟨f i, h (Finset.orderEmbOfFin_mem _ _ i)⟩)
      fun i j hij => e.symm.strictMono (Subtype.mk_lt_mk.2 (f.strictMono hij))
    have hu : u.trans (H'.1.orderEmbOfFin H'.2) = f := RelEmbedding.ext fun i => by
      rw [RelEmbedding.trans_apply, ← Finset.coe_orderIsoOfFin_apply]
      exact congrArg Subtype.val (e.apply_symm_apply _)
    have hH : (faceType u H').1 = H.1 := by
      show Finset.univ.map (u.trans (H'.1.orderEmbOfFin H'.2)).toEmbedding = H.1
      rw [hu]; exact map_univ_orderEmbOfFin H
    exact ⟨u, (simp_eq_iff _ _).2 ⟨hH.symm, fun _ => by dsimp only; exact (res_res _ _ _).symm⟩⟩

/-- **Condition (a)** of page 20 for `D_* = ∐_H D(H)`. -/
theorem flagSS_isFlagGeom : IsFlagGeom (Σ m, (flagSS σ X).X m) := (flagSS σ X).isFlagGeom

lemma faceType_pt {m : ℕ} (i : Fin (m + 1)) (H : Typ n m) :
    (faceType (NonSingular.pt i) H).1 = {H.1.orderEmbOfFin H.2 i} := by
  ext a
  simp only [faceType, Finset.mem_map, Finset.mem_univ, true_and, Finset.mem_singleton]
  exact ⟨fun ⟨_, h⟩ => h.symm, fun h => ⟨0, h.symm⟩⟩

/-- The edge relation of `flagSS` on `D₀` is the relation `≺` of page 27. -/
theorem flagSS_prec_iff {i j : Fin (n + 1)} (hi : ({i} : Finset _).card = 0 + 1)
    (hj : ({j} : Finset _).card = 0 + 1) (a : D σ X ({i} : Finset _))
    (b : D σ X ({j} : Finset _)) :
    (flagSS σ X).Prec ⟨⟨{i}, hi⟩, a⟩ ⟨⟨{j}, hj⟩, b⟩ ↔
      Prec (res (by simp) a : D σ X {i}) (res (by simp) b : D σ X {j}) := by
  constructor
  · rintro ⟨⟨P, c⟩, h₀, h₁⟩
    obtain ⟨hP₀, hc₀⟩ := (simp_eq_iff _ _).1 h₀
    obtain ⟨hP₁, hc₁⟩ := (simp_eq_iff _ _).1 h₁
    rw [faceType_pt, Finset.singleton_inj] at hP₀ hP₁
    refine ⟨hP₀ ▸ hP₁ ▸ (P.1.orderEmbOfFin P.2).strictMono (by decide), P.1,
      by simp [← hP₀, Finset.orderEmbOfFin_mem], by simp [← hP₁, Finset.orderEmbOfFin_mem], c,
      ?_, ?_⟩
    · exact res_eq_res (by simp [faceType_pt, hP₀]) (hc₀ (by simp [faceType_pt, hP₀])) _ _
    · exact res_eq_res (by simp [faceType_pt, hP₁]) (hc₁ (by simp [faceType_pt, hP₁])) _ _
  · intro hp
    obtain ⟨hij, d, hd₁, hd₂⟩ := (prec_iff_pair _ _).1 hp
    let P : Typ n 1 := ⟨{i, j}, Finset.card_pair hij.ne⟩
    have hP : P.1.orderEmbOfFin P.2 0 = i ∧ P.1.orderEmbOfFin P.2 1 = j := by
      have h0 := Finset.orderEmbOfFin_mem P.1 P.2 0
      have h1 := Finset.orderEmbOfFin_mem P.1 P.2 1
      have hlt := (P.1.orderEmbOfFin P.2).strictMono (show (0 : Fin 2) < 1 by decide)
      simp only [P, Finset.mem_insert, Finset.mem_singleton] at h0 h1
      rcases h0 with h0 | h0 <;> rcases h1 with h1 | h1 <;> rw [h0, h1] at hlt <;>
        first | exact ⟨h0, h1⟩ | exact absurd hlt (lt_irrefl _) | exact absurd hlt (lt_asymm hij)
    refine ⟨⟨P, res (by simp [P]) d⟩, (simp_eq_iff _ _).2 ⟨by rw [faceType_pt, hP.1], fun _ => ?_⟩,
      (simp_eq_iff _ _).2 ⟨by rw [faceType_pt, hP.2], fun _ => ?_⟩⟩ <;> rw [res_res]
    · exact res_eq_res (by simp [faceType_pt, hP.1]) hd₁ _ _
    · exact res_eq_res (by simp [faceType_pt, hP.2]) hd₂ _ _

/-- **Transitivity** of the edge relation of `flagSS`, for every `G`-set `X`. -/
theorem flagSS_prec_trans (hσ : ∀ i j : Fin (n + 1), (i : ℕ) + 2 ≤ j → Commute (σ i) (σ j))
    (x y w : (flagSS σ X).X 0) (hxy : (flagSS σ X).Prec x y) (hyw : (flagSS σ X).Prec y w) :
    (flagSS σ X).Prec x w := by
  obtain ⟨⟨_, h₁⟩, a⟩ := x
  obtain ⟨⟨_, h₂⟩, b⟩ := y
  obtain ⟨⟨_, h₃⟩, c⟩ := w
  obtain ⟨i, rfl⟩ := Finset.card_eq_one.1 h₁
  obtain ⟨j, rfl⟩ := Finset.card_eq_one.1 h₂
  obtain ⟨k, rfl⟩ := Finset.card_eq_one.1 h₃
  rw [flagSS_prec_iff] at *
  exact prec_trans hσ hxy hyw

/-- **The « hence » of page 27**: for every `G`-set `X`, the orders of the simplices of the
semi-simplicial set of flags all come from one order on `D₀` satisfying (b) and (c). -/
theorem flagSS_vertexOrder (hσ : ∀ i j : Fin (n + 1), (i : ℕ) + 2 ≤ j → Commute (σ i) (σ j)) :
    ∃ r, IsVertexOrder r ∧ ofVertex r = (flagSS σ X).ord :=
  (flagSS σ X).trans_iff_vertexOrder.1 (flagSS_prec_trans hσ)

end Grothendieck.Folder76
