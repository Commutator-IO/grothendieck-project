import Mathlib

/-!
# Folder 37, page 92: the counterexample to EGA I 10.10.5 b) ⇒ a), c)

The modernised reading `transcripts/37/37.modern.tex` (section « EGA I 10.10.5 sans
hypothèse noethérienne », pages 92 to 97) gives, after the typed letter to Dieudonné
of 27.8.1967:

> `k` a field, `B = k[X₀, X₁, …]`, `A = B[[T]]`, `Aₙ = B[T]/(T^{n+1})`,
> `Jₙ = (X₀, X₁T, …, XₙTⁿ) ⊂ Aₙ`, `Mₙ = Aₙ/Jₙ`. The `Mₙ` fit together and are
> finitely presented; but `Jₙ` cannot be generated by fewer than `n+1` elements. If
> the `Mₙ` came from a finitely presented `A`-module `M`, there would be
> presentations `Aₙ^p → Aₙ^q → Mₙ → 0` with `p, q` independent of `n`, and
> (Schanuel) `Jₙ` would be generated by at most `p + q` elements.

This is finding `37-ega-i-10-10-5-counterexample` of `src/content/findings.ts`.
Proving it says only that the claim holds as stated; whether it stands in the
literature is a separate question.

What is formalised.

* `Jn_spanRank` / `Jn_not_generated`: `Jₙ` is generated by its `n+1` written
  generators and by no family of `m ≤ n` elements. The proof is the reading's, made
  numerical: `λᵢ(f)` is the coefficient of the monomial `Xᵢ Tⁱ` in a lift `f ∈ B[T]`
  and `ε` the constant coefficient. `λᵢ` kills `T^{n+1}B[T]` for `i ≤ n` and
  `λᵢ(a · XₗTˡ) = δᵢₗ ε(a)` (the monomial `XᵢTⁱ` is divisible by `XₗTˡ` only for
  `l = i`). Writing each `XⱼTʲ` through the `gᵣ` and each `gᵣ` through the `XₗTˡ`
  gives `E · L = 1` for an `(n+1) × m` and an `m × (n+1)` matrix over `k`, whence
  `n + 1 ≤ m` by rank. (This is the independence of the `n+1` generators in
  `Jₙ/(TJₙ + 𝔪Jₙ)`; the letter's independence over `B` in `Jₙ/TJₙ` is false,
  `X₀ · X₁T ∈ TJₙ`, and is not used.)
* `Mn_finitePresentation`, `Jn_map_succ`: `Mₙ` is finitely presented, and the
  reduction `A_{n+1} → Aₙ` maps `J_{n+1}` onto `Jₙ` (`X_{n+1}T^{n+1}` dies), so the
  `Mₙ` form a compatible system.
* `ideal_spanRank_le_of_presentation` (Schanuel step, sharper than the page's
  `p + q`): if an `S`-module `N ≅ S/J` is the quotient of a projective module by
  the image of a module generated by `p` elements, `J` is generated by `p + 1`
  elements.
* `no_finitePresentation_inducing` (the counterexample): for **any** commutative ring
  `A` and **any** ring maps `A → Aₙ`, no finitely presented `A`-module `M` has
  `Aₙ ⊗_A M ≅ Mₙ` for all `n`. The page's `A = B[[T]]` with its reductions is the
  case at hand; neither completeness, nor surjectivity of `A → Aₙ`, nor the
  compatibility of the isomorphisms is used: right exactness of `Aₙ ⊗_A -` carries
  a presentation `A^p → A^q → M → 0` to `Aₙ`, and the Schanuel step bounds the
  generators of every `Jₙ` by `p + 1`.

Not formalised: formal schemes, the conditions a), b), c) of EGA I 10.10.5 themselves.
-/

namespace Grothendieck.Folder37

open Polynomial

variable (k : Type*) [Field k]

/-- `B[T]` with `B = k[X₀, X₁, …]`. -/
abbrev P := (MvPolynomial ℕ k)[X]

/-- `Aₙ = B[T]/(T^{n+1})`, a type of its own so that its ring structure has a single
source. -/
def An (n : ℕ) : Type _ := P k ⧸ Ideal.span {(X : P k) ^ (n + 1)}

noncomputable instance (n : ℕ) : CommRing (An k n) :=
  fast_instance% Ideal.Quotient.commRing _

/-- The reduction `B[T] → Aₙ`. -/
noncomputable def mkA (n : ℕ) : P k →+* An k n := Ideal.Quotient.mk _

lemma mkA_surjective (n : ℕ) : Function.Surjective (mkA k n) := Ideal.Quotient.mk_surjective

lemma mkA_eq_zero_iff (n : ℕ) {x : P k} :
    mkA k n x = 0 ↔ x ∈ Ideal.span {(X : P k) ^ (n + 1)} :=
  Ideal.Quotient.eq_zero_iff_mem

/-- The generator `XₗTˡ` of `B[T]`. -/
noncomputable def gen (l : ℕ) : P k := C (MvPolynomial.X l) * X ^ l

/-- `Jₙ = (X₀, X₁T, …, XₙTⁿ) ⊂ Aₙ`. -/
noncomputable def Jn (n : ℕ) : Ideal (An k n) :=
  Ideal.span (Set.range fun l : Fin (n + 1) => mkA k n (gen k l))

/-- `λᵢ`: the coefficient of the monomial `Xᵢ Tⁱ`. -/
noncomputable def lam (i : ℕ) : P k →+ k :=
  (MvPolynomial.lcoeff k (Finsupp.single i 1)).toAddMonoidHom.comp
    (Polynomial.lcoeff (MvPolynomial ℕ k) i).toAddMonoidHom

/-- `ε`: the constant coefficient. -/
noncomputable def eps : P k →+* k :=
  MvPolynomial.constantCoeff.comp Polynomial.constantCoeff

lemma lam_apply (i : ℕ) (f : P k) :
    lam k i f = (f.coeff i).coeff (Finsupp.single i 1) := rfl

lemma lam_mul_gen (a : P k) (i l : ℕ) :
    lam k i (a * gen k l) = if l = i then eps k a else 0 := by
  classical
  rw [lam_apply, gen, ← mul_assoc, coeff_mul_X_pow']
  split_ifs with h1 h2 h2
  · subst h2
    rw [Nat.sub_self, coeff_mul_C, MvPolynomial.coeff_mul_X' (σ := ℕ)]
    simp [eps, MvPolynomial.constantCoeff, Polynomial.constantCoeff_apply]
  · rw [coeff_mul_C, MvPolynomial.coeff_mul_X' (σ := ℕ), ite_eq_right_iff]
    intro h
    simp at h
    exact absurd h h2
  · exact absurd (h2 ▸ le_refl l) h1
  · simp

lemma lam_mul_Xpow (a : P k) {i n : ℕ} (hi : i ≤ n) :
    lam k i (a * X ^ (n + 1)) = 0 := by
  rw [lam_apply, coeff_mul_X_pow', ite_eq_right_iff.2 (fun h => absurd h (by omega))]
  simp

lemma lam_gen (i l : ℕ) : lam k i (gen k l) = if l = i then 1 else 0 := by
  simpa using lam_mul_gen k 1 i l

/-- The numerical core: if each `XⱼTʲ` (`j ≤ n`) is a combination of `g₁, …, gₘ` modulo
`T^{n+1}` and each `gᵣ` a combination of the `XₗTˡ` modulo `T^{n+1}`, then `n + 1 ≤ m`. -/
theorem le_of_lifts (n m : ℕ) (g : Fin m → P k) (a : Fin (n + 1) → Fin m → P k)
    (b : Fin m → Fin (n + 1) → P k) (h : Fin (n + 1) → P k) (h' : Fin m → P k)
    (ha : ∀ j : Fin (n + 1), gen k j = ∑ r, a j r * g r + h j * X ^ (n + 1))
    (hb : ∀ r, g r = ∑ l : Fin (n + 1), b r l * gen k l + h' r * X ^ (n + 1)) : n + 1 ≤ m := by
  classical
  let E : Matrix (Fin (n + 1)) (Fin m) k := fun j r => eps k (a j r)
  let L : Matrix (Fin m) (Fin (n + 1)) k := fun r i => eps k (b r i)
  have hEL : E * L = 1 := by
    ext j i
    have key := congrArg (lam k i) (ha j)
    simp only [lam_gen, map_add, map_sum, lam_mul_Xpow k _ (Fin.is_le i)] at key
    have hr : ∀ r, lam k i (a j r * g r) = eps k (a j r) * eps k (b r i) := fun r => by
      rw [hb r, mul_add, Finset.mul_sum, map_add, map_sum, ← mul_assoc,
        lam_mul_Xpow k _ (Fin.is_le i)]
      simp_rw [← mul_assoc, lam_mul_gen]
      simp [Fin.val_inj, map_mul]
    simp only [hr, add_zero] at key
    rw [Matrix.mul_apply, Matrix.one_apply]
    simp only [E, L]
    rw [← key]
    simp [Fin.val_inj]
  have h1 : (1 : Matrix (Fin (n + 1)) (Fin (n + 1)) k).rank = n + 1 := by simp
  calc n + 1 = (E * L).rank := by rw [hEL, h1]
    _ ≤ E.rank := Matrix.rank_mul_le_left _ _
    _ ≤ m := Matrix.rank_le_width _

/-- `Jₙ` cannot be generated by fewer than `n + 1` elements. -/
theorem Jn_not_generated (n m : ℕ) (g : Fin m → An k n)
    (hg : Ideal.span (Set.range g) = Jn k n) : n + 1 ≤ m := by
  classical
  have hmem : ∀ j : Fin (n + 1), mkA k n (gen k j) ∈ Ideal.span (Set.range g) :=
    fun j => hg ▸ Ideal.subset_span ⟨j, rfl⟩
  have hmem' : ∀ r, g r ∈ Jn k n := fun r => hg ▸ Ideal.subset_span ⟨r, rfl⟩
  choose c hc using fun j => (Submodule.mem_span_range_iff_exists_fun _).1 (hmem j)
  choose d hd using fun r => (Submodule.mem_span_range_iff_exists_fun _).1 (hmem' r)
  choose lift hlift using mkA_surjective k n
  let gt : Fin m → P k := fun r => lift (g r)
  let a : Fin (n + 1) → Fin m → P k := fun j r => lift (c j r)
  let b : Fin m → Fin (n + 1) → P k := fun r l => lift (d r l)
  have ha : ∀ j : Fin (n + 1), ∃ h, gen k j = ∑ r, a j r * gt r + h * X ^ (n + 1) := fun j => by
    have : gen k j - ∑ r, a j r * gt r ∈ Ideal.span {(X : P k) ^ (n + 1)} := by
      rw [← mkA_eq_zero_iff, map_sub, map_sum]
      simp only [map_mul, a, gt, hlift]
      rw [← hc j]; simp [smul_eq_mul]
    obtain ⟨h, hh⟩ := Ideal.mem_span_singleton'.1 this
    exact ⟨h, by rw [hh]; ring⟩
  have hb : ∀ r, ∃ h, gt r = ∑ l : Fin (n + 1), b r l * gen k l + h * X ^ (n + 1) := fun r => by
    have : gt r - ∑ l : Fin (n + 1), b r l * gen k l ∈ Ideal.span {(X : P k) ^ (n + 1)} := by
      rw [← mkA_eq_zero_iff, map_sub, map_sum]
      simp only [map_mul, b, gt, hlift]
      rw [← hd r]; simp [smul_eq_mul]
    obtain ⟨h, hh⟩ := Ideal.mem_span_singleton'.1 this
    exact ⟨h, by rw [hh]; ring⟩
  choose h hh using ha
  choose h' hh' using hb
  exact le_of_lifts k n m gt a b h h' hh hh'

/-- `Jₙ` needs exactly `n + 1` generators. -/
theorem Jn_spanRank (n : ℕ) :
    (∃ g : Fin (n + 1) → An k n, Ideal.span (Set.range g) = Jn k n) ∧
      ∀ m (g : Fin m → An k n), Ideal.span (Set.range g) = Jn k n → n + 1 ≤ m :=
  ⟨⟨_, rfl⟩, Jn_not_generated k n⟩

/-- `Mₙ = Aₙ/Jₙ` is a finitely presented `Aₙ`-module. -/
theorem Mn_finitePresentation (n : ℕ) :
    Module.FinitePresentation (An k n) (An k n ⧸ Jn k n) :=
  Module.finitePresentation_of_surjective (Jn k n).mkQ (Jn k n).mkQ_surjective (by
    rw [Submodule.ker_mkQ]; exact Submodule.fg_span (Set.finite_range _))

lemma span_le_succ (n : ℕ) :
    Ideal.span {(X : P k) ^ (n + 1 + 1)} ≤ Ideal.span {(X : P k) ^ (n + 1)} := by
  rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_span_singleton]
  exact pow_dvd_pow _ (Nat.le_succ _)

/-- The reduction `A_{n+1} → Aₙ`. -/
noncomputable def red (n : ℕ) : An k (n + 1) →+* An k n :=
  Ideal.Quotient.factor (span_le_succ k n)

lemma red_mkA (n : ℕ) (x : P k) : red k n (mkA k (n + 1) x) = mkA k n x :=
  Ideal.Quotient.factor_mk _ _

/-- The reduction `A_{n+1} → Aₙ` maps `J_{n+1}` onto `Jₙ`: the `Mₙ` fit together. -/
theorem Jn_map_succ (n : ℕ) : Ideal.map (red k n) (Jn k (n + 1)) = Jn k n := by
  rw [Jn, Jn, Ideal.map_span]
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨_, ⟨l, rfl⟩, rfl⟩
    rw [red_mkA]
    by_cases hl : (l : ℕ) ≤ n
    · exact Ideal.subset_span ⟨⟨l, by omega⟩, rfl⟩
    · have h0 : mkA k n (gen k l) = 0 := by
        rw [mkA_eq_zero_iff, gen, show (l : ℕ) = n + 1 by omega]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
      exact h0 ▸ zero_mem _
  · rw [Ideal.span_le]
    rintro _ ⟨l, rfl⟩
    exact Ideal.subset_span ⟨mkA k (n + 1) (gen k l), ⟨⟨l, by omega⟩, rfl⟩, by rw [red_mkA]⟩

/-- The Schanuel step. If `N ≅ S/J` and `N` is the quotient of a projective `S`-module
`F` by the image of a module `K` generated by `p` elements, then `J` is generated by
`p + 1` elements. -/
theorem ideal_spanRank_le_of_presentation {S : Type*} [CommRing S] {F K N : Type*}
    [AddCommGroup F] [Module S F] [Module.Projective S F] [AddCommGroup K] [Module S K]
    [AddCommGroup N] [Module S N] (J : Ideal S) (p : ℕ) (v : Fin p → K)
    (hv : Submodule.span S (Set.range v) = ⊤) (γ : K →ₗ[S] F) (φ : F →ₗ[S] N)
    (hφ : Function.Surjective φ) (hex : Function.Exact γ φ) (e : N ≃ₗ[S] S ⧸ J) :
    ∃ w : Fin (p + 1) → S, Ideal.span (Set.range w) = J := by
  classical
  let φ' : F →ₗ[S] S ⧸ J := e.toLinearMap ∘ₗ φ
  obtain ⟨ψ, hψ⟩ := Module.projective_lifting_property J.mkQ φ' J.mkQ_surjective
  obtain ⟨x0, hx0⟩ := (e.surjective.comp hφ) (J.mkQ 1)
  let χ : S →ₗ[S] F := LinearMap.toSpanSingleton S F x0
  have hφ'χ : ∀ s, φ' (χ s) = J.mkQ s := fun s => by
    simp only [χ, LinearMap.toSpanSingleton_apply, map_smul, φ']
    change s • e (φ x0) = _
    rw [show e (φ x0) = J.mkQ 1 from hx0, ← map_smul, smul_eq_mul, mul_one]
  have hψ' : ∀ x, J.mkQ (ψ x) = φ' x := fun x => congrArg (· x) hψ
  let c : S := 1 - ψ (χ 1)
  have hc : c ∈ J := by
    rw [← Submodule.Quotient.mk_eq_zero, ← Submodule.mkQ_apply, map_sub, hψ', hφ'χ, sub_self]
  let w : Fin (p + 1) → S := Fin.cons c (fun i => ψ (γ (v i)))
  refine ⟨w, le_antisymm ?_ ?_⟩
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    refine Fin.cases ?_ (fun i => ?_) i
    · simpa [w] using hc
    · simp only [w, Fin.cons_succ, SetLike.mem_coe]
      rw [← Submodule.Quotient.mk_eq_zero, ← Submodule.mkQ_apply, hψ']
      simp [φ', hex.apply_apply_eq_zero]
  · intro x hx
    have hχx : φ (χ x) = 0 := e.injective <| show e (φ (χ x)) = e 0 by
      rw [map_zero]; exact (hφ'χ x).trans ((Submodule.Quotient.mk_eq_zero _).2 hx)
    obtain ⟨y, hy⟩ := (hex (χ x)).1 hχx
    have hy' : ψ (γ y) ∈ Ideal.span (Set.range w) := by
      have hyv : y ∈ Submodule.span S (Set.range v) := hv ▸ Submodule.mem_top
      have := Submodule.mem_map_of_mem (f := ψ ∘ₗ γ) hyv
      rw [Submodule.map_span, ← Set.range_comp] at this
      refine Submodule.span_mono ?_ this
      rintro _ ⟨i, rfl⟩
      exact ⟨i.succ, by simp [w]⟩
    have hdec : x = x * c + ψ (γ y) := by
      rw [hy]
      simp only [χ, LinearMap.toSpanSingleton_apply, map_smul, smul_eq_mul, c]
      ring
    rw [hdec]
    refine add_mem (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨0, by simp [w]⟩)) hy'

open TensorProduct in
/-- **The counterexample.** For any commutative ring `A` and any ring maps `A → Aₙ`
(the page's `A = B[[T]]` with its reductions), no finitely presented `A`-module `M`
has `Aₙ ⊗_A M ≅ Mₙ = Aₙ/Jₙ` for every `n`. -/
theorem no_finitePresentation_inducing (A : Type*) [CommRing A] (f : ∀ n, A →+* An k n)
    (M : Type*) [AddCommGroup M] [Module A M] [Module.FinitePresentation A M] :
    ¬ ∀ n, letI := (f n).toAlgebra
      Nonempty ((An k n) ⊗[A] M ≃ₗ[An k n] (An k n ⧸ Jn k n)) := by
  intro hM
  obtain ⟨q, p, φ0, γ0, hφ0, hex⟩ := Module.FinitePresentation.exists_fin' A M
  have bound : ∀ n, n + 1 ≤ p + 1 := by
    intro n
    let _ := (f n).toAlgebra
    obtain ⟨e⟩ := hM n
    let bK := Algebra.TensorProduct.basis (An k n) (Pi.basisFun A (Fin p))
    obtain ⟨w, hw⟩ := ideal_spanRank_le_of_presentation (Jn k n) p (fun i => bK i)
      bK.span_eq (γ0.baseChange (An k n)) (φ0.baseChange (An k n))
      (LinearMap.lTensor_surjective (An k n) hφ0) (lTensor_exact (An k n) hex hφ0) e
    exact Jn_not_generated k n (p + 1) w hw
  exact absurd (bound (p + 1)) (by omega)

/-! ## Page 22: when is `Ind C` a topos? (statement only)

A typed exercise on page 22, pencilled « SGA 4 VI 2 », states without proof that for a
small category `C` with Karoubi envelope `C'` the following are equivalent, among
others: (i) `Ind C` is a topos; (ii) `C'` has finite colimits and its canonical functor
to the sheaves for the topology of finite epimorphic (or effective universal epimorphic)
families preserves them. It is Problem 8 of `docs/problems/article.tex`.

Only the statement is here, as a `Prop`, with no proof and no `sorry`. Two choices are
the edition's: « topos » is read as Grothendieck topos (equivalent to sheaves of sets on
a small site), and the topology of (ii) as Mathlib's `coherentTopology`, the topology of
finite effective epimorphic families, which needs `C'` precoherent; precoherence is
therefore part of condition (ii) here. -/

section Problem8

open CategoryTheory Limits

universe u

/-- A category is a Grothendieck topos if it is equivalent to the category of sheaves of
sets on a small site. -/
def IsGrothendieckTopos (E : Type (u+1)) [Category.{u} E] : Prop :=
  ∃ (D : Type u) (_ : SmallCategory D) (J : GrothendieckTopology D),
    Nonempty (E ≌ Sheaf J (Type u))

/-- Condition (i bis) of page 22, as the reading corrects it: the inclusion of `Ind C`
into presheaves has a left exact left adjoint. The page asks for a right adjoint. -/
def IndReflectiveLeftExact (C : Type u) [SmallCategory C] : Prop :=
  ∃ L : (Cᵒᵖ ⥤ Type u) ⥤ Ind C, Nonempty (L ⊣ Ind.inclusion C) ∧ PreservesFiniteLimits L

/-- Condition (ii) of page 22: the Karoubi envelope has finite colimits, and its
canonical functor to the sheaves for the topology of finite effective epimorphic
families preserves them. -/
def KaroubiFinitaryCondition (C : Type u) [SmallCategory C] : Prop :=
  HasFiniteColimits (Idempotents.Karoubi C) ∧
    ∃ _ : Precoherent (Idempotents.Karoubi C),
      PreservesFiniteColimits (coherentTopology (Idempotents.Karoubi C)).yoneda

/-- Problem 8, the open equivalence (i) ⇔ (ii) of page 22. -/
def problem8 : Prop :=
  ∀ (C : Type u) [SmallCategory C], IsGrothendieckTopos (Ind C) ↔ KaroubiFinitaryCondition C

end Problem8

end Grothendieck.Folder37
