import Mathlib

/-!
# Folder 11 (pages 50–56): the tautological subalgebra of `H*(Xᵏ)`, an algebraic model

Finding `11-tautological-diagonal-product-rule` of `src/content/findings.ts`. The folder
computes the subalgebra of `H*(Xᵏ)` generated by the pull-backs `yᵢ` of the point class and
the classes of the partial diagonals. No geometry is used here: everything is derived from
five identities which the diagonal class `Δ ∈ A ⊗ A` of a Poincaré-duality algebra satisfies.

* `DiagData`: a commutative algebra `A` with `Δ ∈ A ⊗ A`, a point class `y`, a scalar `χ`
  and a linear form `∫`, with `(a ⊗ 1)Δ = (1 ⊗ a)Δ`, `Δ` symmetric, `m(Δ) = χ y`,
  `(y ⊗ 1)Δ = y ⊗ y`, `y² = 0`, `∫ y = 1`, `∫ 1 = 0` and `(id ⊗ ∫)Δ = 1`.
* `model`: a finite-dimensional commutative Frobenius algebra over a field, local with
  nilpotent augmentation ideal and socle spanned by `y` (the even-degree case of a
  Poincaré-duality algebra), is such data, `Δ = Σ bᵢ ⊗ b'ᵢ` for dual bases, with
  `χ = dim A`.
* In any commutative algebra `B` with algebra maps `ιᵢ : A → B` (for instance `A^{⊗k}`),
  `d i j` is the image of `Δ` by `(ιᵢ, ιⱼ)`; `d i i = χ yᵢ`.
* `table_two`, `table_three`: the relations of page 50 for `k = 2, 3`, among them
  `δ² = χ y₁y₂` on `X²`, `δ² = 0` and `δ₁₂δ = χ y₁y₂y₃` for the small diagonal of `X³`.
* `graph_rule`: for a connected multigraph `E` on a vertex set `V`, the product of its edge
  classes is the small diagonal `δ_V` if `E` is a tree, `χ ∏ yᵥ` if it has exactly one
  cycle, and `0` otherwise; and `|V| ≤ |E| + 1`.
* `product_rule`, `product_rule_pointed`: for two partitions `R`, `R'` of a finite set of
  `k` indices whose join is the coarse partition, `s + s' ≤ k + 1` (`s`, `s'` their numbers
  of blocks), and `δ_R δ_{R'}` is `δ` if `s + s' = k + 1`, `χ y₁⋯y_k` if `s + s' = k`, and
  `0` if `s + s' < k`; with one point block it is `y₁⋯y_k` or `0`, with two it is `0`.
* `push_old`, `push_point`, `push_diag`, `pull_d`: in `B ⊗ A`, the push-forward along the
  projection forgetting the last factor kills the classes not involving it and sends
  `x·y_∗` and `x·d_{i∗}` to `x`; the pull-back sends diagonals to diagonals.
-/

namespace Folder11

open TensorProduct Algebra.TensorProduct

/-- The data of a diagonal class, a point class and an Euler number. -/
structure DiagData (k : Type*) [CommRing k] (A : Type*) [CommRing A] [Algebra k A] where
  Δ : A ⊗[k] A
  y : A
  χ : k
  tr : A →ₗ[k] k
  comm : ∀ a : A, (a ⊗ₜ[k] (1 : A)) * Δ = ((1 : A) ⊗ₜ[k] a) * Δ
  symm : TensorProduct.comm k A A Δ = Δ
  euler : lmul' k Δ = χ • y
  point : (y ⊗ₜ[k] (1 : A)) * Δ = y ⊗ₜ[k] y
  y_sq : y * y = 0
  tr_y : tr y = 1
  tr_one : tr 1 = 0
  slice : TensorProduct.rid k A (TensorProduct.map LinearMap.id tr Δ) = 1

/-! ## The model: a local commutative Frobenius algebra -/

section Model

variable {k : Type*} [Field k] {A : Type*} [CommRing A] [Algebra k A]
  {ι : Type*} [Fintype ι] [DecidableEq ι] (tr : A →ₗ[k] k)

omit [Fintype ι] in
theorem repr_eq [Finite ι] (b c : Module.Basis ι k A)
    (hd : ∀ i j, tr (b i * c j) = if i = j then 1 else 0) (x : A) (j : ι) :
    b.repr x j = tr (x * c j) := by
  have := Fintype.ofFinite ι
  have : tr (x * c j) = tr ((∑ i, b.repr x i • b i) * c j) := by rw [b.sum_repr]
  rw [this, Finset.sum_mul, map_sum]
  simp [hd]

theorem expand (b c : Module.Basis ι k A)
    (hd : ∀ i j, tr (b i * c j) = if i = j then 1 else 0) (x : A) :
    x = ∑ j, tr (x * c j) • b j := by
  conv_lhs => rw [← b.sum_repr x]
  simp [repr_eq tr b c hd]

variable (b b' : Module.Basis ι k A) (hd : ∀ i j, tr (b i * b' j) = if i = j then 1 else 0)
include hd

omit [Fintype ι] in
theorem hd' : ∀ i j, tr (b' i * b j) = if i = j then 1 else 0 := fun i j => by
  rw [mul_comm, hd]; simp [eq_comm]

/-- The diagonal class `Σ bᵢ ⊗ b'ᵢ`. -/
noncomputable def diag : A ⊗[k] A := ∑ i, b i ⊗ₜ[k] b' i

theorem model_comm (a : A) :
    (a ⊗ₜ[k] (1 : A)) * diag b b' = ((1 : A) ⊗ₜ[k] a) * diag b b' := by
  simp only [diag, Finset.mul_sum, tmul_mul_tmul, one_mul]
  have h1 : ∀ i, (a * b i) ⊗ₜ[k] b' i = ∑ j, tr (a * b i * b' j) • (b j ⊗ₜ[k] b' i) := by
    intro i
    conv_lhs => rw [expand tr b b' hd (a * b i)]
    simp [TensorProduct.sum_tmul, TensorProduct.smul_tmul']
  have h2 : ∀ j, b j ⊗ₜ[k] (a * b' j) = ∑ i, tr (a * b' j * b i) • (b j ⊗ₜ[k] b' i) := by
    intro j
    conv_lhs => rw [expand tr b' b (hd' tr b b' hd) (a * b' j)]
    simp [TensorProduct.tmul_sum, TensorProduct.tmul_smul]
  simp_rw [h1, h2]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun i _ => ?_
  rw [mul_right_comm]

theorem model_symm : TensorProduct.comm k A A (diag b b') = diag b b' := by
  simp only [diag, map_sum, TensorProduct.comm_tmul]
  have h : ∀ i, b' i ⊗ₜ[k] b i = ∑ j, tr (b' i * b' j) • (b j ⊗ₜ[k] b i) := by
    intro i
    conv_lhs => rw [expand tr b b' hd (b' i)]
    simp [TensorProduct.sum_tmul, TensorProduct.smul_tmul']
  simp_rw [h]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun j _ => ?_
  conv_rhs => rw [expand tr b b' hd (b' j)]
  simp only [TensorProduct.tmul_sum, TensorProduct.tmul_smul]
  exact Finset.sum_congr rfl fun x _ => by rw [mul_comm]

theorem model_slice :
    TensorProduct.rid k A (TensorProduct.map LinearMap.id tr (diag b b')) = 1 := by
  conv_rhs => rw [expand tr b b' hd 1]
  simp [diag]

variable {ε : A →ₐ[k] k} {y : A} (hy : ∀ a, a * y = ε a • y)
  (hnil : ∀ a, ε a = 0 → IsNilpotent a)

omit hd in
theorem trace_eq (c : A) (hd : ∀ i j, tr (b i * b' j) = if i = j then 1 else 0) :
    Algebra.trace k A c = tr ((∑ i, b i * b' i) * c) := by
  rw [Algebra.trace_eq_matrix_trace b, Matrix.trace]
  simp only [Matrix.diag, Algebra.leftMulMatrix_eq_repr_mul, repr_eq tr b b' hd,
    Finset.sum_mul, map_sum]
  exact Finset.sum_congr rfl fun i _ => by ring_nf

include hy hnil in
theorem model_euler (htr : tr y = 1) :
    lmul' k (diag b b') = (Fintype.card ι : k) • y := by
  have hlm : lmul' k (diag b b') = ∑ i, b i * b' i := by simp [diag]
  rw [hlm]
  set e := ∑ i, b i * b' i
  -- `∫ (e c) = Tr(c) = (dim A) ε(c)`
  have hc : ∀ c, tr (e * c) = (Fintype.card ι : k) * ε c := by
    intro c
    have hn : Algebra.trace k A (c - algebraMap k A (ε c)) = 0 := by
      have := Algebra.isNilpotent_trace_of_isNilpotent (R := k) (hnil (c - algebraMap k A (ε c))
        (by simp))
      exact this.eq_zero
    rw [← trace_eq tr b b' c hd]
    rw [map_sub, Algebra.trace_algebraMap_of_basis b, sub_eq_zero] at hn
    rw [hn, nsmul_eq_mul]
  have hz : ∀ c, tr ((e - (Fintype.card ι : k) • y) * c) = 0 := by
    intro c
    rw [sub_mul, map_sub, hc, smul_mul_assoc, map_smul, mul_comm y, hy, map_smul, htr]
    simp
  rw [← sub_eq_zero, expand tr b b' hd (e - _)]
  simp [hz]

include hy in
theorem model_point (htr : tr y = 1) :
    (y ⊗ₜ[k] (1 : A)) * diag b b' = y ⊗ₜ[k] y := by
  rw [model_comm tr b b' hd]
  have h : ∀ i, ((1 : A) ⊗ₜ[k] y) * (b i ⊗ₜ[k] b' i) = (ε (b' i) • b i) ⊗ₜ[k] y := by
    intro i; rw [tmul_mul_tmul, one_mul, mul_comm y, hy, ← TensorProduct.smul_tmul]
  rw [diag, Finset.mul_sum]
  simp_rw [h]
  rw [← TensorProduct.sum_tmul]
  congr 1
  conv_rhs => rw [expand tr b b' hd y]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [mul_comm, hy, map_smul, htr, smul_eq_mul, mul_one]

end Model

/-- A local commutative Frobenius algebra with dual bases `b`, `b'` for `∫`, augmentation `ε`
with nilpotent kernel, socle spanned by `y`, `∫ y = 1`, `∫ 1 = 0`, `ε y = 0`, gives diagonal
data with `Δ = Σ bᵢ ⊗ b'ᵢ` and `χ = dim A`. -/
noncomputable def model {k : Type*} [Field k] {A : Type*} [CommRing A] [Algebra k A]
    {ι : Type*} [Fintype ι] [DecidableEq ι] (tr : A →ₗ[k] k) (b b' : Module.Basis ι k A)
    (hd : ∀ i j, tr (b i * b' j) = if i = j then 1 else 0) (ε : A →ₐ[k] k) (y : A)
    (hy : ∀ a, a * y = ε a • y) (hnil : ∀ a, ε a = 0 → IsNilpotent a)
    (htr : tr y = 1) (h1 : tr 1 = 0) (hεy : ε y = 0) : DiagData k A where
  Δ := diag b b'
  y := y
  χ := Fintype.card ι
  tr := tr
  comm := model_comm tr b b' hd
  symm := model_symm tr b b' hd
  euler := model_euler tr b b' hd hy hnil htr
  point := model_point tr b b' hd hy htr
  y_sq := by rw [hy, hεy, zero_smul]
  tr_y := htr
  tr_one := h1
  slice := model_slice tr b b' hd

theorem model_χ {k : Type*} [Field k] {A : Type*} [CommRing A] [Algebra k A]
    {ι : Type*} [Fintype ι] [DecidableEq ι] (tr : A →ₗ[k] k) (b b' : Module.Basis ι k A)
    (hd : ∀ i j, tr (b i * b' j) = if i = j then 1 else 0) (ε : A →ₐ[k] k) (y : A)
    (hy : ∀ a, a * y = ε a • y) (hnil : ∀ a, ε a = 0 → IsNilpotent a)
    (htr : tr y = 1) (h1 : tr 1 = 0) (hεy : ε y = 0) :
    (model tr b b' hd ε y hy hnil htr h1 hεy).χ = Module.finrank k A := by
  simp [model, Module.finrank_eq_card_basis b]

/-! ## Diagonal classes in a target algebra -/

section Classes

variable {k A : Type*} [CommRing k] [CommRing A] [Algebra k A] (D : DiagData k A)
  {B : Type*} [CommRing B] [Algebra k B] {I : Type*} (ι : I → A →ₐ[k] B)

/-- The partial diagonal `δ_{ij}`, image of `Δ` by `(ιᵢ, ιⱼ)`. -/
noncomputable def d (i j : I) : B := productMap (ι i) (ι j) D.Δ

/-- The pull-back `yᵢ` of the point class. -/
def yy (i : I) : B := ι i D.y

theorem transfer (i j : I) (a : A) : d D ι i j * ι j a = d D ι i j * ι i a := by
  have := congrArg (productMap (ι i) (ι j)) (D.comm a)
  simp only [map_mul, productMap_apply_tmul, map_one, mul_one, one_mul] at this
  rw [d, mul_comm, ← this, mul_comm]

theorem productMap_comm (f g : A →ₐ[k] B) (x : A ⊗[k] A) :
    productMap f g (TensorProduct.comm k A A x) = productMap g f x := by
  induction x using TensorProduct.inductionOn with
  | tmul a b => simp [mul_comm]
  | add x y hx hy => simp_all

theorem d_symm (i j : I) : d D ι i j = d D ι j i := by
  rw [d, d, ← productMap_comm, D.symm]

theorem productMap_self (f : A →ₐ[k] B) (x : A ⊗[k] A) : productMap f f x = f (lmul' k x) := by
  induction x using TensorProduct.inductionOn with
  | tmul a b => simp
  | add x y hx hy => simp_all

theorem d_self (i : I) : d D ι i i = D.χ • yy D ι i := by
  rw [d, productMap_self, D.euler, map_smul, yy]

theorem y_d (i j : I) : yy D ι i * d D ι i j = yy D ι i * yy D ι j := by
  have := congrArg (productMap (ι i) (ι j)) D.point
  simpa [map_mul, yy, d] using this

theorem yy_sq (i : I) : yy D ι i * yy D ι i = 0 := by
  rw [yy, ← map_mul, D.y_sq, map_zero]

variable [DecidableEq I]

/-- Renaming `j` to `i`. -/
def ren (j i : I) (a : I) : I := if a = j then i else a

theorem transfer_ren (i j a : I) (u : A) : d D ι i j * ι a u = d D ι i j * ι (ren j i a) u := by
  unfold ren; split_ifs with h
  · subst h; exact transfer D ι i a u
  · rfl

theorem transfer_d (i j a b : I) :
    d D ι i j * d D ι a b = d D ι i j * d D ι (ren j i a) (ren j i b) := by
  have key : ∀ z : A ⊗[k] A, d D ι i j * productMap (ι a) (ι b) z =
      d D ι i j * productMap (ι (ren j i a)) (ι (ren j i b)) z := by
    intro z
    induction z using TensorProduct.inductionOn with
    | tmul u v =>
      simp only [productMap_apply_tmul]
      have h1 := transfer_ren D ι i j a u
      have h2 := transfer_ren D ι i j b v
      calc d D ι i j * (ι a u * ι b v) = (d D ι i j * ι a u) * ι b v := by ring
        _ = ι (ren j i a) u * (d D ι i j * ι b v) := by rw [h1]; ring
        _ = _ := by rw [h2]; ring
    | add x y hx hy => simp only [map_add, mul_add, hx, hy]
  exact key D.Δ

/-! ## Products over multigraphs -/

/-- The product of the edge classes of a multigraph. -/
noncomputable def P (E : Multiset (I × I)) : B := (E.map fun e => d D ι e.1 e.2).prod

/-- The small diagonal of `X^V`, as the star of the root `r`. -/
noncomputable def δ (V : Finset I) (r : I) : B := ∏ v ∈ V.erase r, d D ι r v

/-- The value of a connected multigraph with cyclomatic number `c`. -/
noncomputable def F (c : ℕ) (V : Finset I) (r : I) : B :=
  match c with
  | 0 => δ D ι V r
  | 1 => D.χ • ∏ v ∈ V, yy D ι v
  | _ + 2 => 0

/-- `E` connects every two vertices of `V`. -/
def Conn (E : Multiset (I × I)) (V : Finset I) : Prop :=
  ∀ v ∈ V, ∀ w ∈ V, Relation.EqvGen (fun a b => (a, b) ∈ E) v w

omit [DecidableEq I] in
theorem P_cons (e : I × I) (E : Multiset (I × I)) :
    P D ι (e ::ₘ E) = d D ι e.1 e.2 * P D ι E := by
  simp [P]

omit [DecidableEq I] in
theorem P_add (E₁ E₂ : Multiset (I × I)) : P D ι (E₁ + E₂) = P D ι E₁ * P D ι E₂ := by
  simp [P]

omit [DecidableEq I] in
theorem P_sum {α : Type*} (s : Finset α) (f : α → Multiset (I × I)) :
    P D ι (∑ p ∈ s, f p) = ∏ p ∈ s, P D ι (f p) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [P]
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.prod_insert ha, P_add, ih]

omit [DecidableEq I] in
theorem P_star (s : Finset I) (r : I) :
    P D ι (s.val.map fun v => (r, v)) = ∏ v ∈ s, d D ι r v := by
  simp only [P, Multiset.map_map]; rfl

theorem transfer_P (i j : I) (E : Multiset (I × I)) :
    d D ι i j * P D ι E = d D ι i j * P D ι (E.map (Prod.map (ren j i) (ren j i))) := by
  induction E using Multiset.induction_on with
  | empty => simp [P]
  | cons e E ih =>
    simp only [Multiset.map_cons, P_cons, Prod.map_fst, Prod.map_snd]
    calc d D ι i j * (d D ι e.1 e.2 * P D ι E)
        = (d D ι i j * d D ι e.1 e.2) * P D ι E := by ring
      _ = d D ι (ren j i e.1) (ren j i e.2) * (d D ι i j * P D ι E) := by
          rw [transfer_d]; ring
      _ = _ := by rw [ih]; ring

omit [DecidableEq I] in
theorem prod_transfer (x : B) (s : Finset I) (f g : I → B) (h : ∀ v ∈ s, x * f v = x * g v) :
    x * ∏ v ∈ s, f v = x * ∏ v ∈ s, g v := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.prod_insert ha]
    have h1 := h a (Finset.mem_insert_self _ _)
    have h2 := ih fun v hv => h v (Finset.mem_insert_of_mem hv)
    calc x * (f a * ∏ v ∈ s, f v) = (x * f a) * ∏ v ∈ s, f v := by ring
      _ = g a * (x * ∏ v ∈ s, f v) := by rw [h1]; ring
      _ = _ := by rw [h2]; ring

omit [DecidableEq I] in
/-- `y_r δ_S = y_r ∏_{v ∈ S} y_v`. -/
theorem y_prod_d (r : I) (S : Finset I) :
    yy D ι r * ∏ v ∈ S, d D ι r v = yy D ι r * ∏ v ∈ S, yy D ι v := by
  classical
  induction S using Finset.induction_on with
  | empty => simp
  | insert a S ha ih =>
    rw [Finset.prod_insert ha, Finset.prod_insert ha]
    calc yy D ι r * (d D ι r a * ∏ v ∈ S, d D ι r v)
        = (yy D ι r * d D ι r a) * ∏ v ∈ S, d D ι r v := by ring
      _ = yy D ι a * (yy D ι r * ∏ v ∈ S, d D ι r v) := by rw [y_d]; ring
      _ = _ := by rw [ih]; ring

/-- `yᵢ δ_V = ∏_{v ∈ V} y_v` for `i, r ∈ V`. -/
theorem y_δ {V : Finset I} {i r : I} (hi : i ∈ V) (hr : r ∈ V) :
    yy D ι i * δ D ι V r = ∏ v ∈ V, yy D ι v := by
  have h1 : yy D ι i * δ D ι V r = yy D ι r * δ D ι V r := by
    by_cases hir : i = r
    · rw [hir]
    · unfold δ
      rw [← Finset.mul_prod_erase _ _ (Finset.mem_erase.2 ⟨hir, hi⟩)]
      have := transfer D ι r i D.y
      simp only [yy]
      rw [← mul_assoc, ← mul_assoc, mul_comm (ι i D.y), this, mul_comm (ι r D.y)]
  rw [h1, δ, y_prod_d, Finset.mul_prod_erase _ _ hr]

omit [DecidableEq I] in
theorem y_prod_eq_zero {V : Finset I} {i : I} (hi : i ∈ V) :
    yy D ι i * ∏ v ∈ V, yy D ι v = 0 := by
  classical
  rw [← Finset.mul_prod_erase _ _ hi, ← mul_assoc, yy_sq, zero_mul]

/-- One step of contraction for the small diagonal. -/
theorem d_δ {V : Finset I} {i j r : I} (hi : i ∈ V) (hj : j ∈ V) (hij : i ≠ j) :
    d D ι i j * δ D ι (V.erase j) (if r = j then i else r) = δ D ι V r := by
  unfold δ
  split_ifs with hrj
  · subst hrj
    rw [← Finset.mul_prod_erase (V.erase r) (fun v => d D ι r v)
      (Finset.mem_erase.2 ⟨hij, hi⟩), d_symm D ι i r]
    apply prod_transfer
    intro v hv
    rw [transfer_d D ι r i i v]
    have hvi : v ≠ i := (Finset.mem_erase.1 hv).1
    simp [ren, hvi]
  · have hjV : j ∈ V.erase r := Finset.mem_erase.2 ⟨Ne.symm hrj, hj⟩
    rw [← Finset.mul_prod_erase _ _ hjV, Finset.erase_right_comm]
    by_cases hri : r = i
    · subst hri; rfl
    · have hiV : i ∈ (V.erase r).erase j :=
        Finset.mem_erase.2 ⟨hij, Finset.mem_erase.2 ⟨Ne.symm hri, hi⟩⟩
      rw [← Finset.mul_prod_erase _ _ hiV]
      have := transfer_d D ι r i i j
      rw [show ren i r i = r by simp [ren], show ren i r j = j by simp [ren, hij.symm]] at this
      calc d D ι i j * (d D ι r i * ∏ x ∈ ((V.erase r).erase j).erase i, d D ι r x)
          = (d D ι r i * d D ι i j) * ∏ x ∈ ((V.erase r).erase j).erase i, d D ι r x := by ring
        _ = (d D ι r i * d D ι r j) * ∏ x ∈ ((V.erase r).erase j).erase i, d D ι r x := by
            rw [this]
        _ = _ := by ring

omit [DecidableEq I] in
theorem eqvGen_zero {v w : I}
    (h : Relation.EqvGen (fun a b => (a, b) ∈ (0 : Multiset (I × I))) v w) :
    v = w := by
  induction h with
  | rel a b h => simp at h
  | refl => rfl
  | symm a b _ ih => exact ih.symm
  | trans a b c _ _ ih1 ih2 => exact ih1.trans ih2

omit [DecidableEq I] in
theorem eqvGen_loop {i : I} {E : Multiset (I × I)} {v w : I}
    (h : Relation.EqvGen (fun a b => (a, b) ∈ (i, i) ::ₘ E) v w) :
    Relation.EqvGen (fun a b => (a, b) ∈ E) v w := by
  induction h with
  | rel a b h =>
    rcases Multiset.mem_cons.1 h with h | h
    · simp only [Prod.mk.injEq] at h; rw [h.1, h.2]; exact .refl _
    · exact .rel _ _ h
  | refl => exact .refl _
  | symm a b _ ih => exact ih.symm
  | trans a b c _ _ ih1 ih2 => exact ih1.trans _ _ _ ih2

theorem eqvGen_contract {i j : I} {E : Multiset (I × I)} {v w : I}
    (h : Relation.EqvGen (fun a b => (a, b) ∈ (i, j) ::ₘ E) v w) :
    Relation.EqvGen (fun a b => (a, b) ∈ E.map (Prod.map (ren j i) (ren j i)))
      (ren j i v) (ren j i w) := by
  induction h with
  | rel a b h =>
    rcases Multiset.mem_cons.1 h with h | h
    · simp only [Prod.mk.injEq] at h
      rw [h.1, h.2]
      have : ren j i i = ren j i j := by unfold ren; split_ifs <;> simp_all
      rw [this]; exact .refl _
    · exact .rel _ _ (Multiset.mem_map.2 ⟨_, h, rfl⟩)
  | refl => exact .refl _
  | symm a b _ ih => exact ih.symm
  | trans a b c _ _ ih1 ih2 => exact ih1.trans _ _ _ ih2

theorem F_loop (c : ℕ) {V : Finset I} {i r : I} (hi : i ∈ V) (hr : r ∈ V) :
    D.χ • yy D ι i * F D ι c V r = F D ι (c + 1) V r := by
  rcases c with _ | _ | c
  · simp only [F, smul_mul_assoc, y_δ D ι hi hr]
  · simp only [F, smul_mul_assoc, mul_smul_comm, y_prod_eq_zero D ι hi, smul_zero]
  · simp [F]

theorem F_contract (c : ℕ) {V : Finset I} {i j r : I} (hi : i ∈ V) (hj : j ∈ V) (hij : i ≠ j) :
    d D ι i j * F D ι c (V.erase j) (if r = j then i else r) = F D ι c V r := by
  rcases c with _ | _ | c
  · exact d_δ D ι hi hj hij
  · simp only [F, mul_smul_comm]
    congr 1
    rw [← Finset.mul_prod_erase _ _ hj, ← Finset.mul_prod_erase _ _ (Finset.mem_erase.2 ⟨hij, hi⟩),
      ← mul_assoc, mul_comm (d D ι i j), y_d]
    ring
  · simp [F]

/-- **The multigraph rule.** For a multigraph `E` with edges in `V` connecting `V`, and any
root `r ∈ V`: `|V| ≤ |E| + 1`, and the product of the edge classes is `δ_V` for a tree,
`χ ∏ y_v` with one cycle, `0` with two or more. -/
theorem graph_rule (n : ℕ) : ∀ (E : Multiset (I × I)) (V : Finset I), Multiset.card E = n →
    (∀ e ∈ E, e.1 ∈ V ∧ e.2 ∈ V) → Conn E V → ∀ r ∈ V,
    V.card ≤ Multiset.card E + 1 ∧ P D ι E = F D ι (Multiset.card E + 1 - V.card) V r := by
  induction n with
  | zero =>
    intro E V hn hE hc r hr
    rw [Multiset.card_eq_zero] at hn
    subst hn
    have hV : V = {r} := by
      ext v
      simp only [Finset.mem_singleton]
      exact ⟨fun hv => eqvGen_zero (hc v hv r hr), fun h => h ▸ hr⟩
    subst hV
    simp [P, F, δ]
  | succ n ih =>
    intro E V hn hE hc r hr
    obtain ⟨⟨i, j⟩, E', rfl⟩ : ∃ e E', E = e ::ₘ E' := by
      obtain ⟨e, he⟩ := Multiset.card_pos_iff_exists_mem.1 (by omega : 0 < Multiset.card E)
      exact ⟨e, Multiset.exists_cons_of_mem he⟩
    rw [Multiset.card_cons] at hn ⊢
    have hiV := (hE _ (Multiset.mem_cons_self _ _)).1
    have hjV := (hE _ (Multiset.mem_cons_self _ _)).2
    have hE' : ∀ e ∈ E', e.1 ∈ V ∧ e.2 ∈ V := fun e he => hE e (Multiset.mem_cons_of_mem he)
    rw [P_cons]
    by_cases hij : i = j
    · subst hij
      have hc' : Conn E' V := fun v hv w hw => eqvGen_loop (hc v hv w hw)
      obtain ⟨h1, h2⟩ := ih E' V (by omega) hE' hc' r hr
      refine ⟨by omega, ?_⟩
      rw [h2, d_self, F_loop D ι _ hiV hr]
      congr 1; omega
    · set σ := ren j i
      have hσ : ∀ a ∈ V, σ a ∈ V.erase j := fun a ha => by
        simp only [σ, ren]; split_ifs with h
        · exact Finset.mem_erase.2 ⟨hij, hiV⟩
        · exact Finset.mem_erase.2 ⟨h, ha⟩
      have hσ' : ∀ a ∈ V.erase j, σ a = a := fun a ha => by
        simp [σ, ren, (Finset.mem_erase.1 ha).1]
      have hE'' : ∀ e ∈ E'.map (Prod.map σ σ), e.1 ∈ V.erase j ∧ e.2 ∈ V.erase j := by
        intro e he
        obtain ⟨e', he', rfl⟩ := Multiset.mem_map.1 he
        exact ⟨hσ _ (hE' e' he').1, hσ _ (hE' e' he').2⟩
      have hc'' : Conn (E'.map (Prod.map σ σ)) (V.erase j) := by
        intro v hv w hw
        have := eqvGen_contract (hc v (Finset.mem_of_mem_erase hv) w (Finset.mem_of_mem_erase hw))
        rw [show ren j i v = v from hσ' v hv, show ren j i w = w from hσ' w hw] at this
        exact this
      have hr' : (if r = j then i else r) ∈ V.erase j := by
        split_ifs with h
        · exact Finset.mem_erase.2 ⟨hij, hiV⟩
        · exact Finset.mem_erase.2 ⟨h, hr⟩
      obtain ⟨h1, h2⟩ := ih _ _ (by simpa using hn) hE'' hc'' _ hr'
      rw [Multiset.card_map, Finset.card_erase_of_mem hjV] at h1 h2
      have hV1 : 1 ≤ V.card := Finset.card_pos.2 ⟨r, hr⟩
      refine ⟨by omega, ?_⟩
      rw [transfer_P, h2, ← F_contract D ι _ hiV hjV hij]
      congr 2; omega

/-! ## Two partitions -/

end Classes

section Partitions

variable {k A : Type*} [CommRing k] [CommRing A] [Algebra k A] (D : DiagData k A)
  {B : Type*} [CommRing B] [Algebra k B] {I : Type*} (ι : I → A →ₐ[k] B)
  [LinearOrder I] [Fintype I]

/-- The star edges of a partition: each block joined to its least element. -/
noncomputable def edges (R : Finpartition (Finset.univ : Finset I)) : Multiset (I × I) :=
  ∑ p ∈ R.parts.attach, (p.1.erase (p.1.min' (R.nonempty_of_mem_parts p.2))).val.map
    fun v => (p.1.min' (R.nonempty_of_mem_parts p.2), v)

/-- `δ_R`: the product of the small diagonals of the blocks of `R`. -/
noncomputable def δR (R : Finpartition (Finset.univ : Finset I)) : B :=
  ∏ p ∈ R.parts.attach, δ D ι p.1 (p.1.min' (R.nonempty_of_mem_parts p.2))

theorem P_edges (R : Finpartition (Finset.univ : Finset I)) : P D ι (edges R) = δR D ι R := by
  rw [edges, P_sum]
  exact Finset.prod_congr rfl fun p _ => P_star D ι _ _

theorem card_edges (R : Finpartition (Finset.univ : Finset I)) :
    Multiset.card (edges R) + R.parts.card = Fintype.card I := by
  simp only [edges, Multiset.card_sum, Multiset.card_map, Finset.card_val]
  have h : ∀ p ∈ R.parts.attach,
      (p.1.erase (p.1.min' (R.nonempty_of_mem_parts p.2))).card = p.1.card - 1 :=
    fun p _ => Finset.card_erase_of_mem (Finset.min'_mem _ _)
  rw [Finset.sum_congr rfl h, ← Finset.card_attach (s := R.parts), Finset.card_eq_sum_ones,
    ← Finset.sum_add_distrib]
  have h2 : ∀ p ∈ R.parts.attach, p.1.card - 1 + 1 = p.1.card := fun p _ =>
    Nat.sub_add_cancel (Finset.card_pos.2 (R.nonempty_of_mem_parts p.2))
  rw [Finset.sum_congr rfl h2, Finset.sum_attach R.parts Finset.card, R.sum_card_parts,
    Finset.card_univ]

theorem eqvGen_of_block (R : Finpartition (Finset.univ : Finset I)) {E : Multiset (I × I)}
    (hE : edges R ≤ E) {p : Finset I} (hp : p ∈ R.parts) {a b : I} (ha : a ∈ p) (hb : b ∈ p) :
    Relation.EqvGen (fun a b => (a, b) ∈ E) a b := by
  have hm : ∀ c ∈ p, Relation.EqvGen (fun a b => (a, b) ∈ E)
      (p.min' (R.nonempty_of_mem_parts hp)) c := by
    intro c hc
    by_cases h : c = p.min' (R.nonempty_of_mem_parts hp)
    · rw [h]; exact .refl _
    · refine .rel _ _ (Multiset.mem_of_le hE ?_)
      simp only [edges, Multiset.mem_sum, Multiset.mem_map, Finset.mem_val]
      exact ⟨⟨p, hp⟩, Finset.mem_attach _ _, c, Finset.mem_erase.2 ⟨h, hc⟩, rfl⟩
  exact (hm a ha).symm.trans _ _ _ (hm b hb)

/-- `R` and `R'` have the coarse partition as their join. -/
def Joined (R R' : Finpartition (Finset.univ : Finset I)) : Prop :=
  ∀ v w, Relation.EqvGen (fun a b => (∃ p ∈ R.parts, a ∈ p ∧ b ∈ p) ∨
    ∃ p ∈ R'.parts, a ∈ p ∧ b ∈ p) v w

/-- **Page 56.** For two partitions `R`, `R'` of the `k` indices with coarse join and `s`, `s'`
blocks: `s + s' ≤ k + 1`, and `δ_R δ_{R'}` is the small diagonal if `s + s' = k + 1`,
`χ y₁⋯y_k` if `s + s' = k`, and `0` if `s + s' < k`. -/
theorem product_rule (R R' : Finpartition (Finset.univ : Finset I)) (h : Joined R R') (r : I) :
    R.parts.card + R'.parts.card ≤ Fintype.card I + 1 ∧
    δR D ι R * δR D ι R' =
      F D ι (Fintype.card I + 1 - R.parts.card - R'.parts.card) Finset.univ r := by
  have hc : Conn (edges R + edges R') Finset.univ := by
    intro v hv w hw
    clear hv hw
    induction h v w with
    | rel a b hab =>
      rcases hab with ⟨p, hp, ha, hb⟩ | ⟨p, hp, ha, hb⟩
      · exact eqvGen_of_block R (Multiset.le_add_right _ _) hp ha hb
      · exact eqvGen_of_block R' (Multiset.le_add_left _ _) hp ha hb
    | refl => exact .refl _
    | symm a b _ ih => exact ih.symm
    | trans a b c _ _ ih1 ih2 => exact ih1.trans _ _ _ ih2
  obtain ⟨h1, h2⟩ := graph_rule D ι _ _ _ rfl (fun _ _ => ⟨Finset.mem_univ _, Finset.mem_univ _⟩)
    hc r (Finset.mem_univ _)
  have e1 := card_edges R
  have e2 := card_edges R'
  rw [Multiset.card_add, Finset.card_univ] at h1 h2
  refine ⟨by omega, ?_⟩
  rw [← P_edges, ← P_edges]
  simp only [P, Multiset.map_add, Multiset.prod_add] at h2 ⊢
  rw [h2]; congr 1; omega

/-- With one block of points: `y_j δ_R δ_{R'}` is `y₁⋯y_k` if `s + s' = k + 1` and `0`
otherwise; with two, `y_j y_{j'} δ_R δ_{R'} = 0`. -/
theorem product_rule_pointed (R R' : Finpartition (Finset.univ : Finset I)) (h : Joined R R')
    (j j' : I) :
    yy D ι j * (δR D ι R * δR D ι R') =
      (if R.parts.card + R'.parts.card = Fintype.card I + 1 then ∏ v, yy D ι v else 0) ∧
    yy D ι j * yy D ι j' * (δR D ι R * δR D ι R') = 0 := by
  obtain ⟨h1, h2⟩ := product_rule D ι R R' h j
  have key : yy D ι j * (δR D ι R * δR D ι R') =
      (if R.parts.card + R'.parts.card = Fintype.card I + 1 then ∏ v, yy D ι v else 0) := by
    rw [h2]
    split_ifs with he
    · rw [show Fintype.card I + 1 - R.parts.card - R'.parts.card = 0 by omega]
      exact y_δ D ι (Finset.mem_univ _) (Finset.mem_univ _)
    · obtain ⟨c, hc⟩ : ∃ c, Fintype.card I + 1 - R.parts.card - R'.parts.card = c + 1 :=
        ⟨_, (Nat.succ_pred_eq_of_pos (by omega)).symm⟩
      rw [hc]
      rcases c with _ | c
      · simp only [F, mul_smul_comm, y_prod_eq_zero D ι (Finset.mem_univ j), smul_zero]
      · simp [F]
  refine ⟨key, ?_⟩
  rw [mul_comm (yy D ι j), mul_assoc, key]
  split_ifs
  · exact y_prod_eq_zero D ι (Finset.mem_univ _)
  · simp

end Partitions

/-! ## The tables of page 50 -/

section Tables

variable {k A : Type*} [CommRing k] [CommRing A] [Algebra k A] (D : DiagData k A)
  {B : Type*} [CommRing B] [Algebra k B]

/-- `T(X²)`: `y₁δ = y₂δ = y₁y₂` and `δ² = χ y₁y₂`. -/
theorem table_two (ι : Fin 2 → A →ₐ[k] B) :
    yy D ι 0 * d D ι 0 1 = yy D ι 0 * yy D ι 1 ∧
    yy D ι 1 * d D ι 0 1 = yy D ι 0 * yy D ι 1 ∧
    d D ι 0 1 * d D ι 0 1 = D.χ • (yy D ι 0 * yy D ι 1) := by
  refine ⟨y_d D ι 0 1, ?_, ?_⟩
  · rw [d_symm, y_d, mul_comm]
  · rw [transfer_d D ι 0 1 0 1, show ren (1 : Fin 2) 0 0 = 0 by decide,
      show ren (1 : Fin 2) 0 1 = 0 by decide, d_self, mul_comm, smul_mul_assoc, y_d]

/-- `T(X³)`, with `δ = δ₁₂δ₁₃` the small diagonal: `δ₁₂δ₂₃ = δ₁₂δ₁₃ = δ₂₃δ₁₃ = δ`,
`δ yᵢ = y₁y₂y₃`, `δ² = 0`, `δᵢⱼ δ = χ y₁y₂y₃`, `δᵢⱼ² = χ yᵢyⱼ`, `δᵢⱼ yᵢ = yᵢyⱼ`. -/
theorem table_three (ι : Fin 3 → A →ₐ[k] B) :
    let δ := d D ι 0 1 * d D ι 0 2
    d D ι 0 1 * d D ι 1 2 = δ ∧ d D ι 1 2 * d D ι 0 2 = δ ∧
    (∀ i, yy D ι i * δ = yy D ι 0 * yy D ι 1 * yy D ι 2) ∧ δ * δ = 0 ∧
    (∀ i j, i ≠ j → d D ι i j * δ = D.χ • (yy D ι 0 * yy D ι 1 * yy D ι 2)) ∧
    (∀ i j, d D ι i j * d D ι i j = D.χ • (yy D ι i * yy D ι j)) ∧
    (∀ i j, yy D ι i * d D ι i j = yy D ι i * yy D ι j) := by
  intro δ
  have sq : ∀ i j, d D ι i j * d D ι i j = D.χ • (yy D ι i * yy D ι j) := by
    intro i j
    rw [transfer_d D ι i j i j]
    by_cases hij : i = j
    · subst hij
      rw [show ren i i i = i by simp [ren], d_self, smul_mul_smul_comm, yy_sq]
      simp only [smul_zero]
    · have e1 : ren j i i = i := by simp [ren]
      have e2 : ren j i j = i := by simp [ren]
      rw [e1, e2, d_self, mul_comm, smul_mul_assoc, y_d]
  have h1 : d D ι 0 1 * d D ι 1 2 = δ := by
    rw [transfer_d D ι 0 1 1 2]; simp [ren, δ]
  have h2 : d D ι 1 2 * d D ι 0 2 = δ := by
    rw [mul_comm, transfer_d D ι 0 2 1 2]; simp [ren, δ, d_symm D ι 1 0, mul_comm]
  have hδ : δ = Folder11.δ D ι Finset.univ 0 := by
    simp only [Folder11.δ, δ]
    rw [show (Finset.univ : Finset (Fin 3)).erase 0 = {1, 2} by decide]
    simp
  have hy : ∀ i, yy D ι i * δ = yy D ι 0 * yy D ι 1 * yy D ι 2 := by
    intro i
    rw [hδ, y_δ D ι (Finset.mem_univ i) (Finset.mem_univ 0), Fin.prod_univ_three]
  refine ⟨h1, h2, hy, ?_, ?_, sq, fun i j => y_d D ι i j⟩
  · change d D ι 0 1 * d D ι 0 2 * (d D ι 0 1 * d D ι 0 2) = 0
    calc d D ι 0 1 * d D ι 0 2 * (d D ι 0 1 * d D ι 0 2)
        = (d D ι 0 1 * d D ι 0 1) * (d D ι 0 2 * d D ι 0 2) := by ring
      _ = D.χ • D.χ • (yy D ι 0 * yy D ι 0 * (yy D ι 1 * yy D ι 2)) := by
          rw [sq, sq, smul_mul_smul_comm]; simp only [smul_smul]; congr 1; ring
      _ = 0 := by rw [yy_sq]; simp
  · have h01 : d D ι 0 1 * δ = D.χ • (yy D ι 0 * yy D ι 1 * yy D ι 2) := by
      calc d D ι 0 1 * δ = (d D ι 0 1 * d D ι 0 1) * d D ι 0 2 := by simp only [δ]; ring
        _ = D.χ • (yy D ι 1 * (yy D ι 0 * d D ι 0 2)) := by
            rw [sq, smul_mul_assoc]; congr 1; ring
        _ = _ := by rw [y_d]; congr 1; ring
    have h02 : d D ι 0 2 * δ = D.χ • (yy D ι 0 * yy D ι 1 * yy D ι 2) := by
      calc d D ι 0 2 * δ = (d D ι 0 2 * d D ι 0 2) * d D ι 0 1 := by simp only [δ]; ring
        _ = D.χ • (yy D ι 2 * (yy D ι 0 * d D ι 0 1)) := by
            rw [sq, smul_mul_assoc]; congr 1; ring
        _ = _ := by rw [y_d]; congr 1; ring
    have h12 : d D ι 1 2 * δ = D.χ • (yy D ι 0 * yy D ι 1 * yy D ι 2) := by
      calc d D ι 1 2 * δ = (d D ι 0 1 * d D ι 1 2) * d D ι 0 2 := by simp only [δ]; ring
        _ = d D ι 0 2 * δ := by rw [h1]; simp only [δ]; ring
        _ = _ := h02
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all [d_symm D ι 1 0, d_symm D ι 2 0, d_symm D ι 2 1]

end Tables

/-! ## Projections: one more factor -/

section Projection

variable {k A : Type*} [CommRing k] [CommRing A] [Algebra k A] (D : DiagData k A)
  {B : Type*} [CommRing B] [Algebra k B] {I : Type*} (ι : I → A →ₐ[k] B)

/-- The family on `B ⊗ A`: the old factors and a new one, `∗`. -/
noncomputable def ext : Option I → A →ₐ[k] B ⊗[k] A
  | some i => includeLeft.comp (ι i)
  | none => includeRight

/-- The push-forward along the projection forgetting the new factor: `id ⊗ ∫`. -/
noncomputable def push : B ⊗[k] A →ₗ[k] B :=
  (TensorProduct.rid k B).toLinearMap ∘ₗ TensorProduct.map LinearMap.id D.tr

theorem push_tmul (x : B) (a : A) : push D (x ⊗ₜ a) = D.tr a • x := by
  simp [push]

/-- A class not involving the new factor is killed (`∫ 1 = 0`). -/
theorem push_old (x : B) : push D (includeLeft (R := k) (S := k) x : B ⊗[k] A) = 0 := by
  simp [push_tmul, D.tr_one]

/-- `p_*(x · y_∗) = x`. -/
theorem push_point (x : B) :
    push D ((includeLeft (R := k) (S := k) x : B ⊗[k] A) * yy D (ext ι) none) = x := by
  simp [yy, ext, push_tmul, D.tr_y]

theorem push_productMap (f : A →ₐ[k] B) (x : B) (z : A ⊗[k] A) :
    push D ((includeLeft (R := k) (S := k) x : B ⊗[k] A) *
      productMap (includeLeft.comp f) includeRight z) =
      x * f (TensorProduct.rid k A (TensorProduct.map LinearMap.id D.tr z)) := by
  induction z using TensorProduct.inductionOn with
  | tmul a b => simp [push_tmul, mul_comm]
  | add z w hz hw => simp only [map_add, mul_add, hz, hw]

/-- `p_*(x · δ_{i∗}) = x`: the new index leaves its diagonal block. -/
theorem push_diag (x : B) (i : I) :
    push D ((includeLeft (R := k) (S := k) x : B ⊗[k] A) * d D (ext ι) (some i) none) = x := by
  rw [d, ext, ext, push_productMap, D.slice, map_one, mul_one]

/-- The pull-back sends diagonals to diagonals and point classes to point classes. -/
theorem pull_d (i j : I) :
    (includeLeft (R := k) (S := k) (d D ι i j) : B ⊗[k] A) = d D (ext ι) (some i) (some j) ∧
    (includeLeft (R := k) (S := k) (yy D ι i) : B ⊗[k] A) = yy D (ext ι) (some i) := by
  refine ⟨?_, rfl⟩
  simp only [d, ext]
  induction D.Δ using TensorProduct.inductionOn with
  | tmul a b => simp
  | add z w hz hw => simp only [map_add, hz, hw]

end Projection

end Folder11
