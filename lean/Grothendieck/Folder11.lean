import Mathlib

/-!
# Folder 11 (pages 50–56): the tautological subalgebra of `H*(Xᵏ)`, an algebraic model

Finding `11-tautological-diagonal-product-rule` of `src/content/findings.ts`. The folder
computes the subalgebra of `H*(Xᵏ)` generated by the pull-backs `yᵢ` of the point class and
the classes of the partial diagonals. No geometry is used here: everything is derived from
five identities which the diagonal class `Δ ∈ A ⊗ A` of a Poincaré-duality algebra satisfies.

* `DiagData`: a commutative algebra `A` with `Δ ∈ A ⊗ A`, a point class `y`, a scalar `χ`
  and a linear form `∫`, with `(a ⊗ 1)Δ = (1 ⊗ a)Δ`, `Δ` symmetric, `m(Δ) = χ y`,
  `(y ⊗ 1)Δ = y ⊗ y`, `y² = 0`, `∫ y = 1`, `∫ 1 = 0` and `(id ⊗ ∫)Δ = 1`.
* `model`: a finite-dimensional commutative Frobenius algebra over a field, local with
  nilpotent augmentation ideal and socle spanned by `y` (the even-degree case of a
  Poincaré-duality algebra), is such data, `Δ = Σ bᵢ ⊗ b'ᵢ` for dual bases, with
  `χ = dim A`.
* In any commutative algebra `B` with algebra maps `ιᵢ : A → B` (for instance `A^{⊗k}`),
  `d i j` is the image of `Δ` by `(ιᵢ, ιⱼ)`; `d i i = χ yᵢ`.
* `table_two`, `table_three`: the relations of page 50 for `k = 2, 3`, among them
  `δ² = χ y₁y₂` on `X²`, `δ² = 0` and `δ₁₂δ = χ y₁y₂y₃` for the small diagonal of `X³`.
* `graph_rule`: for a connected multigraph `E` on a vertex set `V`, the product of its edge
  classes is the small diagonal `δ_V` if `E` is a tree, `χ ∏ yᵥ` if it has exactly one
  cycle, and `0` otherwise; and `|V| ≤ |E| + 1`.
* `product_rule`, `product_rule_pointed`: for two partitions `R`, `R'` of a finite set of
  `k` indices whose join is the coarse partition, `s + s' ≤ k + 1` (`s`, `s'` their numbers
  of blocks), and `δ_R δ_{R'}` is `δ` if `s + s' = k + 1`, `χ y₁⋯y_k` if `s + s' = k`, and
  `0` if `s + s' < k`; with one point block it is `y₁⋯y_k` or `0`, with two it is `0`.
* `push_old`, `push_point`, `push_diag`, `pull_d`: in `B ⊗ A`, the push-forward along the
  projection forgetting the last factor kills the classes not involving it and sends
  `x·y_∗` and `x·d_{i∗}` to `x`; the pull-back sends diagonals to diagonals.
-/

namespace Folder11

open TensorProduct Algebra.TensorProduct

/-- The data of a diagonal class, a point class and an Euler number. -/
structure DiagData (k : Type*) [CommRing k] (A : Type*) [CommRing A] [Algebra k A] where
  Δ : A ⊗[k] A
  y : A
  χ : k
  tr : A →ₗ[k] k
  comm : ∀ a : A, (a ⊗ₜ[k] (1 : A)) * Δ = ((1 : A) ⊗ₜ[k] a) * Δ
  symm : TensorProduct.comm k A A Δ = Δ
  euler : lmul' k Δ = χ • y
  point : (y ⊗ₜ[k] (1 : A)) * Δ = y ⊗ₜ[k] y
  y_sq : y * y = 0
  tr_y : tr y = 1
  tr_one : tr 1 = 0
  slice : TensorProduct.rid k A (TensorProduct.map LinearMap.id tr Δ) = 1

/-! ## The model: a local commutative Frobenius algebra -/

section Model

variable {k : Type*} [Field k] {A : Type*} [CommRing A] [Algebra k A]
  {ι : Type*} [Fintype ι] [DecidableEq ι] (tr : A →ₗ[k] k)

omit [Fintype ι] in
theorem repr_eq [Finite ι] (b c : Module.Basis ι k A)
    (hd : ∀ i j, tr (b i * c j) = if i = j then 1 else 0) (x : A) (j : ι) :
    b.repr x j = tr (x * c j) := by
  have := Fintype.ofFinite ι
  have : tr (x * c j) = tr ((∑ i, b.repr x i • b i) * c j) := by rw [b.sum_repr]
  rw [this, Finset.sum_mul, map_sum]
  simp [hd]

theorem expand (b c : Module.Basis ι k A)
    (hd : ∀ i j, tr (b i * c j) = if i = j then 1 else 0) (x : A) :
    x = ∑ j, tr (x * c j) • b j := by
  conv_lhs => rw [← b.sum_repr x]
  simp [repr_eq tr b c hd]

variable (b b' : Module.Basis ι k A) (hd : ∀ i j, tr (b i * b' j) = if i = j then 1 else 0)
include hd

omit [Fintype ι] in
theorem hd' : ∀ i j, tr (b' i * b j) = if i = j then 1 else 0 := fun i j => by
  rw [mul_comm, hd]; simp [eq_comm]

/-- The diagonal class `Σ bᵢ ⊗ b'ᵢ`. -/
noncomputable def diag : A ⊗[k] A := ∑ i, b i ⊗ₜ[k] b' i

theorem model_comm (a : A) :
    (a ⊗ₜ[k] (1 : A)) * diag b b' = ((1 : A) ⊗ₜ[k] a) * diag b b' := by
  simp only [diag, Finset.mul_sum, tmul_mul_tmul, one_mul]
  have h1 : ∀ i, (a * b i) ⊗ₜ[k] b' i = ∑ j, tr (a * b i * b' j) • (b j ⊗ₜ[k] b' i) := by
    intro i
    conv_lhs => rw [expand tr b b' hd (a * b i)]
    simp [TensorProduct.sum_tmul, TensorProduct.smul_tmul']
  have h2 : ∀ j, b j ⊗ₜ[k] (a * b' j) = ∑ i, tr (a * b' j * b i) • (b j ⊗ₜ[k] b' i) := by
    intro j
    conv_lhs => rw [expand tr b' b (hd' tr b b' hd) (a * b' j)]
    simp [TensorProduct.tmul_sum, TensorProduct.tmul_smul]
  simp_rw [h1, h2]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun i _ => by rw [mul_right_comm]

theorem model_symm : TensorProduct.comm k A A (diag b b') = diag b b' := by
  simp only [diag, map_sum, TensorProduct.comm_tmul]
  have h : ∀ i, b' i ⊗ₜ[k] b i = ∑ j, tr (b' i * b' j) • (b j ⊗ₜ[k] b i) := by
    intro i
    conv_lhs => rw [expand tr b b' hd (b' i)]
    simp [TensorProduct.sum_tmul, TensorProduct.smul_tmul']
  simp_rw [h]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun j _ => ?_
  conv_rhs => rw [expand tr b b' hd (b' j)]
  simp only [TensorProduct.tmul_sum, TensorProduct.tmul_smul]
  exact Finset.sum_congr rfl fun x _ => by rw [mul_comm]

theorem model_slice :
    TensorProduct.rid k A (TensorProduct.map LinearMap.id tr (diag b b')) = 1 := by
  conv_rhs => rw [expand tr b b' hd 1]
  simp [diag]

variable {ε : A →ₐ[k] k} {y : A} (hy : ∀ a, a * y = ε a • y)
  (hnil : ∀ a, ε a = 0 → IsNilpotent a)

omit hd in
theorem trace_eq (c : A) (hd : ∀ i j, tr (b i * b' j) = if i = j then 1 else 0) :
    Algebra.trace k A c = tr ((∑ i, b i * b' i) * c) := by
  rw [Algebra.trace_eq_matrix_trace b, Matrix.trace]
  simp only [Matrix.diag, Algebra.leftMulMatrix_eq_repr_mul, repr_eq tr b b' hd,
    Finset.sum_mul, map_sum]
  exact Finset.sum_congr rfl fun i _ => by ring_nf

include hy hnil in
theorem model_euler (htr : tr y = 1) :
    lmul' k (diag b b') = (Fintype.card ι : k) • y := by
  rw [show lmul' k (diag b b') = ∑ i, b i * b' i by simp [diag]]
  set e := ∑ i, b i * b' i
  -- `∫ (e c) = Tr(c) = (dim A) ε(c)`
  have hc : ∀ c, tr (e * c) = (Fintype.card ι : k) * ε c := by
    intro c
    have hn : Algebra.trace k A (c - algebraMap k A (ε c)) = 0 :=
      (Algebra.isNilpotent_trace_of_isNilpotent (R := k) (hnil _ (by simp))).eq_zero
    rw [← trace_eq tr b b' c hd]
    rw [map_sub, Algebra.trace_algebraMap_of_basis b, sub_eq_zero] at hn
    rw [hn, nsmul_eq_mul]
  have hz : ∀ c, tr ((e - (Fintype.card ι : k) • y) * c) = 0 := by
    intro c
    rw [sub_mul, map_sub, hc, smul_mul_assoc, map_smul, mul_comm y, hy, map_smul, htr]
    simp
  rw [← sub_eq_zero, expand tr b b' hd (e - _)]
  simp [hz]

include hy in
theorem model_point (htr : tr y = 1) :
    (y ⊗ₜ[k] (1 : A)) * diag b b' = y ⊗ₜ[k] y := by
  rw [model_comm tr b b' hd]
  have h : ∀ i, ((1 : A) ⊗ₜ[k] y) * (b i ⊗ₜ[k] b' i) = (ε (b' i) • b i) ⊗ₜ[k] y := by
    intro i
    rw [tmul_mul_tmul, one_mul, mul_comm y, hy, ← TensorProduct.smul_tmul]
  simp_rw [diag, Finset.mul_sum, h, ← TensorProduct.sum_tmul]
  congr 1
  conv_rhs => rw [expand tr b b' hd y]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [mul_comm, hy, map_smul, htr, smul_eq_mul, mul_one]

end Model

/-- A local commutative Frobenius algebra with dual bases `b`, `b'` for `∫`, augmentation `ε`
with nilpotent kernel, socle spanned by `y`, `∫ y = 1`, `∫ 1 = 0`, `ε y = 0`, gives diagonal
data with `Δ = Σ bᵢ ⊗ b'ᵢ` and `χ = dim A`. -/
noncomputable def model {k : Type*} [Field k] {A : Type*} [CommRing A] [Algebra k A]
    {ι : Type*} [Fintype ι] [DecidableEq ι] (tr : A →ₗ[k] k) (b b' : Module.Basis ι k A)
    (hd : ∀ i j, tr (b i * b' j) = if i = j then 1 else 0) (ε : A →ₐ[k] k) (y : A)
    (hy : ∀ a, a * y = ε a • y) (hnil : ∀ a, ε a = 0 → IsNilpotent a)
    (htr : tr y = 1) (h1 : tr 1 = 0) (hεy : ε y = 0) : DiagData k A where
  Δ := diag b b'
  y := y
  χ := Fintype.card ι
  tr := tr
  comm := model_comm tr b b' hd
  symm := model_symm tr b b' hd
  euler := model_euler tr b b' hd hy hnil htr
  point := model_point tr b b' hd hy htr
  y_sq := by rw [hy, hεy, zero_smul]
  tr_y := htr
  tr_one := h1
  slice := model_slice tr b b' hd

theorem model_χ {k : Type*} [Field k] {A : Type*} [CommRing A] [Algebra k A]
    {ι : Type*} [Fintype ι] [DecidableEq ι] (tr : A →ₗ[k] k) (b b' : Module.Basis ι k A)
    (hd : ∀ i j, tr (b i * b' j) = if i = j then 1 else 0) (ε : A →ₐ[k] k) (y : A)
    (hy : ∀ a, a * y = ε a • y) (hnil : ∀ a, ε a = 0 → IsNilpotent a)
    (htr : tr y = 1) (h1 : tr 1 = 0) (hεy : ε y = 0) :
    (model tr b b' hd ε y hy hnil htr h1 hεy).χ = Module.finrank k A := by
  simp [model, Module.finrank_eq_card_basis b]

/-! ## Diagonal classes in a target algebra -/

section Classes

variable {k A : Type*} [CommRing k] [CommRing A] [Algebra k A] (D : DiagData k A)
  {B : Type*} [CommRing B] [Algebra k B] {I : Type*} (ι : I → A →ₐ[k] B)

/-- The partial diagonal `δ_{ij}`, image of `Δ` by `(ιᵢ, ιⱼ)`. -/
noncomputable def d (i j : I) : B := productMap (ι i) (ι j) D.Δ

/-- The pull-back `yᵢ` of the point class. -/
def yy (i : I) : B := ι i D.y

theorem transfer (i j : I) (a : A) : d D ι i j * ι j a = d D ι i j * ι i a := by
  have := congrArg (productMap (ι i) (ι j)) (D.comm a)
  simp only [map_mul, productMap_apply_tmul, map_one, mul_one, one_mul] at this
  rw [d, mul_comm, ← this, mul_comm]

theorem productMap_comm (f g : A →ₐ[k] B) (x : A ⊗[k] A) :
    productMap f g (TensorProduct.comm k A A x) = productMap g f x := by
  induction x using TensorProduct.inductionOn with
  | tmul a b => simp [mul_comm]
  | add x y hx hy => simp_all

theorem d_symm (i j : I) : d D ι i j = d D ι j i := by
  rw [d, d, ← productMap_comm, D.symm]

theorem productMap_self (f : A →ₐ[k] B) (x : A ⊗[k] A) : productMap f f x = f (lmul' k x) := by
  induction x using TensorProduct.inductionOn with
  | tmul a b => simp
  | add x y hx hy => simp_all

theorem d_self (i : I) : d D ι i i = D.χ • yy D ι i := by
  rw [d, productMap_self, D.euler, map_smul, yy]

theorem y_d (i j : I) : yy D ι i * d D ι i j = yy D ι i * yy D ι j := by
  simpa [map_mul, yy, d] using congrArg (productMap (ι i) (ι j)) D.point

theorem yy_sq (i : I) : yy D ι i * yy D ι i = 0 := by
  rw [yy, ← map_mul, D.y_sq, map_zero]

variable [DecidableEq I]

/-- Renaming `j` to `i`. -/
def ren (j i : I) (a : I) : I := if a = j then i else a

theorem transfer_ren (i j a : I) (u : A) : d D ι i j * ι a u = d D ι i j * ι (ren j i a) u := by
  unfold ren; split_ifs with h
  · subst h; exact transfer D ι i a u
  · rfl

theorem transfer_d (i j a b : I) :
    d D ι i j * d D ι a b = d D ι i j * d D ι (ren j i a) (ren j i b) := by
  have key : ∀ z : A ⊗[k] A, d D ι i j * productMap (ι a) (ι b) z =
      d D ι i j * productMap (ι (ren j i a)) (ι (ren j i b)) z := by
    intro z
    induction z using TensorProduct.inductionOn with
    | tmul u v =>
      simp only [productMap_apply_tmul]
      rw [← mul_assoc, transfer_ren D ι i j a u, mul_right_comm, transfer_ren D ι i j b v]
      ring
    | add x y hx hy => simp only [map_add, mul_add, hx, hy]
  exact key D.Δ

/-! ## Products over multigraphs -/

/-- The product of the edge classes of a multigraph. -/
noncomputable def P (E : Multiset (I × I)) : B := (E.map fun e => d D ι e.1 e.2).prod

/-- The small diagonal of `X^V`, as the star of the root `r`. -/
noncomputable def δ (V : Finset I) (r : I) : B := ∏ v ∈ V.erase r, d D ι r v

/-- The value of a connected multigraph with cyclomatic number `c`. -/
noncomputable def F (c : ℕ) (V : Finset I) (r : I) : B :=
  match c with
  | 0 => δ D ι V r
  | 1 => D.χ • ∏ v ∈ V, yy D ι v
  | _ + 2 => 0

/-- `E` connects every two vertices of `V`. -/
def Conn (E : Multiset (I × I)) (V : Finset I) : Prop :=
  ∀ v ∈ V, ∀ w ∈ V, Relation.EqvGen (fun a b => (a, b) ∈ E) v w

omit [DecidableEq I] in
theorem P_cons (e : I × I) (E : Multiset (I × I)) :
    P D ι (e ::ₘ E) = d D ι e.1 e.2 * P D ι E := by
  simp [P]

omit [DecidableEq I] in
theorem P_add (E₁ E₂ : Multiset (I × I)) : P D ι (E₁ + E₂) = P D ι E₁ * P D ι E₂ := by
  simp [P]

omit [DecidableEq I] in
theorem P_sum {α : Type*} (s : Finset α) (f : α → Multiset (I × I)) :
    P D ι (∑ p ∈ s, f p) = ∏ p ∈ s, P D ι (f p) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [P]
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.prod_insert ha, P_add, ih]

omit [DecidableEq I] in
theorem P_star (s : Finset I) (r : I) :
    P D ι (s.val.map fun v => (r, v)) = ∏ v ∈ s, d D ι r v := by
  simp only [P, Multiset.map_map]; rfl

theorem transfer_P (i j : I) (E : Multiset (I × I)) :
    d D ι i j * P D ι E = d D ι i j * P D ι (E.map (Prod.map (ren j i) (ren j i))) := by
  induction E using Multiset.induction_on with
  | empty => simp [P]
  | cons e E ih =>
    simp only [Multiset.map_cons, P_cons, Prod.map_fst, Prod.map_snd]
    rw [← mul_assoc, transfer_d, mul_right_comm, ih]
    ring

omit [DecidableEq I] in
theorem prod_transfer (x : B) (s : Finset I) (f g : I → B) (h : ∀ v ∈ s, x * f v = x * g v) :
    x * ∏ v ∈ s, f v = x * ∏ v ∈ s, g v := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.prod_insert ha, ← mul_assoc, h a (Finset.mem_insert_self _ _),
      mul_right_comm, ih fun v hv => h v (Finset.mem_insert_of_mem hv)]
    ring

omit [DecidableEq I] in
/-- `y_r δ_S = y_r ∏_{v ∈ S} y_v`. -/
theorem y_prod_d (r : I) (S : Finset I) :
    yy D ι r * ∏ v ∈ S, d D ι r v = yy D ι r * ∏ v ∈ S, yy D ι v := by
  classical
  induction S using Finset.induction_on with
  | empty => simp
  | insert a S ha ih =>
    rw [Finset.prod_insert ha, Finset.prod_insert ha, ← mul_assoc, y_d, mul_right_comm, ih]
    ring

/-- `yᵢ δ_V = ∏_{v ∈ V} y_v` for `i, r ∈ V`. -/
theorem y_δ {V : Finset I} {i r : I} (hi : i ∈ V) (hr : r ∈ V) :
    yy D ι i * δ D ι V r = ∏ v ∈ V, yy D ι v := by
  have h1 : yy D ι i * δ D ι V r = yy D ι r * δ D ι V r := by
    by_cases hir : i = r
    · rw [hir]
    · unfold δ
      rw [← Finset.mul_prod_erase _ _ (Finset.mem_erase.2 ⟨hir, hi⟩)]
      have := transfer D ι r i D.y
      simp only [yy]
      rw [← mul_assoc, ← mul_assoc, mul_comm (ι i D.y), this, mul_comm (ι r D.y)]
  rw [h1, δ, y_prod_d, Finset.mul_prod_erase _ _ hr]

omit [DecidableEq I] in
theorem y_prod_eq_zero {V : Finset I} {i : I} (hi : i ∈ V) :
    yy D ι i * ∏ v ∈ V, yy D ι v = 0 := by
  classical
  rw [← Finset.mul_prod_erase _ _ hi, ← mul_assoc, yy_sq, zero_mul]

/-- One step of contraction for the small diagonal. -/
theorem d_δ {V : Finset I} {i j r : I} (hi : i ∈ V) (hj : j ∈ V) (hij : i ≠ j) :
    d D ι i j * δ D ι (V.erase j) (if r = j then i else r) = δ D ι V r := by
  unfold δ
  split_ifs with hrj
  · subst hrj
    rw [← Finset.mul_prod_erase (V.erase r) (fun v => d D ι r v)
      (Finset.mem_erase.2 ⟨hij, hi⟩), d_symm D ι i r]
    apply prod_transfer
    intro v hv
    rw [transfer_d D ι r i i v]
    have hvi : v ≠ i := (Finset.mem_erase.1 hv).1
    simp [ren, hvi]
  · have hjV : j ∈ V.erase r := Finset.mem_erase.2 ⟨Ne.symm hrj, hj⟩
    rw [← Finset.mul_prod_erase _ _ hjV, Finset.erase_right_comm]
    by_cases hri : r = i
    · subst hri; rfl
    · have hiV : i ∈ (V.erase r).erase j :=
        Finset.mem_erase.2 ⟨hij, Finset.mem_erase.2 ⟨Ne.symm hri, hi⟩⟩
      rw [← Finset.mul_prod_erase _ _ hiV]
      have := transfer_d D ι r i i j
      rw [show ren i r i = r by simp [ren], show ren i r j = j by simp [ren, hij.symm]] at this
      rw [← mul_assoc, mul_comm (d D ι i j), this]
      ring

omit [DecidableEq I] in
theorem eqvGen_zero {v w : I}
    (h : Relation.EqvGen (fun a b => (a, b) ∈ (0 : Multiset (I × I))) v w) :
    v = w := by
  induction h with
  | rel a b h => simp at h
  | refl => rfl
  | symm a b _ ih => exact ih.symm
  | trans a b c _ _ ih1 ih2 => exact ih1.trans ih2

omit [DecidableEq I] in
theorem eqvGen_loop {i : I} {E : Multiset (I × I)} {v w : I}
    (h : Relation.EqvGen (fun a b => (a, b) ∈ (i, i) ::ₘ E) v w) :
    Relation.EqvGen (fun a b => (a, b) ∈ E) v w := by
  induction h with
  | rel a b h =>
    rcases Multiset.mem_cons.1 h with h | h
    · simp only [Prod.mk.injEq] at h; rw [h.1, h.2]; exact .refl _
    · exact .rel _ _ h
  | refl => exact .refl _
  | symm a b _ ih => exact ih.symm
  | trans a b c _ _ ih1 ih2 => exact ih1.trans _ _ _ ih2

theorem eqvGen_contract {i j : I} {E : Multiset (I × I)} {v w : I}
    (h : Relation.EqvGen (fun a b => (a, b) ∈ (i, j) ::ₘ E) v w) :
    Relation.EqvGen (fun a b => (a, b) ∈ E.map (Prod.map (ren j i) (ren j i)))
      (ren j i v) (ren j i w) := by
  induction h with
  | rel a b h =>
    rcases Multiset.mem_cons.1 h with h | h
    · simp only [Prod.mk.injEq] at h
      rw [h.1, h.2]
      have : ren j i i = ren j i j := by unfold ren; split_ifs <;> simp_all
      rw [this]; exact .refl _
    · exact .rel _ _ (Multiset.mem_map.2 ⟨_, h, rfl⟩)
  | refl => exact .refl _
  | symm a b _ ih => exact ih.symm
  | trans a b c _ _ ih1 ih2 => exact ih1.trans _ _ _ ih2

theorem F_loop (c : ℕ) {V : Finset I} {i r : I} (hi : i ∈ V) (hr : r ∈ V) :
    D.χ • yy D ι i * F D ι c V r = F D ι (c + 1) V r := by
  rcases c with _ | _ | c
  · simp only [F, smul_mul_assoc, y_δ D ι hi hr]
  · simp only [F, smul_mul_assoc, mul_smul_comm, y_prod_eq_zero D ι hi, smul_zero]
  · simp [F]

theorem F_contract (c : ℕ) {V : Finset I} {i j r : I} (hi : i ∈ V) (hj : j ∈ V) (hij : i ≠ j) :
    d D ι i j * F D ι c (V.erase j) (if r = j then i else r) = F D ι c V r := by
  rcases c with _ | _ | c
  · exact d_δ D ι hi hj hij
  · simp only [F, mul_smul_comm]
    congr 1
    rw [← Finset.mul_prod_erase _ _ hj, ← Finset.mul_prod_erase _ _ (Finset.mem_erase.2 ⟨hij, hi⟩),
      ← mul_assoc, mul_comm (d D ι i j), y_d]
    ring
  · simp [F]

/-- **The multigraph rule.** For a multigraph `E` with edges in `V` connecting `V`, and any
root `r ∈ V`: `|V| ≤ |E| + 1`, and the product of the edge classes is `δ_V` for a tree,
`χ ∏ y_v` with one cycle, `0` with two or more. -/
theorem graph_rule (n : ℕ) : ∀ (E : Multiset (I × I)) (V : Finset I), Multiset.card E = n →
    (∀ e ∈ E, e.1 ∈ V ∧ e.2 ∈ V) → Conn E V → ∀ r ∈ V,
    V.card ≤ Multiset.card E + 1 ∧ P D ι E = F D ι (Multiset.card E + 1 - V.card) V r := by
  induction n with
  | zero =>
    intro E V hn hE hc r hr
    rw [Multiset.card_eq_zero] at hn
    subst hn
    have hV : V = {r} := by
      ext v
      simp only [Finset.mem_singleton]
      exact ⟨fun hv => eqvGen_zero (hc v hv r hr), fun h => h ▸ hr⟩
    subst hV
    simp [P, F, δ]
  | succ n ih =>
    intro E V hn hE hc r hr
    obtain ⟨⟨i, j⟩, E', rfl⟩ : ∃ e E', E = e ::ₘ E' := by
      obtain ⟨e, he⟩ := Multiset.card_pos_iff_exists_mem.1 (by omega : 0 < Multiset.card E)
      exact ⟨e, Multiset.exists_cons_of_mem he⟩
    rw [Multiset.card_cons] at hn ⊢
    have hiV := (hE _ (Multiset.mem_cons_self _ _)).1
    have hjV := (hE _ (Multiset.mem_cons_self _ _)).2
    have hE' : ∀ e ∈ E', e.1 ∈ V ∧ e.2 ∈ V := fun e he => hE e (Multiset.mem_cons_of_mem he)
    rw [P_cons]
    by_cases hij : i = j
    · subst hij
      have hc' : Conn E' V := fun v hv w hw => eqvGen_loop (hc v hv w hw)
      obtain ⟨h1, h2⟩ := ih E' V (by omega) hE' hc' r hr
      refine ⟨by omega, ?_⟩
      rw [h2, d_self, F_loop D ι _ hiV hr]
      congr 1; omega
    · set σ := ren j i
      have hσ : ∀ a ∈ V, σ a ∈ V.erase j := fun a ha => by
        simp only [σ, ren]; split_ifs with h
        · exact Finset.mem_erase.2 ⟨hij, hiV⟩
        · exact Finset.mem_erase.2 ⟨h, ha⟩
      have hσ' : ∀ a ∈ V.erase j, σ a = a := fun a ha => by
        simp [σ, ren, (Finset.mem_erase.1 ha).1]
      have hE'' : ∀ e ∈ E'.map (Prod.map σ σ), e.1 ∈ V.erase j ∧ e.2 ∈ V.erase j := by
        intro e he
        obtain ⟨e', he', rfl⟩ := Multiset.mem_map.1 he
        exact ⟨hσ _ (hE' e' he').1, hσ _ (hE' e' he').2⟩
      have hc'' : Conn (E'.map (Prod.map σ σ)) (V.erase j) := by
        intro v hv w hw
        have := eqvGen_contract (hc v (Finset.mem_of_mem_erase hv) w (Finset.mem_of_mem_erase hw))
        rwa [show ren j i v = v from hσ' v hv, show ren j i w = w from hσ' w hw] at this
      have hr' : (if r = j then i else r) ∈ V.erase j := by
        split_ifs with h
        · exact Finset.mem_erase.2 ⟨hij, hiV⟩
        · exact Finset.mem_erase.2 ⟨h, hr⟩
      obtain ⟨h1, h2⟩ := ih _ _ (by simpa using hn) hE'' hc'' _ hr'
      rw [Multiset.card_map, Finset.card_erase_of_mem hjV] at h1 h2
      have hV1 : 1 ≤ V.card := Finset.card_pos.2 ⟨r, hr⟩
      refine ⟨by omega, ?_⟩
      rw [transfer_P, h2, ← F_contract D ι _ hiV hjV hij]
      congr 2; omega

/-! ## Two partitions -/

end Classes

section Partitions

variable {k A : Type*} [CommRing k] [CommRing A] [Algebra k A] (D : DiagData k A)
  {B : Type*} [CommRing B] [Algebra k B] {I : Type*} (ι : I → A →ₐ[k] B)
  [LinearOrder I] [Fintype I]

/-- The star edges of a partition: each block joined to its least element. -/
noncomputable def edges (R : Finpartition (Finset.univ : Finset I)) : Multiset (I × I) :=
  ∑ p ∈ R.parts.attach, (p.1.erase (p.1.min' (R.nonempty_of_mem_parts p.2))).val.map
    fun v => (p.1.min' (R.nonempty_of_mem_parts p.2), v)

/-- `δ_R`: the product of the small diagonals of the blocks of `R`. -/
noncomputable def δR (R : Finpartition (Finset.univ : Finset I)) : B :=
  ∏ p ∈ R.parts.attach, δ D ι p.1 (p.1.min' (R.nonempty_of_mem_parts p.2))

theorem P_edges (R : Finpartition (Finset.univ : Finset I)) : P D ι (edges R) = δR D ι R := by
  rw [edges, P_sum]
  exact Finset.prod_congr rfl fun p _ => P_star D ι _ _

theorem card_edges (R : Finpartition (Finset.univ : Finset I)) :
    Multiset.card (edges R) + R.parts.card = Fintype.card I := by
  simp only [edges, Multiset.card_sum, Multiset.card_map, Finset.card_val]
  have h : ∀ p ∈ R.parts.attach,
      (p.1.erase (p.1.min' (R.nonempty_of_mem_parts p.2))).card = p.1.card - 1 :=
    fun p _ => Finset.card_erase_of_mem (Finset.min'_mem _ _)
  rw [Finset.sum_congr rfl h, ← Finset.card_attach (s := R.parts), Finset.card_eq_sum_ones,
    ← Finset.sum_add_distrib]
  have h2 : ∀ p ∈ R.parts.attach, p.1.card - 1 + 1 = p.1.card := fun p _ =>
    Nat.sub_add_cancel (Finset.card_pos.2 (R.nonempty_of_mem_parts p.2))
  rw [Finset.sum_congr rfl h2, Finset.sum_attach R.parts Finset.card, R.sum_card_parts,
    Finset.card_univ]

theorem eqvGen_of_block (R : Finpartition (Finset.univ : Finset I)) {E : Multiset (I × I)}
    (hE : edges R ≤ E) {p : Finset I} (hp : p ∈ R.parts) {a b : I} (ha : a ∈ p) (hb : b ∈ p) :
    Relation.EqvGen (fun a b => (a, b) ∈ E) a b := by
  have hm : ∀ c ∈ p, Relation.EqvGen (fun a b => (a, b) ∈ E)
      (p.min' (R.nonempty_of_mem_parts hp)) c := by
    intro c hc
    by_cases h : c = p.min' (R.nonempty_of_mem_parts hp)
    · rw [h]; exact .refl _
    · refine .rel _ _ (Multiset.mem_of_le hE ?_)
      simp only [edges, Multiset.mem_sum, Multiset.mem_map, Finset.mem_val]
      exact ⟨⟨p, hp⟩, Finset.mem_attach _ _, c, Finset.mem_erase.2 ⟨h, hc⟩, rfl⟩
  exact (hm a ha).symm.trans _ _ _ (hm b hb)

/-- `R` and `R'` have the coarse partition as their join. -/
def Joined (R R' : Finpartition (Finset.univ : Finset I)) : Prop :=
  ∀ v w, Relation.EqvGen (fun a b => (∃ p ∈ R.parts, a ∈ p ∧ b ∈ p) ∨
    ∃ p ∈ R'.parts, a ∈ p ∧ b ∈ p) v w

/-- **Page 56.** For two partitions `R`, `R'` of the `k` indices with coarse join and `s`, `s'`
blocks: `s + s' ≤ k + 1`, and `δ_R δ_{R'}` is the small diagonal if `s + s' = k + 1`,
`χ y₁⋯y_k` if `s + s' = k`, and `0` if `s + s' < k`. -/
theorem product_rule (R R' : Finpartition (Finset.univ : Finset I)) (h : Joined R R') (r : I) :
    R.parts.card + R'.parts.card ≤ Fintype.card I + 1 ∧
    δR D ι R * δR D ι R' =
      F D ι (Fintype.card I + 1 - R.parts.card - R'.parts.card) Finset.univ r := by
  have hc : Conn (edges R + edges R') Finset.univ := by
    intro v hv w hw
    clear hv hw
    induction h v w with
    | rel a b hab =>
      rcases hab with ⟨p, hp, ha, hb⟩ | ⟨p, hp, ha, hb⟩
      · exact eqvGen_of_block R (Multiset.le_add_right _ _) hp ha hb
      · exact eqvGen_of_block R' (Multiset.le_add_left _ _) hp ha hb
    | refl => exact .refl _
    | symm a b _ ih => exact ih.symm
    | trans a b c _ _ ih1 ih2 => exact ih1.trans _ _ _ ih2
  obtain ⟨h1, h2⟩ := graph_rule D ι _ _ _ rfl (fun _ _ => ⟨Finset.mem_univ _, Finset.mem_univ _⟩)
    hc r (Finset.mem_univ _)
  have e1 := card_edges R
  have e2 := card_edges R'
  rw [Multiset.card_add, Finset.card_univ] at h1 h2
  refine ⟨by omega, ?_⟩
  rw [← P_edges, ← P_edges]
  simp only [P, Multiset.map_add, Multiset.prod_add] at h2 ⊢
  rw [h2]; congr 1; omega

/-- With one block of points: `y_j δ_R δ_{R'}` is `y₁⋯y_k` if `s + s' = k + 1` and `0`
otherwise; with two, `y_j y_{j'} δ_R δ_{R'} = 0`. -/
theorem product_rule_pointed (R R' : Finpartition (Finset.univ : Finset I)) (h : Joined R R')
    (j j' : I) :
    yy D ι j * (δR D ι R * δR D ι R') =
      (if R.parts.card + R'.parts.card = Fintype.card I + 1 then ∏ v, yy D ι v else 0) ∧
    yy D ι j * yy D ι j' * (δR D ι R * δR D ι R') = 0 := by
  obtain ⟨h1, h2⟩ := product_rule D ι R R' h j
  have key : yy D ι j * (δR D ι R * δR D ι R') =
      (if R.parts.card + R'.parts.card = Fintype.card I + 1 then ∏ v, yy D ι v else 0) := by
    rw [h2]
    split_ifs with he
    · rw [show Fintype.card I + 1 - R.parts.card - R'.parts.card = 0 by omega]
      exact y_δ D ι (Finset.mem_univ _) (Finset.mem_univ _)
    · obtain ⟨c, hc⟩ : ∃ c, Fintype.card I + 1 - R.parts.card - R'.parts.card = c + 1 :=
        ⟨_, (Nat.succ_pred_eq_of_pos (by omega)).symm⟩
      rw [hc]
      rcases c with _ | c
      · simp only [F, mul_smul_comm, y_prod_eq_zero D ι (Finset.mem_univ j), smul_zero]
      · simp [F]
  refine ⟨key, ?_⟩
  rw [mul_comm (yy D ι j), mul_assoc, key]
  split_ifs
  · exact y_prod_eq_zero D ι (Finset.mem_univ _)
  · simp

end Partitions

/-! ## The tables of page 50 -/

section Tables

variable {k A : Type*} [CommRing k] [CommRing A] [Algebra k A] (D : DiagData k A)
  {B : Type*} [CommRing B] [Algebra k B]

/-- `T(X²)`: `y₁δ = y₂δ = y₁y₂` and `δ² = χ y₁y₂`. -/
theorem table_two (ι : Fin 2 → A →ₐ[k] B) :
    yy D ι 0 * d D ι 0 1 = yy D ι 0 * yy D ι 1 ∧
    yy D ι 1 * d D ι 0 1 = yy D ι 0 * yy D ι 1 ∧
    d D ι 0 1 * d D ι 0 1 = D.χ • (yy D ι 0 * yy D ι 1) := by
  refine ⟨y_d D ι 0 1, ?_, ?_⟩
  · rw [d_symm, y_d, mul_comm]
  · rw [transfer_d D ι 0 1 0 1, show ren (1 : Fin 2) 0 0 = 0 by decide,
      show ren (1 : Fin 2) 0 1 = 0 by decide, d_self, mul_comm, smul_mul_assoc, y_d]

/-- `T(X³)`, with `δ = δ₁₂δ₁₃` the small diagonal: `δ₁₂δ₂₃ = δ₁₂δ₁₃ = δ₂₃δ₁₃ = δ`,
`δ yᵢ = y₁y₂y₃`, `δ² = 0`, `δᵢⱼ δ = χ y₁y₂y₃`, `δᵢⱼ² = χ yᵢyⱼ`, `δᵢⱼ yᵢ = yᵢyⱼ`. -/
theorem table_three (ι : Fin 3 → A →ₐ[k] B) :
    let δ := d D ι 0 1 * d D ι 0 2
    d D ι 0 1 * d D ι 1 2 = δ ∧ d D ι 1 2 * d D ι 0 2 = δ ∧
    (∀ i, yy D ι i * δ = yy D ι 0 * yy D ι 1 * yy D ι 2) ∧ δ * δ = 0 ∧
    (∀ i j, i ≠ j → d D ι i j * δ = D.χ • (yy D ι 0 * yy D ι 1 * yy D ι 2)) ∧
    (∀ i j, d D ι i j * d D ι i j = D.χ • (yy D ι i * yy D ι j)) ∧
    (∀ i j, yy D ι i * d D ι i j = yy D ι i * yy D ι j) := by
  intro δ
  have sq : ∀ i j, d D ι i j * d D ι i j = D.χ • (yy D ι i * yy D ι j) := by
    intro i j
    rw [transfer_d D ι i j i j]
    by_cases hij : i = j
    · subst hij
      rw [show ren i i i = i by simp [ren], d_self, smul_mul_smul_comm, yy_sq]
      simp only [smul_zero]
    · rw [show ren j i i = i by simp [ren], show ren j i j = i by simp [ren], d_self, mul_comm,
        smul_mul_assoc, y_d]
  have h1 : d D ι 0 1 * d D ι 1 2 = δ := by
    rw [transfer_d D ι 0 1 1 2]; simp [ren, δ]
  have h2 : d D ι 1 2 * d D ι 0 2 = δ := by
    rw [mul_comm, transfer_d D ι 0 2 1 2]; simp [ren, δ, d_symm D ι 1 0, mul_comm]
  have hδ : δ = Folder11.δ D ι Finset.univ 0 := by
    simp only [Folder11.δ, δ]
    rw [show (Finset.univ : Finset (Fin 3)).erase 0 = {1, 2} by decide]
    simp
  have hy : ∀ i, yy D ι i * δ = yy D ι 0 * yy D ι 1 * yy D ι 2 := by
    intro i
    rw [hδ, y_δ D ι (Finset.mem_univ i) (Finset.mem_univ 0), Fin.prod_univ_three]
  refine ⟨h1, h2, hy, ?_, ?_, sq, fun i j => y_d D ι i j⟩
  · change d D ι 0 1 * d D ι 0 2 * (d D ι 0 1 * d D ι 0 2) = 0
    rw [mul_mul_mul_comm, sq, sq, smul_mul_smul_comm, mul_mul_mul_comm, yy_sq]
    simp
  · have h01 : d D ι 0 1 * δ = D.χ • (yy D ι 0 * yy D ι 1 * yy D ι 2) := by
      calc d D ι 0 1 * δ = (d D ι 0 1 * d D ι 0 1) * d D ι 0 2 := by simp only [δ]; ring
        _ = D.χ • (yy D ι 1 * (yy D ι 0 * d D ι 0 2)) := by
            rw [sq, smul_mul_assoc]; congr 1; ring
        _ = _ := by rw [y_d]; congr 1; ring
    have h02 : d D ι 0 2 * δ = D.χ • (yy D ι 0 * yy D ι 1 * yy D ι 2) := by
      calc d D ι 0 2 * δ = (d D ι 0 2 * d D ι 0 2) * d D ι 0 1 := by simp only [δ]; ring
        _ = D.χ • (yy D ι 2 * (yy D ι 0 * d D ι 0 1)) := by
            rw [sq, smul_mul_assoc]; congr 1; ring
        _ = _ := by rw [y_d]; congr 1; ring
    have h12 : d D ι 1 2 * δ = D.χ • (yy D ι 0 * yy D ι 1 * yy D ι 2) := by
      calc d D ι 1 2 * δ = (d D ι 0 1 * d D ι 1 2) * d D ι 0 2 := by simp only [δ]; ring
        _ = d D ι 0 2 * δ := by rw [h1]; simp only [δ]; ring
        _ = _ := h02
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all [d_symm D ι 1 0, d_symm D ι 2 0, d_symm D ι 2 1]

end Tables

/-! ## Projections: one more factor -/

section Projection

variable {k A : Type*} [CommRing k] [CommRing A] [Algebra k A] (D : DiagData k A)
  {B : Type*} [CommRing B] [Algebra k B] {I : Type*} (ι : I → A →ₐ[k] B)

/-- The family on `B ⊗ A`: the old factors and a new one, `∗`. -/
noncomputable def ext : Option I → A →ₐ[k] B ⊗[k] A
  | some i => includeLeft.comp (ι i)
  | none => includeRight

/-- The push-forward along the projection forgetting the new factor: `id ⊗ ∫`. -/
noncomputable def push : B ⊗[k] A →ₗ[k] B :=
  (TensorProduct.rid k B).toLinearMap ∘ₗ TensorProduct.map LinearMap.id D.tr

theorem push_tmul (x : B) (a : A) : push D (x ⊗ₜ a) = D.tr a • x := by
  simp [push]

/-- A class not involving the new factor is killed (`∫ 1 = 0`). -/
theorem push_old (x : B) : push D (includeLeft (R := k) (S := k) x : B ⊗[k] A) = 0 := by
  simp [push_tmul, D.tr_one]

/-- `p_*(x · y_∗) = x`. -/
theorem push_point (x : B) :
    push D ((includeLeft (R := k) (S := k) x : B ⊗[k] A) * yy D (ext ι) none) = x := by
  simp [yy, ext, push_tmul, D.tr_y]

theorem push_productMap (f : A →ₐ[k] B) (x : B) (z : A ⊗[k] A) :
    push D ((includeLeft (R := k) (S := k) x : B ⊗[k] A) *
      productMap (includeLeft.comp f) includeRight z) =
      x * f (TensorProduct.rid k A (TensorProduct.map LinearMap.id D.tr z)) := by
  induction z using TensorProduct.inductionOn with
  | tmul a b => simp [push_tmul, mul_comm]
  | add z w hz hw => simp only [map_add, mul_add, hz, hw]

/-- `p_*(x · δ_{i∗}) = x`: the new index leaves its diagonal block. -/
theorem push_diag (x : B) (i : I) :
    push D ((includeLeft (R := k) (S := k) x : B ⊗[k] A) * d D (ext ι) (some i) none) = x := by
  rw [d, ext, ext, push_productMap, D.slice, map_one, mul_one]

/-- The pull-back sends diagonals to diagonals and point classes to point classes. -/
theorem pull_d (i j : I) :
    (includeLeft (R := k) (S := k) (d D ι i j) : B ⊗[k] A) = d D (ext ι) (some i) (some j) ∧
    (includeLeft (R := k) (S := k) (yy D ι i) : B ⊗[k] A) = yy D (ext ι) (some i) := by
  refine ⟨?_, rfl⟩
  simp only [d, ext]
  induction D.Δ using TensorProduct.inductionOn with
  | tmul a b => simp
  | add z w hz hw => simp only [map_add, hz, hw]

end Projection

end Folder11

/-!
# Folder 11 (pages 37 and 41): simplicial bivariant algebras and Poincaré algebras

Finding `11-simplicial-bivariant-poincare-equivalence` of `src/content/findings.ts`. Page 37
asserts, and page 41 repeats « à vérifier », that evaluation at a one-element set is an
equivalence between the simplicial bivariant algebras whose value at a point is a Poincaré
algebra and the Poincaré algebras. The edition restricts it to special objects; here it is
proved in that form, in the commutative case (no grading, no Koszul signs), over a field `k`.

* `GHom`: the morphisms of the category `𝒞` of page 33, pairs `(f_*, f^*)` with the
  projection formula and `κ_B f_* = κ_A`.
* `SFun`: a contravariant functor from finite non-empty sets and all maps (skeleton
  `Fin (n + 1)`) to `𝒞`; `NatT`: natural transformations of such functors.
* `Special`: `A(pt)` is Poincaré (finite-dimensional, `κ(xy)` non-degenerate), the Künneth
  maps `A(I) ⊗ A(pt) → A(I ⊔ pt)` are isomorphisms and the gauges are multiplicative.
* `adj`, `adj_unique`: into a Poincaré algebra, the push-forward is the adjoint of the
  pull-back (page 33); `poincare_tensor`: `B ⊗ C` is Poincaré; `Special.poincare_all`: so is
  every `A(I)`; `Special.gen`: `A(I)` is generated by the pull-backs along points.
* `faithful`, `full`: evaluation at a point is fully faithful as soon as the target is
  special (the source need not be).
* `powFun`, `essSurj`: `I ↦ P^{⊗ I}`, with pull-backs multiplying along fibres, is special
  and has value `P` at a point.
* `evaluation_equivalence`: the three together.
-/

namespace Folder11.Simplicial

open TensorProduct

universe u

variable {k : Type u} [Field k]

/-- A Poincaré algebra: finite-dimensional, with `(x, y) ↦ κ(xy)` non-degenerate. -/
def IsPoincare (A : Type*) [CommRing A] [Algebra k A] (κ : A →ₗ[k] k) : Prop :=
  FiniteDimensional k A ∧ ∀ x : A, (∀ y, κ (y * x) = 0) → x = 0

section Adjoint

variable {D E : Type*} [CommRing D] [Algebra k D] [CommRing E] [Algebra k E]
  {κD : D →ₗ[k] k}

theorem eq_of_pairing (hD : IsPoincare D κD) {x x' : D} (h : ∀ y, κD (y * x) = κD (y * x')) :
    x = x' :=
  sub_eq_zero.1 (hD.2 _ fun y => by rw [mul_sub, map_sub, h, sub_self])

/-- The bilinear form `κ(xy)`. -/
def form (κD : D →ₗ[k] k) : LinearMap.BilinForm k D := (LinearMap.mul k D).compr₂ κD

theorem form_nondeg (hD : IsPoincare D κD) : (form κD).Nondegenerate :=
  ⟨fun x hx => hD.2 x fun y => by rw [mul_comm]; exact hx y, fun x hx => hD.2 x hx⟩

/-- The push-forward adjoint to an algebra map `h : D → E` into a Poincaré algebra `D`:
`κ_D(y · h_*(x)) = κ_E(h(y) · x)` (page 33). -/
noncomputable def adj (hD : IsPoincare D κD) (κE : E →ₗ[k] k) (h : D →ₐ[k] E) : E →ₗ[k] D :=
  haveI := hD.1
  ((form κD).toDual (form_nondeg hD)).symm.toLinearMap ∘ₗ
    LinearMap.mk₂ k (fun x y => κE (h y * x)) (by intros; simp [mul_add])
      (by intros; simp) (by intros; simp [add_mul])
      (by intros; simp)

theorem adj_spec (hD : IsPoincare D κD) (κE : E →ₗ[k] k) (h : D →ₐ[k] E) (x : E) (y : D) :
    κD (y * adj hD κE h x) = κE (h y * x) := by
  have := hD.1
  rw [mul_comm]
  exact LinearMap.BilinForm.apply_toDual_symm_apply (B := form κD) (hB := form_nondeg hD) _ y

theorem adj_unique (hD : IsPoincare D κD) (κE : E →ₗ[k] k) (h : D →ₐ[k] E) (f : E →ₗ[k] D)
    (hf : ∀ x y, κD (y * f x) = κE (h y * x)) : f = adj hD κE h :=
  LinearMap.ext fun x => eq_of_pairing hD fun y => by rw [hf, adj_spec]

/-- The projection formula `h_*(h(y) x) = y h_*(x)`. -/
theorem adj_proj (hD : IsPoincare D κD) (κE : E →ₗ[k] k) (h : D →ₐ[k] E) (y : D) (x : E) :
    adj hD κE h (h y * x) = y * adj hD κE h x :=
  eq_of_pairing hD fun z => by rw [adj_spec, ← mul_assoc, ← map_mul, ← mul_assoc, adj_spec]

/-- `κ_D ∘ h_* = κ_E`. -/
theorem adj_gauge (hD : IsPoincare D κD) (κE : E →ₗ[k] k) (h : D →ₐ[k] E) (x : E) :
    κD (adj hD κE h x) = κE x := by
  simpa using adj_spec hD κE h x 1

/-- Any pair satisfying the projection formula and preserving gauges is adjoint. -/
theorem pair_spec {κE : E →ₗ[k] k} {push : E →ₗ[k] D} {pull : D →ₐ[k] E}
    (proj : ∀ y x, push (pull y * x) = y * push x) (gauge : ∀ x, κD (push x) = κE x)
    (x : E) (y : D) : κD (y * push x) = κE (pull y * x) := by
  rw [← proj, gauge]

end Adjoint

section Transfer

variable {B C D : Type*} [CommRing B] [Algebra k B] [CommRing C] [Algebra k C]
  [CommRing D] [Algebra k D] {κB : B →ₗ[k] k} {κC : C →ₗ[k] k} {κD : D →ₗ[k] k}

/-- The product gauge on `B ⊗ C`. -/
noncomputable def tgauge (κB : B →ₗ[k] k) (κC : C →ₗ[k] k) : B ⊗[k] C →ₗ[k] k :=
  (TensorProduct.lid k k).toLinearMap ∘ₗ TensorProduct.map κB κC

theorem tgauge_tmul (b : B) (c : C) : tgauge κB κC (b ⊗ₜ c) = κB b * κC c := by
  simp [tgauge]

/-- The tensor product of two Poincaré algebras is Poincaré. -/
theorem poincare_tensor (hB : IsPoincare B κB) (hC : IsPoincare C κC) :
    IsPoincare (B ⊗[k] C) (tgauge κB κC) := by
  have := hB.1
  have := hC.1
  refine ⟨inferInstance, fun x hx => ?_⟩
  set eB := (form κB).toDual (form_nondeg hB)
  set eC := (form κC).toDual (form_nondeg hC)
  have key : (form (tgauge κB κC) : B ⊗[k] C →ₗ[k] Module.Dual k (B ⊗[k] C)) =
      (dualDistribEquiv k B C).toLinearMap ∘ₗ (TensorProduct.congr eB eC).toLinearMap := by
    refine TensorProduct.ext' fun b c => TensorProduct.ext' fun b' c' => ?_
    simp [form, eB, eC, tgauge_tmul, LinearMap.BilinForm.toDual_def]
  have h0 : form (tgauge κB κC) x = 0 := LinearMap.ext fun y => by
    simp only [form, LinearMap.compr₂_apply, LinearMap.mul_apply', LinearMap.zero_apply]
    rw [mul_comm]; exact hx y
  rw [key] at h0
  exact ((TensorProduct.congr eB eC).trans (dualDistribEquiv k B C)).injective
    (h0.trans (map_zero _).symm)

/-- Poincaré duality is carried along a gauge-preserving algebra isomorphism. -/
theorem poincare_transfer (hB : IsPoincare B κB) (e : B →ₐ[k] D) (he : Function.Bijective e)
    (hκ : ∀ x, κD (e x) = κB x) : IsPoincare D κD := by
  have := hB.1
  let L := LinearEquiv.ofBijective e.toLinearMap he
  refine ⟨L.finiteDimensional, fun x hx => ?_⟩
  obtain ⟨z, rfl⟩ := he.2 x
  rw [hB.2 z fun y => by rw [← hκ, map_mul]; exact hx _, map_zero]

end Transfer

/-! ## Simplicial bivariant algebras

The category of finite non-empty sets is replaced by its skeleton: the object `n` stands for
`Fin (n + 1)`. -/

/-- A contravariant functor from finite non-empty sets (all maps) to gauged commutative
`k`-algebras with morphisms `(f_*, f^*)` (page 33): for `α : I → J`, the pull-back
`A(I) → A(J)` is an algebra map, the push-forward `A(J) → A(I)` satisfies the projection
formula and preserves the gauges. -/
structure SFun (k : Type u) [Field k] where
  obj : ℕ → Type u
  [ring : ∀ n, CommRing (obj n)]
  [alg : ∀ n, Algebra k (obj n)]
  κ : ∀ n, obj n →ₗ[k] k
  pull : ∀ {m n : ℕ}, (Fin (m + 1) → Fin (n + 1)) → obj m →ₐ[k] obj n
  push : ∀ {m n : ℕ}, (Fin (m + 1) → Fin (n + 1)) → obj n →ₗ[k] obj m
  pull_id : ∀ n, pull (id : Fin (n + 1) → Fin (n + 1)) = AlgHom.id k (obj n)
  pull_comp : ∀ {l m n : ℕ} (α : Fin (l + 1) → Fin (m + 1)) (β : Fin (m + 1) → Fin (n + 1)),
    pull (β ∘ α) = (pull β).comp (pull α)
  push_id : ∀ n, push (id : Fin (n + 1) → Fin (n + 1)) = LinearMap.id
  push_comp : ∀ {l m n : ℕ} (α : Fin (l + 1) → Fin (m + 1)) (β : Fin (m + 1) → Fin (n + 1)),
    push (β ∘ α) = push α ∘ₗ push β
  proj : ∀ {m n : ℕ} (α : Fin (m + 1) → Fin (n + 1)) (y : obj m) (x : obj n),
    push α (pull α y * x) = y * push α x
  gauge : ∀ {m n : ℕ} (α : Fin (m + 1) → Fin (n + 1)) (x : obj n), κ m (push α x) = κ n x

attribute [instance] SFun.ring SFun.alg

namespace SFun

variable (A : SFun k)

/-- The Künneth map `A(I) ⊗ A(pt) → A(I ⊔ pt)` given by the two pull-backs. -/
noncomputable def kun (n : ℕ) : A.obj n ⊗[k] A.obj 0 →ₐ[k] A.obj (n + 1) :=
  Algebra.TensorProduct.productMap (A.pull (Fin.castSucc : Fin (n + 1) → Fin (n + 2)))
    (A.pull (m := 0) fun _ => Fin.last (n + 1))

/-- The point of `I` at `i`, as a map `pt → I`. -/
abbrev pt {n : ℕ} (i : Fin (n + 1)) : Fin (0 + 1) → Fin (n + 1) := fun _ => i

theorem pull_pt_zero : A.pull (pt (0 : Fin 1)) = AlgHom.id k (A.obj 0) := by
  have : (pt (0 : Fin 1)) = id := funext fun i => Subsingleton.elim (α := Fin 1) _ _
  rw [this, A.pull_id]

theorem pull_comp_pt {m n : ℕ} (α : Fin (m + 1) → Fin (n + 1)) (i : Fin (m + 1)) :
    (A.pull α).comp (A.pull (pt i)) = A.pull (pt (α i)) :=
  (A.pull_comp (pt i) α).symm

end SFun

/-- A special simplicial algebra (pages 37 and 41, with the edition's precisions): `A(pt)` is
Poincaré, the Künneth maps `A(I) ⊗ A(pt) → A(I ⊔ pt)` are isomorphisms and the gauges are
multiplicative. -/
structure Special (A : SFun k) : Prop where
  poincare : IsPoincare (A.obj 0) (A.κ 0)
  kunneth : ∀ n, Function.Bijective (A.kun n)
  gauge_mul : ∀ n a b, A.κ (n + 1) (A.kun n (a ⊗ₜ b)) = A.κ n a * A.κ 0 b

namespace Special

variable {A : SFun k} (hA : Special A)
include hA

/-- Every `A(I)` of a special object is a Poincaré algebra. -/
theorem poincare_all : ∀ n, IsPoincare (A.obj n) (A.κ n)
  | 0 => hA.poincare
  | n + 1 => by
    refine poincare_transfer (poincare_tensor (poincare_all n) hA.poincare) (A.kun n)
      (hA.kunneth n) fun x => ?_
    have : A.κ (n + 1) ∘ₗ (A.kun n).toLinearMap = tgauge (A.κ n) (A.κ 0) :=
      TensorProduct.ext' fun a b => by simp [hA.gauge_mul, tgauge_tmul]
    exact LinearMap.congr_fun this x

/-- `A(I)` is generated by the pull-backs of `A(pt)` along the points of `I`. -/
theorem gen {C : Type*} [Semiring C] [Algebra k C] :
    ∀ (n : ℕ) (f g : A.obj n →ₐ[k] C),
      (∀ i, f.comp (A.pull (SFun.pt i)) = g.comp (A.pull (SFun.pt i))) → f = g
  | 0, f, g, h => by simpa [A.pull_pt_zero] using h 0
  | n + 1, f, g, h => by
    have hc : f.comp (A.kun n) = g.comp (A.kun n) := by
      refine Algebra.TensorProduct.ext ?_ ?_
      · have := gen n (f.comp (A.pull Fin.castSucc)) (g.comp (A.pull Fin.castSucc)) fun i => by
          rw [AlgHom.comp_assoc, AlgHom.comp_assoc, A.pull_comp_pt]; exact h _
        simpa [SFun.kun, AlgHom.comp_assoc] using this
      · ext b
        simpa [SFun.kun] using congr($(h (Fin.last (n + 1))) b)
    ext x
    obtain ⟨z, rfl⟩ := (hA.kunneth n).2 x
    exact AlgHom.congr_fun hc z

end Special

/-- A morphism of `𝒞` between two gauged algebras (page 33): an algebra map `f^*` backwards and
an additive `f_*` forwards, with the projection formula and `κ_B f_* = κ_A`. -/
structure GHom (A B : Type*) [CommRing A] [Algebra k A] [CommRing B] [Algebra k B]
    (κA : A →ₗ[k] k) (κB : B →ₗ[k] k) where
  push : A →ₗ[k] B
  pull : B →ₐ[k] A
  proj : ∀ y x, push (pull y * x) = y * push x
  gauge : ∀ x, κB (push x) = κA x

/-- A natural transformation `A → B` of simplicial bivariant algebras: a morphism of `𝒞` at each
`I`, natural for pull-backs and push-forwards. -/
structure NatT (A B : SFun k) where
  push : ∀ n, A.obj n →ₗ[k] B.obj n
  pull : ∀ n, B.obj n →ₐ[k] A.obj n
  proj : ∀ n y x, push n (pull n y * x) = y * push n x
  gauge : ∀ n x, B.κ n (push n x) = A.κ n x
  nat_pull : ∀ {m n : ℕ} (α : Fin (m + 1) → Fin (n + 1)),
    (pull n).comp (B.pull α) = (A.pull α).comp (pull m)
  nat_push : ∀ {m n : ℕ} (α : Fin (m + 1) → Fin (n + 1)),
    B.push α ∘ₗ push n = push m ∘ₗ A.push α

/-- **Faithfulness.** If `B` is special, a natural transformation `A → B` is determined by
its pull-back at a point. -/
theorem faithful {A B : SFun k} (hB : Special B) (φ ψ : NatT A B) (h : φ.pull 0 = ψ.pull 0)
    (n : ℕ) : φ.pull n = ψ.pull n ∧ φ.push n = ψ.push n := by
  have hp : φ.pull n = ψ.pull n := hB.gen n _ _ fun i => by
    rw [φ.nat_pull, ψ.nat_pull, h]
  refine ⟨hp, ?_⟩
  rw [adj_unique (hB.poincare_all n) _ _ (φ.push n) (pair_spec (φ.proj n) (φ.gauge n)),
    adj_unique (hB.poincare_all n) _ _ (ψ.push n) (pair_spec (ψ.proj n) (ψ.gauge n)), hp]

/-- The pull-backs of a morphism at a point extend to every `I`, naturally on points. -/
theorem extend {A B : SFun k} (hB : Special B) (g : B.obj 0 →ₐ[k] A.obj 0) :
    ∀ n, ∃ h : B.obj n →ₐ[k] A.obj n,
      ∀ i, h.comp (B.pull (SFun.pt i)) = (A.pull (SFun.pt i)).comp g
  | 0 => ⟨g, fun i => by
      rw [Subsingleton.elim (α := Fin 1) i 0, A.pull_pt_zero, B.pull_pt_zero]; rfl⟩
  | n + 1 => by
    obtain ⟨h, hh⟩ := extend hB g n
    let e := AlgEquiv.ofBijective (B.kun n) (hB.kunneth n)
    refine ⟨(A.kun n).comp ((Algebra.TensorProduct.map h g).comp e.symm.toAlgHom),
      fun i => ?_⟩
    have he : ∀ z, e.symm (B.kun n z) = z := fun z => e.symm_apply_apply z
    refine Fin.lastCases ?_ (fun j => ?_) i
    · ext x
      have := he (1 ⊗ₜ x)
      simp only [SFun.kun, Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul] at this
      simp [this, SFun.kun]
    · ext x
      have h1 : B.pull (SFun.pt (Fin.castSucc j)) = (B.pull Fin.castSucc).comp (B.pull (SFun.pt j)) :=
        B.pull_comp _ _
      have h2 : A.pull (SFun.pt (Fin.castSucc j)) = (A.pull Fin.castSucc).comp (A.pull (SFun.pt j)) :=
        A.pull_comp _ _
      have := he (B.pull (SFun.pt j) x ⊗ₜ 1)
      simp only [SFun.kun, Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one] at this
      have hx := congr($(hh j) x)
      simp only [AlgHom.comp_apply] at hx
      simp [h1, h2, this, SFun.kun, hx]

/-- **Fullness.** If `B` is special, every morphism `A(pt) → B(pt)` of `𝒞` is the value at a
point of a natural transformation `A → B`. -/
theorem full {A B : SFun k} (hB : Special B) (g : GHom (A.obj 0) (B.obj 0) (A.κ 0) (B.κ 0)) :
    ∃ φ : NatT A B, φ.pull 0 = g.pull ∧ φ.push 0 = g.push := by
  choose h hh using extend hB g.pull
  have hP := hB.poincare_all
  have nat : ∀ {m n : ℕ} (α : Fin (m + 1) → Fin (n + 1)),
      (h n).comp (B.pull α) = (A.pull α).comp (h m) := fun α => hB.gen _ _ _ fun j => by
    rw [AlgHom.comp_assoc, B.pull_comp_pt, hh, AlgHom.comp_assoc, hh, ← AlgHom.comp_assoc,
      A.pull_comp_pt]
  have h0 : h 0 = g.pull := by simpa [A.pull_pt_zero, B.pull_pt_zero] using hh 0 0
  refine ⟨{ push := fun n => adj (hP n) (A.κ n) (h n),
             pull := h,
             proj := fun n => adj_proj (hP n) _ _,
             gauge := fun n => adj_gauge (hP n) _ _,
             nat_pull := nat,
             nat_push := fun {m n} α => LinearMap.ext fun x => eq_of_pairing (hP m) fun y => ?_ },
    h0, ?_⟩
  · simp only [LinearMap.comp_apply]
    rw [pair_spec (B.proj α) (B.gauge α), adj_spec, adj_spec,
      pair_spec (A.proj α) (A.gauge α), ← AlgHom.comp_apply, nat, AlgHom.comp_apply]
  · simp only
    rw [adj_unique (hP 0) _ _ g.push (pair_spec g.proj g.gauge), h0]

/-! ## The inverse: tensor powers of a Poincaré algebra -/

section Powers

open PiTensorProduct

variable {P : Type u} [CommRing P] [Algebra k P] (κ : P →ₗ[k] k)

variable (k P) in
/-- `P^{⊗ I}` for `I = Fin (n + 1)`. -/
abbrev Pow (n : ℕ) := ⨂[k] _ : Fin (n + 1), P

instance subsingleton_fin_zero_add_one : Subsingleton (Fin (0 + 1)) := inferInstanceAs (Subsingleton (Fin 1))

/-- The factor at `i`: `a ↦ 1 ⊗ ⋯ ⊗ a ⊗ ⋯ ⊗ 1`. -/
noncomputable def single {n : ℕ} (i : Fin (n + 1)) : P →ₐ[k] Pow k P n :=
  singleAlgHom (R := k) (A := fun _ => P) i

/-- Pull-back along `α : I → J`: `⊗ xᵢ ↦ ∏ᵢ x_i` placed at `α(i)`, multiplication along the
fibres of `α` and `1` off its image. -/
noncomputable def powPull {m n : ℕ} (α : Fin (m + 1) → Fin (n + 1)) : Pow k P m →ₐ[k] Pow k P n :=
  liftAlgHom ((MultilinearMap.mkPiAlgebra k (Fin (m + 1)) (Pow k P n)).compLinearMap
      fun i => (single (α i)).toLinearMap)
    (by simp) (fun x y => by simp [Finset.prod_mul_distrib])

theorem powPull_tprod {m n : ℕ} (α : Fin (m + 1) → Fin (n + 1)) (x : Fin (m + 1) → P) :
    powPull α (tprod k x) = ∏ i, single (α i) (x i) := by
  change PiTensorProduct.lift _ (tprod k x) = _
  rw [lift.tprod]
  simp

theorem powPull_single {m n : ℕ} (α : Fin (m + 1) → Fin (n + 1)) (i : Fin (m + 1)) :
    (powPull α).comp (single i) = single (k := k) (P := P) (α i) := by
  ext a
  rw [AlgHom.comp_apply, single, singleAlgHom_apply, MonoidHom.mulSingle_apply, powPull_tprod,
    Finset.prod_eq_single i (fun l _ hl => by rw [Pi.mulSingle_eq_of_ne hl, map_one])
      (by simp), Pi.mulSingle_eq_same]

theorem powPull_id (n : ℕ) : powPull (k := k) (P := P) (id : Fin (n + 1) → Fin (n + 1)) = AlgHom.id k _ :=
  algHom_ext fun i => powPull_single _ i

theorem powPull_comp {l m n : ℕ} (α : Fin (l + 1) → Fin (m + 1)) (β : Fin (m + 1) → Fin (n + 1)) :
    powPull (k := k) (P := P) (β ∘ α) = (powPull β).comp (powPull α) :=
  algHom_ext fun i => by
    rw [AlgHom.comp_assoc]
    erw [powPull_single, powPull_single, powPull_single]
    rfl

/-- The product gauge `κ(⊗ xᵢ) = ∏ κ(xᵢ)`. -/
noncomputable def powGauge (n : ℕ) : Pow k P n →ₗ[k] k :=
  lift ((MultilinearMap.mkPiAlgebra k (Fin (n + 1)) k).compLinearMap fun _ => κ)

theorem powGauge_tprod {n : ℕ} (x : Fin (n + 1) → P) : powGauge κ n (tprod k x) = ∏ i, κ (x i) := by
  simp [powGauge]

theorem prod_single {n : ℕ} (z : Fin (n + 1) → P) : ∏ j, single j (z j) = tprod k z := by
  simp only [single, singleAlgHom_apply, MonoidHom.mulSingle_apply]
  rw [← tprod_prod, Finset.univ_prod_mulSingle]

theorem tensor_ext {M : Type*} [AddCommGroup M] [Module k M] {m n : ℕ}
    {f g : Pow k P m ⊗[k] Pow k P n →ₗ[k] M}
    (h : ∀ x y, f (tprod k x ⊗ₜ tprod k y) = g (tprod k x ⊗ₜ tprod k y)) : f = g :=
  TensorProduct.ext (PiTensorProduct.ext (MultilinearMap.ext fun x =>
    PiTensorProduct.ext (MultilinearMap.ext fun y => h x y)))

/-- The Künneth map of the tensor powers. -/
noncomputable def kunT (n : ℕ) : Pow k P n ⊗[k] Pow k P 0 →ₐ[k] Pow k P (n + 1) :=
  Algebra.TensorProduct.productMap (powPull (Fin.castSucc : Fin (n + 1) → Fin (n + 2)))
    (powPull (m := 0) fun _ => Fin.last (n + 1))

theorem kunT_tprod (n : ℕ) (x : Fin (n + 1) → P) (y : Fin (0 + 1) → P) :
    kunT (k := k) (P := P) n (tprod k x ⊗ₜ tprod k y) = tprod k (Fin.snoc x (y 0) : Fin (n + 2) → P) := by
  rw [kunT, Algebra.TensorProduct.productMap_apply_tmul, powPull_tprod, powPull_tprod,
    ← prod_single, Fin.prod_univ_castSucc (n := n + 1)]
  simp [Fin.snoc_castSucc, Fin.snoc_last]

theorem kunT_bijective (n : ℕ) : Function.Bijective (kunT (k := k) (P := P) n) := by
  let L : Pow k P n ⊗[k] Pow k P 0 ≃ₗ[k] Pow k P (n + 1) :=
    (tmulEquiv k P).trans (reindex k (fun _ => P) (finSumFinEquiv (m := n + 1) (n := 1)))
  have : (kunT (k := k) (P := P) n).toLinearMap = L.toLinearMap := tensor_ext fun x y => by
    simp only [AlgHom.toLinearMap_apply, kunT_tprod, LinearEquiv.coe_coe, L,
      LinearEquiv.trans_apply, tmulEquiv_apply, reindex_tprod]
    congr 1
    funext j
    refine Fin.lastCases ?_ (fun i => ?_) j
    · simp [finSumFinEquiv_symm_last]
    · simp [finSumFinEquiv_symm_apply_castSucc]
  exact (congrArg DFunLike.coe this : (kunT (k := k) (P := P) n : _ → _) = L) ▸ L.bijective

theorem kunT_gauge (n : ℕ) (z : Pow k P n ⊗[k] Pow k P 0) :
    powGauge κ (n + 1) (kunT (k := k) (P := P) n z) = tgauge (powGauge κ n) (powGauge κ 0) z := by
  have : powGauge κ (n + 1) ∘ₗ (kunT (k := k) (P := P) n).toLinearMap =
      tgauge (powGauge κ n) (powGauge κ 0) := tensor_ext fun x y => by
    simp [kunT_tprod, tgauge_tmul, powGauge_tprod, Fin.prod_univ_castSucc]
  exact LinearMap.congr_fun this z

theorem single_zero_bijective : Function.Bijective (single (k := k) (P := P) (0 : Fin (0 + 1))) := by
  have hl : ∀ a : P, subsingletonEquiv (R := k) (s := fun _ => P) 0 (single (k := k) (n := 0) 0 a) = a := fun a => by
    simp [single]
  refine ⟨fun a b hab => by rw [← hl a, ← hl b, hab], fun z =>
    ⟨subsingletonEquiv (R := k) (s := fun _ => P) 0 z,
      (subsingletonEquiv (R := k) (s := fun _ => P) 0).injective (hl _)⟩⟩

theorem single_zero_gauge (a : P) : powGauge κ 0 (single 0 a) = κ a := by
  simp [single, powGauge_tprod]

variable {κ}

/-- Every tensor power of a Poincaré algebra is Poincaré, with the product gauge. -/
theorem powPoincare (hP : IsPoincare P κ) : ∀ n, IsPoincare (Pow k P n) (powGauge κ n)
  | 0 => poincare_transfer hP (single 0) single_zero_bijective (single_zero_gauge κ)
  | n + 1 => poincare_transfer (poincare_tensor (powPoincare hP n) (powPoincare hP 0)) (kunT n)
      (kunT_bijective n) (kunT_gauge κ n)

/-- The special simplicial algebra `I ↦ P^{⊗ I}`, push-forwards adjoint to pull-backs. -/
noncomputable def powFun (hP : IsPoincare P κ) : SFun k where
  obj n := Pow k P n
  κ n := powGauge κ n
  pull α := powPull α
  push {m n} α := adj (powPoincare hP m) (powGauge κ n) (powPull α)
  pull_id n := powPull_id n
  pull_comp α β := powPull_comp α β
  push_id n := (adj_unique _ _ _ LinearMap.id fun x y => by rw [powPull_id]; rfl).symm
  push_comp {l m n} α β := (adj_unique _ _ _ _ fun x y => by
    rw [LinearMap.comp_apply, adj_spec, adj_spec, powPull_comp, AlgHom.comp_apply]).symm
  proj α := adj_proj _ _ _
  gauge α := adj_gauge _ _ _

theorem powFun_special (hP : IsPoincare P κ) : Special (powFun hP) where
  poincare := powPoincare hP 0
  kunneth n := kunT_bijective n
  gauge_mul n a b := by
    rw [show (powFun hP).kun n = kunT n from rfl]
    exact (kunT_gauge κ n _).trans (tgauge_tmul _ _)

/-- **Essential surjectivity.** Every Poincaré algebra is, up to a gauge-preserving algebra
isomorphism, the value at a point of a special simplicial bivariant algebra. -/
theorem essSurj (hP : IsPoincare P κ) :
    ∃ (A : SFun k) (_ : Special A) (e : P ≃ₐ[k] A.obj 0), ∀ x, A.κ 0 (e x) = κ x :=
  ⟨powFun hP, powFun_special hP, AlgEquiv.ofBijective (single 0) single_zero_bijective,
    single_zero_gauge κ⟩

end Powers

/-- A gauge-preserving algebra isomorphism is an isomorphism of `𝒞`, with `f_* = e` and
`f^* = e⁻¹` (a « good » isomorphism of page 33). -/
noncomputable def GHom.ofEquiv {A B : Type*} [CommRing A] [Algebra k A] [CommRing B] [Algebra k B]
    {κA : A →ₗ[k] k} {κB : B →ₗ[k] k} (e : A ≃ₐ[k] B) (h : ∀ x, κB (e x) = κA x) :
    GHom A B κA κB where
  push := e.toLinearMap
  pull := e.symm.toAlgHom
  proj y x := by simp
  gauge := h

/-- **Pages 37 and 41, in the edition's precise form (commutative case).** Evaluation at a
point, from special simplicial bivariant algebras to Poincaré algebras, is faithful, full and
essentially surjective, hence an equivalence. -/
theorem evaluation_equivalence :
    (∀ {A B : SFun k}, Special B → ∀ φ ψ : NatT A B, φ.pull 0 = ψ.pull 0 →
      ∀ n, φ.pull n = ψ.pull n ∧ φ.push n = ψ.push n) ∧
    (∀ {A B : SFun k}, Special B → ∀ g : GHom (A.obj 0) (B.obj 0) (A.κ 0) (B.κ 0),
      ∃ φ : NatT A B, φ.pull 0 = g.pull ∧ φ.push 0 = g.push) ∧
    (∀ (P : Type u) [CommRing P] [Algebra k P] (κ : P →ₗ[k] k), IsPoincare P κ →
      ∃ (A : SFun k) (_ : Special A) (e : P ≃ₐ[k] A.obj 0), ∀ x, A.κ 0 (e x) = κ x) :=
  ⟨fun hB φ ψ h n => faithful hB φ ψ h n, fun hB g => full hB g, fun _ _ _ _ hP => essSurj hP⟩

end Folder11.Simplicial
