import Mathlib

/-!
# Folder 155: the Takeuchi product as an idealiser quotient (page 1)

Finding `155-takeuchi-idealiser` (`src/content/findings.ts`), on the reading
`transcripts/155/155.modern.tex`. Page 1, condition (ii): the comultiplication of
`A` is first written into `A ⊗̂_{k′} A`, then said to take its values in
`𝒥̃/𝒥`, where `J = Ker(k′ ⊗_k k′ → k′)`, `𝒥 = J · (A ⊗̂_k A)` and
`𝒥̃ = {λ | λ𝒥 ⊂ 𝒥}`, and to be a ring homomorphism `A → 𝒥̃/𝒥`.

**Partial: the uncompleted version**, for `K` a commutative `k`-algebra and
`ι : K → A` a `k`-algebra map into a ring `A`, not central.

* `idealiser`, `ringCon`, `le_idealiser_of`: for a right ideal `L` of a ring
  `S`, `𝕀(L) = {λ | λL ⊆ L}` is a subring containing `L`, in which `L` is a
  two-sided ideal, so that `𝕀(L)/L` is a ring; it is the largest subring of `S`
  in which `L` is a two-sided ideal;
* `bigJ`, `bigJ_eq`: `𝒥 = J · (A ⊗_k A)` is the right ideal generated by the
  `ι x ⊗ 1 − 1 ⊗ ι x`;
* `φ`, `φ_surjective`, `φ_eq_zero_iff`: `(A ⊗_k A)/𝒥 ≅ A ⊗_K A`, `A` a
  `K`-module through `ι` on the left — the reading's « n'est autre que »;
* `mem_idealiser_iff_takeuchi`: `λ ∈ 𝒥̃` iff its image `Σ aᵢ ⊗ bᵢ` in
  `A ⊗_K A` satisfies `Σ aᵢ ι(x) ⊗ bᵢ = Σ aᵢ ⊗ bᵢ ι(x)` for every `x ∈ K`,
  Takeuchi's condition; so `𝒥̃/𝒥` is Takeuchi's `A ×_K A` (`takeuchi_iff`).

Not formalised: the completed tensor products of pro-objects, the
comultiplication itself, the isomorphism `𝕀(L)/L ≅ End_S(S/L)`.
-/

namespace Grothendieck.Folder155

open TensorProduct

section Idealiser

variable {S : Type*} [Ring S]

/-- The idealiser `{λ | λL ⊆ L}` of an additive subgroup `L`. -/
def idealiser (L : AddSubgroup S) : Subring S where
  carrier := {a | ∀ l ∈ L, a * l ∈ L}
  mul_mem' {a b} ha hb l hl := by rw [mul_assoc]; exact ha _ (hb l hl)
  one_mem' l hl := by rwa [one_mul]
  add_mem' {a b} ha hb l hl := by rw [add_mul]; exact L.add_mem (ha l hl) (hb l hl)
  zero_mem' l _ := by rw [zero_mul]; exact L.zero_mem
  neg_mem' {a} ha l hl := by rw [neg_mul]; exact L.neg_mem (ha l hl)

theorem mem_idealiser {L : AddSubgroup S} {a : S} :
    a ∈ idealiser L ↔ ∀ l ∈ L, a * l ∈ L := Iff.rfl

/-- `L` is a right ideal. -/
def IsRightIdeal (L : AddSubgroup S) : Prop := ∀ l ∈ L, ∀ s : S, l * s ∈ L

theorem mem_idealiser_of_mem {L : AddSubgroup S} (hL : IsRightIdeal L) {l : S} (hl : l ∈ L) :
    l ∈ idealiser L :=
  fun l' _ => hL l hl l'

/-- The idealiser is the largest subring in which `L` is a (left, hence two-sided)
ideal. -/
theorem le_idealiser_of {L : AddSubgroup S} (R : Subring S)
    (h : ∀ r ∈ R, ∀ l ∈ L, r * l ∈ L) : R ≤ idealiser L :=
  fun r hr l hl => h r hr l hl

/-- `L` is a two-sided ideal of `𝕀(L)`: congruence modulo `L` is a ring congruence. -/
def ringCon {L : AddSubgroup S} (hL : IsRightIdeal L) : RingCon (idealiser L) where
  r a b := (a : S) - b ∈ L
  iseqv :=
    { refl := fun a => by rw [sub_self]; exact L.zero_mem
      symm := fun {a b} h => by have := L.neg_mem h; rwa [neg_sub] at this
      trans := fun {a b c} h1 h2 => by
        have := L.add_mem h1 h2; rwa [sub_add_sub_cancel] at this }
  add' {a b c d} h1 h2 := by
    have := L.add_mem h1 h2
    simp only [Subring.coe_add]
    rwa [add_sub_add_comm]
  mul' {a b c d} h1 h2 := by
    have e : (a : S) * c - b * d = a * (c - d) + (a - b) * d := by noncomm_ring
    simp only [Subring.coe_mul, e]
    exact L.add_mem (a.2 _ h2) (hL _ h1 _)

/-- `𝕀(L)/L` is a ring. -/
example {L : AddSubgroup S} (hL : IsRightIdeal L) : Ring (ringCon hL).Quotient := inferInstance

end Idealiser

section Takeuchi

variable {k K A : Type*} [CommRing k] [CommRing K] [Algebra k K] [Ring A] [Algebra k A]
  (ι : K →ₐ[k] A)

/-- The generator `ι x ⊗ 1 − 1 ⊗ ι x`. -/
def g (x : K) : A ⊗[k] A := ι x ⊗ₜ 1 - 1 ⊗ₜ ι x

/-- `𝒥`, the right ideal generated by the `ι x ⊗ 1 − 1 ⊗ ι x`. -/
def bigJ : AddSubgroup (A ⊗[k] A) :=
  AddSubgroup.closure {t | ∃ x s, t = g ι x * s}

theorem bigJ_isRightIdeal : IsRightIdeal (bigJ ι) := by
  intro l hl s
  induction hl using AddSubgroup.closure_induction with
  | mem t ht =>
    obtain ⟨x, s', rfl⟩ := ht
    exact AddSubgroup.subset_closure ⟨x, s' * s, by rw [mul_assoc]⟩
  | zero => rw [zero_mul]; exact zero_mem _
  | add a b _ _ ha hb => rw [add_mul]; exact add_mem ha hb
  | neg a _ ha => rw [neg_mul]; exact neg_mem ha

theorem g_mem (x : K) : g ι x ∈ bigJ ι :=
  AddSubgroup.subset_closure ⟨x, 1, by rw [mul_one]⟩

/-- The image of `K ⊗_k K` in `A ⊗_k A` is commutative. -/
theorem map_mul_comm (j j' : K ⊗[k] K) :
    Algebra.TensorProduct.map ι ι j * Algebra.TensorProduct.map ι ι j' =
      Algebra.TensorProduct.map ι ι j' * Algebra.TensorProduct.map ι ι j := by
  rw [← map_mul, ← map_mul, mul_comm]

/-- `𝒥 = J · (A ⊗_k A)`, `J = Ker(K ⊗_k K → K)`. -/
theorem bigJ_eq : bigJ ι = AddSubgroup.closure
    {u | ∃ j ∈ KaehlerDifferential.ideal k K, ∃ t, u = Algebra.TensorProduct.map ι ι j * t} := by
  apply le_antisymm
  · rw [bigJ, AddSubgroup.closure_le]
    rintro _ ⟨x, s, rfl⟩
    refine AddSubgroup.subset_closure ⟨x ⊗ₜ 1 - 1 ⊗ₜ x, ?_, s, ?_⟩
    · simp [RingHom.mem_ker]
    · simp [g]
  · rw [AddSubgroup.closure_le]
    rintro _ ⟨j, hj, t, rfl⟩
    have hj' : j ∈ Submodule.span K
        (Set.range fun s : K => (1 : K) ⊗ₜ[k] s - s ⊗ₜ[k] (1 : K)) := by
      rw [KaehlerDifferential.submodule_span_range_eq_ideal]; exact hj
    clear hj
    induction hj' using Submodule.span_induction generalizing t with
    | mem j hj =>
      obtain ⟨s, rfl⟩ := hj
      have : Algebra.TensorProduct.map ι ι ((1 : K) ⊗ₜ[k] s - s ⊗ₜ[k] 1) * t = g ι s * (-t) := by
        simp [g, sub_mul]
      rw [SetLike.mem_coe, this]
      exact bigJ_isRightIdeal ι _ (g_mem ι s) _
    | zero => simp
    | add j j' _ _ hj hj' => rw [map_add, add_mul]; exact add_mem (hj t) (hj' t)
    | smul c j _ hj =>
      have : c • j = j * (c ⊗ₜ 1) := by rw [Algebra.smul_def, mul_comm]; rfl
      rw [this, map_mul, mul_assoc]
      exact hj _

theorem mem_idealiser_iff (a : A ⊗[k] A) :
    a ∈ idealiser (bigJ ι) ↔ ∀ x, a * g ι x ∈ bigJ ι := by
  refine ⟨fun h x => h _ (g_mem ι x), fun h l hl => ?_⟩
  induction hl using AddSubgroup.closure_induction with
  | mem t ht =>
    obtain ⟨x, s, rfl⟩ := ht
    rw [← mul_assoc]
    exact bigJ_isRightIdeal ι _ (h x) _
  | zero => rw [mul_zero]; exact zero_mem _
  | add a b _ _ ha hb => rw [mul_add]; exact add_mem ha hb
  | neg a _ ha => rw [mul_neg]; exact neg_mem ha

/-! `A` is a `K`-module through `ι`, on the left. -/

variable [Module K A] (hι : ∀ (x : K) (a : A), x • a = ι x * a)
include hι

theorem smul_eq_algebraMap (c : k) (a : A) : c • a = algebraMap k K c • a := by
  rw [hι, AlgHom.commutes, Algebra.smul_def]

omit hι in
/-- `(a, b) ↦ a ⊗ b ∈ A ⊗_K A`, biadditive. -/
def tmulK : A →+ A →+ A ⊗[K] A where
  toFun a :=
    { toFun := fun b => a ⊗ₜ[K] b
      map_zero' := tmul_zero _ _
      map_add' := tmul_add a }
  map_zero' := by ext b; exact zero_tmul _ _
  map_add' a a' := by ext b; exact add_tmul _ _ _

omit hι in
/-- `(a, b) ↦ [a ⊗ b] ∈ (A ⊗_k A)/𝒥`, biadditive. -/
def tmulQ : A →+ A →+ (A ⊗[k] A) ⧸ bigJ ι where
  toFun a :=
    { toFun := fun b => (QuotientAddGroup.mk (a ⊗ₜ[k] b) : (A ⊗[k] A) ⧸ bigJ ι)
      map_zero' := by rw [tmul_zero]; rfl
      map_add' := fun b b' => by rw [tmul_add]; rfl }
  map_zero' := by ext b; change QuotientAddGroup.mk _ = 0; rw [zero_tmul]; rfl
  map_add' a a' := by ext b; change QuotientAddGroup.mk _ = _; rw [add_tmul]; rfl

/-- The quotient map `A ⊗_k A → A ⊗_K A`. -/
noncomputable def φ : A ⊗[k] A →+ A ⊗[K] A :=
  liftAddHom tmulK fun c a b => by
    change (c • a) ⊗ₜ[K] b = a ⊗ₜ[K] (c • b)
    rw [smul_eq_algebraMap ι hι, smul_eq_algebraMap ι hι, smul_tmul]

@[simp] theorem φ_tmul (a b : A) : φ ι hι (a ⊗ₜ b) = a ⊗ₜ[K] b := rfl

/-- The inverse map `A ⊗_K A → (A ⊗_k A)/𝒥`. -/
noncomputable def ψ : A ⊗[K] A →+ (A ⊗[k] A) ⧸ bigJ ι :=
  liftAddHom (tmulQ ι) fun x a b => by
      change (QuotientAddGroup.mk ((x • a) ⊗ₜ[k] b) : (A ⊗[k] A) ⧸ bigJ ι) =
        QuotientAddGroup.mk (a ⊗ₜ[k] (x • b))
      rw [hι, hι, QuotientAddGroup.eq_iff_sub_mem]
      have : (ι x * a) ⊗ₜ[k] b - a ⊗ₜ[k] (ι x * b) = g ι x * (a ⊗ₜ b) := by
        simp [g, sub_mul]
      rw [this]
      exact bigJ_isRightIdeal ι _ (g_mem ι x) _

theorem ψ_φ (s : A ⊗[k] A) : ψ ι hι (φ ι hι s) = QuotientAddGroup.mk s := by
  induction s using TensorProduct.inductionOn with
  | tmul a b => rfl
  | add s t hs ht => rw [map_add, map_add, hs, ht]; rfl

theorem φ_surjective : Function.Surjective (φ ι hι) := by
  intro t
  induction t using TensorProduct.inductionOn with
  | tmul a b => exact ⟨a ⊗ₜ b, rfl⟩
  | add s t hs ht =>
    obtain ⟨s', rfl⟩ := hs
    obtain ⟨t', rfl⟩ := ht
    exact ⟨s' + t', map_add _ _ _⟩

theorem φ_g_mul (x : K) (s : A ⊗[k] A) : φ ι hι (g ι x * s) = 0 := by
  induction s using TensorProduct.inductionOn with
  | tmul a b =>
    simp only [g, sub_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul, map_sub, φ_tmul]
    rw [← hι, ← hι, smul_tmul, sub_self]
  | add s t hs ht => rw [mul_add, map_add, hs, ht, add_zero]

/-- The kernel of `A ⊗_k A → A ⊗_K A` is `𝒥`. -/
theorem φ_eq_zero_iff (s : A ⊗[k] A) : φ ι hι s = 0 ↔ s ∈ bigJ ι := by
  constructor
  · intro h
    have := ψ_φ ι hι s
    rw [h, map_zero, eq_comm, QuotientAddGroup.eq_zero_iff] at this
    exact this
  · intro hs
    induction hs using AddSubgroup.closure_induction with
    | mem t ht => obtain ⟨x, s, rfl⟩ := ht; exact φ_g_mul ι hι x s
    | zero => exact map_zero _
    | add a b _ _ ha hb => rw [map_add, ha, hb, add_zero]
    | neg a _ ha => rw [map_neg, ha, neg_zero]

/-- Right multiplication by `ι x` on `A`, a `K`-linear map. -/
def mulRight (x : K) : A →ₗ[K] A where
  toFun a := a * ι x
  map_add' a b := add_mul a b (ι x)
  map_smul' y a := by simp only [hι, RingHom.id_apply, mul_assoc]

/-- `Σ aᵢ ⊗ bᵢ ↦ Σ aᵢ ι(x) ⊗ bᵢ` on `A ⊗_K A`. -/
noncomputable def ρ₁ (x : K) : A ⊗[K] A →ₗ[K] A ⊗[K] A :=
  TensorProduct.map (mulRight ι hι x) LinearMap.id

/-- `Σ aᵢ ⊗ bᵢ ↦ Σ aᵢ ⊗ bᵢ ι(x)` on `A ⊗_K A`. -/
noncomputable def ρ₂ (x : K) : A ⊗[K] A →ₗ[K] A ⊗[K] A :=
  TensorProduct.map LinearMap.id (mulRight ι hι x)

/-- Takeuchi's `A ×_K A`: the `t` with `Σ aᵢ ι(x) ⊗ bᵢ = Σ aᵢ ⊗ bᵢ ι(x)`. -/
def takeuchi : Set (A ⊗[K] A) := {t | ∀ x, ρ₁ ι hι x t = ρ₂ ι hι x t}

theorem φ_mul_g (a : A ⊗[k] A) (x : K) :
    φ ι hι (a * g ι x) = ρ₁ ι hι x (φ ι hι a) - ρ₂ ι hι x (φ ι hι a) := by
  induction a using TensorProduct.inductionOn with
  | tmul a b =>
    simp [g, mul_sub, ρ₁, ρ₂, mulRight]
  | add s t hs ht => rw [add_mul, map_add, hs, ht, map_add, map_add, map_add]; abel

/-- **Page 1, the idealiser is Takeuchi's subring**: `λ ∈ 𝒥̃` iff its image in
`A ⊗_K A` lies in `A ×_K A`. -/
theorem mem_idealiser_iff_takeuchi (a : A ⊗[k] A) :
    a ∈ idealiser (bigJ ι) ↔ φ ι hι a ∈ takeuchi ι hι := by
  rw [mem_idealiser_iff]
  refine forall_congr' fun x => ?_
  rw [← φ_eq_zero_iff ι hι, φ_mul_g, sub_eq_zero]

/-- Hence `𝒥̃/𝒥 ≅ A ×_K A`: `φ` maps `𝒥̃` onto `A ×_K A`, with kernel `𝒥`. -/
theorem takeuchi_iff (t : A ⊗[K] A) :
    t ∈ takeuchi ι hι ↔ ∃ a ∈ idealiser (bigJ ι), φ ι hι a = t := by
  constructor
  · intro ht
    obtain ⟨a, rfl⟩ := φ_surjective ι hι t
    exact ⟨a, (mem_idealiser_iff_takeuchi ι hι a).mpr ht, rfl⟩
  · rintro ⟨a, ha, rfl⟩
    exact (mem_idealiser_iff_takeuchi ι hι a).mp ha

end Takeuchi

end Grothendieck.Folder155
