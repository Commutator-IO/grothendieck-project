import Mathlib

/-!
# Folder 83, pages 126–143: the line of twists and its degenerate locus

The modernised reading `transcripts/83/83.modern.tex` (station X, « La théorie
intrinsèque : twists », pages 126 to 136, and « Le produit contracté `X ∧ X'` »,
pages 137 to 143) takes two quadratic algebras `H = k[u]`, `H' = k[v]` over a
commutative ring `k`, `u² = bu − c`, `v² = b'v − c'`, and `P = H ⊗ H'` with
basis `(1, u, v, uv)`. It states:

> **Théorème récapitulatif (pages 130 to 136).** The Hamilton–Cayley algebra
> structures on `P` inducing the given ones on `H ⊗ 1` and `1 ⊗ H'` form a torsor
> under `(L ⊗ L')^∨`, `L = H/k`, `L' = H'/k`, identified with the twists `T`
> (`T(u, 1) = Tr u`, `T(1, v) = Tr v`); in coordinates the structure attached to
> `t = T(u, v)` is `M(b, c; b', c'; t)`, and `δ_{P,B}` is `t ↦ Q(t)` up to sign,
> `Q = t² − bb't + b²c' + b'²c − 4cc'`.
>
> **Pages 137 to 143.** `S̃ = δ_{P,B}⁻¹(0)` is a quadratic cover; the map
> `X ×_S X' → S̃` sends two characters `(φ, φ')` to the twist
> `t_{φ,φ'}(u, v) = Tr(v)φ(u) + Tr(u)φ'(v) − 2φ(u)φ'(v)`, a root of `Q`; the
> involution `T ↦ T'` is `t ↦ bb' − t`; the algebra of `S̃` is the product
> `H * H'`, generated by `u * v = Tr(v)u + Tr(u)v − 2u ⊗ v`, with
> `Tr(u * v) = bb'`, `det(u * v) = b²c' + b'²c − 4cc'`, `disc = δδ'`,
> `t_{φ,φ'} = (φ ⊗ φ')(u * v)` and `(u * v)' = u' * v = u * v'`.

This is finding `83-twist-line-degenerate-locus-is-product` of
`src/content/findings.ts`. Proving it says only that the claims hold as stated
in coordinates; whether they stand in the literature is a separate question.

What is formalised, over an arbitrary commutative ring `k`, without dividing by
`2`, with `H`, `H'` free (`L`, `L'` trivialised, so `(L ⊗ L')^∨ = k`):

* the line of structures. `mulM b c b' c' t` is the multiplication of
  `M(b, c; b', c'; t)` on `P = k⁴` (table of page 92); it is unital, bilinear and
  associative for every `t` (`one_mulM`, `mulM_one`, `mulM_add`, `add_mulM`,
  `mulM_smul`, `smul_mulM`, `mulM_assoc`), restricts to `H` and `H'`
  (`u_mul_u`, `v_mul_v`, `u_mul_v`), and every element satisfies Hamilton–Cayley
  for `trM` and `nrdM` (`hamilton_cayley`), with `nrdM` multiplicative
  (`nrdM_mulM`) and `trM (uv) = t` (`trM_w`). Conversely (`realise_mulM`), in any
  `k`-algebra `A` whose elements satisfy Hamilton–Cayley for a linear form `T` and
  a function `N`, with `u² = bu − c`, `v² = b'v − c'` (`T u = b`, `N u = c`, …),
  there is a `t` such that `x ↦ x₀ + x₁u + x₂v + x₃uv` is multiplicative from
  `M(b, c; b', c'; t)`; if this map is injective, `t` is unique
  (`realise_unique`), and distinct `t` give distinct structures (`mulM_inj`): the
  structures form the affine line of `t`, a torsor under `k`;
* the degenerate locus. The reduced norm on `B = k1 + ku + kv` is
  `x₀² + cx₁² + c'x₂² + bx₀x₁ + b'x₀x₂ + (bb' − t)x₁x₂` (`nrdM_B`); its half
  discriminant (`halfDisc3`, with `2 · halfDisc3 = det` of the polar matrix,
  `two_mul_halfDisc3`) is `−Q(t)` (`deltaPB_eq`); `Q` has discriminant `δδ'`
  (`disc_Q`) and is invariant under `t ↦ bb' − t` (`Q_invol`); the trace form of
  `M(b, c; b', c'; t)` in the basis `(1, u, v, uv)` has determinant `−Q(t)²`
  (`det_traceForm`). `S̃ = Spec k[t]/(Q)` is free of rank `2` (`Stilde_rank`);
* the product. In `H ⊗ H'` (`H = k[X]/(X² − bX + c)`), `u * v` satisfies
  `Q(u * v) = 0` (`star_root`, from `Q(w) = (2V − b')²(U² − bU + c) + δ(V² − b'V + c')`,
  `Q_star_identity`), whence the algebra map `starHom : k[t]/(Q) → H ⊗ H'`,
  `t ↦ u * v`; the conjugations of `H` and `H'` both send `u * v` to `bb' − u * v`
  (`conjL_star`, `conjR_star`, `conjL_star_eq_conjR_star`); for characters `φ`, `φ'` with values in any
  commutative `k`-algebra, `(φ ⊗ φ')(u * v) = b'φ(u) + bφ'(v) − 2φ(u)φ'(v)`
  (`productMap_star`), which is `t_{φ,φ'}(u, v)` (`twist_eq_productMap`), a root of
  `Q` (`twist_root`, `productMap_star_root`), and `t_{φ,φ'}` is a twist (`twist_one_right`,
  `twist_one_left`); conjugating `φ` sends it to `bb' − t` (`twist_conj`).

Not formalised: the intrinsic torsors for `H`, `H'` locally free (only the free,
trivialised case), the chain of isomorphisms `AZ_P → Q_P → … → L_P`, the
criterion « Azumaya iff `Q` invertible » of page 98 (only the trace-form
determinant `−Q²`), and the identification `S̃ ≅ X ∧ X'` as the quotient of
`X × X'` by `σ × σ'` when `(2, δ, δ') = 1`, whose algebraic core (the invariants
of `σ ⊗ σ'` are `k[u * v]` iff `(2, b, b') = 1`) is
`Grothendieck.Folder84.invariants_of_span_eq_top`.
-/

namespace Grothendieck.Folder83

open Polynomial TensorProduct

/-! ## The line of Hamilton–Cayley structures on `P = H ⊗ H'` -/

section Line

variable {k : Type*} [CommRing k]

/-- An element `x₀ + x₁u + x₂v + x₃uv` of `P = H ⊗ H'`, in the basis
`(1, u, v, uv)`. -/
@[ext] structure P (k : Type*) where
  x0 : k
  x1 : k
  x2 : k
  x3 : k

namespace P

instance : Add (P k) := ⟨fun x y => ⟨x.x0 + y.x0, x.x1 + y.x1, x.x2 + y.x2, x.x3 + y.x3⟩⟩
instance : SMul k (P k) := ⟨fun a x => ⟨a * x.x0, a * x.x1, a * x.x2, a * x.x3⟩⟩

@[simp] lemma add_x0 (x y : P k) : (x + y).x0 = x.x0 + y.x0 := rfl
@[simp] lemma add_x1 (x y : P k) : (x + y).x1 = x.x1 + y.x1 := rfl
@[simp] lemma add_x2 (x y : P k) : (x + y).x2 = x.x2 + y.x2 := rfl
@[simp] lemma add_x3 (x y : P k) : (x + y).x3 = x.x3 + y.x3 := rfl
@[simp] lemma smul_x0 (a : k) (x : P k) : (a • x).x0 = a * x.x0 := rfl
@[simp] lemma smul_x1 (a : k) (x : P k) : (a • x).x1 = a * x.x1 := rfl
@[simp] lemma smul_x2 (a : k) (x : P k) : (a • x).x2 = a * x.x2 := rfl
@[simp] lemma smul_x3 (a : k) (x : P k) : (a • x).x3 = a * x.x3 := rfl

/-- The basis vectors `1`, `u`, `v`, `uv`. -/
def one : P k := ⟨1, 0, 0, 0⟩
/-- The basis vector `u = u ⊗ 1`. -/
def u : P k := ⟨0, 1, 0, 0⟩
/-- The basis vector `v = 1 ⊗ v`. -/
def v : P k := ⟨0, 0, 1, 0⟩
/-- The basis vector `uv = u ⊗ v`. -/
def w : P k := ⟨0, 0, 0, 1⟩

end P

open P

/-- The multiplication of `M(b, c; b', c'; t)` (table of page 92, left factor in
the row): `u² = bu − c`, `vu = (t − bb') + b'u + bv − uv`, `v(uv) = −bc' + c'u + tv`,
`(uv)u = −b'c + tu + cv`, `(uv)² = −cc' + t·uv`, and so on. -/
def mulM (b c b' c' t : k) (x y : P k) : P k where
  x0 := x.x0 * y.x0 - c * x.x1 * y.x1 - c' * x.x2 * y.x2 - c * c' * x.x3 * y.x3
    + (t - b * b') * x.x2 * y.x1 - b * c' * x.x2 * y.x3 - b' * c * x.x3 * y.x1
  x1 := x.x0 * y.x1 + x.x1 * y.x0 + b * x.x1 * y.x1 + b' * x.x2 * y.x1
    + c' * x.x2 * y.x3 - c' * x.x3 * y.x2 + t * x.x3 * y.x1
  x2 := x.x0 * y.x2 + x.x2 * y.x0 + b * x.x2 * y.x1 + b' * x.x2 * y.x2
    - c * x.x1 * y.x3 + c * x.x3 * y.x1 + t * x.x2 * y.x3
  x3 := x.x0 * y.x3 + x.x3 * y.x0 + b * x.x1 * y.x3 + b' * x.x3 * y.x2
    + t * x.x3 * y.x3 + x.x1 * y.x2 - x.x2 * y.x1

variable (b c b' c' t : k)

theorem one_mulM (x : P k) : mulM b c b' c' t one x = x := by
  ext <;> simp [mulM, one]

theorem mulM_one (x : P k) : mulM b c b' c' t x one = x := by
  ext <;> simp [mulM, one]

theorem mulM_add (x y z : P k) :
    mulM b c b' c' t x (y + z) = mulM b c b' c' t x y + mulM b c b' c' t x z := by
  ext <;> simp [mulM] <;> ring

theorem add_mulM (x y z : P k) :
    mulM b c b' c' t (x + y) z = mulM b c b' c' t x z + mulM b c b' c' t y z := by
  ext <;> simp [mulM] <;> ring

theorem mulM_smul (a : k) (x y : P k) :
    mulM b c b' c' t x (a • y) = a • mulM b c b' c' t x y := by
  ext <;> simp [mulM] <;> ring

theorem smul_mulM (a : k) (x y : P k) :
    mulM b c b' c' t (a • x) y = a • mulM b c b' c' t x y := by
  ext <;> simp [mulM] <;> ring

/-- Page 84 (« se vérifient »): `M(b, c; b', c'; t)` is associative, for every
value of the twist `t`, over any commutative ring. -/
theorem mulM_assoc (x y z : P k) :
    mulM b c b' c' t (mulM b c b' c' t x y) z = mulM b c b' c' t x (mulM b c b' c' t y z) := by
  ext <;> simp [mulM] <;> ring

/-- The structure induces the given one on `H ⊗ 1`: `u² = bu − c`. -/
theorem u_mul_u : mulM b c b' c' t u u = ⟨-c, b, 0, 0⟩ := by
  ext <;> simp [mulM, P.u]

/-- The structure induces the given one on `1 ⊗ H'`: `v² = b'v − c'`. -/
theorem v_mul_v : mulM b c b' c' t v v = ⟨-c', 0, b', 0⟩ := by
  ext <;> simp [mulM, P.v]

/-- The product of `u ⊗ 1` and `1 ⊗ v` is `u ⊗ v`. -/
theorem u_mul_v : mulM b c b' c' t u v = w := by
  ext <;> simp [mulM, P.u, P.v, P.w]

/-- The reverse product `vu = (t − bb') + b'u + bv − uv` (relation (6') of page 81). -/
theorem v_mul_u : mulM b c b' c' t v u = ⟨t - b * b', b', b, -1⟩ := by
  ext <;> simp [mulM, P.u, P.v]

/-- The trace of `M(b, c; b', c'; t)`: `Tr(x₀ + x₁u + x₂v + x₃uv) = 2x₀ + bx₁ + b'x₂ + tx₃`. -/
def trM (x : P k) : k := 2 * x.x0 + b * x.x1 + b' * x.x2 + t * x.x3

/-- The reduced norm (`det`) of `M(b, c; b', c'; t)`. -/
def nrdM (x : P k) : k :=
  x.x0 ^ 2 + c * x.x1 ^ 2 + c' * x.x2 ^ 2 + c * c' * x.x3 ^ 2 + b * x.x0 * x.x1
    + b' * x.x0 * x.x2 + t * x.x0 * x.x3 + (b * b' - t) * x.x1 * x.x2
    + b' * c * x.x1 * x.x3 + b * c' * x.x2 * x.x3

/-- The twist of the structure: `Tr(uv) = t`. -/
theorem trM_w : trM b b' t (w : P k) = t := by simp [trM, P.w]

/-- Hamilton–Cayley: every element `x` of `M(b, c; b', c'; t)` satisfies
`x² − Tr(x)x + det(x) = 0`. -/
theorem hamilton_cayley (x : P k) :
    mulM b c b' c' t x x = trM b b' t x • x + (-nrdM b c b' c' t x) • one := by
  ext <;> simp [mulM, trM, nrdM, one] <;> ring

/-- `det` is multiplicative on `M(b, c; b', c'; t)`. -/
theorem nrdM_mulM (x y : P k) :
    nrdM b c b' c' t (mulM b c b' c' t x y) = nrdM b c b' c' t x * nrdM b c b' c' t y := by
  simp [nrdM, mulM]; ring

/-- Distinct twists give distinct structures: the structures `M(b, c; b', c'; t)`
are parametrised injectively by `t ∈ k`. -/
theorem mulM_inj {t t' : k} (h : mulM b c b' c' t = mulM b c b' c' t') : t = t' := by
  have := congrArg (fun m => (m (v : P k) u).x0) h
  simpa [mulM, P.u, P.v] using this

/-- The realisation map `x ↦ x₀ + x₁u + x₂v + x₃uv` into a `k`-algebra `A`. -/
def realise {A : Type*} [Ring A] [Algebra k A] (uA vA : A) (x : P k) : A :=
  x.x0 • (1 : A) + x.x1 • uA + x.x2 • vA + x.x3 • (uA * vA)

/-- Pages 81 and 130: in any `k`-algebra `A` all of whose elements satisfy
Hamilton–Cayley for a linear form `T` and a function `N`, two elements `u`, `v`
with `T u = b`, `N u = c`, `T v = b'`, `N v = c'` satisfy
`vu = (t − bb') + b'u + bv − uv` with `t = bb' + c + c' − N(u + v)`, and the
realisation `M(b, c; b', c'; t) → A` is multiplicative. -/
theorem realise_mulM {A : Type*} [Ring A] [Algebra k A] (T : A →ₗ[k] k) (N : A → k)
    (hHC : ∀ x : A, x * x - T x • x + N x • (1 : A) = 0) {uA vA : A}
    (hTu : T uA = b) (hNu : N uA = c) (hTv : T vA = b') (hNv : N vA = c') :
    ∃ t : k, ∀ x y : P k,
      realise uA vA (mulM b c b' c' t x y) = realise uA vA x * realise uA vA y := by
  have uu : uA * uA = b • uA - c • (1 : A) := by
    have := hHC uA; rw [hTu, hNu] at this
    rw [← sub_eq_zero, ← this]; abel
  have vv : vA * vA = b' • vA - c' • (1 : A) := by
    have := hHC vA; rw [hTv, hNv] at this
    rw [← sub_eq_zero, ← this]; abel
  set t := b * b' + c + c' - N (uA + vA) with ht
  refine ⟨t, ?_⟩
  have vu : vA * uA = (t - b * b') • (1 : A) + b' • uA + b • vA - uA * vA := by
    have h := hHC (uA + vA)
    rw [map_add, hTu, hTv] at h
    have hN : N (uA + vA) = b * b' + c + c' - t := by rw [ht]; ring
    rw [hN] at h
    simp only [add_mul, mul_add, uu, vv, add_smul, smul_add, sub_smul] at h
    rw [← sub_eq_zero, ← h]; module
  have u_uv : uA * (uA * vA) = b • (uA * vA) - c • vA := by
    rw [← mul_assoc, uu, sub_mul, smul_mul_assoc, smul_mul_assoc, one_mul]
  have v_uv : vA * (uA * vA) = (-(b * c')) • (1 : A) + c' • uA + t • vA := by
    rw [← mul_assoc, vu]
    simp only [sub_mul, add_mul, smul_mul_assoc, one_mul, mul_assoc, vv, mul_sub, mul_smul_comm,
      mul_one]
    module
  have uv_u : (uA * vA) * uA = (-(b' * c)) • (1 : A) + t • uA + c • vA := by
    rw [mul_assoc, vu]
    simp only [mul_sub, mul_add, mul_smul_comm, mul_one, ← mul_assoc, uu, sub_mul,
      smul_mul_assoc, one_mul]
    module
  have uv_v : (uA * vA) * vA = (-c') • uA + b' • (uA * vA) := by
    rw [mul_assoc, vv, mul_sub, mul_smul_comm, mul_smul_comm, mul_one]; module
  have uv_uv : (uA * vA) * (uA * vA) = (-(c * c')) • (1 : A) + t • (uA * vA) := by
    rw [← mul_assoc, uv_u]
    simp only [add_mul, smul_mul_assoc, one_mul, vv]
    module
  intro x y
  simp only [realise, mulM, add_mul, mul_add, smul_mul_smul_comm, one_mul, mul_one, uu, vv, vu,
    u_uv, v_uv, uv_u, uv_v, uv_uv]
  module

/-- Uniqueness of the twist: if the realisation `M(b, c; b', c'; t) → A` is
injective (`(1, u, v, uv)` free in `A`), at most one `t` makes it multiplicative. -/
theorem realise_unique {A : Type*} [Ring A] [Algebra k A] {uA vA : A}
    (hinj : Function.Injective (realise (k := k) uA vA)) {t t' : k}
    (ht : ∀ x y : P k, realise uA vA (mulM b c b' c' t x y) = realise uA vA x * realise uA vA y)
    (ht' : ∀ x y : P k,
      realise uA vA (mulM b c b' c' t' x y) = realise uA vA x * realise uA vA y) :
    t = t' := by
  have h := hinj ((ht v u).trans (ht' v u).symm)
  have := congrArg P.x0 h
  simpa [mulM, P.u, P.v] using this

end Line

/-! ## The degenerate locus `δ_{P,B} = 0` -/

section Locus

variable {k : Type*} [CommRing k] (b c b' c' t : k)

open P

/-- The quadratic polynomial of the twist line, `Q(t) = t² − bb't + b²c' + b'²c − 4cc'`. -/
def Q : k := t ^ 2 - b * b' * t + (b ^ 2 * c' + b' ^ 2 * c - 4 * c * c')

/-- Page 94: the reduced norm on `B = k1 + ku + kv` is
`x₀² + cx₁² + c'x₂² + bx₀x₁ + b'x₀x₂ + (bb' − t)x₁x₂`. -/
theorem nrdM_B (x0 x1 x2 : k) :
    nrdM b c b' c' t ⟨x0, x1, x2, 0⟩ = x0 ^ 2 + c * x1 ^ 2 + c' * x2 ^ 2 + b * x0 * x1
      + b' * x0 * x2 + (b * b' - t) * x1 * x2 := by
  simp [nrdM]

/-- The half discriminant of the ternary form
`a₁x₁² + a₂x₂² + a₃x₃² + a₁₂x₁x₂ + a₁₃x₁x₃ + a₂₃x₂x₃`. -/
def halfDisc3 (a1 a2 a3 a12 a13 a23 : k) : k :=
  4 * a1 * a2 * a3 + a12 * a13 * a23 - a1 * a23 ^ 2 - a2 * a13 ^ 2 - a3 * a12 ^ 2

/-- `halfDisc3` halves the determinant of the polar matrix, over any ring. -/
theorem two_mul_halfDisc3 (a1 a2 a3 a12 a13 a23 : k) :
    2 * halfDisc3 a1 a2 a3 a12 a13 a23
      = !![2 * a1, a12, a13; a12, 2 * a2, a23; a13, a23, 2 * a3].det := by
  rw [Matrix.det_fin_three]; simp [halfDisc3]; ring

/-- Pages 94, 116–120 and 136: `δ_{P,B}`, the half discriminant of `det` on `B` in
the basis `(1, u, v)`, is `−Q(t)`. Its zero locus on the line of twists is
`Q(t) = 0`. -/
theorem deltaPB_eq : halfDisc3 1 c c' b b' (b * b' - t) = -Q b c b' c' t := by
  unfold halfDisc3 Q; ring

/-- Page 91, (13): the discriminant of `Q` in `t` is `δδ'`. -/
theorem disc_Q :
    (b * b') ^ 2 - 4 * (b ^ 2 * c' + b' ^ 2 * c - 4 * c * c') = (b ^ 2 - 4 * c) * (b' ^ 2 - 4 * c') := by
  ring

/-- Pages 140–141: `Q` is invariant under the involution `t ↦ bb' − t` of the line. -/
theorem Q_invol : Q b c b' c' (b * b' - t) = Q b c b' c' t := by
  unfold Q; ring

/-- The basis `(1, u, v, uv)` of `P`. -/
def basisP : Fin 4 → P k := ![one, u, v, w]

/-- The trace form `Tr(eᵢeⱼ)` of `M(b, c; b', c'; t)` in the basis `(1, u, v, uv)`. -/
def traceForm : Matrix (Fin 4) (Fin 4) k :=
  fun i j => trM b b' t (mulM b c b' c' t (basisP i) (basisP j))

/-- Page 92: the matrix of the trace form (with `Tr((uv)²) = t² − 2cc'`). -/
theorem traceForm_eq : traceForm b c b' c' t =
    !![2, b, b', t; b, b ^ 2 - 2 * c, t, b * t - b' * c; b', t, b' ^ 2 - 2 * c', b' * t - b * c';
      t, b * t - b' * c, b' * t - b * c', t ^ 2 - 2 * c * c'] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [traceForm, basisP, trM, mulM, P.one, P.u, P.v, P.w] <;> ring

/-- The discriminant of the trace form of `M(b, c; b', c'; t)` is `−Q(t)²`: where
`Q(t)` is invertible the trace form is non-degenerate. -/
theorem det_traceForm : (traceForm b c b' c' t).det = -(Q b c b' c' t) ^ 2 := by
  rw [traceForm_eq, Matrix.det_succ_row_zero]
  simp [Fin.sum_univ_succ, Matrix.det_fin_three, Matrix.submatrix, Fin.succAbove, Q]
  ring

end Locus

/-! ## The product `H * H'` as the algebra of the degenerate locus -/

section Product

variable {k : Type*} [CommRing k]

/-- The polynomial `X² − bX + c`. -/
noncomputable def qp (b c : k) : k[X] := X ^ 2 - C b * X + C c

lemma qp_monic (b c : k) : (qp b c).Monic := by
  unfold qp; monicity!

lemma qp_natDegree [Nontrivial k] (b c : k) : (qp b c).natDegree = 2 := by
  unfold qp; compute_degree!

lemma eval₂_qp {S : Type*} [CommRing S] (f : k →+* S) (x : S) (b c : k) :
    (qp b c).eval₂ f x = x ^ 2 - f b * x + f c := by
  simp [qp]

/-- The quadratic algebra `H = k[u]/(u² − bu + c)`. -/
abbrev Hq (b c : k) := AdjoinRoot (qp b c)

lemma root_eq (b c : k) :
    AdjoinRoot.root (qp b c) ^ 2 - algebraMap k (Hq b c) b * AdjoinRoot.root _
      + algebraMap k (Hq b c) c = 0 := by
  have : AdjoinRoot.mk (qp b c) (X ^ 2 - C b * X + C c) = 0 := AdjoinRoot.mk_self
  simpa using this

/-- The polynomial `Q` of the line of twists. -/
noncomputable def Qpoly (b c b' c' : k) : k[X] := qp (b * b') (b ^ 2 * c' + b' ^ 2 * c - 4 * c * c')

/-- `S̃ = Spec k[t]/(Q)` is a quadratic cover: `k[t]/(Q)` is free of rank `2`. -/
theorem Stilde_rank [Nontrivial k] (b c b' c' : k) :
    (AdjoinRoot.powerBasis' (qp_monic (b * b') (b ^ 2 * c' + b' ^ 2 * c - 4 * c * c'))).dim = 2 := by
  rw [AdjoinRoot.powerBasis'_dim, qp_natDegree]

/-- Pages 138 and 143, the identity behind `Q(u * v) = 0`: with
`w = b'U + bV − 2UV`, `Q(w) = (2V − b')²(U² − bU + c) + (b² − 4c)(V² − b'V + c')`. -/
theorem Q_star_identity {A : Type*} [CommRing A] (b c b' c' U V : A) :
    (b' * U + b * V - 2 * U * V) ^ 2 - b * b' * (b' * U + b * V - 2 * U * V)
        + (b ^ 2 * c' + b' ^ 2 * c - 4 * c * c')
      = (2 * V - b') ^ 2 * (U ^ 2 - b * U + c) + (b ^ 2 - 4 * c) * (V ^ 2 - b' * V + c') := by
  ring

variable (b c b' c' : k)

/-- The element `u * v = Tr(v)u + Tr(u)v − 2u ⊗ v = b'u + bv − 2uv` of `H ⊗ H'`. -/
noncomputable def star : Hq b c ⊗[k] Hq b' c' :=
  algebraMap k _ b' * (AdjoinRoot.root _ ⊗ₜ 1) + algebraMap k _ b * (1 ⊗ₜ AdjoinRoot.root _)
    - 2 * ((AdjoinRoot.root _ ⊗ₜ 1) * (1 ⊗ₜ AdjoinRoot.root _))

/-- Page 143: `u * v` is a root of `Q` in `H ⊗ H'`, so `Tr(u * v) = bb'` and
`det(u * v) = b²c' + b'²c − 4cc'`. -/
theorem star_root :
    star b c b' c' ^ 2 - algebraMap k _ (b * b') * star b c b' c'
      + algebraMap k _ (b ^ 2 * c' + b' ^ 2 * c - 4 * c * c') = 0 := by
  have eU := congrArg (Algebra.TensorProduct.includeLeft (R := k) (S := k) (B := Hq b' c'))
    (root_eq b c)
  have eV := congrArg (Algebra.TensorProduct.includeRight (R := k) (A := Hq b c)) (root_eq b' c')
  simp only [map_add, map_sub, map_mul, map_pow, AlgHom.commutes, map_zero,
    Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.includeRight_apply] at eU eV
  simp only [star, map_mul, map_sub, map_add, map_pow, map_ofNat]
  linear_combination
    (2 * (1 ⊗ₜ[k] AdjoinRoot.root (qp b' c')) - algebraMap k (Hq b c ⊗[k] Hq b' c') b') ^ 2 * eU
      + (algebraMap k _ b ^ 2 - 4 * algebraMap k _ c) * eV

/-- Pages 141–143: the algebra map `k[t]/(Q) → H ⊗ H'`, `t ↦ u * v`, comorphism of
`X ×_S X' → S̃`. -/
noncomputable def starHom : AdjoinRoot (Qpoly b c b' c') →ₐ[k] Hq b c ⊗[k] Hq b' c' :=
  AdjoinRoot.liftAlgHom _ (Algebra.ofId k _) (star b c b' c') (by
    rw [Qpoly, eval₂_qp]
    exact star_root b c b' c')

theorem starHom_root : starHom b c b' c' (AdjoinRoot.root _) = star b c b' c' :=
  AdjoinRoot.liftAlgHom_root _ _ _ _

/-- The conjugation `x ↦ x'` of `H`, `u ↦ b − u`. -/
noncomputable def conj : Hq b c →ₐ[k] Hq b c :=
  AdjoinRoot.liftAlgHom _ (Algebra.ofId k _) (algebraMap k _ b - AdjoinRoot.root _) (by
    have := root_eq b c
    rw [eval₂_qp]
    change (_ : Hq b c) ^ 2 - algebraMap k _ b * _ + algebraMap k _ c = 0
    linear_combination this)

theorem conj_root : conj b c (AdjoinRoot.root _) = algebraMap k _ b - AdjoinRoot.root _ :=
  AdjoinRoot.liftAlgHom_root _ _ _ _

/-- Page 143: `(u * v)' = u' * v`: the conjugation of `H` sends `u * v` to `bb' − u * v`. -/
theorem conjL_star :
    Algebra.TensorProduct.map (conj b c) (AlgHom.id k _) (star b c b' c')
      = algebraMap k _ (b * b') - star b c b' c' := by
  simp only [star, map_add, map_sub, map_mul, AlgHom.commutes, map_ofNat,
    Algebra.TensorProduct.map_tmul, conj_root, AlgHom.id_apply, map_one, sub_tmul]
  rw [← Algebra.TensorProduct.algebraMap_apply]
  ring

/-- Page 143: `(u * v)' = u * v'`: the conjugation of `H'` also sends `u * v` to
`bb' − u * v`. -/
theorem conjR_star :
    Algebra.TensorProduct.map (AlgHom.id k _) (conj b' c') (star b c b' c')
      = algebraMap k _ (b * b') - star b c b' c' := by
  simp only [star, map_add, map_sub, map_mul, AlgHom.commutes, map_ofNat,
    Algebra.TensorProduct.map_tmul, conj_root, AlgHom.id_apply, map_one, tmul_sub]
  rw [← Algebra.TensorProduct.algebraMap_apply']
  ring

/-- The conjugations of `H` and `H'` agree on `u * v`: it lies in the invariants of
`σ ⊗ σ'`. -/
theorem conjL_star_eq_conjR_star :
    Algebra.TensorProduct.map (conj b c) (AlgHom.id k _) (star b c b' c')
      = Algebra.TensorProduct.map (AlgHom.id k _) (conj b' c') (star b c b' c') := by
  rw [conjL_star, conjR_star]

variable {K : Type*} [CommRing K] [Algebra k K]

/-- Pages 137–139 and 143: for characters `φ : H → K`, `φ' : H' → K`, with
`z = φ(u)`, `z' = φ'(v)`, `(φ ⊗ φ')(u * v) = b'z + bz' − 2zz'`. -/
theorem productMap_star (φ : Hq b c →ₐ[k] K) (φ' : Hq b' c' →ₐ[k] K) :
    Algebra.TensorProduct.productMap φ φ' (star b c b' c')
      = algebraMap k K b' * φ (AdjoinRoot.root _) + algebraMap k K b * φ' (AdjoinRoot.root _)
        - 2 * φ (AdjoinRoot.root _) * φ' (AdjoinRoot.root _) := by
  simp only [star, map_add, map_sub, map_mul, AlgHom.commutes, map_ofNat,
    Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one, one_mul]
  ring

variable {H H' : Type*} [Ring H] [Ring H'] [Algebra k H] [Algebra k H']

/-- The twist of two characters (page 137):
`t_{φ,φ'}(x, y) = Tr(y)φ(x) + Tr(x)φ'(y) − 2φ(x)φ'(y)`. -/
def twist (Tr : H →ₗ[k] k) (Tr' : H' →ₗ[k] k) (φ : H →ₐ[k] K) (φ' : H' →ₐ[k] K)
    (x : H) (y : H') : K :=
  algebraMap k K (Tr' y) * φ x + algebraMap k K (Tr x) * φ' y - 2 * φ x * φ' y

/-- `t_{φ,φ'}` is a twist: `T(x, 1) = Tr x` (for `Tr' 1 = 2`). -/
theorem twist_one_right (Tr : H →ₗ[k] k) (Tr' : H' →ₗ[k] k) (φ : H →ₐ[k] K)
    (φ' : H' →ₐ[k] K) (h : Tr' 1 = 2) (x : H) :
    twist Tr Tr' φ φ' x 1 = algebraMap k K (Tr x) := by
  simp [twist, h, map_ofNat]

/-- `t_{φ,φ'}` is a twist: `T(1, y) = Tr y` (for `Tr 1 = 2`). -/
theorem twist_one_left (Tr : H →ₗ[k] k) (Tr' : H' →ₗ[k] k) (φ : H →ₐ[k] K)
    (φ' : H' →ₐ[k] K) (h : Tr 1 = 2) (y : H') :
    twist Tr Tr' φ φ' 1 y = algebraMap k K (Tr' y) := by
  simp [twist, h, map_ofNat]

/-- Page 143: `t_{φ,φ'}(u, v) = (φ ⊗ φ')(u * v)`, for any traces with `Tr u = b`,
`Tr v = b'`. -/
theorem twist_eq_productMap (Tr : Hq b c →ₗ[k] k) (Tr' : Hq b' c' →ₗ[k] k)
    (hTr : Tr (AdjoinRoot.root _) = b) (hTr' : Tr' (AdjoinRoot.root _) = b')
    (φ : Hq b c →ₐ[k] K) (φ' : Hq b' c' →ₐ[k] K) :
    twist Tr Tr' φ φ' (AdjoinRoot.root _) (AdjoinRoot.root _)
      = Algebra.TensorProduct.productMap φ φ' (star b c b' c') := by
  rw [productMap_star, twist, hTr, hTr']

/-- Pages 138–139: `t = b'z + bz' − 2zz'` is a root of `Q` whenever `z`, `z'` are
roots of `z² − bz + c`, `z'² − b'z' + c'`: the twist of two characters lies on the
degenerate locus `S̃`. -/
theorem twist_root {z z' : K}
    (hz : z ^ 2 - algebraMap k K b * z + algebraMap k K c = 0)
    (hz' : z' ^ 2 - algebraMap k K b' * z' + algebraMap k K c' = 0) :
    (algebraMap k K b' * z + algebraMap k K b * z' - 2 * z * z') ^ 2
        - algebraMap k K (b * b') * (algebraMap k K b' * z + algebraMap k K b * z' - 2 * z * z')
        + algebraMap k K (b ^ 2 * c' + b' ^ 2 * c - 4 * c * c') = 0 := by
  simp only [map_mul, map_add, map_sub, map_pow, map_ofNat]
  linear_combination (2 * z' - algebraMap k K b') ^ 2 * hz
    + (algebraMap k K b ^ 2 - 4 * algebraMap k K c) * hz'

/-- The values of the twists of characters: `(φ ⊗ φ')(u * v)` is a root of `Q`. -/
theorem productMap_star_root (φ : Hq b c →ₐ[k] K) (φ' : Hq b' c' →ₐ[k] K) :
    (Algebra.TensorProduct.productMap φ φ' (star b c b' c')) ^ 2
        - algebraMap k K (b * b') * Algebra.TensorProduct.productMap φ φ' (star b c b' c')
        + algebraMap k K (b ^ 2 * c' + b' ^ 2 * c - 4 * c * c') = 0 := by
  have := congrArg (Algebra.TensorProduct.productMap φ φ') (star_root b c b' c')
  simpa only [map_add, map_sub, map_mul, map_pow, AlgHom.commutes, map_zero] using this

/-- Page 141: replacing `φ` by the conjugate character `φ ∘ σ` sends the twist `t`
to `bb' − t`, the involution of `S̃`. -/
theorem twist_conj (φ : Hq b c →ₐ[k] K) (φ' : Hq b' c' →ₐ[k] K) :
    Algebra.TensorProduct.productMap (φ.comp (conj b c)) φ' (star b c b' c')
      = algebraMap k K (b * b') - Algebra.TensorProduct.productMap φ φ' (star b c b' c') := by
  rw [productMap_star, productMap_star, AlgHom.comp_apply, conj_root]
  simp only [map_sub, AlgHom.commutes, map_mul]
  ring

end Product

end Grothendieck.Folder83
