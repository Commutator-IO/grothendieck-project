import Mathlib.CategoryTheory.Triangulated.Functor
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.GroupTheory.FreeAbelianGroup
import Mathlib.Tactic.Abel
import Mathlib.LinearAlgebra.Dimension.RankNullity
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# IHÉS FG_IL_5_SGA6_2_3, views 1–3: the group `K` of a triangulated category, and the Euler identity

Working notes headed « Groupes K » in the Fonds Grothendieck–Illusie (IHÉS). View 1: for a
triangulated category `C`, `K(C)` is the free abelian group on the objects divided by the
subgroup generated by `[X] − [X'] − [X'']` for each distinguished triangle `X' → X → X'' → X'[1]`;
`cl_C : Ob C → K(C)` is universal for the additive functions `χ`; then `χ(X[n]) = (−1)ⁿ χ(X)`,
`χ(X + Y) = χ(X) + χ(Y)`, and, in a list added in a darker ink, `χ(0) = 0` and `χ(X) = χ(X')` if
`X ≃ X'`. View 2: `cl_C` is surjective (a Proposition, through the monoid of isomorphism classes);
a Cor. giving `cl X = cl X'` iff `X + B + A[1] + C[1] ≃ X' + B' + A'[1] + C'[1]` for two
distinguished triangles; functoriality for exact functors. View 3, item 5 of a list of properties
of additive functions on an abelian category: `Σ (−1)ⁱ χ(Xⁱ) = Σ (−1)ⁱ χ(Hⁱ(X•))` for a finite
complex. The same identity is in the margin of view 2 of FG_IL_5_SGA6_2_1 (Prop. 1.1 and its
Cor. 2, for the alternating sum of classes).

Here `C` is a pretriangulated category in the sense of mathlib (`Pretriangulated C`; the octahedral
axiom is not used), and `K₀ C` is `FreeAbelianGroup C` modulo the relations, the edition's
encoding of `Z^(Ob C)`. Mathlib has no `K₀` of a triangulated category. The Euler identity is
proved for dimensions, the additive function `χ = dim` on finite-dimensional vector spaces.

**What is proved.**
* `cl_obj₂`, `lift`, `lift_cl`, `hom_ext`: the relation of a triangle and the universal property.
* `cl_zero`, `cl_eq_of_iso`, `cl_of_isZero`: `cl 0 = 0`, from the triangle `0 → 0 → 0 → 0`, and
  isomorphic objects have the same class, from `X → Y → 0 → X[1]`.
* `cl_shift_one`, `cl_shift`: `cl (X[1]) = − cl X`, by rotating `X → X → 0 → X[1]`, and
  `cl (X[n]) = (−1)ⁿ cl X` for `n : ℤ`.
* `cl_biprod`, `cl_sub`: `cl (X ⊞ Y) = cl X + cl Y`, from the split triangle, and
  `cl X − cl Y = cl (X ⊞ Y[1])`.
* `cl_surjective`: **the Proposition of view 2**, every element of `K(C)` is one `cl X`.
* `cl_eq_of_iso_biprod`: the « ⇐ » half of the Cor. of view 2.
* `map`, `map_cl`, `map_eq_of_iso`: an exact functor induces `K(φ)` with `cl X ↦ cl (φ X)`, and
  isomorphic functors induce the same map.
* `sum_finrank_eq_sum_finrank_cohomology`: **the Euler identity** for a complex of
  finite-dimensional vector spaces `V 0 → V 1 → ⋯ → V n → 0` over a division ring, indexed by `ℕ`
  with `d n = 0`: `∑_{i ≤ n} (−1)ⁱ dim Vⁱ = ∑_{i ≤ n} (−1)ⁱ dim Hⁱ`, with
  `Hⁱ = ker dⁱ / im dⁱ⁻¹` (`cohomology`). The proof is rank–nullity in each degree and a
  telescoping sum (`sum_alternating_telescope`).

**Not formalised.** The « ⇒ » half of the two-triangle Cor. (Thomason, Lemma 2.4), which needs
the page's monoid argument; the description of `K(C)` as the quotient of the monoid of
isomorphism classes; `K(φ)` an isomorphism for an equivalence; the exact sequence for a Verdier
quotient (marked « à vérifier » on view 3); § 2's comparison `K(C) ≅ K(D^b(C))` for an abelian
category, and the Euler identity for an arbitrary additive function or for finite-length modules.
-/

namespace Grothendieck.IhesSGA6_2_3

open CategoryTheory Limits Pretriangulated ZeroObject

section K₀

universe v u

variable (C : Type u) [Category.{v} C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]

/-- The relations `[Y] − [X] − [Z]`, one for each distinguished triangle `X → Y → Z → X[1]`. -/
def relations : AddSubgroup (FreeAbelianGroup C) :=
  AddSubgroup.closure {x | ∃ T ∈ distTriang C,
    x = FreeAbelianGroup.of T.obj₂ - FreeAbelianGroup.of T.obj₁ - FreeAbelianGroup.of T.obj₃}

/-- The group `K(C)`: the free abelian group on the objects of `C` divided by the relations
of the distinguished triangles. -/
abbrev K₀ : Type u := FreeAbelianGroup C ⧸ relations C

variable {C}

/-- The class `cl X` of an object in `K(C)`. -/
def cl (X : C) : K₀ C := QuotientAddGroup.mk (FreeAbelianGroup.of X)

/-- `cl Y = cl X + cl Z` for a distinguished triangle `X → Y → Z → X[1]`. -/
theorem cl_obj₂ (T : Triangle C) (hT : T ∈ distTriang C) :
    cl T.obj₂ = cl T.obj₁ + cl T.obj₃ := by
  have : FreeAbelianGroup.of T.obj₂ - FreeAbelianGroup.of T.obj₁ - FreeAbelianGroup.of T.obj₃ ∈
      relations C := AddSubgroup.subset_closure ⟨T, hT, rfl⟩
  have h := (QuotientAddGroup.eq_zero_iff _).mpr this
  rw [QuotientAddGroup.mk_sub, QuotientAddGroup.mk_sub, sub_sub, sub_eq_zero] at h
  exact h

/-- **Universal property**: an additive function `χ` on the objects (`χ Y = χ X + χ Z` on each
distinguished triangle) factors through `K(C)`. -/
def lift {A : Type*} [AddCommGroup A] (χ : C → A)
    (hχ : ∀ T ∈ distTriang C, χ T.obj₂ = χ T.obj₁ + χ T.obj₃) : K₀ C →+ A :=
  QuotientAddGroup.lift _ (FreeAbelianGroup.lift χ) <| (AddSubgroup.closure_le _).mpr <| by
    rintro _ ⟨T, hT, rfl⟩
    simp [hχ T hT]

@[simp]
theorem lift_cl {A : Type*} [AddCommGroup A] (χ : C → A)
    (hχ : ∀ T ∈ distTriang C, χ T.obj₂ = χ T.obj₁ + χ T.obj₃) (X : C) :
    lift χ hχ (cl X) = χ X :=
  FreeAbelianGroup.lift_apply_of χ X

/-- Two homomorphisms out of `K(C)` that agree on the classes are equal. -/
theorem hom_ext {A : Type*} [AddCommGroup A] {f g : K₀ C →+ A} (h : ∀ X, f (cl X) = g (cl X)) :
    f = g :=
  QuotientAddGroup.addMonoidHom_ext _ (FreeAbelianGroup.lift_ext _ _ h)

/-- `cl 0 = 0`, from the triangle `0 → 0 → 0 → 0`. -/
@[simp]
theorem cl_zero : cl (0 : C) = 0 := by
  have := cl_obj₂ _ (contractible_distinguished (0 : C))
  simpa using this

set_option backward.defeqAttrib.useBackward true in
/-- Isomorphic objects have the same class, from the triangle `X → Y → 0 → X[1]`. -/
theorem cl_eq_of_iso {X Y : C} (e : X ≅ Y) : cl X = cl Y := by
  have hT : Triangle.mk e.hom (0 : Y ⟶ 0) 0 ∈ distTriang C :=
    isomorphic_distinguished _ (contractible_distinguished X) _
      (Triangle.isoMk (Triangle.mk e.hom (0 : Y ⟶ 0) 0) (contractibleTriangle X) (Iso.refl _)
        e.symm (Iso.refl _) (by simp) (by simp) (by simp))
  have := cl_obj₂ _ hT
  simp only [Triangle.mk_obj₂, Triangle.mk_obj₁, Triangle.mk_obj₃, cl_zero, add_zero] at this
  exact this.symm

/-- A zero object has class `0`. -/
theorem cl_of_isZero {X : C} (hX : IsZero X) : cl X = 0 := by
  rw [cl_eq_of_iso (hX.isoZero), cl_zero]

/-- `cl (X[1]) = − cl X`, by rotating the triangle `X → X → 0 → X[1]`. -/
@[simp]
theorem cl_shift_one (X : C) : cl (X⟦(1 : ℤ)⟧) = - cl X := by
  have := cl_obj₂ _ (rot_of_distTriang _ (contractible_distinguished X))
  simp only [Triangle.rotate_obj₂, Triangle.rotate_obj₁, Triangle.rotate_obj₃,
    contractibleTriangle_obj₃, contractibleTriangle_obj₂, contractibleTriangle_obj₁,
    cl_zero] at this
  rw [eq_neg_iff_add_eq_zero, add_comm]
  exact this.symm

/-- `cl (X[n]) = (−1)ⁿ cl X` for every `n : ℤ`. -/
theorem cl_shift (X : C) (n : ℤ) : cl (X⟦n⟧) = n.negOnePow • cl X := by
  induction n using Int.induction_on with
  | zero => simpa using cl_eq_of_iso ((shiftFunctorZero C ℤ).app X)
  | succ n ih =>
    rw [cl_eq_of_iso ((shiftFunctorAdd' C (n : ℤ) 1 ((n : ℤ) + 1) rfl).app X),
      Functor.comp_obj, cl_shift_one, ih, Int.negOnePow_succ, Units.neg_smul]
  | pred n ih =>
    have h := cl_eq_of_iso ((shiftFunctorAdd' C (-(n : ℤ) - 1) 1 (-(n : ℤ)) (by omega)).app X)
    rw [Functor.comp_obj, cl_shift_one, ih] at h
    rw [Int.negOnePow_sub, Int.negOnePow_one, mul_neg, mul_one, Units.neg_smul, h, neg_neg]

/-- `cl (X ⊞ Y) = cl X + cl Y`, from the split triangle `X → X ⊞ Y → Y → X[1]`. -/
@[simp]
theorem cl_biprod (X Y : C) : cl (X ⊞ Y) = cl X + cl Y :=
  cl_obj₂ _ (binaryBiproductTriangle_distinguished X Y)

/-- `cl X − cl Y = cl (X ⊞ Y[1])`. -/
theorem cl_sub (X Y : C) : cl X - cl Y = cl (X ⊞ Y⟦(1 : ℤ)⟧) := by
  rw [cl_biprod, cl_shift_one, sub_eq_add_neg]

/-- **Proposition** of view 2: `cl : Ob C → K(C)` is surjective, every element of `K(C)` is the
class of one object. -/
theorem cl_surjective : Function.Surjective (cl : C → K₀ C) := by
  intro x
  induction x using QuotientAddGroup.induction_on with
  | H z =>
    induction z using FreeAbelianGroup.induction_on with
    | zero => exact ⟨0, cl_zero⟩
    | of X => exact ⟨X, rfl⟩
    | neg X _ => exact ⟨X⟦(1 : ℤ)⟧, by rw [cl_shift_one]; rfl⟩
    | add a b ha hb =>
      obtain ⟨X, hX⟩ := ha
      obtain ⟨Y, hY⟩ := hb
      exact ⟨X ⊞ Y, by rw [cl_biprod, hX, hY]; rfl⟩


/-- The easy half of the **Cor.** of view 2 (the two-triangle criterion): if
`X ⊕ B ⊕ A[1] ⊕ C[1] ≅ X' ⊕ B' ⊕ A'[1] ⊕ C'[1]` for two distinguished triangles
`A → B → C → A[1]` and `A' → B' → C' → A'[1]`, then `cl X = cl X'`. -/
theorem cl_eq_of_iso_biprod {X X' : C} (T T' : Triangle C) (hT : T ∈ distTriang C)
    (hT' : T' ∈ distTriang C)
    (e : X ⊞ (T.obj₂ ⊞ (T.obj₁⟦(1 : ℤ)⟧ ⊞ T.obj₃⟦(1 : ℤ)⟧)) ≅
      X' ⊞ (T'.obj₂ ⊞ (T'.obj₁⟦(1 : ℤ)⟧ ⊞ T'.obj₃⟦(1 : ℤ)⟧))) :
    cl X = cl X' := by
  have h := cl_eq_of_iso e
  simp only [cl_biprod, cl_shift_one, cl_obj₂ T hT, cl_obj₂ T' hT'] at h
  have k : ∀ a b : K₀ C, a + b + (-a + -b) = 0 := fun a b => by abel
  rwa [k, k, add_zero, add_zero] at h

end K₀

section Functoriality

universe v₁ v₂ u₁ u₂

variable {C : Type u₁} [Category.{v₁} C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
  {D : Type u₂} [Category.{v₂} D] [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]

/-- **Fonctorialité**: an exact (triangulated) functor `φ : C ⥤ D` induces
`K(φ) : K(C) → K(D)`, `cl X ↦ cl (φ X)`. -/
def map (F : C ⥤ D) [F.CommShift ℤ] [F.IsTriangulated] : K₀ C →+ K₀ D :=
  lift (fun X => cl (F.obj X)) fun T hT => cl_obj₂ _ (F.map_distinguished T hT)

@[simp]
theorem map_cl (F : C ⥤ D) [F.CommShift ℤ] [F.IsTriangulated] (X : C) :
    map F (cl X) = cl (F.obj X) :=
  lift_cl _ _ X

/-- Isomorphic exact functors induce the same map. -/
theorem map_eq_of_iso {F G : C ⥤ D} [F.CommShift ℤ] [F.IsTriangulated] [G.CommShift ℤ]
    [G.IsTriangulated] (e : F ≅ G) : map F = map G :=
  hom_ext fun X => by rw [map_cl, map_cl, cl_eq_of_iso (e.app X)]

end Functoriality

section Euler

/-- The telescoping behind the Euler identity: if `b 0 = 0` and `b (i+1) = r i`, the alternating
sum of the `r i + b i` up to `n` is `(-1)ⁿ r n`. -/
theorem sum_alternating_telescope (r b : ℕ → ℤ) (h0 : b 0 = 0) (hb : ∀ i, b (i + 1) = r i)
    (n : ℕ) : ∑ i ∈ Finset.range (n + 1), (-1 : ℤ) ^ i * (r i + b i) = (-1) ^ n * r n := by
  induction n with
  | zero => simp [h0]
  | succ n ih => rw [Finset.sum_range_succ, ih, hb, pow_succ]; ring

variable {K : Type*} [DivisionRing K] {V : ℕ → Type*} [∀ i, AddCommGroup (V i)]
  [∀ i, Module K (V i)] (d : ∀ i, V i →ₗ[K] V (i + 1))

/-- The coboundaries `im dⁱ⁻¹` in degree `i`, as a subspace of the cocycles `ker dⁱ`. -/
def coboundaries : (i : ℕ) → Submodule K (LinearMap.ker (d i))
  | 0 => ⊥
  | i + 1 => (LinearMap.range (d i)).comap (LinearMap.ker (d (i + 1))).subtype

/-- The cohomology `Hⁱ = ker dⁱ / im dⁱ⁻¹` of the complex `V 0 → V 1 → ⋯`. -/
abbrev cohomology (i : ℕ) : Type _ := LinearMap.ker (d i) ⧸ coboundaries d i

/-- **The Euler identity** (item 5 of view 3): for a complex of finite-dimensional vector spaces
`V 0 → V 1 → ⋯ → V n → 0` (the differential `d n` is zero),
`∑ (-1)ⁱ dim Vⁱ = ∑ (-1)ⁱ dim Hⁱ`, the sums over `0 ≤ i ≤ n`. -/
theorem sum_finrank_eq_sum_finrank_cohomology [∀ i, FiniteDimensional K (V i)]
    (hd : ∀ i, d (i + 1) ∘ₗ d i = 0) (n : ℕ) (hn : d n = 0) :
    ∑ i ∈ Finset.range (n + 1), (-1 : ℤ) ^ i * Module.finrank K (V i) =
      ∑ i ∈ Finset.range (n + 1), (-1 : ℤ) ^ i * Module.finrank K (cohomology d i) := by
  set r : ℕ → ℤ := fun i => Module.finrank K (LinearMap.range (d i))
  set b : ℕ → ℤ := fun i => Module.finrank K (coboundaries d i)
  have hV : ∀ i, (Module.finrank K (V i) : ℤ) =
      Module.finrank K (cohomology d i) + (r i + b i) := by
    intro i
    have h1 := LinearMap.finrank_range_add_finrank_ker (d i)
    have h2 : Module.finrank K (cohomology d i) + Module.finrank K (coboundaries d i) =
        Module.finrank K (LinearMap.ker (d i)) := Submodule.finrank_quotient_add_finrank _
    simp only [r, b]
    omega
  have h0 : b 0 = 0 := by
    change ((Module.finrank K (⊥ : Submodule K (LinearMap.ker (d 0))) : ℕ) : ℤ) = 0
    rw [finrank_bot, Nat.cast_zero]
  have hb : ∀ i, b (i + 1) = r i := by
    intro i
    have hle : LinearMap.range (d i) ≤ LinearMap.ker (d (i + 1)) := by
      rintro _ ⟨x, rfl⟩
      exact congrArg (· x) (hd i)
    change ((Module.finrank K ((LinearMap.range (d i)).comap
      (LinearMap.ker (d (i + 1))).subtype) : ℕ) : ℤ) = Module.finrank K (LinearMap.range (d i))
    rw [(Submodule.comapSubtypeEquivOfLe hle).finrank_eq]
  have hrn : r n = 0 := by
    change ((Module.finrank K (LinearMap.range (d n)) : ℕ) : ℤ) = 0
    rw [hn, LinearMap.range_zero, finrank_bot, Nat.cast_zero]
  rw [Finset.sum_congr rfl fun i _ => by rw [hV i, mul_add], Finset.sum_add_distrib,
    sum_alternating_telescope r b h0 hb, hrn, mul_zero, add_zero]

end Euler

end Grothendieck.IhesSGA6_2_3
