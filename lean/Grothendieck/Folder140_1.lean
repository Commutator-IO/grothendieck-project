import Grothendieck.Folder146

/-!
# Folder 140-1, pages 22 and 24: `H¹(U_{0,3}, 𝔖₃; 𝔾_m) ≃ ℤ/6`

The modernised reading `transcripts/140-1/140-1.modern.tex` (« Le lemme :
`H¹(U_{0,3}, 𝔖₃; 𝔾_m) ≃ ℤ/6` ») gives the boxed lemma of page 22: for `S` regular integral
with `Pic(S) = 0`, the group of `𝔖₃`-equivariant `𝔾_m`-torsors on `U_{0,3} = ℙ¹ − {0, 1, ∞}`
is `ℤ/6`, and `ℤ/3` in generic characteristic `2`. A marginal note bounds it by two exact
sequences: the equivariant `H¹` is `H¹(𝔖₃, O(U_{0,3})^*)`, and
`0 → O(S)^* → O(U_{0,3})^* → V(J) → 0` with `V(J) = Ker(ℤ^J → ℤ)` the divisors of the units.
The reading adds the computations the page does not write: `H¹(𝔖₃, O(S)^*) = μ₂(S)` and
`H¹(𝔖₃, V(J)) = ℤ/3`, hence an order dividing `6` (resp. `3`). This is the reachable part of
finding `140-1-equivariant-pic-u03` of `src/content/findings.ts`.

`H¹` is mathlib's group cohomology `groupCohomology.H1` of the representation
`Rep.ofDistribMulAction ℤ G M`; `H1Equiv` identifies it with cocycles modulo coboundaries
(`Z1`, `B1`, `Q`), where the work is done.

* `exact_mapQ`, `card_dvd_of_exact`: for a short exact sequence `0 → A → M → N → 0` of
  `G`-modules, `H¹(A) → H¹(M) → H¹(N)` is exact in the middle, so `|H¹(M)|` divides
  `|H¹(A)| |H¹(N)|`.
* `card_H1_VJ` (with `H1_VJ`): `H¹(𝔖₃, V(J)) ≃ ℤ/3`. A cocycle `f` with values in `V(J)` is the
  coboundary, in `ℤ^J`, of its potential `m_j = −f(τ_j)_j` (`τ_j` the transposition of `0` and
  `j`, `cocycle_eq_pot`): this is `H¹(𝔖₃, ℤ^J) = 0` made explicit; its class is `∑ m_j mod 3`.
* `card_H1_triv`, `card_mu2_dvd`, `card_mu2_char_two`: for `k` a domain and the trivial
  action, `H¹(𝔖₃, k^*) = Hom(𝔖₃, k^*) = μ₂(k)`, of order dividing `2`, and `1` if `2 = 0`.
* `card_H1_dvd`: the « majoration » — for every extension `0 → k^* → M → V(J) → 0` of
  `𝔖₃`-modules, `|H¹(𝔖₃, M)|` divides `6`, and `3` if `2 = 0` in `k`.

The lower bound of page 24, in a model of the units:
* `Units3 k = k^* × V(J)`, `c λ^a (1 − λ)^b ↦ (c, (a, b, −a − b))`, with the anharmonic action
  (`sgnExp` records the signs, as `λ/(λ − 1) = −λ (1 − λ)⁻¹`); over a field, `ev_smul_lam`,
  `ev_smul_lam'`, `smul_incl` check it against the substitutions `Folder146.anh` evaluated at
  the points of `U`, and `card_H1_units_dvd` is the bound for it.
* `tan`: the tangent cocycle `σ ↦ (h⁻¹)′(λ)`, constant `sign σ`, divisor `2[∞] − 2[σ(∞)]`
  (`ev_tan` against `Folder146.der`). `dvd_of_zsmul_tan`: if `m [tan] = 0` then `3 ∣ m`
  (its divisor is twice the generator of `H¹(𝔖₃, V(J))`), and `2 ∣ m` if `2 ≠ 0` (its constant
  at the transposition of `0` and `1`, which fixes `∞`, is `−1`).
* `H1_units`: for a domain `k` with `2 ≠ 0`, `H¹(𝔖₃, Units3 k) ≃ ℤ/6`, generated by the tangent
  class; `H1_units_char_two`: `ℤ/3` when `2 = 0`. Characteristic `3` is covered.

Not formalised: that `O(U_{0,3})^*` is `Units3 k` (the units of `k[λ, 1/λ, 1/(1 − λ)]`),
`Pic(U_{0,3}) = 0` and the Hochschild–Serre sequence identifying `Pic` of the quotient stack with
`H¹`, and the page's generator `O(1)` on `ℙ(V_J)`: the generator here is the tangent class.
-/

namespace Grothendieck.Folder140_1

open groupCohomology

/-! ## Cocycles modulo coboundaries -/

section General

variable {G : Type} [Group G]

/-- The `ℤ`-linear representation of `G` on an abelian group with a distributive action. -/
abbrev R (G M : Type) [Group G] [AddCommGroup M] [DistribMulAction G M] : Rep ℤ G :=
  Rep.ofDistribMulAction ℤ G M

variable {M N : Type} [AddCommGroup M] [DistribMulAction G M] [AddCommGroup N]
  [DistribMulAction G N]

variable (G M) in
/-- The 1-cocycles `f(gh) = g f(h) + f(g)`. -/
def Z1 : AddSubgroup (G → M) where
  carrier := {f | IsCocycle₁ f}
  add_mem' {f f'} hf hf' g h := by
    simp only [Pi.add_apply, hf g h, hf' g h, smul_add]; abel
  zero_mem' g h := by simp
  neg_mem' {f} hf g h := by simp only [Pi.neg_apply, hf g h, smul_neg]; abel

lemma Z1_apply_mul (f : Z1 G M) (g h : G) : (f : G → M) (g * h) = g • f.1 h + f.1 g := f.2 g h

variable (G M) in
/-- The 1-coboundaries `g ↦ g m - m`, inside the cocycles. -/
def B1 : AddSubgroup (Z1 G M) where
  carrier := {f | IsCoboundary₁ (f : G → M)}
  add_mem' {f f'} := fun ⟨x, hx⟩ ⟨x', hx'⟩ => ⟨x + x', fun g => by
    change g • (x + x') - (x + x') = (f : G → M) g + (f' : G → M) g
    rw [smul_add, ← hx, ← hx']
    abel⟩
  zero_mem' := ⟨0, fun g => by simp⟩
  neg_mem' {f} := fun ⟨x, hx⟩ => ⟨-x, fun g => by
    change g • (-x) - (-x) = -(f : G → M) g
    rw [smul_neg, ← hx]
    abel⟩

variable (G M) in
/-- `Z¹ / B¹`. -/
abbrev Q := Z1 G M ⧸ B1 G M

/-- Mathlib's cocycles are these cocycles. -/
def cocyclesEquiv : cocycles₁ (R G M) ≃+ Z1 G M where
  toFun f := ⟨f.1, isCocycle₁_of_mem_cocycles₁ _ f.2⟩
  invFun f := ⟨f.1, (cocyclesOfIsCocycle₁ (k := ℤ) f.2).2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl

variable (G M) in
/-- `H¹(G, M)` (Mathlib's, for the representation on `M`) is cocycles modulo coboundaries. -/
noncomputable def H1Equiv : Q G M ≃+ H1 (R G M) :=
  let ψ : Z1 G M →+ H1 (R G M) :=
    (H1π (R G M)).hom.toAddMonoidHom.comp (cocyclesEquiv (G := G) (M := M)).symm.toAddMonoidHom
  have hψ : Function.Surjective ψ := fun y => by
    obtain ⟨x, hx⟩ := (ModuleCat.epi_iff_surjective (H1π (R G M))).1 inferInstance y
    exact ⟨cocyclesEquiv x, by simpa [ψ] using hx⟩
  have hk : ψ.ker = B1 G M := by
    ext f
    change (H1π (R G M)) (cocyclesEquiv.symm f) = 0 ↔ IsCoboundary₁ (f : G → M)
    rw [H1π_eq_zero_iff]
    exact ⟨isCoboundary₁_of_mem_coboundaries₁ _,
      fun h => (coboundariesOfIsCoboundary₁ (k := ℤ) h).2⟩
  (QuotientAddGroup.quotientAddEquivOfEq hk.symm).trans
    (QuotientAddGroup.quotientKerEquivOfSurjective ψ hψ)

lemma card_H1 : Nat.card (H1 (R G M)) = Nat.card (Q G M) :=
  (Nat.card_congr (H1Equiv G M).toEquiv).symm

/-- A `G`-map `M → N` on cocycles. -/
def mapZ (φ : M →+ N) (hφ : ∀ (g : G) m, φ (g • m) = g • φ m) : Z1 G M →+ Z1 G N where
  toFun f := ⟨φ ∘ f, fun g h => by simp [Z1_apply_mul, hφ]⟩
  map_zero' := by ext; simp
  map_add' f f' := by ext; simp

@[simp] lemma mapZ_apply (φ : M →+ N) (hφ : ∀ (g : G) m, φ (g • m) = g • φ m)
    (f : Z1 G M) (g : G) : (mapZ φ hφ f : G → N) g = φ ((f : G → M) g) := rfl

/-- A `G`-map `M → N` on `Z¹/B¹`. -/
def mapQ (φ : M →+ N) (hφ : ∀ (g : G) m, φ (g • m) = g • φ m) : Q G M →+ Q G N :=
  QuotientAddGroup.map _ _ (mapZ φ hφ) fun f hf => by
    obtain ⟨x, hx⟩ := hf
    exact ⟨φ x, fun g => by simp [← hx, hφ]⟩

variable {A : Type} [AddCommGroup A] [DistribMulAction G A]

/-- Exactness in the middle of `H¹(A) → H¹(M) → H¹(N)` for a short exact sequence of
`G`-modules. -/
theorem exact_mapQ (i : A →+ M) (p : M →+ N) (hi : ∀ (g : G) a, i (g • a) = g • i a)
    (hp : ∀ (g : G) m, p (g • m) = g • p m) (hinj : Function.Injective i)
    (hsurj : Function.Surjective p) (hex : ∀ m, p m = 0 ↔ ∃ a, i a = m) :
    (mapQ p hp).ker = (mapQ i hi).range := by
  ext x
  induction x using QuotientAddGroup.induction_on with | H f
  rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
  change (QuotientAddGroup.mk (mapZ p hp f) : Q G N) = 0 ↔ _
  rw [QuotientAddGroup.eq_zero_iff]
  constructor
  · rintro ⟨v, hv⟩
    obtain ⟨m, rfl⟩ := hsurj v
    have h0 : ∀ g, p ((f : G → M) g - (g • m - m)) = 0 := fun g => by
      rw [map_sub, map_sub, hp, hv g, mapZ_apply, sub_self]
    choose a ha using fun g => (hex _).1 (h0 g)
    have hac : IsCocycle₁ a := fun g h => hinj (by
      rw [map_add, hi, ha, ha, ha, Z1_apply_mul, mul_smul]; simp only [smul_sub]; abel)
    refine ⟨QuotientAddGroup.mk ⟨a, hac⟩, ?_⟩
    change (QuotientAddGroup.mk (mapZ i hi ⟨a, hac⟩) : Q G M) = QuotientAddGroup.mk f
    rw [QuotientAddGroup.eq]
    exact ⟨m, fun g => by
      change _ = -i (a g) + (f : G → M) g
      rw [ha]; abel⟩
  · rintro ⟨y, hy⟩
    induction y using QuotientAddGroup.induction_on with | H a
    change (QuotientAddGroup.mk (mapZ i hi a) : Q G M) = QuotientAddGroup.mk f at hy
    rw [QuotientAddGroup.eq] at hy
    obtain ⟨m, hm⟩ := hy
    refine ⟨p m, fun g => ?_⟩
    have := congrArg p (hm g)
    change p (g • m - m) = p (-i ((a : G → A) g) + (f : G → M) g) at this
    have hpi : p (i ((a : G → A) g)) = 0 := (hex _).2 ⟨_, rfl⟩
    rw [← hp, ← map_sub, this, map_add, map_neg, hpi, neg_zero, zero_add]
    rfl

/-- In an exact sequence `P → Q' → S` of abelian groups, `|Q'|` divides `|P| |S|`. -/
lemma card_dvd_of_exact {P Q' S : Type} [AddCommGroup P] [AddCommGroup Q'] [AddCommGroup S]
    (α : P →+ Q') (β : Q' →+ S) (h : β.ker = α.range) :
    Nat.card Q' ∣ Nat.card P * Nat.card S := by
  rw [← AddSubgroup.card_ker_mul_card_range β, h]
  exact mul_dvd_mul (AddSubgroup.card_range_dvd α) (AddSubgroup.card_addSubgroup_dvd_card _)

end General

/-! ## `𝔖₃` and `V(J)` -/

/-- `𝔖₃ = 𝔖_J`, `J = {0, 1, 2}`. -/
abbrev G3 := Equiv.Perm (Fin 3)

/-- `V(J) = Ker(ℤ^J → ℤ)`, the divisors of the units of `U_{0,3}`. -/
def VJ : AddSubgroup (Fin 3 → ℤ) where
  carrier := {x | ∑ j, x j = 0}
  add_mem' {x y} hx hy := by simp_all [Finset.sum_add_distrib]
  zero_mem' := by simp
  neg_mem' {x} hx := by simp_all

lemma sum_perm (σ : G3) (x : Fin 3 → ℤ) : ∑ j, x (σ⁻¹ j) = ∑ j, x j :=
  Equiv.sum_comp σ⁻¹ x

/-- `𝔖₃` permutes the coordinates: `(σ x)_j = x_{σ⁻¹ j}`. -/
instance : DistribMulAction G3 VJ where
  smul σ x := ⟨fun j => (x : Fin 3 → ℤ) (σ⁻¹ j), (sum_perm σ x).trans x.2⟩
  one_smul x := rfl
  mul_smul σ τ x := by ext j; rfl
  smul_zero σ := rfl
  smul_add σ x y := rfl

@[simp] lemma smul_VJ (σ : G3) (x : VJ) (j : Fin 3) :
    ((σ • x : VJ) : Fin 3 → ℤ) j = (x : Fin 3 → ℤ) (σ⁻¹ j) := rfl

lemma stab_sq : ∀ s : G3, s 0 = 0 → s * s = 1 := by decide

/-- The potential `m_j = -f(swap 0 j)_j` of a cocycle. -/
def pot (f : G3 → VJ) (j : Fin 3) : ℤ := -(f (Equiv.swap 0 j) : Fin 3 → ℤ) j

/-- `H¹(𝔖₃, ℤ^J) = 0`, explicitly: a cocycle with values in `V(J)` is the coboundary of its
potential in `ℤ^J`. -/
lemma cocycle_eq_pot {f : G3 → VJ} (hf : IsCocycle₁ f) (g : G3) (j : Fin 3) :
    (f g : Fin 3 → ℤ) j = pot f (g⁻¹ j) - pot f j := by
  have h1 : f 1 = 0 := by simpa using hf 1 1
  have hs : ∀ s : G3, s 0 = 0 → (f s : Fin 3 → ℤ) 0 = 0 := fun s hs0 => by
    have := congrArg (fun x : VJ => (x : Fin 3 → ℤ) 0) (hf s s)
    have hinv : s⁻¹ 0 = 0 := by rw [Equiv.Perm.inv_eq_iff_eq, hs0]
    simp only [stab_sq s hs0, h1, AddSubgroup.coe_add, Pi.add_apply, smul_VJ, hinv,
      ZeroMemClass.coe_zero, Pi.zero_apply] at this
    omega
  set k := g⁻¹ j
  set s : G3 := (Equiv.swap 0 j)⁻¹ * g * Equiv.swap 0 k with hsdef
  have hs0 : s 0 = 0 := by simp [hsdef, k, Equiv.swap_inv]
  have hgs : g * Equiv.swap 0 k = Equiv.swap 0 j * s := by simp [hsdef, ← mul_assoc]
  have hf' : ∀ g h, f (g * h) = g • f h + f g := hf
  have e := congrArg (fun x : VJ => (x : Fin 3 → ℤ) j) (congrArg f hgs)
  simp only [hf', AddSubgroup.coe_add, Pi.add_apply, smul_VJ, Equiv.swap_inv,
    Equiv.swap_apply_right, hs s hs0] at e
  simp only [pot, k] at e ⊢
  omega

/-- The class of a cocycle: the sum of its potential, modulo `3`. -/
def psi : Z1 G3 VJ →+ ZMod 3 where
  toFun f := ((∑ j, pot f j : ℤ) : ZMod 3)
  map_zero' := by simp [pot]
  map_add' f f' := by
    simp only [pot, AddSubgroup.coe_add, Pi.add_apply, Finset.sum_add_distrib, neg_add]
    push_cast; ring

lemma psi_eq_zero_iff (f : Z1 G3 VJ) : psi f = 0 ↔ IsCoboundary₁ (f : G3 → VJ) := by
  have hf : IsCocycle₁ (f : G3 → VJ) := f.2
  change ((∑ j, pot f j : ℤ) : ZMod 3) = 0 ↔ _
  rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
  constructor
  · rintro ⟨t, ht⟩
    refine ⟨⟨fun j => pot f j - t, ?_⟩, fun g => ?_⟩
    · change ∑ j, (pot f j - t) = 0
      rw [Finset.sum_sub_distrib, ht]; simp
    · ext j
      simp [cocycle_eq_pot hf g j]
  · rintro ⟨v, hv⟩
    refine ⟨-(v : Fin 3 → ℤ) 0, ?_⟩
    have hp : ∀ j, pot f j = (v : Fin 3 → ℤ) j - (v : Fin 3 → ℤ) 0 := fun j => by
      simp [pot, ← hv, Equiv.swap_inv]
    have hv0 : ∑ j, (v : Fin 3 → ℤ) j = 0 := v.2
    simp [hp, Finset.sum_sub_distrib, hv0]

/-- The first basis vector of `ℤ^J`. -/
def e0 : Fin 3 → ℤ := fun j => if j = 0 then 1 else 0

/-- Its coboundary in `ℤ^J`, a cocycle with values in `V(J)`. -/
def f0 : Z1 G3 VJ :=
  ⟨fun g => ⟨fun j => e0 (g⁻¹ j) - e0 j, by
      change ∑ j, (e0 (g⁻¹ j) - e0 j) = 0
      rw [Finset.sum_sub_distrib, sum_perm g e0, sub_self]⟩,
    fun g h => by ext j; simp [mul_inv_rev]⟩

lemma psi_f0 : psi f0 = 1 := by
  change ((∑ j, pot f0 j : ℤ) : ZMod 3) = 1
  simp only [pot, f0, Fin.sum_univ_three, Equiv.swap_inv, e0, Fin.isValue, sub_self,
    Equiv.swap_apply_right, neg_sub, zero_add, Int.cast_add, Int.cast_sub]
  decide

lemma psi_surjective : Function.Surjective psi := fun z => ⟨(z.val : ℤ) • f0, by
  rw [map_zsmul, psi_f0]; simp⟩

/-- `H¹(𝔖₃, V(J)) ≃ ℤ/3`, the reading's computation for the marginal note of page 22. -/
noncomputable def H1_VJ : Q G3 VJ ≃+ ZMod 3 :=
  (QuotientAddGroup.quotientAddEquivOfEq (by
      ext f; rw [AddMonoidHom.mem_ker, psi_eq_zero_iff]; rfl)).trans
    (QuotientAddGroup.quotientKerEquivOfSurjective psi psi_surjective)

theorem card_H1_VJ : Nat.card (H1 (R G3 VJ)) = 3 := by
  rw [card_H1, Nat.card_congr H1_VJ.toEquiv, Nat.card_zmod]

/-! ## Constants: `H¹(𝔖₃, k^*) = μ₂(k)` -/

/-- The units of a ring `k` (the units of the base `S`), written additively, with the trivial
action of `𝔖₃`. -/
def Triv (k : Type) [CommRing k] := Additive kˣ

instance (k : Type) [CommRing k] : AddCommGroup (Triv k) :=
  inferInstanceAs (AddCommGroup (Additive kˣ))

instance (k : Type) [CommRing k] : DistribMulAction G3 (Triv k) where
  smul _ x := x
  one_smul _ := rfl
  mul_smul _ _ _ := rfl
  smul_zero _ := rfl
  smul_add _ _ _ := rfl

variable {k : Type} [CommRing k]

@[simp] lemma smul_triv (g : G3) (x : Triv k) : g • x = x := rfl

/-- The elements of order dividing `2`: `μ₂(k)`, written additively. -/
def mu2 (k : Type) [CommRing k] := {x : Triv k // x + x = 0}

/-- The odd permutations go to `x`, the even ones to `0`. -/
def signCocycle (x : mu2 k) : Z1 G3 (Triv k) :=
  ⟨fun g => if Equiv.Perm.sign g = 1 then 0 else x.1, fun g h => by
    have hx := x.2
    simp only [smul_triv, map_mul]
    rcases Int.units_eq_one_or (Equiv.Perm.sign g) with hg | hg <;>
    rcases Int.units_eq_one_or (Equiv.Perm.sign h) with hh | hh <;>
    simp [hg, hh, hx]⟩

lemma perm3_cases : ∀ g : G3, g = 1 ∨ g = Equiv.swap 0 1 ∨ g = Equiv.swap 1 2 ∨
    g = Equiv.swap 0 1 * Equiv.swap 1 2 ∨ g = Equiv.swap 1 2 * Equiv.swap 0 1 ∨
    g = Equiv.swap 0 1 * Equiv.swap 1 2 * Equiv.swap 0 1 := by decide

section Triv

variable (f : Z1 G3 (Triv k))

lemma cocycle_triv_mul (g h : G3) : (f : G3 → Triv k) (g * h) = f.1 h + f.1 g := f.2 g h

lemma cocycle_triv_one : (f : G3 → Triv k) 1 = 0 := by simpa using cocycle_triv_mul f 1 1

lemma cocycle_triv_two : (f : G3 → Triv k) (Equiv.swap 0 1) + f.1 (Equiv.swap 0 1) = 0 := by
  rw [← cocycle_triv_mul, show Equiv.swap (0 : Fin 3) 1 * Equiv.swap 0 1 = 1 by decide]
  exact cocycle_triv_one f

/-- A cocycle for the trivial action is the sign cocycle of its value at a transposition. -/
lemma cocycle_triv_eq : f = signCocycle ⟨_, cocycle_triv_two f⟩ := by
  have h1 := cocycle_triv_one f
  have haa : f.1 (Equiv.swap 0 1) + f.1 (Equiv.swap 0 1) = 0 := cocycle_triv_two f
  have e := congrArg f.1 (show Equiv.swap (0 : Fin 3) 1 * Equiv.swap 1 2 * Equiv.swap 0 1 =
    Equiv.swap 1 2 * Equiv.swap 0 1 * Equiv.swap 1 2 by decide)
  simp only [cocycle_triv_mul] at e
  have key : f.1 (Equiv.swap 1 2) = f.1 (Equiv.swap 0 1) := by
    linear_combination (norm := module) -e
  have sa : Equiv.Perm.sign (Equiv.swap (0 : Fin 3) 1) = -1 := by decide
  have sb : Equiv.Perm.sign (Equiv.swap (1 : Fin 3) 2) = -1 := by decide
  apply Subtype.ext
  funext g
  rcases perm3_cases g with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp only [signCocycle, cocycle_triv_mul, h1, key, map_mul, sa, sb, map_one] <;>
    simp [haa]

end Triv

/-- Cocycles for the trivial action are `μ₂(k)`, by the value at a transposition. -/
def cocyclesTrivEquiv : Z1 G3 (Triv k) ≃ mu2 k where
  toFun f := ⟨_, cocycle_triv_two f⟩
  invFun := signCocycle
  left_inv f := (cocycle_triv_eq f).symm
  right_inv x := Subtype.ext (by simp [signCocycle])

lemma B1_triv : B1 G3 (Triv k) = ⊥ :=
  eq_bot_iff.2 fun _ ⟨x, hx⟩ =>
    AddSubgroup.mem_bot.2 (Subtype.ext (funext fun g => by simp [← hx g]))

/-- `H¹(𝔖₃, k^*) = Hom(𝔖₃, k^*) = μ₂(k)` for the trivial action. -/
theorem card_H1_triv : Nat.card (H1 (R G3 (Triv k))) = Nat.card (mu2 k) := by
  rw [card_H1, Nat.card_congr ((QuotientAddGroup.quotientAddEquivOfEq B1_triv).trans
    QuotientAddGroup.quotientBot).toEquiv, Nat.card_congr cocyclesTrivEquiv]

/-- An element of `μ₂(k)`, as an element of `k`. -/
def val (x : mu2 k) : k := ((Additive.toMul (show Additive kˣ from x.1) : kˣ) : k)

/-- An element of `μ₂(k)` is `1` or `-1` when `k` is a domain. -/
lemma mu2_eq [IsDomain k] (x : mu2 k) : val x = 1 ∨ val x = -1 :=
  mul_self_eq_one_iff.1
    (show val x * val x = 1 from congrArg Units.val (congrArg Additive.toMul x.2))

lemma mu2_ext {x y : mu2 k} (h : val x = val y) : x = y :=
  Subtype.ext (Additive.toMul.injective (Units.ext h))

/-- `μ₂(k)` has one or two elements: its order divides `2`. -/
theorem card_mu2_dvd [IsDomain k] : Nat.card (mu2 k) ∣ 2 := by
  classical
  let ψ : mu2 k → ({1, -1} : Finset k) := fun x => ⟨val x, by
    rcases mu2_eq x with h | h <;> simp [h]⟩
  have hψ : Function.Injective ψ := fun x y h => mu2_ext (congrArg Subtype.val h)
  have : Finite (mu2 k) := Finite.of_injective ψ hψ
  have : Nonempty (mu2 k) := ⟨⟨0, add_zero 0⟩⟩
  have h1 := Nat.card_pos (α := mu2 k)
  have h2 : Nat.card (mu2 k) ≤ 2 := (Nat.card_le_card_of_injective ψ hψ).trans (by
    rw [Nat.card_eq_fintype_card, Fintype.card_coe]; exact Finset.card_le_two)
  interval_cases h : Nat.card (mu2 k) <;> simp

/-- In characteristic `2`, `μ₂(k)` is trivial. -/
theorem card_mu2_char_two [IsDomain k] (h2 : (2 : k) = 0) : Nat.card (mu2 k) = 1 := by
  have hm : (-1 : k) = 1 := by linear_combination -h2
  have : Unique (mu2 k) := ⟨⟨⟨0, add_zero 0⟩⟩, fun x => mu2_ext ((mu2_eq x).elim id (·.trans hm))⟩
  exact Nat.card_unique

/-! ## The bound of the marginal note of page 22 -/

/-- The « majoration » of page 22, with the reading's computations: for an extension of
`𝔖₃`-modules `0 → k^* → M → V(J) → 0` (`k^*` with the trivial action, `k` a domain), the
order of `H¹(𝔖₃, M)` divides `6`, and divides `3` in characteristic `2`. For `M` the units of
`U_{0,3}` over `S = Spec k` this bounds `H¹(U_{0,3}, 𝔖₃; 𝔾_m)`. -/
theorem card_H1_dvd [IsDomain k] (M : Type) [AddCommGroup M] [DistribMulAction G3 M]
    (i : Triv k →+ M) (p : M →+ VJ) (hi : ∀ (g : G3) a, i a = g • i a)
    (hp : ∀ (g : G3) m, p (g • m) = g • p m) (hinj : Function.Injective i)
    (hsurj : Function.Surjective p) (hex : ∀ m, p m = 0 ↔ ∃ a, i a = m) :
    Nat.card (H1 (R G3 M)) ∣ 6 ∧ ((2 : k) = 0 → Nat.card (H1 (R G3 M)) ∣ 3) := by
  have key := card_dvd_of_exact _ _ (exact_mapQ (G := G3) i p hi hp hinj hsurj hex)
  rw [← card_H1 (M := Triv k), card_H1_triv, ← card_H1 (M := VJ), card_H1_VJ] at key
  rw [card_H1]
  exact ⟨key.trans (mul_dvd_mul_right card_mu2_dvd 3),
    fun h2 => by rwa [card_mu2_char_two h2, one_mul] at key⟩

/-! ## The units of `U_{0,3}` and the lower bound of page 24 -/

/-- The coefficients of `sgnExp σ`: `1` at `0` when `σ⁻¹(∞) = 1`, at `1` when `σ⁻¹(∞) = 0`. -/
def wt (σ : G3) (j : Fin 3) : ℤ := if σ⁻¹ 2 = 1 ∧ j = 0 ∨ σ⁻¹ 2 = 0 ∧ j = 1 then 1 else 0

/-- The parity of the constant that appears when `λ^a (1 − λ)^b`, `v = (a, b, −a − b)`, is
composed with the substitution `h` inducing `σ⁻¹` on `0, 1, ∞`: `hλ` carries a sign when
`h(∞) = 1`, and `1 − hλ` when `h(∞) = 0`. -/
def sgnExp (σ : G3) (v : VJ) : ℤ := ∑ j, wt σ j * (v : Fin 3 → ℤ) j

lemma sgnExp_add (σ : G3) (v w : VJ) : sgnExp σ (v + w) = sgnExp σ v + sgnExp σ w := by
  simp [sgnExp, mul_add, Finset.sum_add_distrib]

lemma wt_key : ∀ σ τ : G3, ∀ j, (wt (σ * τ) j - wt τ j - wt σ (τ j) -
    (wt (σ * τ) 0 - wt τ 0 - wt σ (τ 0))) % 2 = 0 := by decide

lemma sgnExp_mul (σ τ : G3) (v : VJ) :
    2 ∣ sgnExp (σ * τ) v - (sgnExp τ v + sgnExp σ (τ • v)) := by
  have hv : ∑ j, (v : Fin 3 → ℤ) j = 0 := v.2
  have e : sgnExp σ (τ • v) = ∑ j, wt σ (τ j) * (v : Fin 3 → ℤ) j := by
    simp only [sgnExp, smul_VJ]
    rw [← Equiv.sum_comp τ]
    simp
  obtain ⟨t1, h1⟩ := Int.dvd_of_emod_eq_zero (wt_key σ τ 1)
  obtain ⟨t2, h2⟩ := Int.dvd_of_emod_eq_zero (wt_key σ τ 2)
  rw [e]
  simp only [sgnExp, Fin.sum_univ_three] at hv ⊢
  exact ⟨t1 * (v : Fin 3 → ℤ) 1 + t2 * (v : Fin 3 → ℤ) 2, by
    linear_combination (v : Fin 3 → ℤ) 1 * h1 + (v : Fin 3 → ℤ) 2 * h2 +
      (wt (σ * τ) 0 - wt τ 0 - wt σ (τ 0)) * hv⟩

@[simp] lemma sgnExp_zero (σ : G3) : sgnExp σ 0 = 0 := by simp [sgnExp]

@[simp] lemma sgnExp_one (v : VJ) : sgnExp 1 v = 0 := by simp [sgnExp, wt]

lemma sgnExp_swap (v : VJ) : sgnExp (Equiv.swap 0 1) v = 0 := by
  simp [sgnExp, wt, show Equiv.swap (0 : Fin 3) 1 2 = 2 by decide]

/-- The units of `U_{0,3} = Spec k[λ, 1/λ, 1/(1 − λ)]`, written additively: `c λ^a (1 − λ)^b`
is `(c, (a, b, −a − b))`, the second component its divisor on `0, 1, ∞`. -/
def Units3 (k : Type) [CommRing k] := Triv k × VJ

instance : AddCommGroup (Units3 k) := inferInstanceAs (AddCommGroup (Triv k × VJ))

namespace Units3

/-- The unit `c λ^a (1 − λ)^b`, `v = (a, b, −a − b)`. -/
def mk (c : Triv k) (v : VJ) : Units3 k := (c, v)

/-- The constant. -/
def cst (x : Units3 k) : Triv k := Prod.fst (β := VJ) x

/-- The divisor. -/
def dv (x : Units3 k) : VJ := Prod.snd (α := Triv k) x

@[ext] lemma ext {x y : Units3 k} (h1 : x.cst = y.cst) (h2 : x.dv = y.dv) : x = y :=
  Prod.ext h1 h2

@[simp] lemma cst_mk (c : Triv k) (v : VJ) : (mk c v).cst = c := rfl
@[simp] lemma dv_mk (c : Triv k) (v : VJ) : (mk c v).dv = v := rfl
@[simp] lemma cst_add (x y : Units3 k) : (x + y).cst = x.cst + y.cst := rfl
@[simp] lemma dv_add (x y : Units3 k) : (x + y).dv = x.dv + y.dv := rfl
@[simp] lemma cst_sub (x y : Units3 k) : (x - y).cst = x.cst - y.cst := rfl
@[simp] lemma dv_sub (x y : Units3 k) : (x - y).dv = x.dv - y.dv := rfl
@[simp] lemma cst_zero : (0 : Units3 k).cst = 0 := rfl
@[simp] lemma dv_zero : (0 : Units3 k).dv = 0 := rfl
@[simp] lemma cst_zsmul (m : ℤ) (x : Units3 k) : (m • x).cst = m • x.cst := rfl
@[simp] lemma dv_zsmul (m : ℤ) (x : Units3 k) : (m • x).dv = m • x.dv := rfl

end Units3

open Units3

/-- `(-1)^s`, in `k^*` written additively. -/
def negPow (s : ℤ) : Triv k := Additive.ofMul ((-1 : kˣ) ^ s)

lemma negPow_add (s t : ℤ) : negPow (k := k) (s + t) = negPow s + negPow t := by
  rw [negPow, zpow_add]; rfl

@[simp] lemma negPow_zero : negPow (k := k) 0 = 0 := by rw [negPow, zpow_zero]; rfl

lemma negPow_eq_zero {s : ℤ} (h : 2 ∣ s) : negPow (k := k) s = 0 := by
  obtain ⟨u, rfl⟩ := h
  rw [negPow, zpow_mul, show ((-1 : kˣ) ^ (2 : ℤ)) = 1 by norm_num, one_zpow]; rfl

lemma negPow_congr {s t : ℤ} (h : 2 ∣ s - t) : negPow (k := k) s = negPow t := by
  rw [show s = s - t + t by ring, negPow_add, negPow_eq_zero h, zero_add]

/-- The anharmonic action: `σ` sends `f` to `f ∘ h`, `h` the substitution inducing `σ⁻¹` on
`0, 1, ∞`; on the divisor it permutes the coordinates, on the constant it multiplies by
`(-1)^{sgnExp σ v}` (`ev_smul`). -/
instance : DistribMulAction G3 (Units3 k) where
  smul σ x := mk (x.cst + negPow (sgnExp σ x.dv)) (σ • x.dv)
  one_smul x := Units3.ext (show x.cst + negPow (sgnExp 1 x.dv) = x.cst by simp)
    (one_smul G3 x.dv)
  mul_smul σ τ x := Units3.ext (by
    change x.cst + _ = x.cst + _ + _
    rw [add_assoc, ← negPow_add, negPow_congr (sgnExp_mul σ τ x.dv)]; rfl) (mul_smul σ τ x.dv)
  smul_zero σ := Units3.ext (show (0 : Units3 k).cst + negPow (sgnExp σ 0) = 0 by simp)
    (smul_zero σ)
  smul_add σ x y := Units3.ext (by
    change x.cst + y.cst + negPow (sgnExp σ (x.dv + y.dv)) = x.cst + _ + (y.cst + _)
    rw [sgnExp_add, negPow_add]; abel) (smul_add σ x.dv y.dv)

@[simp] lemma cst_smul (σ : G3) (x : Units3 k) :
    (σ • x).cst = x.cst + negPow (sgnExp σ x.dv) := rfl

@[simp] lemma dv_smul (σ : G3) (x : Units3 k) : (σ • x).dv = σ • x.dv := rfl

/-- The constants. -/
def incl : Triv k →+ Units3 k where
  toFun c := mk c 0
  map_zero' := rfl
  map_add' _ _ := Units3.ext rfl (add_zero 0).symm

/-- The divisor. -/
def dvs : Units3 k →+ VJ where
  toFun := dv
  map_zero' := rfl
  map_add' _ _ := rfl

@[simp] lemma dvs_apply (x : Units3 k) : dvs x = x.dv := rfl

/-- The bound of page 22 for the units of `U_{0,3}`: `|H¹(𝔖₃, O(U_{0,3})^*)|` divides `6`, and
`3` in characteristic `2`. -/
theorem card_H1_units_dvd [IsDomain k] :
    Nat.card (H1 (R G3 (Units3 k))) ∣ 6 ∧ ((2 : k) = 0 → Nat.card (H1 (R G3 (Units3 k))) ∣ 3) :=
  card_H1_dvd (Units3 k) incl dvs (fun g a => Units3.ext (show a = a + negPow (sgnExp g 0) by simp)
    (smul_zero g).symm)
    (fun _ _ => rfl) (fun _ _ h => congrArg cst h) (fun v => ⟨mk 0 v, rfl⟩)
    (fun m => ⟨fun h => ⟨m.cst, Units3.ext rfl h.symm⟩, fun ⟨a, ha⟩ => ha ▸ rfl⟩)

/-- The sign of a permutation, in `k^*`. -/
def sgnK (σ : G3) : Triv k :=
  Additive.ofMul (Units.map (Int.castRingHom k).toMonoidHom (Equiv.Perm.sign σ))

/-- The point `∞`. -/
def e2 : Fin 3 → ℤ := fun j => if j = 2 then 1 else 0

/-- The divisor `2[∞] − 2[σ(∞)]`. -/
def tanV (σ : G3) : VJ := ⟨fun j => 2 * (e2 j - e2 (σ⁻¹ j)), by
  change ∑ j, 2 * (e2 j - e2 (σ⁻¹ j)) = 0
  rw [← Finset.mul_sum, Finset.sum_sub_distrib, sum_perm σ e2, sub_self, mul_zero]⟩

lemma sgnExp_tanV (σ τ : G3) : 2 ∣ sgnExp σ (tanV τ) :=
  Finset.dvd_sum fun _ _ => Dvd.dvd.mul_left (dvd_mul_right 2 _) _

/-- The tangent cocycle `σ ↦ (h⁻¹)′(λ)`, `h` inducing `σ` on `0, 1, ∞`: its constant is the
sign of `σ` and its divisor `2[∞] − 2[σ(∞)]` (`ev_tan`). -/
def tan : Z1 G3 (Units3 k) :=
  ⟨fun σ => mk (sgnK σ) (tanV σ), fun σ τ => Units3.ext (by
    simp only [cst_add, cst_smul, cst_mk, dv_mk, negPow_eq_zero (sgnExp_tanV σ τ), add_zero]
    rw [add_comm, sgnK, map_mul, map_mul]; rfl)
    (by ext j; simp [tanV, mul_inv_rev]; ring)⟩

/-- No power `m` of the tangent class with `3 ∤ m`, or with `2 ∤ m` when `2 ≠ 0`, is trivial:
its divisor is twice the generator of `H¹(𝔖₃, V(J)) = ℤ/3`, and at the transposition of `0` and
`1` its constant is `-1`. -/
theorem dvd_of_zsmul_tan (m : ℤ) (hm : m • (QuotientAddGroup.mk tan : Q G3 (Units3 k)) = 0) :
    3 ∣ m ∧ ((2 : k) ≠ 0 → 2 ∣ m) := by
  rw [← QuotientAddGroup.mk_zsmul, QuotientAddGroup.eq_zero_iff] at hm
  obtain ⟨x, hx⟩ := hm
  refine ⟨?_, fun h2 => ?_⟩
  · have h0 : psi (mapZ dvs (fun _ _ => rfl) (m • tan)) = 0 :=
      (psi_eq_zero_iff _).2 ⟨x.dv, fun g => congrArg dv (hx g)⟩
    have h1 : psi (mapZ dvs (fun _ _ => rfl) (tan (k := k))) = 1 := by
      change ((∑ j, -((tanV (Equiv.swap 0 j) : Fin 3 → ℤ) j) : ℤ) : ZMod 3) = 1
      simp only [Finset.sum_neg_distrib, Int.cast_neg, Int.cast_sum]
      decide
    rw [map_zsmul, map_zsmul, h1, zsmul_one] at h0
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd m 3).1 h0
  · have e := congrArg Additive.toMul (congrArg cst (hx (Equiv.swap 0 1)))
    simp only [cst_sub, cst_smul, sgnExp_swap, negPow_zero, add_zero, sub_self] at e
    rcases Int.even_or_odd m with he | ho
    · exact even_iff_two_dvd.1 he
    · have : (-1 : kˣ) = 1 := by
        change (1 : kˣ) = ((Units.map (Int.castRingHom k).toMonoidHom
          (Equiv.Perm.sign (Equiv.swap (0 : Fin 3) 1))) ^ m) at e
        simpa [Equiv.Perm.sign_swap, ho.neg_one_zpow] using e.symm
      have h := Units.ext_iff.1 this
      simp only [Units.val_neg, Units.val_one] at h
      exact absurd (by linear_combination -h) h2

lemma card_addOrderOf_tan [IsDomain k] (n : ℕ) (hn : (2 : k) ≠ 0 → n = 6)
    (hn' : (2 : k) = 0 → n = 3) :
    Nat.card (H1 (R G3 (Units3 k))) = n ∧
      addOrderOf (H1Equiv G3 (Units3 k) (QuotientAddGroup.mk tan)) = n := by
  rw [AddEquiv.addOrderOf_eq, card_H1]
  set c := (QuotientAddGroup.mk tan : Q G3 (Units3 k))
  have hc := addOrderOf_dvd_natCard c
  obtain ⟨h3, h2⟩ := dvd_of_zsmul_tan (k := k) (addOrderOf c)
    (by rw [natCast_zsmul]; exact addOrderOf_nsmul_eq_zero c)
  obtain ⟨h6, h3'⟩ := card_H1_units_dvd (k := k)
  rw [card_H1] at h6 h3'
  norm_cast at h3 h2
  by_cases h : (2 : k) = 0
  · rw [hn' h]
    exact ⟨Nat.dvd_antisymm (h3' h) (h3.trans hc), Nat.dvd_antisymm (hc.trans (h3' h)) h3⟩
  · rw [hn h]
    have h6' : 6 ∣ addOrderOf c := Nat.Coprime.mul_dvd_of_dvd_of_dvd (by norm_num) (h2 h) h3
    exact ⟨Nat.dvd_antisymm h6 (h6'.trans hc), Nat.dvd_antisymm (hc.trans h6) h6'⟩

lemma nonempty_addEquiv_zmod {A : Type} [AddGroup A] (a : A) {n : ℕ} (hn : n ≠ 0)
    (hc : Nat.card A = n) (ha : addOrderOf a = n) : Nonempty (A ≃+ ZMod n) := by
  subst hc
  have : Finite A := Nat.finite_of_card_ne_zero hn
  exact ⟨(zmodAddCyclicAddEquiv (isAddCyclic_of_addOrderOf_eq_card a ha)).symm⟩

/-- The lower bound of page 24, with the bound of page 22: for a domain `k` with `2 ≠ 0`,
`H¹(𝔖₃, O(U_{0,3})^*) ≃ ℤ/6`, generated by the tangent class. -/
theorem H1_units [IsDomain k] (h2 : (2 : k) ≠ 0) :
    Nat.card (H1 (R G3 (Units3 k))) = 6 ∧
      addOrderOf (H1Equiv G3 (Units3 k) (QuotientAddGroup.mk tan)) = 6 ∧
      Nonempty (H1 (R G3 (Units3 k)) ≃+ ZMod 6) := by
  obtain ⟨h1, h2⟩ := card_addOrderOf_tan (k := k) 6 (fun _ => rfl) (absurd · h2)
  exact ⟨h1, h2, nonempty_addEquiv_zmod _ (by norm_num) h1 h2⟩

/-- In characteristic `2`, `H¹(𝔖₃, O(U_{0,3})^*) ≃ ℤ/3`, generated by the tangent class. -/
theorem H1_units_char_two [IsDomain k] (h2 : (2 : k) = 0) :
    Nat.card (H1 (R G3 (Units3 k))) = 3 ∧
      addOrderOf (H1Equiv G3 (Units3 k) (QuotientAddGroup.mk tan)) = 3 ∧
      Nonempty (H1 (R G3 (Units3 k)) ≃+ ZMod 3) := by
  obtain ⟨h1, h2⟩ := card_addOrderOf_tan (k := k) 3 (absurd h2) (fun _ => rfl)
  exact ⟨h1, h2, nonempty_addEquiv_zmod _ (by norm_num) h1 h2⟩

/-! ## The model is the units of `U_{0,3}`, and `tan` is the tangent cocycle

Over a field `K`, `ev x` evaluates a unit at a point `x ∈ U(K)`. The action sends `λ` and
`1 − λ` to `h(λ)` and `1 − h(λ)`, `h` the substitution of `Folder146.anh` inducing `σ⁻¹` on
`0, 1, ∞`, and `tan σ` evaluates to the derivative `Folder146.der` of that substitution. -/

section Ev

variable {K : Type} [Field K]

/-- The index, in `Folder146.anh`, of the substitution inducing `h` on `0, 1, ∞`. -/
def idx (h : G3) : Fin 6 :=
  if h 2 = 2 then (if h 0 = 0 then 0 else 2) else if h 2 = 0 then (if h 0 = 2 then 1 else 4)
  else if h 0 = 0 then 3 else 5

lemma perm_vals : ∀ h : G3, (h 0 = 0 ∧ h 1 = 1 ∧ h 2 = 2) ∨ (h 0 = 2 ∧ h 1 = 1 ∧ h 2 = 0) ∨
    (h 0 = 1 ∧ h 1 = 0 ∧ h 2 = 2) ∨ (h 0 = 0 ∧ h 1 = 2 ∧ h 2 = 1) ∨
    (h 0 = 1 ∧ h 1 = 2 ∧ h 2 = 0) ∨ (h 0 = 2 ∧ h 1 = 0 ∧ h 2 = 1) := by decide

lemma sign_vals : ∀ h : G3, Equiv.Perm.sign h =
    if h 0 = 0 ∧ h 1 = 1 ∨ h 0 = 1 ∧ h 1 = 2 ∨ h 0 = 2 ∧ h 1 = 0 then 1 else -1 := by decide

/-- A constant, in `K`. -/
def cval (c : Triv K) : K := ((Additive.toMul (show Additive Kˣ from c) : Kˣ) : K)

@[simp] lemma cval_zero : cval (0 : Triv K) = 1 := rfl

@[simp] lemma cval_add (c c' : Triv K) : cval (c + c') = cval c * cval c' := rfl

@[simp] lemma cval_negPow (s : ℤ) : cval (negPow (k := K) s) = (-1) ^ s := by
  simp [cval, negPow, Units.val_zpow_eq_zpow_val]

@[simp] lemma cval_sgnK (σ : G3) : cval (sgnK (k := K) σ) = ((Equiv.Perm.sign σ : ℤ) : K) := rfl

/-- The value at `x` of a unit. -/
def ev (x : K) (m : Units3 K) : K :=
  cval m.cst * x ^ (m.dv : Fin 3 → ℤ) 0 * (1 - x) ^ (m.dv : Fin 3 → ℤ) 1

lemma ev_smul_eq (x : K) (σ : G3) (m : Units3 K) : ev x (σ • m) =
    cval m.cst * (-1) ^ sgnExp σ m.dv *
      x ^ (m.dv : Fin 3 → ℤ) (σ⁻¹ 0) * (1 - x) ^ (m.dv : Fin 3 → ℤ) (σ⁻¹ 1) := by
  simp [ev]

/-- The unit `λ`. -/
def lam : Units3 K := mk 0 ⟨![1, 0, -1], by
  change ∑ j, (![1, 0, -1] : Fin 3 → ℤ) j = 0; simp [Fin.sum_univ_three]⟩

/-- The unit `1 − λ`. -/
def lam' : Units3 K := mk 0 ⟨![0, 1, -1], by
  change ∑ j, (![0, 1, -1] : Fin 3 → ℤ) j = 0; simp [Fin.sum_univ_three]⟩

/-- `σ` sends `λ` to `h(λ)`, `h = anh (idx σ⁻¹)`. -/
theorem ev_smul_lam (σ : G3) {x : K} (hx : Folder146.U x) :
    ev x (σ • lam) = Folder146.anh (idx σ⁻¹) x := by
  obtain ⟨h0, h1⟩ := hx
  have h1' : x - 1 ≠ 0 := sub_ne_zero.2 h1
  have h1'' : 1 - x ≠ 0 := sub_ne_zero.2 (Ne.symm h1)
  rw [ev_smul_eq]
  rcases perm_vals σ⁻¹ with ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ |
    ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ <;>
  simp [sgnExp, wt, lam, idx, e0, e1, e2, Folder146.anh] <;>
  field_simp <;> ring

/-- `σ` sends `1 − λ` to `1 − h(λ)`. -/
theorem ev_smul_lam' (σ : G3) {x : K} (hx : Folder146.U x) :
    ev x (σ • lam') = 1 - Folder146.anh (idx σ⁻¹) x := by
  obtain ⟨h0, h1⟩ := hx
  have h1' : x - 1 ≠ 0 := sub_ne_zero.2 h1
  have h1'' : 1 - x ≠ 0 := sub_ne_zero.2 (Ne.symm h1)
  rw [ev_smul_eq]
  rcases perm_vals σ⁻¹ with ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ |
    ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ <;>
  simp [sgnExp, wt, lam', idx, e0, e1, e2, Folder146.anh] <;>
  field_simp <;> ring

/-- The constants are fixed. -/
theorem smul_incl (σ : G3) (c : Triv K) : σ • incl c = incl c :=
  Units3.ext (show c + negPow (sgnExp σ 0) = c by simp) (smul_zero σ)

/-- `tan σ` is the derivative of `h = anh (idx σ⁻¹)`: `tan` is the tangent cocycle
`g ↦ g′(λ)` of `Folder146.der_mul`. -/
theorem ev_tan (σ : G3) {x : K} (hx : Folder146.U x) :
    ev x (((tan : Z1 G3 (Units3 K)) : G3 → Units3 K) σ) = Folder146.der (idx σ⁻¹) x := by
  obtain ⟨h0, h1⟩ := hx
  have h1' : x - 1 ≠ 0 := sub_ne_zero.2 h1
  have h1'' : 1 - x ≠ 0 := sub_ne_zero.2 (Ne.symm h1)
  change cval (sgnK σ) * x ^ (2 * (e2 0 - e2 (σ⁻¹ 0))) *
    (1 - x) ^ (2 * (e2 1 - e2 (σ⁻¹ 1))) = _
  rw [cval_sgnK, ← Equiv.Perm.sign_inv, sign_vals]
  rcases perm_vals σ⁻¹ with ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ |
    ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ <;>
  simp [Grothendieck.Folder140_1.e2, idx, e0, e1, e2, Folder146.der] <;> field_simp
  ring

end Ev

end Grothendieck.Folder140_1

/-! ## The units of `U_{0,3}` are the model, and `Pic(U_{0,3}) = 0`

`O3 k = k[λ, 1/λ, 1/(1 − λ)]` is `Localization.Away (X (1 − X))` of `k[X]`. For `k` a domain,
`unitsEquiv : Units3 k ≃+ O3 k^*` sends `(c, v)` to `c λ^{v₀} (1 − λ)^{v₁}` (`toUnits`): it is
injective because `X` and `1 − X` are non-associated primes of `k[X]` (`C_mul_pow_inj`,
`unitOf_eq_one`), and surjective because a unit `p / (X (1 − X))^n` has `p ∣ X^N (1 − X)^N`, so
`p = u X^i (1 − X)^j` with `u ∈ k[X]^* = k^*` (`dvd_pow_mul_pow`, `exists_unitOf`). Over a field,
`O3 K` is a localization of a principal ideal domain, hence factorial, and its Picard group is
trivial (`pic_O3_subsingleton`). The action of `𝔖₃` on `O3 k` by the anharmonic substitutions
is not defined here: the model's action is compared with them pointwise by `ev_smul_lam`. -/
namespace Grothendieck.Folder140_1

open Polynomial Units3

section Ring

/-- A divisor of `π s`, `π` prime, divides `s` or is `π` times a divisor of `s`. -/
lemma dvd_prime_mul {R : Type} [CommRing R] [IsDomain R] {π p s : R} (hπ : Prime π)
    (h : p ∣ π * s) : p ∣ s ∨ ∃ p', p = π * p' ∧ p' ∣ s := by
  obtain ⟨c, hc⟩ := h
  rcases hπ.dvd_or_dvd ⟨s, hc.symm⟩ with ⟨p', rfl⟩ | ⟨c', rfl⟩
  · exact .inr ⟨p', rfl, c, mul_left_cancel₀ hπ.ne_zero (by rw [hc]; ring)⟩
  · exact .inl ⟨c', mul_left_cancel₀ hπ.ne_zero (by rw [hc]; ring)⟩

/-- The divisors of `π^a ρ^b`, `π` and `ρ` prime, are the `u π^i ρ^j`, `u` a unit. -/
lemma dvd_pow_mul_pow {R : Type} [CommRing R] [IsDomain R] {π ρ : R} (hπ : Prime π)
    (hρ : Prime ρ) (a b : ℕ) {p : R} (h : p ∣ π ^ a * ρ ^ b) :
    ∃ u : Rˣ, ∃ i j : ℕ, p = u * π ^ i * ρ ^ j := by
  induction a generalizing p with
  | zero =>
    rw [pow_zero, one_mul] at h
    induction b generalizing p with
    | zero => exact ⟨(isUnit_of_dvd_one (by simpa using h)).unit, 0, 0, by simp⟩
    | succ b ih =>
      rw [pow_succ'] at h
      rcases dvd_prime_mul hρ h with h' | ⟨p', rfl, h'⟩
      · exact ih h'
      · obtain ⟨u, i, j, rfl⟩ := ih h'
        exact ⟨u, i, j + 1, by ring⟩
  | succ a ih =>
    rw [pow_succ', mul_assoc] at h
    rcases dvd_prime_mul hπ h with h' | ⟨p', rfl, h'⟩
    · exact ih h'
    · obtain ⟨u, i, j, rfl⟩ := ih h'
      exact ⟨u, i + 1, j, by ring⟩

/-- `π^a x = π^b y` with `π` dividing neither `x` nor `y` forces `a = b` and `x = y`. -/
lemma pow_mul_cancel {R : Type} [CommRing R] [IsDomain R] {π x y : R} (hπ : Prime π)
    (hx : ¬ π ∣ x) (hy : ¬ π ∣ y) {a b : ℕ} (h : π ^ a * x = π ^ b * y) : a = b ∧ x = y := by
  have key : ∀ {a b : ℕ} {x y : R}, ¬ π ∣ x → π ^ a * x = π ^ b * y → a ≤ b → a = b ∧ x = y := by
    intro a b x y hx h hab
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hab
    rw [pow_add, mul_assoc] at h
    have h' := mul_left_cancel₀ (pow_ne_zero a hπ.ne_zero) h
    rcases d with _ | d
    · simpa using h'
    · exact absurd ⟨π ^ d * y, by rw [h']; ring⟩ hx
  rcases le_total a b with hab | hab
  · exact key hx h hab
  · exact (key hy h.symm hab).imp Eq.symm Eq.symm

end Ring

variable {k : Type} [CommRing k] [IsDomain k]

lemma one_sub_X_ne_zero : (1 - X : k[X]) ≠ 0 := fun h => by
  simpa using congrArg (eval 0) h

lemma prime_one_sub_X : Prime (1 - X : k[X]) := by
  simpa using (prime_X_sub_C (1 : k)).neg

lemma X_not_dvd_one_sub_X : ¬ (X : k[X]) ∣ 1 - X := fun ⟨q, hq⟩ => by
  simpa using congrArg (eval 0) hq

lemma one_sub_X_not_dvd_X : ¬ (1 - X : k[X]) ∣ X := fun ⟨q, hq⟩ => by
  simpa using congrArg (eval 1) hq

variable (k) in
/-- The coordinate ring `k[λ, 1/λ, 1/(1 − λ)]` of `U_{0,3}`. -/
abbrev O3 := Localization.Away (X * (1 - X) : k[X])

lemma X_mul_ne_zero : (X * (1 - X) : k[X]) ≠ 0 := mul_ne_zero X_ne_zero one_sub_X_ne_zero

lemma algebraMap_O3_injective : Function.Injective (algebraMap k[X] (O3 k)) :=
  IsLocalization.injective (M := Submonoid.powers (X * (1 - X) : k[X])) (O3 k)
    (powers_le_nonZeroDivisors_of_noZeroDivisors X_mul_ne_zero)

/-- The unit `λ` of `O(U_{0,3})`. -/
noncomputable def lamU : (O3 k)ˣ :=
  (isUnit_of_mul_isUnit_left (by
    rw [← map_mul]; exact IsLocalization.Away.algebraMap_isUnit _ :
    IsUnit (algebraMap k[X] (O3 k) X * algebraMap k[X] (O3 k) (1 - X)))).unit

/-- The unit `1 − λ` of `O(U_{0,3})`. -/
noncomputable def lam'U : (O3 k)ˣ :=
  (isUnit_of_mul_isUnit_right (by
    rw [← map_mul]; exact IsLocalization.Away.algebraMap_isUnit _ :
    IsUnit (algebraMap k[X] (O3 k) X * algebraMap k[X] (O3 k) (1 - X)))).unit

omit [IsDomain k] in
@[simp] lemma val_lamU : (lamU (k := k) : O3 k) = algebraMap k[X] (O3 k) X := rfl
omit [IsDomain k] in
@[simp] lemma val_lam'U : (lam'U (k := k) : O3 k) = algebraMap k[X] (O3 k) (1 - X) := rfl

/-- The constants. -/
noncomputable def cU : kˣ →* (O3 k)ˣ := Units.map (algebraMap k (O3 k)).toMonoidHom

omit [IsDomain k] in
@[simp] lemma val_cU (c : kˣ) : (cU c : O3 k) = algebraMap k[X] (O3 k) (C (c : k)) := by
  simp [cU, IsScalarTower.algebraMap_apply k k[X] (O3 k)]

/-- The unit `c λ^a (1 − λ)^b` of `O(U_{0,3})`. -/
noncomputable def unitOf (c : kˣ) (a b : ℤ) : (O3 k)ˣ := cU c * lamU ^ a * lam'U ^ b

omit [IsDomain k] in
lemma unitOf_mul (c c' : kˣ) (a b a' b' : ℤ) :
    unitOf (c * c') (a + a') (b + b') = unitOf c a b * unitOf c' a' b' := by
  simp only [unitOf, map_mul, zpow_add]; ac_rfl

omit [IsDomain k] in
lemma val_unitOf_nat (c : kˣ) (a b : ℕ) :
    (unitOf c a b : O3 k) = algebraMap k[X] (O3 k) (C (c : k) * X ^ a * (1 - X) ^ b) := by
  simp [unitOf]

/-- The model of the units is the units of `U_{0,3}`: `(c, v) ↦ c λ^{v₀} (1 − λ)^{v₁}`. -/
noncomputable def toUnits : Units3 k →+ Additive (O3 k)ˣ where
  toFun x := Additive.ofMul (unitOf (Additive.toMul (show Additive kˣ from x.cst))
    ((x.dv : Fin 3 → ℤ) 0) ((x.dv : Fin 3 → ℤ) 1))
  map_zero' := by
    change Additive.ofMul (unitOf 1 0 0) = 0
    simp [unitOf]
  map_add' x y := by
    rw [← ofMul_mul, ← unitOf_mul]; rfl


/-- A prime `π` dividing neither `ρ` nor any unit divides no `u ρ^n`. -/
lemma not_dvd_unit_mul_pow {R : Type} [CommRing R] {π ρ : R} (hπ : Prime π) (hρ : ¬ π ∣ ρ)
    (u : R) (hu : IsUnit u) (n : ℕ) : ¬ π ∣ u * ρ ^ n := fun h =>
  (hπ.dvd_or_dvd h).elim (fun h => hπ.not_isUnit (isUnit_of_dvd_unit h hu))
    (fun h => hρ (hπ.dvd_of_dvd_pow h))

/-- `c X^a (1 − X)^b = c' X^{a'} (1 − X)^{b'}` in `k[X]` forces `c = c'`, `a = a'`, `b = b'`. -/
lemma C_mul_pow_inj {c c' : kˣ} {a b a' b' : ℕ}
    (h : C (c : k) * X ^ a * (1 - X) ^ b = C (c' : k) * X ^ a' * (1 - X) ^ b') :
    c = c' ∧ a = a' ∧ b = b' := by
  have hu : ∀ c : kˣ, IsUnit (C (c : k)) := fun c => isUnit_C.2 c.isUnit
  obtain ⟨ha, h1⟩ := pow_mul_cancel prime_X
    (not_dvd_unit_mul_pow prime_X X_not_dvd_one_sub_X _ (hu c) b)
    (not_dvd_unit_mul_pow prime_X X_not_dvd_one_sub_X _ (hu c') b')
    (show X ^ a * (C (c : k) * (1 - X) ^ b) = X ^ a' * (C (c' : k) * (1 - X) ^ b') by
      linear_combination h)
  have hn : ∀ c : kˣ, ¬ (1 - X : k[X]) ∣ C (c : k) := fun c h =>
    prime_one_sub_X.not_isUnit (isUnit_of_dvd_unit h (hu c))
  obtain ⟨hb, h2⟩ := pow_mul_cancel prime_one_sub_X (hn c) (hn c')
    (show (1 - X) ^ b * C (c : k) = (1 - X) ^ b' * C (c' : k) by linear_combination h1)
  exact ⟨Units.ext (C_injective h2), ha, hb⟩

/-- `c λ^a (1 − λ)^b = 1` only for `c = 1`, `a = b = 0`. -/
theorem unitOf_eq_one {c : kˣ} {a b : ℤ} (h : unitOf c a b = 1) : c = 1 ∧ a = 0 ∧ b = 0 := by
  have ea := Int.toNat_sub_toNat_neg a
  have eb := Int.toNat_sub_toNat_neg b
  have e : unitOf c a.toNat b.toNat = unitOf 1 (-a).toNat (-b).toNat := by
    have := unitOf_mul c 1 a b ((-a).toNat) ((-b).toNat)
    rwa [h, one_mul, mul_one, show a + (-a).toNat = a.toNat by omega,
      show b + (-b).toNat = b.toNat by omega] at this
  have e' := congrArg Units.val e
  rw [val_unitOf_nat, val_unitOf_nat] at e'
  obtain ⟨hc, ha, hb⟩ := C_mul_pow_inj (algebraMap_O3_injective e')
  exact ⟨hc, by omega, by omega⟩

/-- Every unit of `k[λ, 1/λ, 1/(1 − λ)]` is a `c λ^a (1 − λ)^b`, `c ∈ k^*`. -/
theorem exists_unitOf (u : (O3 k)ˣ) : ∃ c : kˣ, ∃ a b : ℤ, u = unitOf c a b := by
  set x : k[X] := X * (1 - X)
  obtain ⟨n, p, hp⟩ := IsLocalization.Away.surj x (u : O3 k)
  obtain ⟨m, q, hq⟩ := IsLocalization.Away.surj x ((u⁻¹ : (O3 k)ˣ) : O3 k)
  have hpq : p * q = X ^ (n + m) * (1 - X) ^ (n + m) := by
    rw [← mul_pow]
    apply algebraMap_O3_injective
    rw [map_mul, ← hp, ← hq, map_pow, pow_add]
    linear_combination (algebraMap k[X] (O3 k) x ^ n * algebraMap k[X] (O3 k) x ^ m) *
      Units.mul_inv u
  obtain ⟨w, i, j, hw⟩ := dvd_pow_mul_pow prime_X prime_one_sub_X (n + m) (n + m) ⟨q, hpq.symm⟩
  obtain ⟨r, hr, hrw⟩ := Polynomial.isUnit_iff.1 w.isUnit
  refine ⟨hr.unit, i - n, j - n, mul_right_cancel (b := unitOf 1 n n) ?_⟩
  rw [← unitOf_mul, mul_one, sub_add_cancel, sub_add_cancel]
  apply Units.ext
  rw [Units.val_mul, val_unitOf_nat, val_unitOf_nat, IsUnit.unit_spec, hrw, ← hw, ← hp]
  simp [x, mul_pow]

theorem toUnits_bijective : Function.Bijective (toUnits (k := k)) := by
  refine ⟨(injective_iff_map_eq_zero _).2 fun x hx => ?_, fun u => ?_⟩
  · obtain ⟨hc, ha, hb⟩ := unitOf_eq_one (congrArg Additive.toMul hx)
    have hs : ∑ j, (x.dv : Fin 3 → ℤ) j = 0 := x.dv.2
    rw [Fin.sum_univ_three, ha, hb] at hs
    refine Units3.ext (congrArg Additive.ofMul hc) (Subtype.ext (funext fun j => ?_))
    fin_cases j
    exacts [ha, hb, by change (x.dv : Fin 3 → ℤ) 2 = 0; omega]
  · obtain ⟨c, a, b, hu⟩ := exists_unitOf (Additive.toMul u)
    refine ⟨mk (Additive.ofMul c) ⟨![a, b, -a - b], by
      change ∑ j, (![a, b, -a - b] : Fin 3 → ℤ) j = 0; simp [Fin.sum_univ_three]⟩, ?_⟩
    change Additive.ofMul (unitOf c a b) = u
    rw [← hu]; rfl

/-- The units of `U_{0,3} = Spec k[λ, 1/λ, 1/(1 − λ)]`, `k` a domain, are the model `Units3 k`:
`O(U_{0,3})^* = k^* × λ^ℤ × (1 − λ)^ℤ`. -/
noncomputable def unitsEquiv : Units3 k ≃+ Additive (O3 k)ˣ :=
  AddEquiv.ofBijective toUnits toUnits_bijective

omit [IsDomain k] in
/-- The constants of the model go to the constants. -/
lemma toUnits_incl (c : Triv k) :
    toUnits (incl c) = Additive.ofMul (cU (Additive.toMul (show Additive kˣ from c))) := by
  change Additive.ofMul (unitOf (Additive.toMul (show Additive kˣ from c)) 0 0) = _
  simp [unitOf]

/-- `Pic(U_{0,3}) = 0` over a field: `K[λ, 1/λ, 1/(1 − λ)]` is a localization of the principal
ideal domain `K[λ]`, hence factorial, and the Picard group of a factorial domain is trivial. -/
theorem pic_O3_subsingleton (K : Type) [Field K] : Subsingleton (CommRing.Pic (O3 K)) := by
  have : IsDomain (O3 K) := IsLocalization.Away.isDomain _ (X_mul_ne_zero (k := K))
  have : UniqueFactorizationMonoid (O3 K) :=
    UniqueFactorizationMonoid.of_isLocalization (S := Submonoid.powers (X * (1 - X) : K[X])) _
  infer_instance

end Grothendieck.Folder140_1
