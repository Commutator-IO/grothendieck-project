import Mathlib.Order.Basic
import Mathlib.Data.Set.Lattice.Indexed
import Mathlib.Data.List.Chain
import Mathlib.Data.Fintype.Powerset
import Mathlib.Data.Fin.VecNotation

/-!
# Folder 156-4, pages 65–68: supports, cosupports, and the presumed Boolean algebra

The modernised reading `transcripts/156-4/156-4.modern.tex` (§ XIII, « Supports et
cosupports ») works with a poset of multistrates `(𝓜, ≤)` and a symmetric relation `R`
(« compatibles »). Two multistrates are *disjoint* when they are compatible and have no common
lower bound; the cosupport of a part `Φ ⊂ 𝓜` is the set of multistrates disjoint from every
element of `Φ`, the support is the cosupport of the cosupport, and a part is *saturated* when it
equals its support. Page 68:

> Je présume qu'on a en fait une algèbre de Boole (« ultra-stonienne », à cause des Sup quelc.)

This is finding `156-4-supports-boolean-presumption`. Proved here:

* `cosupp_antitone`, `subset_supp`, `cosupp_supp`, `isSaturated_cosupp`,
  `isSaturated_iInter`, `inter_cosupp_eq_empty`, `supp_union_cosupp`: for any poset and any
  symmetric relation, the saturated parts are closed under arbitrary intersections, and the
  cosupport is an orthocomplementation on them — an involution reversing inclusion, with
  `S ∩ cosupp S = ∅` and `supp (S ∪ cosupp S) = 𝓜`. The saturated parts form a complete
  ortholattice (meet: intersection, join: support of the union).
* `Hexagon`: the edition's seven-element model, four minimal multistrates `a, b, c, d` and
  `v_ab, v_bc, v_cd` above the pairs `ab, bc, cd`, `R` generated by the pairs inside each
  `𝓜_{≤v}`. `hexagon_hyp`: `R` is reflexive, symmetric and inherited downwards, every
  `𝓜_{≤v}` is pairwise compatible, and `𝓜` is connected, so C 4 is vacuous.
  `hexagon_saturated`: the saturated parts are exactly `∅, {b}, {c}, {a, c}, {b, d}, 𝓜`;
  `hexagon_not_distrib`: `{b, d} ∧ ({b} ∨ {c}) = {b, d}` while
  `({b, d} ∧ {b}) ∨ ({b, d} ∧ {c}) = {b}`.

**What the formalisation finds.** The presumption fails: the lattice of saturated parts is a
complete ortholattice, not in general a Boolean algebra, even under the hypotheses on
`(𝓜, ≤, R)` of pages 58–61. What the model checks of the axioms is the structure of
`(𝓜, ≤, R)` that pages 58–64 impose; the figures themselves (C 1–C 3, stated for the set of
figures) are not encoded.
-/

namespace Grothendieck.Folder156_4

section General

variable {M : Type*} [PartialOrder M] (R : M → M → Prop)

/-- Two multistrates are disjoint when they are compatible and have no common lower bound. -/
def Disj (X Y : M) : Prop := R X Y ∧ ∀ Z, ¬ (Z ≤ X ∧ Z ≤ Y)

/-- The cosupport of `Φ`: the multistrates disjoint from every element of `Φ`. -/
def cosupp (Φ : Set M) : Set M := {X | ∀ Y ∈ Φ, Disj R X Y}

/-- The support, cosupport of the cosupport. -/
def supp (Φ : Set M) : Set M := cosupp R (cosupp R Φ)

/-- A part is saturated when it equals its support. -/
def IsSaturated (Φ : Set M) : Prop := supp R Φ = Φ

theorem cosupp_antitone {Φ Ψ : Set M} (h : Φ ⊆ Ψ) : cosupp R Ψ ⊆ cosupp R Φ :=
  fun _ hX Y hY => hX Y (h hY)

variable {R}

theorem disj_symm (hR : ∀ {X Y : M}, R X Y → R Y X) {X Y : M} (h : Disj R X Y) : Disj R Y X :=
  ⟨hR h.1, fun Z hZ => h.2 Z ⟨hZ.2, hZ.1⟩⟩

theorem subset_supp (hR : ∀ {X Y : M}, R X Y → R Y X) (Φ : Set M) : Φ ⊆ supp R Φ :=
  fun _ hX _ hY => disj_symm hR (hY _ hX)

theorem cosupp_supp (hR : ∀ {X Y : M}, R X Y → R Y X) (Φ : Set M) :
    cosupp R (supp R Φ) = cosupp R Φ :=
  (cosupp_antitone R (subset_supp hR Φ)).antisymm (subset_supp hR _)

/-- The cosupport of any part is saturated. -/
theorem isSaturated_cosupp (hR : ∀ {X Y : M}, R X Y → R Y X) (Φ : Set M) :
    IsSaturated R (cosupp R Φ) :=
  cosupp_supp hR Φ

/-- Arbitrary intersections of saturated parts are saturated. -/
theorem isSaturated_iInter (hR : ∀ {X Y : M}, R X Y → R Y X) {ι : Type*} (S : ι → Set M)
    (hS : ∀ i, IsSaturated R (S i)) : IsSaturated R (⋂ i, S i) := by
  refine (Set.Subset.antisymm ?_ (subset_supp hR _))
  refine Set.subset_iInter fun i => ?_
  rw [← hS i]
  exact cosupp_antitone R (cosupp_antitone R (Set.iInter_subset S i))

/-- No multistrate is disjoint from itself, so `S ∩ cosupp S = ∅`. -/
theorem inter_cosupp_eq_empty (Φ : Set M) : Φ ∩ cosupp R Φ = ∅ :=
  Set.eq_empty_iff_forall_notMem.2 fun X hX => (hX.2 X hX.1).2 X ⟨le_rfl, le_rfl⟩

/-- For `S` saturated, `S ∨ cosupp S = 𝓜`. -/
theorem supp_union_cosupp {Φ : Set M} (hΦ : IsSaturated R Φ) :
    supp R (Φ ∪ cosupp R Φ) = Set.univ := by
  have h : cosupp R (Φ ∪ cosupp R Φ) = ∅ := by
    refine Set.eq_empty_iff_forall_notMem.2 fun X hX => ?_
    have h1 : X ∈ cosupp R Φ := fun Y hY => hX Y (Or.inl hY)
    have h2 : X ∈ supp R Φ := fun Y hY => hX Y (Or.inr hY)
    rw [hΦ] at h2
    exact (inter_cosupp_eq_empty Φ).subset ⟨h2, h1⟩
  rw [supp, h]
  exact Set.eq_univ_of_forall fun _ _ h => h.elim

/-- The cosupport is an involution on saturated parts. -/
theorem cosupp_cosupp {Φ : Set M} (hΦ : IsSaturated R Φ) : cosupp R (cosupp R Φ) = Φ := hΦ

end General

section Hexagon

/-- The seven multistrates: `0, 1, 2, 3` are `a, b, c, d`, and `4, 5, 6` are
`v_ab, v_bc, v_cd`. -/
abbrev Hexagon := Fin 7

/-- The minimal multistrates under each `v`. -/
def below : Fin 7 → Finset (Fin 7) :=
  ![{0}, {1}, {2}, {3}, {0, 1, 4}, {1, 2, 5}, {2, 3, 6}]

/-- The order: `x ≤ y` iff `x ∈ 𝓜_{≤y}`. -/
def le (x y : Fin 7) : Prop := x ∈ below y

/-- `R`: generated by the pairs inside each `𝓜_{≤v}`. -/
def rel (x y : Fin 7) : Prop := ∃ v, x ∈ below v ∧ y ∈ below v

instance : DecidableRel le := fun _ _ => inferInstanceAs (Decidable (_ ∈ _))
instance : DecidableRel rel := fun _ _ => inferInstanceAs (Decidable (∃ _, _))

/-- Disjointness in the model. -/
def disj (x y : Fin 7) : Prop := rel x y ∧ ∀ z, ¬ (le z x ∧ le z y)

instance : DecidableRel disj := fun _ _ => inferInstanceAs (Decidable (_ ∧ _))

/-- The cosupport of a part of the model. -/
def cosuppH (Φ : Finset (Fin 7)) : Finset (Fin 7) := Finset.univ.filter fun x => ∀ y ∈ Φ, disj x y

/-- The support of a part of the model. -/
def suppH (Φ : Finset (Fin 7)) : Finset (Fin 7) := cosuppH (cosuppH Φ)

/-- The model satisfies the hypotheses on `(𝓜, ≤, R)`: `≤` is a partial order, `R` is
reflexive, symmetric, inherited downwards, every `𝓜_{≤v}` is pairwise compatible, and `𝓜` is
connected (the chain `a, v_ab, b, v_bc, c, v_cd, d` of comparable elements runs through it). -/
theorem hexagon_hyp :
    (∀ x, le x x) ∧ (∀ x y, le x y → le y x → x = y) ∧
      (∀ x y z, le x y → le y z → le x z) ∧
      (∀ x, rel x x) ∧ (∀ x y, rel x y → rel y x) ∧
      (∀ x y x' y', rel x y → le x' x → le y' y → rel x' y') ∧
      (∀ v x y, le x v → le y v → rel x y) ∧
      List.IsChain (fun x y => le x y ∨ le y x) ([0, 4, 1, 5, 2, 6, 3] : List (Fin 7)) ∧
      (∀ x : Fin 7, x ∈ ([0, 4, 1, 5, 2, 6, 3] : List (Fin 7))) := by
  decide

/-- **The saturated parts of the model are `∅, {b}, {c}, {a, c}, {b, d}, 𝓜`.** -/
theorem hexagon_saturated :
    Finset.univ.filter (fun Φ : Finset (Fin 7) => suppH Φ = Φ) =
      {∅, {1}, {2}, {0, 2}, {1, 3}, Finset.univ} := by
  decide

/-- **The lattice of saturated parts is not distributive**: with meet the intersection and
join the support of the union, `{b, d} ∧ ({b} ∨ {c}) = {b, d}` while
`({b, d} ∧ {b}) ∨ ({b, d} ∧ {c}) = {b}`. -/
theorem hexagon_not_distrib :
    ({1, 3} : Finset (Fin 7)) ∩ suppH ({1} ∪ {2}) = {1, 3} ∧
      suppH (({1, 3} : Finset (Fin 7)) ∩ {1} ∪ {1, 3} ∩ {2}) = {1} := by
  decide

end Hexagon

end Grothendieck.Folder156_4
