import Mathlib.Order.Filter.Germ.Basic
import Mathlib.Order.Filter.Ultrafilter.Basic
import Mathlib.Topology.Sets.Closeds
import Mathlib.Topology.NhdsSet
import Mathlib.Data.ZMod.Defs
import Mathlib.Algebra.Ring.Subring.Basic

/-!
# Folder 156-2, pages 14–15: the rives of a closed subset and the map `Riv(A, X) → Comp(Ã)`

The modernised reading `transcripts/156-2/156-2.modern.tex` (« Rives et bi-rives ») sets, for
a closed subset `A` of a space `X`, `j : U = X ∖ A → X`,

> `Riv(A,X) = lim_{V ⊃ A} Comp(V ∖ A) = lim_{V ⊃ A} Γ(V, j_* 𝔽₂)`, … Soit `Ã → A` le spectre
> de Stone relatif du faisceau d'anneaux booléens `(j_* 𝔽₂)|_A` … d'où une application
> canonique `(*) Riv(A,X) → Comp(Ã)`, toujours injective, et bijective si `X` est paracompact.

The reading's footnote: « L'injectivité n'utilise rien : une section sur `V` nulle en germe en
chaque point de `A` est nulle sur un voisinage ouvert de `A`. »

What is formalised, with `Comp(Z)` the clopen subsets of `Z` and parts of `V ∖ A` open and
closed in `V ∖ A` encoded by their indicators, functions `X → 𝔽₂` locally constant on `V ∖ A`:

* `Riv A` — germs along `A` (for the filter `𝓝ˢ A ⊓ 𝓟 (X ∖ A)`) of such functions, as a
  subring of the germ ring: the colimit over neighbourhoods `V ⊇ A`.
* `Stalk A x` — the stalk of `j_* 𝔽₂` at `x`, germs for `𝓝[X ∖ A] x`.
* `Spec A` — the relative Stone spectrum `Ã`: pairs `(x, χ)`, `x ∈ A`, `χ : Stalk A x →+* 𝔽₂`
  a point of the spectrum of the stalk, with the topology generated by the sets
  `{(y, χ) : y ∈ W, χ(germ of f at y) = 1}`.
* `toComp` — the map `(*)`, `ρ ↦ {(x, χ) : χ(ρ_x) = 1}`; its values are clopen
  (`isOpen_toSpecSet`, `toSpecSet_compl`), and it is a morphism of Boolean algebras
  (`toComp_mul`, `toComp_one`, `toSpecSet_compl`).
* `toComp_injective` — **the map `(*)` is injective**, for any subset `A` of any space.
* `riv_one_eq_zero_iff` — `Riv(A, X) = 0` iff `A` is open: the reading's « A non ouvert » for
  the page's « A ≠ ∅ » in the remark on bi-rives.

Not formalised: the bijectivity for `X` paracompact (Godement's theorem, Tier 3 of issue #54),
the identification `Comp(Ã) ≃ Γ(A, (j_* 𝔽₂)|_A)`, regularly immersed `A`, and the cut space
`X̄` of pages 16–17.

**What the formalisation finds.** The injectivity holds as the reading's footnote says, with no
hypothesis: neither closedness of `A` nor any separation of `X` is used. The only input beyond
the definitions is that distinct germs at `x` are separated by a point of the spectrum of the
stalk, which comes here from an ultrafilter finer than `𝓝[X ∖ A] x` (evaluation along it is a
ring morphism on germs, `evGerm`), so no Boolean prime ideal theorem has to be invoked
separately. With the topology chosen on `Ã` (the one the finding notes the reading names but
does not specify), the image of each rive is clopen.

What this certifies is that the reading holds together at this point, not that it is what the
pages say (issue #26).
-/

namespace Grothendieck.Folder156_2

open Filter Topology

/-! ### Evaluation at an ultrafilter -/

section Ultra

variable {Y : Type*}

theorem zmod2_cases (a : ZMod 2) : a = 0 ∨ a = 1 := by
  fin_cases a
  exacts [Or.inl rfl, Or.inr rfl]


/-- The value of `g : X → 𝔽₂` along an ultrafilter. -/
noncomputable def evU (𝒰 : Ultrafilter Y) (g : Y → ZMod 2) : ZMod 2 :=
  open Classical in if {y | g y = 1} ∈ 𝒰 then 1 else 0

theorem evU_spec (𝒰 : Ultrafilter Y) (g : Y → ZMod 2) : {y | g y = evU 𝒰 g} ∈ 𝒰 := by
  unfold evU
  split_ifs with h
  · exact h
  · refine Filter.mem_of_superset (𝒰.compl_mem_iff_notMem.mpr h) fun y hy => ?_
    rcases zmod2_cases (g y) with h0 | h1
    · exact h0
    · exact absurd h1 hy

theorem evU_eq (𝒰 : Ultrafilter Y) {g : Y → ZMod 2} {c : ZMod 2} (h : {y | g y = c} ∈ 𝒰) :
    evU 𝒰 g = c := by
  obtain ⟨y, h1, h2⟩ := 𝒰.nonempty_of_mem (inter_mem h (evU_spec 𝒰 g))
  exact h2.symm.trans h1

end Ultra

variable {X : Type*} [TopologicalSpace X] (A : Set X)

/-- `f : X → 𝔽₂` is locally constant on `S` (for the subspace topology): it is the indicator
of a part of `S` open and closed in `S`. -/
def LocConst (f : X → ZMod 2) (S : Set X) : Prop := ∀ y ∈ S, ∀ᶠ z in 𝓝[S] y, f z = f y

variable {A}

theorem LocConst.mono {f : X → ZMod 2} {S T : Set X} (h : LocConst f S) (hT : T ⊆ S) :
    LocConst f T := fun y hy => nhdsWithin_mono y hT (h y (hT hy))

theorem LocConst.const (c : ZMod 2) (S : Set X) : LocConst (fun _ => c) S :=
  fun _ _ => Eventually.of_forall fun _ => rfl

theorem LocConst.add {f g : X → ZMod 2} {S : Set X} (hf : LocConst f S) (hg : LocConst g S) :
    LocConst (f + g) S := fun y hy => (hf y hy).mp ((hg y hy).mono fun z h1 h2 => by
      simp [h1, h2])

theorem LocConst.mul {f g : X → ZMod 2} {S : Set X} (hf : LocConst f S) (hg : LocConst g S) :
    LocConst (f * g) S := fun y hy => (hf y hy).mp ((hg y hy).mono fun z h1 h2 => by
      simp [h1, h2])

theorem LocConst.neg {f : X → ZMod 2} {S : Set X} (hf : LocConst f S) :
    LocConst (-f) S := fun y hy => (hf y hy).mono fun z h => by simp [h]

variable (A)

/-- Germs, for the filter `F ⊓ 𝓟 (X ∖ A)`, of functions locally constant on `V ∖ A` for some
`V ∈ F`: the sections of `j_* 𝔽₂` near `F`. -/
def locSec (F : Filter X) : Subring (Germ (F ⊓ 𝓟 Aᶜ) (ZMod 2)) where
  carrier := {g | ∃ V ∈ F, ∃ f : X → ZMod 2, LocConst f (V ∩ Aᶜ) ∧ (f : Germ _ _) = g}
  mul_mem' := by
    rintro _ _ ⟨V, hV, f, hf, rfl⟩ ⟨W, hW, g, hg, rfl⟩
    exact ⟨V ∩ W, inter_mem hV hW, f * g, (hf.mono (by intro; simp_all)).mul
      (hg.mono (by intro; simp_all)), rfl⟩
  one_mem' := ⟨Set.univ, univ_mem, 1, LocConst.const 1 _, rfl⟩
  add_mem' := by
    rintro _ _ ⟨V, hV, f, hf, rfl⟩ ⟨W, hW, g, hg, rfl⟩
    exact ⟨V ∩ W, inter_mem hV hW, f + g, (hf.mono (by intro; simp_all)).add
      (hg.mono (by intro; simp_all)), rfl⟩
  zero_mem' := ⟨Set.univ, univ_mem, 0, LocConst.const 0 _, rfl⟩
  neg_mem' := by
    rintro _ ⟨V, hV, f, hf, rfl⟩
    exact ⟨V, hV, -f, hf.neg, rfl⟩

theorem mem_locSec {F : Filter X} {g : Germ (F ⊓ 𝓟 Aᶜ) (ZMod 2)} :
    g ∈ locSec A F ↔ ∃ V ∈ F, ∃ f : X → ZMod 2, LocConst f (V ∩ Aᶜ) ∧ (f : Germ _ _) = g :=
  Iff.rfl

/-- The rives of `A`: `Riv(A, X) = lim_{V ⊇ A} Comp(V ∖ A)`, germs along `A` of open and closed
parts of `V ∖ A`, as a Boolean ring. -/
abbrev Riv := locSec A (𝓝ˢ A)

/-- The stalk at `x` of `j_* 𝔽₂`, `j : X ∖ A → X`. -/
abbrev Stalk (x : X) := locSec A (𝓝 x)

/-- The relative Stone spectrum `Ã → A` of `(j_* 𝔽₂)|_A`: over `x ∈ A`, the points of the
spectrum of the stalk. -/
def Spec := Σ x : A, (Stalk A x →+* ZMod 2)

/-- Its topology, generated by the sets `{(y, χ) : y ∈ W, χ(germ of f at y) = 1}`, `W` open and
`f` locally constant on `W ∖ A`. -/
instance : TopologicalSpace (Spec A) := TopologicalSpace.generateFrom
  {S | ∃ W : Set X, IsOpen W ∧ ∃ f : X → ZMod 2, LocConst f (W ∩ Aᶜ) ∧
    S = {p | (p.1 : X) ∈ W ∧ ∃ h, p.2 ⟨(f : Germ _ _), h⟩ = 1}}

variable {A}

theorem tendsto_res {x : X} (hx : x ∈ A) :
    Tendsto id (𝓝 x ⊓ 𝓟 Aᶜ) (𝓝ˢ A ⊓ 𝓟 Aᶜ) :=
  inf_le_inf_right _ (nhds_le_nhdsSet hx)

/-- The germ at `x ∈ A` of a rive. -/
def res {x : X} (hx : x ∈ A) (ρ : Riv A) : Stalk A x :=
  ⟨ρ.1.compTendsto id (tendsto_res hx), by
    obtain ⟨g, hg⟩ := ρ
    obtain ⟨V, hV, f, hf, rfl⟩ := (mem_locSec A).1 hg
    exact ⟨V, nhds_le_nhdsSet hx hV, f, hf, rfl⟩⟩


theorem res_coe {x : X} (hx : x ∈ A) {ρ : Riv A} {f : X → ZMod 2} (h : ρ.1 = f) :
    (res hx ρ).1 = (f : Germ _ _) := by
  simp only [res, h]; rfl


/-- Evaluation along `𝒰` as a ring morphism on germs, for `𝒰` finer than `l`. -/
noncomputable def evGerm {l : Filter X} (𝒰 : Ultrafilter X) (h𝒰 : (𝒰 : Filter X) ≤ l) :
    Germ l (ZMod 2) →+* ZMod 2 where
  toFun g := g.liftOn (evU 𝒰) fun f f' hff' => by
    refine (evU_eq 𝒰 ?_).symm
    filter_upwards [h𝒰 hff', evU_spec 𝒰 f] with y h1 h2 using h1 ▸ h2
  map_one' := evU_eq 𝒰 (Filter.mem_of_superset Filter.univ_mem fun _ _ => rfl)
  map_mul' g g' := by
    induction g using Germ.inductionOn with | h f => ?_
    induction g' using Germ.inductionOn with | h f' => ?_
    change evU 𝒰 (f * f') = evU 𝒰 f * evU 𝒰 f'
    refine evU_eq 𝒰 ?_
    filter_upwards [evU_spec 𝒰 f, evU_spec 𝒰 f'] with y h1 h2
    simp [h1, h2]
  map_zero' := evU_eq 𝒰 (Filter.mem_of_superset Filter.univ_mem fun _ _ => rfl)
  map_add' g g' := by
    induction g using Germ.inductionOn with | h f => ?_
    induction g' using Germ.inductionOn with | h f' => ?_
    change evU 𝒰 (f + f') = evU 𝒰 f + evU 𝒰 f'
    refine evU_eq 𝒰 ?_
    filter_upwards [evU_spec 𝒰 f, evU_spec 𝒰 f'] with y h1 h2
    simp [h1, h2]


/-! ### The map `(*) : Riv(A, X) → Comp(Ã)` -/

/-- The set of points `(x, χ)` of `Ã` where the germ of `ρ` at `x` takes the value `1`. -/
def toSpecSet (ρ : Riv A) : Set (Spec A) := {p | p.2 (res p.1.2 ρ) = 1}

theorem toSpecSet_eq_basic (ρ : Riv A) : ∃ W : Set X, IsOpen W ∧ ∃ f : X → ZMod 2,
    LocConst f (W ∩ Aᶜ) ∧ toSpecSet ρ = {p | (p.1 : X) ∈ W ∧ ∃ h, p.2 ⟨(f : Germ _ _), h⟩ = 1} := by
  obtain ⟨g, hg⟩ := ρ
  obtain ⟨V, hV, f, hf, rfl⟩ := (mem_locSec A).1 hg
  obtain ⟨W, hW, hAW, hWV⟩ := mem_nhdsSet_iff_exists.1 hV
  refine ⟨W, hW, f, hf.mono (Set.inter_subset_inter_left _ hWV), ?_⟩
  ext p
  simp only [toSpecSet, Set.mem_ofPred_eq]
  constructor
  · intro h
    exact ⟨hAW p.1.2, (res p.1.2 ⟨_, hg⟩).2, by rw [← h]; rfl⟩
  · rintro ⟨-, _, h⟩
    rw [← h]; rfl

theorem isOpen_toSpecSet (ρ : Riv A) : IsOpen (toSpecSet ρ) := by
  obtain ⟨W, hW, f, hf, h⟩ := toSpecSet_eq_basic ρ
  rw [h]
  exact TopologicalSpace.isOpen_generateFrom_of_mem ⟨W, hW, f, hf, rfl⟩

theorem toSpecSet_compl (ρ : Riv A) : (toSpecSet ρ)ᶜ = toSpecSet (1 - ρ) := by
  ext p
  simp only [toSpecSet, Set.mem_compl_iff, Set.mem_ofPred_eq]
  have : res p.1.2 (1 - ρ) = 1 - res p.1.2 ρ := by
    obtain ⟨g, -⟩ := ρ
    apply Subtype.ext
    induction g using Germ.inductionOn with | h f => rfl
  rw [this, map_sub, map_one]
  rcases zmod2_cases (p.2 (res p.1.2 ρ)) with h | h <;> rw [h] <;> decide

/-- The canonical map `(*)` of page 15, `Riv(A, X) → Comp(Ã)`. -/
def toComp (ρ : Riv A) : TopologicalSpace.Clopens (Spec A) :=
  ⟨toSpecSet ρ, ⟨by rw [← isOpen_compl_iff, toSpecSet_compl]; exact isOpen_toSpecSet _,
    isOpen_toSpecSet ρ⟩⟩


theorem toComp_carrier (ρ : Riv A) : (toComp ρ : Set (Spec A)) = toSpecSet ρ := rfl

/-- Page 15: the map `(*) : Riv(A, X) → Comp(Ã)` is injective. Neither paracompactness nor the
closedness of `A` is used. -/
theorem toComp_injective : Function.Injective (toComp (A := A)) := by
  intro ρ ρ' h
  have hset : toSpecSet ρ = toSpecSet ρ' := by
    rw [← toComp_carrier, ← toComp_carrier, h]
  obtain ⟨g, hg⟩ := ρ
  obtain ⟨V, hV, f, hf, rfl⟩ := (mem_locSec A).1 hg
  obtain ⟨g', hg'⟩ := ρ'
  obtain ⟨V', hV', f', hf', rfl⟩ := (mem_locSec A).1 hg'
  apply Subtype.ext
  change (f : Germ (𝓝ˢ A ⊓ 𝓟 Aᶜ) (ZMod 2)) = (f' : Germ (𝓝ˢ A ⊓ 𝓟 Aᶜ) (ZMod 2))
  rw [Germ.coe_eq, EventuallyEq, Filter.Eventually, mem_inf_principal, mem_nhdsSet_iff_forall]
  intro x hx
  rw [← mem_inf_principal]
  by_contra hne
  have hnb : NeBot (𝓝 x ⊓ 𝓟 Aᶜ ⊓ 𝓟 {y | f y ≠ f' y}) := by
    rw [neBot_iff, Ne, inf_principal_eq_bot]
    convert hne using 2
    ext y; simp
  set 𝒰 := Ultrafilter.of (𝓝 x ⊓ 𝓟 Aᶜ ⊓ 𝓟 {y | f y ≠ f' y})
  have h𝒰 : (𝒰 : Filter X) ≤ 𝓝 x ⊓ 𝓟 Aᶜ := (Ultrafilter.of_le _).trans inf_le_left
  have hne𝒰 : {y | f y ≠ f' y} ∈ 𝒰 := Ultrafilter.of_le _ (mem_inf_of_right (mem_principal_self _))
  set p : Spec A := ⟨⟨x, hx⟩, (evGerm 𝒰 h𝒰).comp (Stalk A x).subtype⟩
  have e1 : p ∈ toSpecSet ⟨_, hg⟩ ↔ evU 𝒰 f = 1 := Iff.rfl
  have e2 : p ∈ toSpecSet ⟨_, hg'⟩ ↔ evU 𝒰 f' = 1 := Iff.rfl
  have hdiff : evU 𝒰 f ≠ evU 𝒰 f' := by
    obtain ⟨y, ⟨h1, h2⟩, h3⟩ := 𝒰.nonempty_of_mem
      (inter_mem (inter_mem (evU_spec 𝒰 f) (evU_spec 𝒰 f')) hne𝒰)
    intro heq
    exact h3 (by simp only [Set.mem_ofPred_eq] at h1 h2; rw [h1, h2, heq])
  rw [hset] at e1
  have := e1.symm.trans e2
  rcases zmod2_cases (evU 𝒰 f) with h1 | h1 <;> rcases zmod2_cases (evU 𝒰 f') with h2 | h2 <;>
    simp_all

theorem res_mul {x : X} (hx : x ∈ A) (ρ ρ' : Riv A) : res hx (ρ * ρ') = res hx ρ * res hx ρ' := by
  obtain ⟨g, -⟩ := ρ
  obtain ⟨g', -⟩ := ρ'
  apply Subtype.ext
  induction g using Germ.inductionOn with | h f => ?_
  induction g' using Germ.inductionOn with | h f' => rfl

/-- `(*)` is a morphism of Boolean algebras: it sends products to intersections and `1` to `Ã`;
complements go to complements by `toSpecSet_compl`. -/
theorem toComp_mul (ρ ρ' : Riv A) : toComp (ρ * ρ') = toComp ρ ⊓ toComp ρ' := by
  apply TopologicalSpace.Clopens.ext
  change toSpecSet (ρ * ρ') = toSpecSet ρ ∩ toSpecSet ρ'
  ext p
  simp only [toSpecSet, Set.mem_ofPred_eq, Set.mem_inter_iff, res_mul, map_mul]
  rcases zmod2_cases (p.2 (res p.1.2 ρ)) with h1 | h1 <;>
    rcases zmod2_cases (p.2 (res p.1.2 ρ')) with h2 | h2 <;> simp [h1, h2]

theorem toComp_one : toComp (1 : Riv A) = ⊤ := by
  apply TopologicalSpace.Clopens.ext
  change toSpecSet 1 = Set.univ
  ext p
  simp only [toSpecSet, Set.mem_ofPred_eq, Set.mem_univ, iff_true]
  have : res p.1.2 (1 : Riv A) = 1 := Subtype.ext rfl
  rw [this, map_one]

/-- The correction of the reading (page 15, « A non ouvert » for the page's « A ≠ ∅ »): the
Boolean ring of rives is zero, so that `ρ = ρ'` and `ρ + ρ' = 1` can hold together, exactly when
`A` is open. -/
theorem riv_one_eq_zero_iff : (1 : Riv A) = 0 ↔ IsOpen A := by
  rw [Subtype.ext_iff]
  change ((1 : X → ZMod 2) : Germ (𝓝ˢ A ⊓ 𝓟 Aᶜ) (ZMod 2)) =
    ((0 : X → ZMod 2) : Germ (𝓝ˢ A ⊓ 𝓟 Aᶜ) (ZMod 2)) ↔ _
  rw [Germ.coe_eq, EventuallyEq, Filter.Eventually]
  have h10 : {y : X | (1 : X → ZMod 2) y = (0 : X → ZMod 2) y} = ∅ := by
    ext; simp only [Pi.one_apply, Pi.zero_apply, Set.mem_ofPred_eq, Set.mem_empty_iff_false,
      iff_false]; decide
  rw [h10, empty_mem_iff_bot, inf_principal_eq_bot, compl_compl]
  constructor
  · intro h
    exact isOpen_iff_mem_nhds.2 fun x hx => mem_nhdsSet_iff_forall.1 h x hx
  · exact IsOpen.mem_nhdsSet_self

end Grothendieck.Folder156_2
