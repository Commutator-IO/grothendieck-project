import Mathlib.Topology.Sets.Opens
import Mathlib.Topology.LocallyClosed
import Mathlib.Topology.Sober

/-!
# Folder 161-3: the topos of a product, the converse on pages 10–11

Issue #26 lists folder 161-3 (2-products of topoi, the topos of a product of
spaces). Of the folder, the covering argument of pages 10–11 is formalised here,
as the reading `transcripts/161-3/161-3.modern.tex` gives it (« Le sens
réciproque »), together with its translation into frames.

* **The statement.** « Supposons que toute partie localement fermée non vide de
  `X` possède un point admettant, dans elle, un voisinage relatif
  quasi-compact. » Then `Top(X × Y) → Top(X) × Top(Y)` is an equivalence, for
  every space `Y`. The hypothesis is `HypG X`; no separation, sobriety or
  hypothesis on `Y` is assumed.
* **The model.** The page works with the « S » of the 2-product: a set of pairs
  `(U, V)` of opens of `X` and `Y`, stable under shrinking and under unions in
  each variable separately (`CIdeal`), and the theorem amounts to saying that
  such an `S` contains every rectangle `U × V` covered by its own rectangles.
  That is `covering`, proved by the page's maximality argument: `U'` the
  largest open of `U` with `(U', V) ∈ S`, a point of `U \ U'` with a
  quasi-compact neighbourhood `T`, the tube lemma over `T`
  (`IsCompact.induction_on`) for each `y ∈ V`, then a union over `y`. The step
  the page leaves out, `U'' ⊆ U' ∪ ⋃ Uᵢ`, is the last case split of the proof.
* **The bijection.** Every open `W` of `X × Y` gives the `CIdeal` `rect W` of
  the rectangles inside it, and `W` is the union of these rectangles
  (`iUnion_rect`, no hypothesis); under `HypG X`, every `CIdeal` is
  `rect` of the union of its rectangles (`eq_rect`).
* **The frame coproduct.** The `CIdeal`s form a frame (`CIdeal.instFrame`):
  meets are intersections, the join of a family is the `CIdeal` generated by its
  union (`CIdeal.span`), and the distributive law comes from `CIdeal.span_inter`
  (the `CIdeal` generated by a down-set `D` meets a down-set `A` inside the one
  generated by `D ∩ A`). With `CIdeal.inl U` (generated by `(U, ⊤)`) and
  `CIdeal.inr V`, it is the coproduct `Opens X ⊗ Opens Y`: for frame
  homomorphisms `f`, `g` to any frame `L`, `CIdeal.lift f g` sends `S` to
  `⨆_{(U,V) ∈ S} f U ⊓ g V` and is the only frame homomorphism with
  `lift ∘ inl = f`, `lift ∘ inr = g` (`CIdeal.existsUnique_lift`; uniqueness
  because every `CIdeal` is the join of its rectangles, `CIdeal.eq_iSup_rect`).
  No hypothesis on `X` or `Y` here.
* **The comparison.** `toOpens`, the lift of the two projections, sends `S` to
  `⋃_{(U,V) ∈ S} U × V` (`coe_toOpens`); it is onto for all `X`, `Y`
  (`toOpens_surjective`), and under `HypG X` it is an order isomorphism, hence an
  isomorphism of frames: `frameEquiv hG : CIdeal X Y ≃o Opens (X × Y)`, with
  `frameEquiv_apply`, `toOpens_comp_inl`, `toOpens_comp_inr`. Under (G), the
  coproduct of the frames of opens of `X` and `Y` is the frame of opens of
  `X × Y`.
* **(G) against Isbell's hypothesis.** Isbell (Proc. AMS 81 (1981), Th. 4) proves
  the same statement under `HypI X`: every nonempty closed set has a point with
  a core-compact neighbourhood in it (`WayBelowOpen`, `CoreCompact`). For sober
  spaces (I) implies (G), but not conversely: the counterexample of MathOverflow
  answer 516370 (to question 516361) is formalised here. The space `K` has a
  point `bot` whose only neighbourhood is `K`, a point `p`, and isolated points
  `d n m`, the neighbourhoods of `p` containing all rows `{n} × ℕ` for `n` large.
  It is scattered (`K.scattered`), hence sober (`Scattered.quasiSober`,
  `Scattered.t0Space`), compact, and not core-compact at `p`
  (`K.not_coreCompact`). Its countable power `ℕ → K` is sober (products of
  quasi-sober spaces are quasi-sober, `quasiSober_pi`), satisfies (G) as does
  every product of compact scattered spaces (`hypG_pi`: pin down the finitely
  many coordinates of a basic open with `exists_isolated_pi`, the fibre is
  compact by Tychonoff), and fails (I) (`not_hypI_pi`: every open leaves a
  coordinate free, along which `K` is a retract of the neighbourhood, and the
  argument at `p` applies to any space of which `K` is a retract,
  `K.not_coreCompact_of_retract`). Hence `hypG_not_hypI`.

**What the formalisation finds.** Nothing false: the argument holds as the
reading completes it, for arbitrary `X` and `Y`.

**Not formalised.** The last step of the dictionary, from frames to topoi: the
2-product `Top(X) ×_top Top(Y)` as the sheaves on the product locale (mathlib
has no 2-category of topoi). Nor the implication (I) ⇒ (G) for sober spaces, a
remark of the edition which rests on the Hofmann–Lawson theory of core-compact
sober spaces. Nor the rest of the folder (pages 3–8 on the
2-product as an intersection of subtopoi, pages 11–14 on infinite products).

What this certifies is that the reading holds together, not that it is what the
pages say (issue #26).
-/

namespace Grothendieck.Folder161_3

open TopologicalSpace Set

/-- The page's hypothesis: every nonempty locally closed `Z ⊆ X` has a point `x`
with a quasi-compact neighbourhood `T` in `Z`, i.e. `O ∩ Z ⊆ T ⊆ Z` for an
open `O ∋ x`. -/
def HypG (X : Type*) [TopologicalSpace X] : Prop :=
  ∀ Z : Set X, IsLocallyClosed Z → Z.Nonempty →
    ∃ x ∈ Z, ∃ T ⊆ Z, IsCompact T ∧ ∃ O : Set X, IsOpen O ∧ x ∈ O ∧ O ∩ Z ⊆ T

/-- A set of pairs of opens, stable under shrinking and under arbitrary unions in
each variable: an element of the frame coproduct of `Opens X` and `Opens Y`, the
« S » of the page. -/
@[ext]
structure CIdeal (X Y : Type*) [TopologicalSpace X] [TopologicalSpace Y] where
  carrier : Set (Opens X × Opens Y)
  mono : ∀ {U U' V V'}, (U, V) ∈ carrier → U' ≤ U → V' ≤ V → (U', V') ∈ carrier
  sSup_left : ∀ (s : Set (Opens X)) V,
    (∀ U ∈ s, (U, V) ∈ carrier) → (sSup s, V) ∈ carrier
  sSup_right : ∀ U (s : Set (Opens Y)),
    (∀ V ∈ s, (U, V) ∈ carrier) → (U, sSup s) ∈ carrier

variable {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]

namespace CIdeal

variable (S : CIdeal X Y)

lemma sup_left {U U' V} (h : (U, V) ∈ S.carrier) (h' : (U', V) ∈ S.carrier) :
    (U ⊔ U', V) ∈ S.carrier := by
  simpa [sSup_pair] using S.sSup_left {U, U'} V (by simp [h, h'])

lemma bot_top : (⊥, ⊤) ∈ S.carrier := by simpa using S.sSup_left ∅ ⊤ (by simp)

end CIdeal

/-- Pages 10–11: under `HypG X`, a `CIdeal` contains every rectangle covered by
its own rectangles. -/
theorem covering (hG : HypG X) (S : CIdeal X Y) (U : Opens X) (V : Opens Y)
    (h : (U : Set X) ×ˢ (V : Set Y) ⊆ ⋃ p ∈ S.carrier, (p.1 : Set X) ×ˢ (p.2 : Set Y)) :
    (U, V) ∈ S.carrier := by
  set U' := sSup {W | W ≤ U ∧ (W, V) ∈ S.carrier}
  have hU' : (U', V) ∈ S.carrier := S.sSup_left _ V fun W hW => hW.2
  suffices U ≤ U' from S.mono hU' this le_rfl
  by_contra hne
  obtain ⟨x, ⟨hxU, hxU'⟩, T, hTZ, hT, O, hO, hxO, hOT⟩ :=
    hG ((U : Set X) \ U') ⟨U, (U' : Set X)ᶜ, U.2, U'.2.isClosed_compl, sdiff_eq _ _⟩
      (sdiff_nonempty.2 hne)
  let U'' : Opens X := ⟨O ∩ U, hO.inter U.2⟩
  have key : (U' ⊔ U'', V) ∈ S.carrier := by
    refine S.mono (S.sSup_right _ {W | (U' ⊔ U'', W) ∈ S.carrier} fun W hW => hW) le_rfl ?_
    intro y hy
    obtain ⟨A, B, hAB, hyB, hTA⟩ : ∃ A B, (A, B) ∈ S.carrier ∧ y ∈ B ∧ T ⊆ A := by
      refine hT.induction_on (p := fun s => ∃ A B, (A, B) ∈ S.carrier ∧ y ∈ B ∧ s ⊆ A)
        ⟨⊥, ⊤, S.bot_top, trivial, empty_subset _⟩ ?_ ?_ ?_
      · exact fun s t hst ⟨A, B, h1, h2, h3⟩ => ⟨A, B, h1, h2, hst.trans h3⟩
      · rintro s t ⟨A, B, h1, h2, h3⟩ ⟨A', B', h1', h2', h3'⟩
        exact ⟨A ⊔ A', B ⊓ B', S.sup_left (S.mono h1 le_rfl inf_le_left)
          (S.mono h1' le_rfl inf_le_right), ⟨h2, h2'⟩, union_subset_union h3 h3'⟩
      · intro t ht
        obtain ⟨A, hA, B, hAB, hyB⟩ := by simpa using h (mk_mem_prod (hTZ ht).1 hy)
        exact ⟨A, mem_nhdsWithin_of_mem_nhds (A.2.mem_nhds hA), A, B, hAB, hyB, subset_rfl⟩
    refine Opens.mem_sSup.2 ⟨B ⊓ V, ?_, hyB, hy⟩
    refine S.mono (S.sup_left (S.mono hU' le_rfl inf_le_right) (S.mono hAB le_rfl inf_le_left))
      ?_ le_rfl
    rintro z (hz | ⟨hzO, hzU⟩)
    exacts [Or.inl hz, (em _).imp_right fun hz' => hTA (hOT ⟨hzO, hzU, hz'⟩)]
  have : U'' ≤ U' := le_sSup ⟨fun z hz => hz.2, S.mono key le_sup_right le_rfl⟩
  exact hxU' (this ⟨hxO, hxU⟩)

/-- The rectangles contained in `W ⊆ X × Y`. -/
def rect (W : Set (X × Y)) : CIdeal X Y where
  carrier := {p | (p.1 : Set X) ×ˢ (p.2 : Set Y) ⊆ W}
  mono h hU hV := (prod_mono hU hV).trans h
  sSup_left s V hs := by
    rintro ⟨x, y⟩ ⟨hx, hy⟩
    obtain ⟨U, hU, hxU⟩ := Opens.mem_sSup.1 hx
    exact hs U hU ⟨hxU, hy⟩
  sSup_right U s hs := by
    rintro ⟨x, y⟩ ⟨hx, hy⟩
    obtain ⟨V, hV, hyV⟩ := Opens.mem_sSup.1 hy
    exact hs V hV ⟨hx, hyV⟩

/-- An open `W` is the union of the rectangles inside it. -/
theorem iUnion_rect {W : Set (X × Y)} (hW : IsOpen W) :
    ⋃ p ∈ (rect W).carrier, (p.1 : Set X) ×ˢ (p.2 : Set Y) = W := by
  refine subset_antisymm (iUnion₂_subset fun p hp => hp) fun ⟨x, y⟩ hxy => ?_
  obtain ⟨u, v, hu, hv, hx, hy, huv⟩ := isOpen_prod_iff.1 hW x y hxy
  exact mem_biUnion (x := ((⟨u, hu⟩ : Opens X), (⟨v, hv⟩ : Opens Y)))
    (show _ ∈ (rect W).carrier from huv) ⟨hx, hy⟩

/-- Under `HypG X`, every `CIdeal` is `rect` of the union of its rectangles. -/
theorem eq_rect (hG : HypG X) (S : CIdeal X Y) :
    S.carrier = (rect (⋃ p ∈ S.carrier, (p.1 : Set X) ×ˢ (p.2 : Set Y))).carrier :=
  subset_antisymm (fun _ hp => subset_biUnion_of_mem (u := fun p : Opens X × Opens Y =>
    (p.1 : Set X) ×ˢ (p.2 : Set Y)) hp) fun p hp => covering hG S p.1 p.2 hp

/-! ### The frame of C-ideals -/

namespace CIdeal

variable (S : CIdeal X Y)

lemma bot_left (V : Opens Y) : (⊥, V) ∈ S.carrier := S.mono S.bot_top le_rfl le_top

lemma bot_right (U : Opens X) : (U, ⊥) ∈ S.carrier := by
  simpa using S.sSup_right U ∅ (by simp)

lemma isLowerSet : IsLowerSet S.carrier := fun _ _ h hp => S.mono hp h.1 h.2

/-- Closure under `sSup` in the first variable, in the form used below. -/
lemma mem_of_le_sSup_left {s : Set (Opens X)} {U V} (hU : U ≤ sSup s)
    (h : ∀ W ∈ s, (U ⊓ W, V) ∈ S.carrier) : (U, V) ∈ S.carrier := by
  have := S.sSup_left _ V (forall_mem_image.2 h)
  rwa [sSup_image, ← inf_sSup_eq, inf_eq_left.2 hU] at this

lemma mem_of_le_sSup_right {s : Set (Opens Y)} {U V} (hV : V ≤ sSup s)
    (h : ∀ W ∈ s, (U, V ⊓ W) ∈ S.carrier) : (U, V) ∈ S.carrier := by
  have := S.sSup_right U _ (forall_mem_image.2 h)
  rwa [sSup_image, ← inf_sSup_eq, inf_eq_left.2 hV] at this

instance : PartialOrder (CIdeal X Y) := PartialOrder.lift carrier fun _ _ => CIdeal.ext

lemma le_def {S T : CIdeal X Y} : S ≤ T ↔ S.carrier ⊆ T.carrier := Iff.rfl

lemma mem_of_le {S T : CIdeal X Y} (h : S ≤ T) {p} (hp : p ∈ S.carrier) : p ∈ T.carrier :=
  h hp

instance : InfSet (CIdeal X Y) where
  sInf s :=
    { carrier := ⋂ S ∈ s, S.carrier
      mono := fun h hU hV => mem_iInter₂.2 fun S hS => S.mono (mem_iInter₂.1 h S hS) hU hV
      sSup_left := fun t V h => mem_iInter₂.2 fun S hS =>
        S.sSup_left t V fun U hU => mem_iInter₂.1 (h U hU) S hS
      sSup_right := fun U t h => mem_iInter₂.2 fun S hS =>
        S.sSup_right U t fun V hV => mem_iInter₂.1 (h V hV) S hS }

/-- Meets are intersections; the join of a family is the C-ideal generated by its union. -/
instance : CompleteLattice (CIdeal X Y) :=
  completeLatticeOfInf _ fun _ =>
    ⟨fun _ hS => biInter_subset_of_mem hS, fun _ hT => subset_iInter₂ hT⟩

@[simp] lemma carrier_inf (S T : CIdeal X Y) : (S ⊓ T).carrier = S.carrier ∩ T.carrier := by
  change (⋂ U ∈ ({S, T} : Set (CIdeal X Y)), U.carrier) = _
  simp

@[simp] lemma carrier_top : (⊤ : CIdeal X Y).carrier = univ := by
  change (⋂ U ∈ (∅ : Set (CIdeal X Y)), U.carrier) = _
  simp

/-- The C-ideal generated by a set of pairs of opens. -/
def span (D : Set (Opens X × Opens Y)) : CIdeal X Y := sInf {S | D ⊆ S.carrier}

lemma subset_span (D : Set (Opens X × Opens Y)) : D ⊆ (span D).carrier :=
  subset_iInter₂ fun _ h => h

lemma span_le {D : Set (Opens X × Opens Y)} {S : CIdeal X Y} (h : D ⊆ S.carrier) :
    span D ≤ S :=
  sInf_le h

lemma sSup_eq_span (s : Set (CIdeal X Y)) : sSup s = span (⋃ S ∈ s, S.carrier) :=
  le_antisymm (sSup_le fun _ hS => (subset_biUnion_of_mem hS).trans (subset_span _))
    (span_le (iUnion₂_subset fun _ hS => (le_sSup hS : _ ≤ sSup s)))

/-- The C-ideal generated by a down-set `D` meets a down-set `A` inside the C-ideal generated by
`D ∩ A`: the distributive law of the frame. -/
lemma span_inter {D A : Set (Opens X × Opens Y)} (hD : IsLowerSet D) (hA : IsLowerSet A) :
    (span D).carrier ∩ A ⊆ (span (D ∩ A)).carrier := by
  let T : CIdeal X Y :=
    { carrier := {p | ∀ q ≤ p, q ∈ A → q ∈ (span (D ∩ A)).carrier}
      mono := fun h hU hV q hq => h q (hq.trans ⟨hU, hV⟩)
      sSup_left := fun s V h q hq hqA => (span _).mem_of_le_sSup_left hq.1 fun U hU =>
        h U hU _ ⟨inf_le_right, hq.2⟩ (hA (show _ ≤ q from ⟨inf_le_left, le_rfl⟩) hqA)
      sSup_right := fun U s h q hq hqA => (span _).mem_of_le_sSup_right hq.2 fun V hV =>
        h V hV _ ⟨hq.1, inf_le_right⟩ (hA (show _ ≤ q from ⟨le_rfl, inf_le_left⟩) hqA) }
  rintro p ⟨hp, hpA⟩
  exact span_le (S := T) (fun q hq r hr hrA => subset_span _ ⟨hD hr hq, hrA⟩) hp p le_rfl hpA

/-- The C-ideals form a frame. -/
instance instFrame : Order.Frame (CIdeal X Y) := .ofMinimalAxioms ⟨fun a s p hp => by
  rw [carrier_inf, sSup_eq_span] at hp
  refine span_le (fun q hq => ?_) (span_inter (isLowerSet_iUnion₂ fun S _ => S.isLowerSet)
    a.isLowerSet ⟨hp.2, hp.1⟩)
  obtain ⟨S, hS, hqS⟩ := mem_iUnion₂.1 hq.1
  exact mem_of_le (le_biSup (a ⊓ ·) hS) (by simp [hq.2, hqS])⟩

/-! ### The coproduct of frames -/

/-- `U ↦ U × Y`: the C-ideal generated by `(U, ⊤)`. -/
def inl : FrameHom (Opens X) (CIdeal X Y) where
  toFun U :=
    { carrier := {p | p.1 ≤ U ∨ p.2 = ⊥}
      mono := fun h hU hV => by
        rcases h with h | h
        exacts [.inl (hU.trans h), .inr (le_bot_iff.1 (hV.trans h.le))]
      sSup_left := fun s V h => (em (V = ⊥)).elim Or.inr fun hV =>
        Or.inl (sSup_le fun U' hU' => (h U' hU').resolve_right hV)
      sSup_right := fun U' s h => (em (U' ≤ U)).elim Or.inl fun hU' =>
        Or.inr (sSup_eq_bot.2 fun V hV => (h V hV).resolve_left hU') }
  map_inf' U U' := CIdeal.ext <| by ext; simp [and_or_right]
  map_top' := CIdeal.ext <| by ext; simp
  map_sSup' s := by
    refine le_antisymm ?_ (sSup_le ?_)
    · rintro ⟨U', V⟩ (h | rfl)
      exacts [mem_of_le_sSup_left _ h fun U hU =>
        mem_of_le (le_sSup (mem_image_of_mem _ hU)) (.inl inf_le_right), bot_right _ _]
    exact forall_mem_image.2 fun _ hU _ hp => hp.imp (le_trans · (le_sSup hU)) id

/-- `V ↦ X × V`: the C-ideal generated by `(⊤, V)`. -/
def inr : FrameHom (Opens Y) (CIdeal X Y) where
  toFun V :=
    { carrier := {p | p.1 = ⊥ ∨ p.2 ≤ V}
      mono := fun h hU hV => by
        rcases h with h | h
        exacts [.inl (le_bot_iff.1 (hU.trans h.le)), .inr (hV.trans h)]
      sSup_left := fun s V' h => (em (V' ≤ V)).elim Or.inr fun hV' =>
        Or.inl (sSup_eq_bot.2 fun U hU => (h U hU).resolve_right hV')
      sSup_right := fun U s h => (em (U = ⊥)).elim Or.inl fun hU =>
        Or.inr (sSup_le fun V' hV' => (h V' hV').resolve_left hU) }
  map_inf' V V' := CIdeal.ext <| by ext; simp [or_and_left]
  map_top' := CIdeal.ext <| by ext; simp
  map_sSup' s := by
    refine le_antisymm ?_ (sSup_le ?_)
    · rintro ⟨U, V'⟩ (rfl | h)
      exacts [bot_left _ _, mem_of_le_sSup_right _ h fun V hV =>
        mem_of_le (le_sSup (mem_image_of_mem _ hV)) (.inr inf_le_right)]
    exact forall_mem_image.2 fun _ hV _ hp => hp.imp id (le_trans · (le_sSup hV))

@[simp] lemma mem_inl {p : Opens X × Opens Y} {U : Opens X} :
    p ∈ (inl U : CIdeal X Y).carrier ↔ p.1 ≤ U ∨ p.2 = ⊥ := Iff.rfl

@[simp] lemma mem_inr {p : Opens X × Opens Y} {V : Opens Y} :
    p ∈ (inr V : CIdeal X Y).carrier ↔ p.1 = ⊥ ∨ p.2 ≤ V := Iff.rfl

/-- The rectangle `inl U ⊓ inr V` lies in `S` exactly when `(U, V) ∈ S`. -/
lemma inl_inf_inr_le_iff {U : Opens X} {V : Opens Y} :
    inl U ⊓ inr V ≤ S ↔ (U, V) ∈ S.carrier := by
  refine ⟨fun h => h (by simp), fun h ⟨a, b⟩ hq => ?_⟩
  simp only [carrier_inf, mem_inter_iff, mem_inl, mem_inr] at hq
  rcases hq with ⟨ha | rfl, rfl | hb⟩
  exacts [S.bot_left _, S.mono h ha hb, S.bot_left _, S.bot_right _]

/-- Every C-ideal is the join of its rectangles. -/
theorem eq_iSup_rect : S = ⨆ p ∈ S.carrier, inl p.1 ⊓ inr p.2 := by
  refine le_antisymm (le_def.2 fun p hp => ?_) (iSup₂_le fun _ => (inl_inf_inr_le_iff S).2)
  exact mem_of_le (le_biSup (fun p : Opens X × Opens Y => (inl p.1 ⊓ inr p.2 : CIdeal X Y)) hp)
    (by simp)

variable {L : Type*} [Order.Frame L] (f : FrameHom (Opens X) L) (g : FrameHom (Opens Y) L)

/-- The sup `⨆_{(U,V) ∈ D} f U ⊓ g V` does not change when `D` is replaced by the C-ideal it
generates. -/
lemma iSup_span (D : Set (Opens X × Opens Y)) :
    ⨆ p ∈ (span D).carrier, f p.1 ⊓ g p.2 = ⨆ p ∈ D, f p.1 ⊓ g p.2 := by
  refine le_antisymm ?_ (biSup_mono (subset_span D))
  let T : CIdeal X Y :=
    { carrier := {p | f p.1 ⊓ g p.2 ≤ ⨆ p ∈ D, f p.1 ⊓ g p.2}
      mono := fun h hU hV =>
        (inf_le_inf (OrderHomClass.mono f hU) (OrderHomClass.mono g hV)).trans h
      sSup_left := fun s V h => by
        show f (sSup s) ⊓ g V ≤ _
        rw [map_sSup, sSup_image, iSup₂_inf_eq]
        exact iSup₂_le h
      sSup_right := fun U s h => by
        show f U ⊓ g (sSup s) ≤ _
        rw [map_sSup, sSup_image, inf_iSup₂_eq]
        exact iSup₂_le h }
  exact iSup₂_le fun p hp =>
    span_le (S := T) (fun q hq => le_iSup₂ (f := fun p _ => f p.1 ⊓ g p.2) q hq) hp

/-- The map out of the coproduct: `S ↦ ⨆_{(U,V) ∈ S} f U ⊓ g V`. -/
def lift : FrameHom (CIdeal X Y) L where
  toFun S := ⨆ p ∈ S.carrier, f p.1 ⊓ g p.2
  map_inf' S T := by
    show ⨆ p ∈ (S ⊓ T).carrier, _ = (⨆ p ∈ S.carrier, _) ⊓ ⨆ p ∈ T.carrier, _
    rw [carrier_inf]
    refine le_antisymm (iSup₂_le fun p hp => le_inf (le_iSup₂_of_le p hp.1 le_rfl)
      (le_iSup₂_of_le p hp.2 le_rfl)) ?_
    simp only [iSup₂_inf_eq, inf_iSup₂_eq]
    exact iSup₂_le fun q hq => iSup₂_le fun p hp => le_iSup₂_of_le (p.1 ⊓ q.1, p.2 ⊓ q.2)
      (by simpa using ⟨S.mono hp inf_le_left inf_le_left, T.mono hq inf_le_right inf_le_right⟩)
      (by simp only [map_inf]; exact le_of_eq (by ac_rfl))
  map_top' := top_le_iff.1 <| le_iSup₂_of_le (⊤, ⊤) (by simp) (by simp)
  map_sSup' s := by simp only [sSup_eq_span, iSup_span, sSup_image, iSup_iUnion]

lemma lift_apply (S : CIdeal X Y) : lift f g S = ⨆ p ∈ S.carrier, f p.1 ⊓ g p.2 := rfl

theorem lift_comp_inl : (lift f g).comp inl = f := FrameHom.ext fun U =>
  le_antisymm (iSup₂_le fun p hp => hp.elim (fun h => inf_le_left.trans (OrderHomClass.mono f h))
    fun h => by simp [h])
    (le_iSup₂_of_le (U, ⊤) (Or.inl le_rfl) (by simp))

theorem lift_comp_inr : (lift f g).comp inr = g := FrameHom.ext fun V =>
  le_antisymm (iSup₂_le fun p hp => hp.elim (fun h => by simp [h])
    fun h => inf_le_right.trans (OrderHomClass.mono g h))
    (le_iSup₂_of_le (⊤, V) (Or.inr le_rfl) (by simp))

theorem lift_unique (h : FrameHom (CIdeal X Y) L) (h₁ : h.comp inl = f) (h₂ : h.comp inr = g) :
    h = lift f g := by
  subst h₁ h₂
  ext S
  conv_lhs => rw [eq_iSup_rect S]
  simp [lift_apply]

/-- The universal property of the coproduct `Opens X ⊗ Opens Y`. -/
theorem existsUnique_lift :
    ∃! h : FrameHom (CIdeal X Y) L, h.comp inl = f ∧ h.comp inr = g :=
  ⟨lift f g, ⟨lift_comp_inl f g, lift_comp_inr f g⟩,
    fun h h' => lift_unique f g h h'.1 h'.2⟩

end CIdeal

/-! ### The comparison with `Opens (X × Y)` -/

open CIdeal

/-- The comparison map `S ↦ ⋃_{(U,V) ∈ S} U × V`, the map out of the coproduct given by the
two projections. -/
def toOpens : FrameHom (CIdeal X Y) (Opens (X × Y)) :=
  lift (Opens.comap (ContinuousMap.fst)) (Opens.comap (ContinuousMap.snd))

lemma coe_toOpens (S : CIdeal X Y) :
    (toOpens S : Set (X × Y)) = ⋃ p ∈ S.carrier, (p.1 : Set X) ×ˢ (p.2 : Set Y) := by
  simp [toOpens, lift_apply, prod_eq]

theorem toOpens_comp_inl : toOpens.comp inl = Opens.comap (ContinuousMap.fst : C(X × Y, X)) :=
  lift_comp_inl _ _

theorem toOpens_comp_inr : toOpens.comp inr = Opens.comap (ContinuousMap.snd : C(X × Y, Y)) :=
  lift_comp_inr _ _

/-- Unconditionally, every open of `X × Y` comes from a C-ideal. -/
theorem toOpens_surjective : Function.Surjective (toOpens : CIdeal X Y → Opens (X × Y)) :=
  fun W => ⟨rect W, Opens.ext <| (coe_toOpens _).trans (iUnion_rect W.2)⟩

/-- Under `HypG X`, the comparison map reflects the order. -/
theorem toOpens_le_toOpens_iff (hG : HypG X) {S T : CIdeal X Y} :
    toOpens S ≤ toOpens T ↔ S ≤ T := by
  refine ⟨fun h p hp => (eq_rect hG T).superset ?_, fun h => OrderHomClass.mono _ h⟩
  have h' : (toOpens S : Set (X × Y)) ⊆ toOpens T := h
  rw [coe_toOpens, coe_toOpens] at h'
  exact ((eq_rect hG S).subset hp).trans h'

/-- Pages 10–11 as a statement on frames: under `HypG X`, the coproduct of the frames
`Opens X` and `Opens Y` is `Opens (X × Y)`. The map is `toOpens` (`frameEquiv_apply`), the map out
of the coproduct given by the two projections (`toOpens_comp_inl`, `toOpens_comp_inr`). -/
noncomputable def frameEquiv (hG : HypG X) : CIdeal X Y ≃o Opens (X × Y) where
  __ := Equiv.ofBijective toOpens ⟨fun _ _ h => le_antisymm
    ((toOpens_le_toOpens_iff hG).1 h.le) ((toOpens_le_toOpens_iff hG).1 h.ge), toOpens_surjective⟩
  map_rel_iff' := toOpens_le_toOpens_iff hG

@[simp] lemma frameEquiv_apply (hG : HypG X) (S : CIdeal X Y) :
    frameEquiv hG S = toOpens S := rfl

/-! ### (G) is strictly weaker than Isbell's hypothesis -/

open Function (eval update update_of_ne update_self)

/-- `V` is way below `U` among the opens: `V ⊆ U`, and every nonempty directed family of opens
whose union contains `U` has a member containing `V`. -/
def WayBelowOpen {X : Type*} [TopologicalSpace X] (V U : Set X) : Prop :=
  V ⊆ U ∧ ∀ 𝒲 : Set (Set X), 𝒲.Nonempty → DirectedOn (· ⊆ ·) 𝒲 → (∀ W ∈ 𝒲, IsOpen W) →
    U ⊆ ⋃₀ 𝒲 → ∃ W ∈ 𝒲, V ⊆ W

/-- Core-compactness: every point `x` of an open `U` has an open neighbourhood way below `U`. -/
def CoreCompact (X : Type*) [TopologicalSpace X] : Prop :=
  ∀ U : Set X, IsOpen U → ∀ x ∈ U, ∃ V, IsOpen V ∧ x ∈ V ∧ WayBelowOpen V U

/-- Isbell's hypothesis (Proc. AMS 81 (1981), Th. 4): every nonempty closed `H ⊆ X` has a point
`x` with a neighbourhood `N` in `H` (`O ∩ H ⊆ N ⊆ H` for an open `O ∋ x`) which is core-compact
as a subspace. -/
def HypI (X : Type*) [TopologicalSpace X] : Prop :=
  ∀ H : Set X, IsClosed H → H.Nonempty →
    ∃ x ∈ H, ∃ N ⊆ H, (∃ O : Set X, IsOpen O ∧ x ∈ O ∧ O ∩ H ⊆ N) ∧ CoreCompact N

/-- Every nonempty subset has a relatively isolated point. -/
def Scattered (X : Type*) [TopologicalSpace X] : Prop :=
  ∀ A : Set X, A.Nonempty → ∃ x ∈ A, ∃ W, IsOpen W ∧ x ∈ W ∧ ∀ y ∈ A, y ∈ W → y = x

section Scattered

variable {Z : Type*} [TopologicalSpace Z]

theorem Scattered.t0Space (h : Scattered Z) : T0Space Z := by
  refine (t0Space_iff_inseparable _).2 fun x y hxy => ?_
  obtain ⟨z, hz | hz, W, hW, hzW, hiso⟩ := h {x, y} (insert_nonempty _ _) <;> subst hz
  · exact (hiso y (by simp) ((inseparable_iff_forall_isOpen.1 hxy W hW).1 hzW)).symm
  · exact hiso x (by simp) ((inseparable_iff_forall_isOpen.1 hxy W hW).2 hzW)

/-- An isolated point of an irreducible closed set is its generic point. -/
theorem Scattered.quasiSober (h : Scattered Z) : QuasiSober Z where
  sober {S} hS hc := by
    obtain ⟨x, hx, W, hW, hxW, hiso⟩ := h S hS.nonempty
    refine ⟨x, (closure_minimal (singleton_subset_iff.2 hx) hc).antisymm fun y hy => ?_⟩
    rw [← specializes_iff_mem_closure, specializes_iff_forall_open]
    intro V hV hyV
    obtain ⟨z, hzS, hzW, hzV⟩ := hS.2 W V hW hV ⟨x, hx, hxW⟩ ⟨y, hy, hyV⟩
    exact hiso z hzS hzW ▸ hzV

end Scattered

/-- An arbitrary product of quasi-sober spaces is quasi-sober: the generic point of an
irreducible closed `S` has for coordinates the generic points of the closures of the
projections of `S`. -/
instance quasiSober_pi {ι : Type*} {π : ι → Type*} [∀ i, TopologicalSpace (π i)]
    [∀ i, QuasiSober (π i)] : QuasiSober (∀ i, π i) where
  sober {S} hS hc := by
    classical
    have hi i : IsIrreducible (eval i '' S) := hS.image _ (continuous_apply i).continuousOn
    set x : ∀ i, π i := fun i => (hi i).genericPoint
    have hx i : closure {x i} = closure (eval i '' S) := (hi i).genericPoint_closure_eq
    have hxS : x ∈ S := by
      rw [← hc.closure_eq, mem_closure_iff]
      intro o ho hxo
      obtain ⟨I, u, hu, hIo⟩ := isOpen_pi_iff.1 ho x hxo
      suffices (S ∩ (I : Set ι).pi u).Nonempty from
        let ⟨y, hyS, hyI⟩ := this; ⟨y, hIo hyI, hyS⟩
      clear hIo
      induction I using Finset.induction_on with
      | empty => simpa using hS.nonempty
      | insert a I ha ih =>
        rw [Finset.coe_insert, insert_pi]
        have hua := hu a (Finset.mem_insert_self _ _)
        obtain ⟨_, hy, y, hyS, rfl⟩ :=
          mem_closure_iff.1 (hx a ▸ subset_closure rfl : x a ∈ closure (eval a '' S)) _ hua.1 hua.2
        exact hS.2 _ _ (hua.1.preimage (continuous_apply a))
          (isOpen_set_pi I.finite_toSet fun b hb => (hu b (Finset.mem_insert_of_mem hb)).1)
          ⟨y, hyS, hy⟩ (ih fun b hb => hu b (Finset.mem_insert_of_mem hb))
    refine ⟨x, (closure_minimal (singleton_subset_iff.2 hxS) hc).antisymm fun y hy => ?_⟩
    rw [← specializes_iff_mem_closure, specializes_pi]
    exact fun i => specializes_iff_mem_closure.2 (hx i ▸ subset_closure (mem_image_of_mem _ hy))

/-- The space of the MathOverflow answer: a point `bot`, a point `p`, and points `d n m`
indexed by `ℕ × ℕ`. -/
inductive K
  | bot
  | p
  | d (n m : ℕ)

namespace K

/-- The opens of `K`: a set containing `bot` is everything; a set containing `p` contains the
rows `{n} × ℕ` for all `n` large enough. -/
instance : TopologicalSpace K where
  IsOpen W := (bot ∈ W → W = univ) ∧ (p ∈ W → ∃ N, ∀ n ≥ N, ∀ m, d n m ∈ W)
  isOpen_univ := ⟨fun _ => rfl, fun _ => ⟨0, fun _ _ _ => trivial⟩⟩
  isOpen_inter s t hs ht := ⟨fun h => by rw [hs.1 h.1, ht.1 h.2, univ_inter], fun h =>
    let ⟨N, hN⟩ := hs.2 h.1
    let ⟨N', hN'⟩ := ht.2 h.2
    ⟨max N N', fun n hn m => ⟨hN n (le_of_max_le_left hn) m, hN' n (le_of_max_le_right hn) m⟩⟩⟩
  isOpen_sUnion S hS := ⟨fun ⟨s, hs, hb⟩ => eq_univ_of_univ_subset ((hS s hs).1 hb ▸
    subset_sUnion_of_mem hs), fun ⟨s, hs, hp⟩ =>
    let ⟨N, hN⟩ := (hS s hs).2 hp
    ⟨N, fun n hn m => ⟨s, hs, hN n hn m⟩⟩⟩

lemma isOpen_iff {W : Set K} :
    IsOpen W ↔ (bot ∈ W → W = univ) ∧ (p ∈ W → ∃ N, ∀ n ≥ N, ∀ m, d n m ∈ W) := Iff.rfl

/-- The only open containing `bot` is `K`. -/
instance : CompactSpace K := ⟨isCompact_iff_finite_subcover.2 fun U hU hcov => by
  obtain ⟨i, hi⟩ := mem_iUnion.1 (hcov (mem_univ bot))
  exact ⟨{i}, by simp [(hU i).1 hi]⟩⟩

lemma isOpen_ne_bot : IsOpen {k : K | k ≠ bot} :=
  isOpen_iff.2 ⟨fun h => (h rfl).elim, fun _ => ⟨0, fun _ _ _ => by simp⟩⟩

/-- `K` is scattered: isolate a point `d n m` if there is one, else `p`, else `bot`. -/
theorem scattered : Scattered K := by
  intro A hA
  by_cases hd : ∃ n m, d n m ∈ A
  · obtain ⟨n, m, h⟩ := hd
    exact ⟨_, h, {d n m}, isOpen_iff.2 ⟨by simp, by simp⟩, rfl, fun y _ hy => hy⟩
  by_cases hp : p ∈ A
  · refine ⟨p, hp, _, isOpen_ne_bot, by simp, ?_⟩
    rintro (_ | _ | ⟨n, m⟩) hy hne
    exacts [(hne rfl).elim, rfl, (hd ⟨n, m, hy⟩).elim]
  · have h : ∀ y ∈ A, y = bot := by
      rintro (_ | _ | ⟨n, m⟩) hy
      exacts [rfl, (hp hy).elim, (hd ⟨n, m, hy⟩).elim]
    obtain ⟨y, hy⟩ := hA
    exact ⟨bot, h y hy ▸ hy, univ, isOpen_univ, trivial, fun y hy _ => h y hy⟩

instance : QuasiSober K := scattered.quasiSober

instance : T0Space K := scattered.t0Space

/-- A space through which `K` retracts (`q ∘ L = id`, both continuous) is not core-compact: no
open neighbourhood of `L p` is way below `q⁻¹(K \ {bot})`. -/
theorem not_coreCompact_of_retract {Y : Type*} [TopologicalSpace Y] {L : K → Y} {q : Y → K}
    (hL : Continuous L) (hq : Continuous q) (hqL : ∀ k, q (L k) = k) : ¬ CoreCompact Y := by
  intro hY
  obtain ⟨V, hV, hLV, -, hwb⟩ := hY _ (isOpen_ne_bot.preimage hq) (L p) (by simp [hqL])
  obtain ⟨N, hN⟩ := (isOpen_iff.1 (hV.preimage hL)).2 hLV
  let T (m₀ : ℕ) : Set K := {k | k ≠ bot ∧ ∀ m, k = d N m → m < m₀}
  have hT m₀ : IsOpen (T m₀) := isOpen_iff.2 ⟨fun h => (h.1 rfl).elim, fun _ =>
    ⟨N + 1, fun n hn m => ⟨by simp, fun m' h => by injection h; omega⟩⟩⟩
  have hcov (k : K) : ∃ m₀, ∀ m, k = d N m → m < m₀ := by
    rcases k with _ | _ | ⟨n, m⟩
    exacts [⟨0, by simp⟩, ⟨0, by simp⟩, ⟨m + 1, fun m' h => by injection h; omega⟩]
  obtain ⟨_, ⟨m₀, rfl⟩, hVW⟩ := hwb (range fun m₀ => q ⁻¹' T m₀) (range_nonempty _)
    (directedOn_range.2 <| Monotone.directed_le fun a b hab k hk =>
      ⟨hk.1, fun m h => (hk.2 m h).trans_le hab⟩)
    (forall_mem_range.2 fun m₀ => (hT m₀).preimage hq)
    (fun y hy => let ⟨m₀, hm₀⟩ := hcov (q y); ⟨_, ⟨m₀, rfl⟩, hy, hm₀⟩)
  exact lt_irrefl _ ((hVW (hN N le_rfl m₀)).2 m₀ (hqL _))

/-- `K` is not core-compact, at the point `p`. -/
theorem not_coreCompact : ¬ CoreCompact K :=
  not_coreCompact_of_retract continuous_id continuous_id fun _ => rfl

end K

/-- In a product of scattered spaces, finitely many coordinates can be pinned down: a nonempty
`A` has a point `a` with an open `O ∋ a` whose points in `A` agree with `a` on `J`. -/
theorem exists_isolated_pi {ι : Type*} {π : ι → Type*} [∀ i, TopologicalSpace (π i)]
    (h : ∀ i, Scattered (π i)) (J : Finset ι) (A : Set (∀ i, π i)) (hA : A.Nonempty) :
    ∃ a ∈ A, ∃ O, IsOpen O ∧ a ∈ O ∧ ∀ b ∈ A, b ∈ O → ∀ j ∈ J, b j = a j := by
  classical
  induction J using Finset.induction_on generalizing A with
  | empty => obtain ⟨a, ha⟩ := hA; exact ⟨a, ha, univ, isOpen_univ, trivial, by simp⟩
  | insert i J hi ih =>
    obtain ⟨_, ⟨a₀, ha₀, rfl⟩, W, hW, hW₀, hiso⟩ := h i (eval i '' A) (hA.image _)
    obtain ⟨a, ⟨haA, hai⟩, O, hO, haO, hJ⟩ := ih {b ∈ A | b i = a₀ i} ⟨a₀, ha₀, rfl⟩
    refine ⟨a, haA, O ∩ eval i ⁻¹' W, hO.inter (hW.preimage (continuous_apply i)),
      ⟨haO, show a i ∈ W from hai ▸ hW₀⟩, fun b hb hbO => ?_⟩
    have hbi : b i = a₀ i := hiso _ (mem_image_of_mem _ hb) hbO.2
    simp only [Finset.mem_insert, forall_eq_or_imp]
    exact ⟨hbi.trans hai.symm, hJ b ⟨hb, hbi⟩ hbO.1⟩

/-- A product of compact scattered spaces satisfies (G): in `Z = U ∩ H`, pin down the finitely
many coordinates of a basic open inside `U`; the fibre over the pinned point is compact
(Tychonoff), and its trace on `H` is a compact neighbourhood in `Z`. -/
theorem hypG_pi {ι : Type*} {π : ι → Type*} [∀ i, TopologicalSpace (π i)]
    [∀ i, CompactSpace (π i)] (h : ∀ i, Scattered (π i)) : HypG (∀ i, π i) := by
  classical
  rintro _ ⟨U, H, hU, hH, rfl⟩ ⟨z, hzU, hzH⟩
  obtain ⟨J, u, hu, hJU⟩ := isOpen_pi_iff.1 hU z hzU
  have hB : IsOpen ((J : Set ι).pi u) := isOpen_set_pi J.finite_toSet fun j hj => (hu j hj).1
  obtain ⟨a, ⟨haH, haB⟩, O, hO, haO, hiso⟩ :=
    exists_isolated_pi h J (H ∩ (J : Set ι).pi u) ⟨z, hzH, fun j hj => (hu j hj).2⟩
  have hF : {b : ∀ i, π i | ∀ j ∈ J, b j = a j} =
      univ.pi fun i => if i ∈ J then {a i} else univ := by
    ext b
    simp only [mem_ofPred_eq, mem_univ_pi]
    refine forall_congr' fun i => ?_
    split_ifs with hi <;> simp [hi]
  refine ⟨a, ⟨hJU haB, haH⟩, {b | ∀ j ∈ J, b j = a j} ∩ H,
    fun b hb => ⟨hJU fun j hj => by rw [hb.1 j hj]; exact haB j hj, hb.2⟩, ?_,
    O ∩ (J : Set ι).pi u, hO.inter hB, ⟨haO, haB⟩,
    fun b ⟨⟨hbO, hbB⟩, _, hbH⟩ => ⟨hiso b ⟨hbH, hbB⟩ hbO, hbH⟩⟩
  rw [hF]
  exact (isCompact_univ_pi fun i => by
    split_ifs; exacts [isCompact_singleton, isCompact_univ]).inter_right hH

/-- `K^ι` for infinite `ι` fails (I): a neighbourhood of `x` contains a basic open, which leaves
some coordinate `j` free, so `K` retracts through the neighbourhood by `k ↦ x[j ↦ k]`. -/
theorem not_hypI_pi {ι : Type*} [Infinite ι] : ¬ HypI (ι → K) := by
  classical
  intro hI
  obtain ⟨x, -, N, -, ⟨O, hO, hxO, hON⟩, hN⟩ := hI univ isClosed_univ ⟨fun _ => K.bot, trivial⟩
  obtain ⟨I, u, hu, hIO⟩ := isOpen_pi_iff.1 hO x hxO
  obtain ⟨j, hj⟩ := Infinite.exists_notMem_finset I
  have hL k : update x j k ∈ N := hON ⟨hIO fun i hi => by
    rw [update_of_ne (ne_of_mem_of_not_mem hi hj)]; exact (hu i hi).2, trivial⟩
  exact K.not_coreCompact_of_retract (L := fun k => ⟨update x j k, hL k⟩) (q := (·.1 j))
    ((continuous_const.update j continuous_id : Continuous (update x j ·)).subtype_mk hL)
    ((continuous_apply j).comp continuous_subtype_val) (fun k => update_self ..) hN

/-- (G) is strictly weaker than (I) for sober spaces: `ℕ → K` is sober and satisfies (G) but
not (I) (the counterexample of MathOverflow answer 516370). -/
theorem hypG_not_hypI :
    ∃ (X : Type) (_ : TopologicalSpace X), QuasiSober X ∧ T0Space X ∧ HypG X ∧ ¬ HypI X :=
  ⟨ℕ → K, inferInstance, inferInstance, inferInstance, hypG_pi fun _ => K.scattered,
    not_hypI_pi⟩

end Grothendieck.Folder161_3
