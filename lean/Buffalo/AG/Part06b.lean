/-! ### Discrete valuation rings, artinian rings -/

section DVR

variable (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]

/-- In a discrete valuation ring the primes are `0` and the maximal ideal. -/
theorem dvr_prime_eq (p : Ideal R) [hp : p.IsPrime] : p = ⊥ ∨ p = IsLocalRing.maximalIdeal R := by
  by_cases h : p = ⊥
  · exact Or.inl h
  · exact Or.inr (IsLocalRing.eq_maximalIdeal (hp.isMaximal h))

/-- Oqhr-Gt66es-5841 (1:37:21) [ex] A discrete valuation ring (e.g. `k[[t]]`) is a local domain
with a single nonzero prime ideal; its spectrum has a generic point `(0)` and a special point `𝔪`,
lying in the closure of the former. -/
theorem ex_5841 :
    (∀ p : Ideal R, p.IsPrime → p = ⊥ ∨ p = IsLocalRing.maximalIdeal R) ∧
    IsLocalRing.maximalIdeal R ≠ ⊥ ∧
    (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum R) ⤳ ⟨IsLocalRing.maximalIdeal R, inferInstance⟩ ∧
    ∀ (k : Type u) [Field k], IsDiscreteValuationRing (PowerSeries k) := by
  refine ⟨fun p hp => dvr_prime_eq R p, fun h => ?_, ?_, fun k _ => inferInstance⟩
  · exact IsDiscreteValuationRing.not_isField R (IsLocalRing.isField_iff_maximalIdeal_eq.2 h)
  · rw [← PrimeSpectrum.le_iff_specializes]
    exact bot_le (a := IsLocalRing.maximalIdeal R)

/-- Oqhr-Gt66es-5903 (1:38:23) [cex] A discrete valuation ring is not artinian, although its
spectrum is finite (two points) and it is noetherian. -/
theorem cex_5903 : ¬ IsArtinianRing R ∧ IsNoetherianRing R := by
  refine ⟨fun h => IsDiscreteValuationRing.not_isField R (IsArtinianRing.isField_of_isDomain R),
    inferInstance⟩

/-- Oqhr-Gt66es-5968 (1:39:28) [prop] For a noetherian local ring `𝒪` (a local ring of a locally
noetherian scheme), `𝒪/𝔪ⁿ` is an artinian local ring; for `I` finite, `k^I` (the ring of the
constant scheme `I_k`) is artinian. -/
theorem prop_5968 (O : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O] (n : ℕ)
    (hn : n ≠ 0) :
    IsArtinianRing (O ⧸ IsLocalRing.maximalIdeal O ^ n) ∧
    IsLocalRing (O ⧸ IsLocalRing.maximalIdeal O ^ n) ∧
    ∀ (I : Type u) [Finite I] (k : Type u) [Field k], IsArtinianRing (I → k) := by
  have hne : IsLocalRing.maximalIdeal O ^ n ≠ ⊤ := by
    intro h
    exact IsLocalRing.maximalIdeal.isMaximal O |>.ne_top
      (Ideal.eq_top_iff_one _ |>.2 (Ideal.pow_le_self hn (h ▸ Submodule.mem_top)))
  have : Nontrivial (O ⧸ IsLocalRing.maximalIdeal O ^ n) := Ideal.Quotient.nontrivial_iff.2 hne
  have hloc : IsLocalRing (O ⧸ IsLocalRing.maximalIdeal O ^ n) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  have := IsLocalHom.of_surjective (Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ n))
    Ideal.Quotient.mk_surjective
  refine ⟨?_, hloc, fun I _ k _ => inferInstance⟩
  rw [isArtinianRing_iff_isNilpotent_maximalIdeal]
  refine ⟨n, ?_⟩
  have hmap : (IsLocalRing.maximalIdeal O).map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ n))
      = IsLocalRing.maximalIdeal _ := by
    ext x
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective]
    constructor
    · rintro ⟨y, hy, hyx⟩
      rw [← hyx]
      exact (IsLocalRing.mem_maximalIdeal _).2 fun hu =>
        (IsLocalRing.mem_maximalIdeal _).1 hy (isUnit_of_map_unit _ _ hu)
    · intro hx
      refine ⟨x, ?_, rfl⟩
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact fun hu => (IsLocalRing.mem_maximalIdeal _).1 hx (hu.map _)
  rw [← hmap, ← Ideal.map_pow, Ideal.zero_eq_bot, Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]

end DVR

/-! ### Reduced, integral and normal schemes -/

section Reduced

/-- Oqhr-Gt66es-6097 (1:41:37) [def] `X` is reduced if `𝒪_X` has no nonzero nilpotent section over
any open set (mathlib: `AlgebraicGeometry.IsReduced`); equivalently its local rings are reduced
(`isReduced_of_isReduced_stalk`, and the instance on stalks). -/
theorem def_6097 (X : Scheme.{u}) :
    AlgebraicGeometry.IsReduced X ↔ ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) :=
  ⟨fun _ _ => inferInstance, fun h => by have := h; exact isReduced_of_isReduced_stalk X⟩

/-- Oqhr-Gt66es-6161 (1:42:41) [prop] Being reduced is local (open subschemes of a reduced scheme
are reduced, and reducedness is read on the local rings), and `Spec A` is reduced iff `A` is. -/
theorem prop_6161 :
    (∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f] [AlgebraicGeometry.IsReduced Y],
      AlgebraicGeometry.IsReduced X) ∧
    ∀ R : CommRingCat.{u}, AlgebraicGeometry.IsReduced (Spec R) ↔ _root_.IsReduced R :=
  ⟨fun f _ _ => isReduced_of_isOpenImmersion f, affine_isReduced_iff⟩

/-- Oqhr-Gt66es-6224 (1:43:44) [def] A scheme is integral if it is reduced and irreducible
(mathlib's `AlgebraicGeometry.IsIntegral`: nonempty with domains of sections; equivalent by
`isIntegral_iff_irreducibleSpace_and_isReduced`). -/
example (X : Scheme.{u}) :
    AlgebraicGeometry.IsIntegral X ↔ IrreducibleSpace X ∧ AlgebraicGeometry.IsReduced X :=
  isIntegral_iff_irreducibleSpace_and_isReduced X

/-- Topological core of 6355: a space covered by nonempty irreducible open sets meeting pairwise
is irreducible. -/
theorem isPreirreducible_of_cover {T : Type*} [TopologicalSpace T] {ι : Type*} (U : ι → Set T)
    (hU : ∀ i, IsOpen (U i)) (hcov : ⋃ i, U i = Set.univ) (hirr : ∀ i, IsPreirreducible (U i))
    (hmeet : ∀ i j, (U i ∩ U j).Nonempty) : IsPreirreducible (Set.univ : Set T) := by
  rintro V W hV hW ⟨v, -, hv⟩ ⟨w, -, hw⟩
  obtain ⟨i, hi⟩ := Set.mem_iUnion.1 (hcov.symm ▸ Set.mem_univ v : v ∈ ⋃ i, U i)
  obtain ⟨j, hj⟩ := Set.mem_iUnion.1 (hcov.symm ▸ Set.mem_univ w : w ∈ ⋃ i, U i)
  obtain ⟨z, hzi, hzV, hzj⟩ := hirr i V (U j) hV (hU j) ⟨v, hi, hv⟩ (hmeet i j)
  obtain ⟨y, hyj, hyV, hyW⟩ := hirr j V W hV hW ⟨z, hzj, hzV⟩ ⟨w, hj, hw⟩
  exact ⟨y, Set.mem_univ _, hyV, hyW⟩

/-- Oqhr-Gt66es-6355 (1:45:55) [prop] If `X` is covered by nonempty open sets `X_i`, `X` is
integral iff the `X_i` are integral and pairwise meet. Proved for the underlying spaces
(irreducibility; reducedness is local by 6161), for a nonempty family: `X` is irreducible iff the `X_i` are irreducible
and pairwise meet. -/
theorem prop_6355 {T : Type*} [TopologicalSpace T] {ι : Type*} [Nonempty ι] (U : ι → Set T)
    (hU : ∀ i, IsOpen (U i)) (hcov : ⋃ i, U i = Set.univ) (hne : ∀ i, (U i).Nonempty) :
    IrreducibleSpace T ↔ (∀ i, IsIrreducible (U i)) ∧ ∀ i j, (U i ∩ U j).Nonempty := by
  constructor
  · intro h
    have hT := h.isIrreducible_univ
    refine ⟨fun i => ⟨hne i, hT.2.open_subset (hU i) (Set.subset_univ _)⟩, fun i j => ?_⟩
    obtain ⟨x, -, hx⟩ := hT.2 (U i) (U j) (hU i) (hU j) (by simpa using hne i)
      (by simpa using hne j)
    exact ⟨x, hx⟩
  · rintro ⟨hirr, hmeet⟩
    obtain ⟨i⟩ := ‹Nonempty ι›
    exact (irreducibleSpace_def T).2 ⟨(hne i).mono (Set.subset_univ _),
      isPreirreducible_of_cover U hU hcov (fun j => (hirr j).2) hmeet⟩

/-- Oqhr-Gt66es-6430 (1:47:10) [prop] `Spec A` is integral iff `A` is an integral domain. -/
theorem prop_6430 (R : CommRingCat.{u}) : AlgebraicGeometry.IsIntegral (Spec R) ↔ IsDomain R :=
  affine_isIntegral_iff R

/-- Oqhr-Gt66es-6568 (1:49:28) [def] A scheme is normal if all its local rings are integrally
closed integral domains. -/
def IsNormalScheme (X : Scheme.{u}) : Prop :=
  ∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)

/-- Oqhr-Gt66es-6634 (1:50:34) [prop] A locally noetherian normal scheme is a disjoint sum of
integral schemes. Proved: the key point, that when the local ring `R_𝔭` is a domain, `𝔭` contains
a single minimal prime (so the irreducible components through a point are one, and they are
disjoint). -/
theorem prop_6634 {R : Type u} [CommRing R] (p : Ideal R) [p.IsPrime]
    [IsDomain (Localization.AtPrime p)] (q₁ q₂ : Ideal R) (h₁ : q₁ ∈ minimalPrimes R)
    (h₂ : q₂ ∈ minimalPrimes R) (hq₁ : q₁ ≤ p) (hq₂ : q₂ ≤ p) : q₁ = q₂ := by
  let K := RingHom.ker (algebraMap R (Localization.AtPrime p))
  have hK : K.IsPrime := RingHom.ker_isPrime _
  have hle : ∀ q : Ideal R, q.IsPrime → q ≤ p → K ≤ q := by
    intro q hq hqp a ha
    obtain ⟨⟨s, hs⟩, hsa⟩ := (IsLocalization.map_eq_zero_iff p.primeCompl
      (Localization.AtPrime p) a).1 ha
    exact (hq.mem_or_mem (hsa ▸ q.zero_mem)).resolve_left fun h => hs (hqp h)
  have e₁ : q₁ = K := le_antisymm (h₁.2 ⟨hK, bot_le⟩ (hle q₁ h₁.1.1 hq₁)) (hle q₁ h₁.1.1 hq₁)
  have e₂ : q₂ = K := le_antisymm (h₂.2 ⟨hK, bot_le⟩ (hle q₂ h₂.1.1 hq₂)) (hle q₂ h₂.1.1 hq₂)
  rw [e₁, e₂]

/-- Oqhr-Gt66es-6697 (1:51:37) [prop] An affine integral scheme `Spec A` is normal iff `A` is
integrally closed. Proved: if the local rings `A_𝔪` are integrally closed, so is `A`
(mathlib: `IsIntegrallyClosed.of_localization_maximal`), and conversely the localizations of an
integrally closed domain are integrally closed (`isIntegrallyClosed_of_isLocalization`). -/
theorem prop_6697 (A : Type u) [CommRing A] [IsDomain A] :
    IsIntegrallyClosed A ↔
      ∀ (p : Ideal A) [p.IsPrime], IsIntegrallyClosed (Localization.AtPrime p) := by
  constructor
  · intro _ p _
    exact isIntegrallyClosed_of_isLocalization (Localization.AtPrime p) p.primeCompl p.primeCompl_le_nonZeroDivisors
  · intro h
    exact IsIntegrallyClosed.of_localization_maximal fun p _ _ => h p

/-- Oqhr-Gt66es-6899 (1:54:59) [prop] For `X` integral with generic point `η`, the residue field
at `η` is the function field: the residue map from `𝒪_{X,η} = K(X)` is bijective. -/
theorem prop_6899 (X : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] :
    Function.Bijective (X.residue (genericPoint X)) := by
  refine ⟨?_, Ideal.Quotient.mk_surjective⟩
  have hf : IsField (X.presheaf.stalk (genericPoint X)) := Field.toIsField X.functionField
  rw [injective_iff_map_eq_zero]
  intro a ha
  have hm : IsLocalRing.maximalIdeal (X.presheaf.stalk (genericPoint X)) = ⊥ :=
    IsLocalRing.isField_iff_maximalIdeal_eq.1 hf
  have : a ∈ RingHom.ker (IsLocalRing.residue (X.presheaf.stalk (genericPoint X))) := ha
  rwa [IsLocalRing.ker_residue, hm] at this

end Reduced

/-! ### Birational morphisms, Zariski's Main Theorem, normalization of curves -/

section Birational

/-- Oqhr-Gt66es-7023 (1:57:03) [prop] A birational morphism `X' → X` of finite type between integral
schemes is an isomorphism over a nonempty open set of `X`. Affine case: if `B` is generated over `A`
by a finite set and every element of `B` is a fraction of elements of `A` (same function field),
there is `f ∈ A`, nonzero in `B`, with `B ⊂ A_f`, i.e. `A_f → B_f` is surjective (and injective when
`A → B` is), so `Spec B_f → Spec A_f` is an isomorphism over `D(f)`. -/
theorem prop_7023 {A B : Type*} [CommRing A] [CommRing B] [Algebra A B] (s : Finset B)
    (hs : Algebra.adjoin A (s : Set B) = ⊤)
    (hfrac : ∀ b : B, ∃ a d : A, algebraMap A B d ≠ 0 ∧ algebraMap A B d * b = algebraMap A B a)
    [IsDomain B] :
    ∃ f : A, algebraMap A B f ≠ 0 ∧
      ∀ b : B, ∃ (a : A) (n : ℕ), algebraMap A B (f ^ n) * b = algebraMap A B a := by
  classical
  choose num den hden hnd using hfrac
  refine ⟨∏ g ∈ s, den g, ?_, fun b => ?_⟩
  · rw [map_prod]
    exact Finset.prod_ne_zero_iff.2 fun g _ => hden g
  · have hb : b ∈ Algebra.adjoin A (s : Set B) := hs ▸ Algebra.mem_top
    induction hb using Algebra.adjoin_induction with
    | mem g hg =>
      refine ⟨num g * ∏ h ∈ s.erase g, den h, 1, ?_⟩
      rw [pow_one, ← Finset.mul_prod_erase s den hg, map_mul, map_mul, mul_comm (algebraMap A B (den g)),
        mul_assoc, hnd, mul_comm]
    | algebraMap a => exact ⟨a, 0, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨a, n, ha⟩ := hx
      obtain ⟨c, m, hc⟩ := hy
      refine ⟨(∏ g ∈ s, den g) ^ m * a + (∏ g ∈ s, den g) ^ n * c, n + m, ?_⟩
      rw [map_add, map_mul, map_mul, ← ha, ← hc, pow_add, map_mul]
      simp only [map_pow]
      ring
    | mul x y _ _ hx hy =>
      obtain ⟨a, n, ha⟩ := hx
      obtain ⟨c, m, hc⟩ := hy
      refine ⟨a * c, n + m, ?_⟩
      rw [map_mul, ← ha, ← hc, pow_add, map_mul]
      ring

/-- Oqhr-Gt66es-7150 (1:59:10) [thm] Zariski's Main Theorem. Mathlib's form: a separated
quasi-compact morphism, locally of finite type and locally quasi-finite (finite fibres), factors
as an open immersion into its relative normalization (`Scheme.Hom.toNormalization`), followed by
an integral morphism. Grothendieck's form follows when `X` is normal integral and `f` birational,
the relative normalization then being `X` itself (not formalised). -/
theorem thm_7150 {X Y : Scheme.{u}} (f : X ⟶ Y) [LocallyQuasiFinite f] [LocallyOfFiniteType f]
    [IsSeparated f] [QuasiCompact f] :
    IsOpenImmersion f.toNormalization ∧ IsIntegralHom f.fromNormalization ∧
      f.toNormalization ≫ f.fromNormalization = f :=
  ⟨inferInstance, inferInstance, f.toNormalization_fromNormalization⟩

variable (k : Type u) [Field k]

/-- The parametrisation `t ↦ (t² - 1, t(t² - 1))` of the nodal cubic `y² = x²(x + 1)`. -/
def nodeParam : MvPolynomial (Fin 2) k →ₐ[k] k[X] :=
  MvPolynomial.aeval ![X ^ 2 - 1, X * (X ^ 2 - 1)]

/-- Oqhr-Gt66es-7280 (2:01:20) [ex] The normalization of the nodal cubic `y² = x²(x + 1)` is
`k[t]`, `x = t² - 1`, `y = t(t² - 1)`. Proved: the parametrisation kills the equation; `t` is
integral (`t² = x + 1`) and a fraction (`x t = y`), so the map is finite and birational; and it is
not surjective (in characteristic `≠ 2`): every element of the image takes the same value at
`t = 1` and `t = -1` (the two points above the node), but `t` does not. -/
theorem ex_7280 (h2 : (2 : k) ≠ 0) :
    nodeParam k (MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 ^ 2 * (MvPolynomial.X 0 + 1)) = 0 ∧
    X ^ 2 = nodeParam k (MvPolynomial.X 0) + 1 ∧
    nodeParam k (MvPolynomial.X 0) * X = nodeParam k (MvPolynomial.X 1) ∧
    X ∉ Set.range (nodeParam k) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · simp [nodeParam]; ring
  · simp [nodeParam]
  · simp [nodeParam]; ring
  · rintro ⟨P, hP⟩
    have key : ∀ Q : MvPolynomial (Fin 2) k, (nodeParam k Q).eval 1 = (nodeParam k Q).eval (-1) := by
      intro Q
      induction Q using MvPolynomial.induction_on with
      | C a => simp [nodeParam]
      | add p q hp hq => simp [hp, hq]
      | mul_X p i hp =>
        rw [map_mul, eval_mul, eval_mul, hp]
        fin_cases i <;> simp [nodeParam]
    have := key P
    rw [hP] at this
    simp only [eval_X] at this
    apply h2
    linear_combination this

/-- The parametrisation `t ↦ (t², t³)` of the cusp `y² = x³`. -/
def cuspParam : MvPolynomial (Fin 2) k →ₐ[k] k[X] :=
  MvPolynomial.aeval ![X ^ 2, X ^ 3]

/-- Oqhr-Gt66es-7347 (2:02:27) [ex] The normalization `t ↦ (t², t³)` of the cusp `y² = x³` is
bijective on points without being an isomorphism. Proved: the parametrisation kills the equation;
`t ↦ (t², t³)` is a bijection from `k` onto the `k`-points of the cusp; `t` is not in the image of
`k[x, y]` (no element of the image has a term in `t`). -/
theorem ex_7347 :
    cuspParam k (MvPolynomial.X 1 ^ 2 - MvPolynomial.X 0 ^ 3) = 0 ∧
    Set.BijOn (fun t : k => (t ^ 2, t ^ 3)) Set.univ {p : k × k | p.2 ^ 2 = p.1 ^ 3} ∧
    X ∉ Set.range (cuspParam k) := by
  refine ⟨by simp [cuspParam]; ring, ⟨fun t _ => by simp; ring, fun s _ t _ hst => ?_,
    fun p hp => ?_⟩, ?_⟩
  · obtain ⟨h1, h2⟩ := Prod.mk.inj hst
    by_cases hs : s = 0
    · have : t ^ 2 = 0 := by rw [← h1, hs]; ring
      rw [hs, (pow_eq_zero_iff two_ne_zero).1 this]
    · have ht : t ≠ 0 := by
        rintro rfl
        exact hs ((pow_eq_zero_iff two_ne_zero).1 (by rw [h1]; ring))
      calc s = s ^ 3 / s ^ 2 := by rw [eq_div_iff (pow_ne_zero 2 hs)]; ring
        _ = t ^ 3 / t ^ 2 := by rw [h1, h2]
        _ = t := by rw [div_eq_iff (pow_ne_zero 2 ht)]; ring
  · obtain ⟨a, b⟩ := p
    change b ^ 2 = a ^ 3 at hp
    by_cases ha : a = 0
    · subst ha
      have hb : b = 0 := (pow_eq_zero_iff two_ne_zero).1 (by rw [hp]; ring)
      exact ⟨0, Set.mem_univ _, by simp [hb]⟩
    · refine ⟨b / a, Set.mem_univ _, ?_⟩
      refine Prod.ext ?_ ?_
      · change (b / a) ^ 2 = a
        rw [div_pow, div_eq_iff (pow_ne_zero 2 ha)]
        linear_combination hp
      · change (b / a) ^ 3 = b
        rw [div_pow, div_eq_iff (pow_ne_zero 3 ha)]
        linear_combination b * hp
  · rintro ⟨P, hP⟩
    have key : ∀ Q : MvPolynomial (Fin 2) k, (cuspParam k Q).coeff 1 = 0 := by
      intro Q
      induction Q using MvPolynomial.induction_on with
      | C a => simp [cuspParam]
      | add p q hp hq => simp [hp, hq]
      | mul_X p i hp =>
        rw [map_mul, Polynomial.coeff_mul]
        rw [Finset.Nat.antidiagonal_succ]
        simp only [Finset.sum_cons, Finset.Nat.antidiagonal_zero, Finset.sum_map,
          Finset.sum_singleton]
        fin_cases i <;> simp [cuspParam, Polynomial.coeff_X_pow]
    have := key P
    rw [hP] at this
    simp at this

/-- Oqhr-Gt66es-7413 (2:03:33) [prop] The normalization morphism `X' → X` is birational with
finite fibres, and is an isomorphism iff `X` is normal. Affine case of the last clause: for a
domain `A` with fraction field `K`, `A → A'` (integral closure of `A` in `K`) is an isomorphism iff
`A` is integrally closed. -/
theorem prop_7413 (A : Type u) [CommRing A] [IsDomain A] :
    integralClosure A (FractionRing A) = ⊥ ↔ IsIntegrallyClosed A := by
  constructor
  · intro h
    rw [isIntegrallyClosed_iff (FractionRing A)]
    intro x hx
    have : x ∈ (⊥ : Subalgebra A (FractionRing A)) := h ▸ hx
    exact Algebra.mem_bot.1 this
  · intro _
    exact IsIntegrallyClosed.integralClosure_eq_bot A (FractionRing A)

end Birational

/-! ### Regular rings -/

section Regular

/-- Oqhr-Gt66es-7602 (2:06:42) [def] A scheme is regular if all its local rings are regular. -/
def IsRegularScheme (X : Scheme.{u}) : Prop :=
  ∀ x : X, IsRegularLocalRing (X.presheaf.stalk x)

/-- Oqhr-Gt66es-7860 (2:11:00) [def] A noetherian local ring is regular if its maximal ideal is
generated by an `A`-regular sequence `x₁, …, xₙ`. The definition as stated (mathlib's
`IsRegularLocalRing` asks instead for `dim A` generators; the two agree, not formalised here). -/
def IsRegularBySequence (A : Type u) [CommRing A] [IsLocalRing A] : Prop :=
  IsNoetherianRing A ∧ ∃ xs : List A, RingTheory.Sequence.IsRegular A xs ∧
    Ideal.ofList xs = IsLocalRing.maximalIdeal A

/-- Oqhr-Gt66es-7990 (2:13:10) [prop] For an `M`-regular sequence, the Koszul complex is acyclic.
Mathlib has no Koszul complex; proved: the case of one element, whose Koszul complex
`0 → M → M → 0` (multiplication by `x`) has `H₁ = 0` iff `x` is `M`-regular. -/
theorem prop_7990 {A M : Type u} [CommRing A] [AddCommGroup M] [Module A M] (x : A) :
    IsSMulRegular M x ↔ LinearMap.ker (LinearMap.lsmul A M x) = ⊥ := by
  rw [LinearMap.ker_eq_bot]
  rfl

/-- Oqhr-Gt66es-8055 (2:14:15) [prop] A field is regular; if `A` is regular, so is `A[t]`; hence
`k[t₁, …, tₙ]` is regular. (The open sets `𝔾_m`, `GL_n` of affine space: not formalised, mathlib
lacking the regularity of localizations of regular rings.) -/
theorem prop_8055 (k : Type u) [Field k] (A : Type u) [CommRing A] [IsRegularRing A] (n : ℕ) :
    IsRegularLocalRing k ∧ IsRegularRing A[X] ∧ IsRegularRing (MvPolynomial (Fin n) k) :=
  ⟨inferInstance, inferInstance, inferInstance⟩

/-- Oqhr-Gt66es-8186 (2:16:26) [prop] (corrected) A ring is regular if its localizations at all
primes are; principal ideal domains and Dedekind rings are regular (for example `ℤ` and rings of
integers of number fields), as are their polynomial rings. -/
theorem prop_8186 (R : Type u) [CommRing R] [IsDedekindDomain R] (K : Type u) [Field K]
    [NumberField K] :
    IsRegularRing R ∧ IsRegularRing ℤ ∧ IsRegularRing (NumberField.RingOfIntegers K) ∧
      IsRegularRing R[X] :=
  ⟨inferInstance, inferInstance, inferInstance, inferInstance⟩

/-- Counterexample to 8186 as stated: the principal ideal ring `ℤ/4` is not regular (its local
ring is `ℤ/4` itself, of dimension `0`, with a nonzero maximal ideal); the statement needs
principal ideal *domains* (French « anneaux principaux »). -/
theorem cex_8186 : ¬ IsRegularRing (ZMod 4) := by
  intro h
  have : Fact (1 < 4) := ⟨by norm_num⟩
  obtain ⟨p, hp⟩ := Ideal.exists_maximal (ZMod 4)
  have hpp : p.IsPrime := hp.isPrime
  let L := Localization.AtPrime p
  have hreg : IsRegularLocalRing L := inferInstance
  have hdim : ringKrullDim L = 0 := by
    rw [← ringKrullDimZero_iff_ringKrullDim_eq_zero]; infer_instance
  have h0 := hreg.spanFinrank_maximalIdeal
  rw [hdim] at h0
  have hbot : IsLocalRing.maximalIdeal L = ⊥ :=
    (Submodule.spanFinrank_eq_zero_iff_eq_bot (IsNoetherian.noetherian _)).1 (by exact_mod_cast h0)
  have hf : IsField L := IsLocalRing.isField_iff_maximalIdeal_eq.2 hbot
  let F := hf.toField
  have h2 : (2 : ZMod 4) ∈ p := hpp.mem_or_mem (show (2 : ZMod 4) * 2 ∈ p by
    rw [show (2 : ZMod 4) * 2 = 0 by decide]; exact p.zero_mem) |>.elim id id
  have hnil : algebraMap (ZMod 4) L 2 = 0 := by
    have : (algebraMap (ZMod 4) L 2) ^ 2 = 0 := by
      rw [← map_pow, show (2 : ZMod 4) ^ 2 = 0 by decide, map_zero]
    exact pow_eq_zero_iff (two_ne_zero) |>.1 this
  obtain ⟨⟨s, hs⟩, hs2⟩ := (IsLocalization.map_eq_zero_iff p.primeCompl L 2).1 hnil
  apply hs
  have : ∀ t : ZMod 4, t * 2 = 0 → t = 0 ∨ t = 2 := by decide
  rcases this s hs2 with rfl | rfl
  · exact p.zero_mem
  · exact h2

end Regular

/-! ### Surjective endomorphisms, monoids -/

section Endomorphisms

/-- Oqhr-Gt66es-8653 (2:24:13) [prop] An endomorphism of a scheme of finite presentation that is a
monomorphism is an isomorphism (EGA IV 17.9.6; not formalised); consequently a monoid scheme
whose left translations are monomorphisms is a group. Proved: the last step, on points — a monoid
whose left translations are bijective is a group. -/
theorem prop_8653 {M : Type u} [Monoid M] (h : ∀ a : M, Function.Bijective (a * ·)) (a : M) :
    IsUnit a := by
  obtain ⟨b, hb⟩ := (h a).2 1
  have hb' : a * b = 1 := hb
  have hba : b * a = 1 := (h a).1 (show a * (b * a) = a * 1 by
    rw [← mul_assoc, hb', one_mul, mul_one])
  have hb := hb'
  exact ⟨⟨a, b, hb, hba⟩, rfl⟩

/-- Oqhr-Gt66es-8805 (2:26:45) [prop] A surjective endomorphism of a finitely generated module over
a commutative ring is bijective (mathlib: `OrzechProperty.injective_of_surjective_endomorphism`). -/
theorem prop_8805 {A M : Type u} [CommRing A] [AddCommGroup M] [Module A M] [Module.Finite A M]
    (f : M →ₗ[A] M) (hf : Function.Surjective f) : Function.Bijective f :=
  ⟨OrzechProperty.injective_of_surjective_endomorphism f hf, hf⟩

/-- Oqhr-Gt66es-9207 (2:33:27) [prop] A surjective endomorphism of a finitely presented algebra is
an isomorphism. Proved: the noetherian case (the kernels of the iterates stabilize); the general
case by passage to the limit is not formalised. -/
theorem prop_9207 {A : Type u} [CommRing A] [IsNoetherianRing A] (φ : A →+* A)
    (hφ : Function.Surjective φ) : Function.Bijective φ := by
  refine ⟨?_, hφ⟩
  let I : ℕ →o Ideal A := ⟨fun n => RingHom.ker (φ ^ n), fun m n hmn a ha => by
    simp only [RingHom.mem_ker, RingHom.coe_pow] at ha ⊢
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hmn
    rw [add_comm, Function.iterate_add_apply, ha, Function.iterate_fixed (map_zero φ)]⟩
  obtain ⟨n, hn⟩ := monotone_stabilizes_iff_noetherian.2 (inferInstance : IsNoetherian A A) I
  rw [injective_iff_map_eq_zero]
  intro a ha
  have hsurj : Function.Surjective (φ ^ n) := by
    rw [RingHom.coe_pow]; exact hφ.iterate n
  obtain ⟨b, rfl⟩ := hsurj a
  have hb : b ∈ I (n + 1) := by
    change (φ ^ (n + 1)) b = 0
    rw [RingHom.coe_pow, Function.iterate_succ_apply', ← RingHom.coe_pow]
    exact ha
  rw [← hn (n + 1) (Nat.le_succ n)] at hb
  exact hb

end Endomorphisms

/-! ### Classes of morphisms stable under composition and base change -/

section Classes

variable {C : Type u} [Category.{v} C] [HasPullbacks C] (P : MorphismProperty C)

/-- Oqhr-Gt66es-9661 (2:41:01) [prop] Affine morphisms contain the isomorphisms and are stable
under composition and under base change. -/
theorem prop_9661 :
    (∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [IsIso f], IsAffineHom f) ∧
    (∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) [IsAffineHom f] [IsAffineHom g],
      IsAffineHom (f ≫ g)) ∧
    MorphismProperty.IsStableUnderBaseChange (@IsAffineHom : MorphismProperty Scheme.{u}) :=
  ⟨fun _ _ => inferInstance, fun _ _ _ _ => inferInstance, inferInstance⟩

/-- Oqhr-Gt66es-9795 (2:43:15) [prop] A class stable under composition and base change is stable
under fibre product: `f₁ ×_S f₂ ∈ M` if `f₁, f₂ ∈ M` (mathlib: `MorphismProperty.pullbackMap`). -/
theorem prop_9795 [P.IsStableUnderBaseChange] [P.IsStableUnderComposition] {S X X' Y Y' : C}
    {f : X ⟶ S} {g : Y ⟶ S} {f' : X' ⟶ S} {g' : Y' ⟶ S} {i₁ : X ⟶ X'} {i₂ : Y ⟶ Y'}
    (h₁ : P i₁) (h₂ : P i₂) (e₁ : f = i₁ ≫ f') (e₂ : g = i₂ ≫ g') :
    P (pullback.map f g f' g' i₁ i₂ (𝟙 _) ((Category.comp_id _).trans e₁)
        ((Category.comp_id _).trans e₂)) :=
  P.pullbackMap h₁ h₂ e₁ e₂

/-- Oqhr-Gt66es-10079 (2:47:59) [prop] For such a class `M` (multiplicative, stable under base
change): if `g ∘ f ∈ M` and the diagonal `Δ_g ∈ M`, then `f ∈ M` (`f` is its graph, a base change
of `Δ_g`, followed by a base change of `g ∘ f`). -/
theorem prop_10079 [P.IsStableUnderBaseChange] [P.IsMultiplicative] {X Y Z : C} (f : X ⟶ Y)
    (g : Y ⟶ Z) (hΔ : P (pullback.diagonal g)) (hfg : P (f ≫ g)) : P f := by
  set gr : X ⟶ pullback (f ≫ g) g := pullback.lift (𝟙 X) f (by simp)
  have : f = gr ≫ pullback.snd _ _ := by simp [gr]
  rw [this]
  exact P.comp_mem _ _ (P.of_isPullback (pullback_lift_diagonal_isPullback f g) hΔ)
    (P.pullback_snd _ _ hfg)

/-- Oqhr-Gt66es-10336 (2:52:16) [prop] Giving a morphism `f : X → Y` over `S` is equivalent to
giving a section `Γ_f = (id, f)` of `X ×_S Y → X`; `f` is `Γ_f` followed by the second
projection. -/
def prop_10336 {X Y S : C} (p : X ⟶ S) (g : Y ⟶ S) :
    {f : X ⟶ Y // f ≫ g = p} ≃ {s : X ⟶ pullback p g // s ≫ pullback.fst p g = 𝟙 X} where
  toFun f := ⟨pullback.lift (𝟙 X) f.1 (by simp [f.2]), by simp⟩
  invFun s := ⟨s.1 ≫ pullback.snd p g, by
    rw [Category.assoc, ← pullback.condition, ← Category.assoc, s.2, Category.id_comp]⟩
  left_inv f := by ext; simp
  right_inv s := by
    apply Subtype.ext
    apply pullback.hom_ext <;> simp [s.2]

/-- Oqhr-Gt66es-10408 (2:53:28) [prop] The graph `Γ_f` is a monomorphism and is deduced from
`Δ_g : Y → Y ×_Z Y` by the base change `f × id_Y` (mathlib:
`pullback_lift_diagonal_isPullback`). -/
theorem prop_10408 {X Y Z : C} (f : X ⟶ Y) (g : Y ⟶ Z) :
    Mono (pullback.lift (𝟙 X) f (by simp) : X ⟶ pullback (f ≫ g) g) ∧
    IsPullback f (pullback.lift (𝟙 X) f (by simp)) (pullback.diagonal g)
      (pullback.map (f ≫ g) g g g f (𝟙 Y) (𝟙 Z) (by simp) (by simp)) := by
  refine ⟨?_, pullback_lift_diagonal_isPullback f g⟩
  have : pullback.lift (𝟙 X) f (by simp) ≫ pullback.fst (f ≫ g) g = 𝟙 X := by simp
  exact mono_of_mono_fac this

/-- Oqhr-Gt66es-10536 (2:55:36) [prop] For `g : Y → S` and a class `M` as above, the following are
equivalent: `Δ_g ∈ M`; every graph `Γ_f : X → X ×_S Y` is in `M`; for all `u, v : X → Y`, the kernel
of `(u, v)` (base change of `Δ_g` along `(u, v)`) is in `M`. -/
theorem prop_10536 [P.IsStableUnderBaseChange] [P.RespectsIso] {Y S : C} (g : Y ⟶ S) :
    List.TFAE [P (pullback.diagonal g),
      ∀ (X : C) (p : X ⟶ S) (f : X ⟶ Y) (h : f ≫ g = p),
        P (pullback.lift (𝟙 X) f (by simp [h]) : X ⟶ pullback p g),
      ∀ (X : C) (u v : X ⟶ Y) (h : u ≫ g = v ≫ g),
        P (pullback.fst (pullback.lift u v h) (pullback.diagonal g))] := by
  tfae_have 1 → 2 := by
    intro hΔ X p f h
    subst h
    exact P.of_isPullback (pullback_lift_diagonal_isPullback f g) hΔ
  tfae_have 2 → 1 := fun h => by
    have := h Y g (𝟙 Y) (Category.id_comp g)
    exact this
  tfae_have 1 → 3 := fun hΔ X u v h => P.pullback_fst _ _ hΔ
  tfae_have 3 → 1 := by
    intro h
    have h3 := h _ (pullback.fst g g) (pullback.snd g g) pullback.condition
    rw [pullback.lift_fst_snd] at h3
    have e : pullback.fst (𝟙 (pullback g g)) (pullback.diagonal g) =
        pullback.snd (𝟙 (pullback g g)) (pullback.diagonal g) ≫ pullback.diagonal g := by
      rw [← pullback.condition, Category.comp_id]
    rw [e, P.cancel_left_of_respectsIso] at h3
    exact h3
  tfae_finish

/-- Oqhr-Gt66es-10860 (3:01:00) [prop] These conditions are also equivalent to: every section of
every base change `Y ×_S S' → S'` is in `M` (`M` multiplicative, stable under base change). -/
theorem prop_10860 [P.IsStableUnderBaseChange] [P.IsMultiplicative] {Y S : C} (g : Y ⟶ S) :
    P (pullback.diagonal g) ↔ ∀ (S' : C) (φ : S' ⟶ S) (s : S' ⟶ pullback g φ),
      s ≫ pullback.snd g φ = 𝟙 S' → P s := by
  constructor
  · intro hΔ S' φ s hs
    have hd : P.diagonal (pullback.snd g φ) :=
      MorphismProperty.pullback_snd (P := P.diagonal) g φ (MorphismProperty.diagonal_iff.2 hΔ)
    refine prop_10079 P s (pullback.snd g φ) hd ?_
    rw [hs]
    exact P.id_mem _
  · intro h
    exact h Y g (pullback.diagonal g) (by simp)

/-- Oqhr-Gt66es-11051 (3:04:11) [prop] Monomorphisms are stable under base change and composition;
every diagonal is a monomorphism; if `g ∘ f` is a monomorphism, so is `f`. -/
theorem prop_11051 :
    (∀ {X Y S : C} (f : X ⟶ S) (g : Y ⟶ S) [Mono f], Mono (pullback.snd f g)) ∧
    (∀ {X Y Z : C} (f : X ⟶ Y) (g : Y ⟶ Z) [Mono f] [Mono g], Mono (f ≫ g)) ∧
    (∀ {X S : C} (f : X ⟶ S), Mono (pullback.diagonal f)) ∧
    (∀ {X Y Z : C} (f : X ⟶ Y) (g : Y ⟶ Z) [Mono (f ≫ g)], Mono f) :=
  ⟨fun _ _ _ => inferInstance, fun _ _ _ _ => inferInstance, fun _ => inferInstance,
    fun f g _ => mono_of_mono f g⟩

/-- Oqhr-Gt66es-11114 (3:05:14) [prop] Surjective morphisms of schemes are stable under composition
and base change. -/
theorem prop_11114 :
    MorphismProperty.IsStableUnderComposition @Surjective.{u} ∧
    MorphismProperty.IsStableUnderBaseChange @Surjective.{u} :=
  ⟨(inferInstance : MorphismProperty.IsMultiplicative @Surjective.{u}).toIsStableUnderComposition,
    inferInstance⟩

/-- Oqhr-Gt66es-11246 (3:07:26) [prop] Epimorphisms of schemes are stable under composition (not
under base change: for affine schemes, see `board_11246`). -/
theorem prop_11246 {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) [Epi f] [Epi g] : Epi (f ≫ g) :=
  inferInstance

/-- Oqhr-Gt66es-11579 (3:12:59) [def] `f` is quasi-compact if the preimage of every quasi-compact
open set is quasi-compact (mathlib: `QuasiCompact`, field `isCompact_preimage`). -/
example {X Y : Scheme.{u}} (f : X ⟶ Y) [QuasiCompact f] (U : Set Y) (hU : IsOpen U)
    (hc : IsCompact U) : IsCompact (f ⁻¹' U) :=
  QuasiCompact.isCompact_preimage U hU hc

/-- Oqhr-Gt66es-11643 (3:14:03) [prop] Quasi-compactness of a morphism is local on the base: `f` is
quasi-compact iff each `f⁻¹(S_i)` is quasi-compact for the affine open sets `S_i` of `S` (mathlib:
`quasiCompact_iff_forall_isAffineOpen`; for an arbitrary affine covering, mathlib's
`HasAffineProperty @QuasiCompact`). -/
theorem prop_11643 {X S : Scheme.{u}} (f : X ⟶ S) :
    QuasiCompact f ↔ ∀ U : S.Opens, IsAffineOpen U → IsCompact (f ⁻¹ᵁ U : Set X) :=
  quasiCompact_iff_forall_isAffineOpen

end Classes

end

