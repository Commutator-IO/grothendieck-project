import Buffalo.AG.Part09a

/-!
# Buffalo, algebraic geometry, part 09 (b): 11 July 1973, 5:30:39–6:57:40

The entries of `docs/buffalo-ag/index.tex` lines 1219–1290 (video `3ULFIl_2Wis`, recorded on the
groups course's video but belonging to the algebraic geometry course): Galois descent and the
profinite Galois group, descent for families of morphisms (mathlib's `Pseudofunctor.DescentData`),
the fpqc, fppf, Zariski and étale topologies (mathlib's `Scheme.fpqcPrecoverage` and its
neighbours), sheaves on a site, quotients and algebraic spaces.
-/

open CategoryTheory Limits AlgebraicGeometry Topology Opposite

universe u v w

namespace Buffalo.AG.Part09

noncomputable section

/-! ### Galois descent -/

section Galois

variable (k k' : Type*) [Field k] [Field k'] [Algebra k k']

/-- 3ULFIl_2Wis-19904 (5:31:44) [ex] (the rank) For `k'/k` finite Galois, `Spec k' → Spec k` is
faithfully flat and its rank `[k' : k]` is the order of `Γ = Gal(k'/k)`, as for a `Γ`-torsor. -/
theorem ex_19904 [FiniteDimensional k k'] [IsGalois k k'] :
    Module.FaithfullyFlat k k' ∧ Nat.card (k' ≃ₐ[k] k') = Module.finrank k k' :=
  ⟨inferInstance, IsGalois.card_aut_eq_finrank k k'⟩

/-- 3ULFIl_2Wis-20102 (5:35:02) [prop] For `k'/k` Galois (possibly infinite),
`Γ = Gal(k'/k) ≃ lim Γ_i`, the limit of the finite Galois groups of the finite Galois
subextensions. -/
def prop_20102 [IsGalois k k'] :=
  InfiniteGalois.mulEquivToLimit k k'

/-- 3ULFIl_2Wis-20447 (5:40:47) [prop] (affine level) The ring of `Γ_k = lim Γ_{i,k}` is
`colim k^{Γ_i}`, the locally constant functions `Γ → k`; the comorphism of the constant group
`Γ → Γ_k`, restriction to all functions `Γ → k`, is injective: `Γ → Γ_k` is schematically
dominant. -/
theorem prop_20447 [IsGalois k k'] :
    Function.Injective (fun φ : LocallyConstant (k' ≃ₐ[k] k') k => (φ : (k' ≃ₐ[k] k') → k)) :=
  LocallyConstant.coe_injective

end Galois

/-! ### Descent for families of morphisms (mathlib's descent data) -/

section DescentData

variable {C : Type u} [Category.{v} C] (F : Pseudofunctor (LocallyDiscrete Cᵒᵖ) Cat.{w, w})

/-- 3ULFIl_2Wis-20702 (5:45:02) [def] Descent of degrees `0` and `1` for a family `R` of maps to
`S`: `X ↦ (X'_i, descent datum)` is faithful (degree 0) and full (degree 1), mathlib's
`Pseudofunctor.IsPrestackFor`. -/
theorem def_20702 {S : C} (R : Presieve S) (h : F.IsPrestackFor R) :
    (F.toDescentData (fun (f : R.category) => f.obj.hom)).Faithful ∧
      (F.toDescentData (fun (f : R.category) => f.obj.hom)).Full :=
  ⟨h.fullyFaithful.faithful, h.fullyFaithful.full⟩

/-- 3ULFIl_2Wis-20768 (5:46:08) [def] Descent of degree `2` (effective descent): the functor to
descent data is an equivalence, mathlib's `Pseudofunctor.IsStackFor`. -/
theorem def_20768 {S : C} (R : Presieve S) (h : F.IsStackFor R) :
    (F.toDescentData (fun (f : R.category) => f.obj.hom)).IsEquivalence :=
  h.isEquivalence

/-- 3ULFIl_2Wis-21089 (5:51:29) [prop] A descent datum is the data, for every `T` over `S` and
every pair `u, v : T → S'_i, S'_j`, of maps `u^* X'_i → v^* X'_j`, functorial in `T` and transitive
(mathlib's definition of `Pseudofunctor.DescentData`); it is equivalent to the datum on the chosen
fibre products `S'_i ×_S S'_j` with the cocycle condition on triple products. -/
def prop_21089 {ι : Type*} {S : C} {X : ι → C} {f : ∀ i, X i ⟶ S}
    (sq : ∀ i j, ChosenPullback (f i) (f j))
    (sq₃ : ∀ i₁ i₂ i₃, ChosenPullback₃ (sq i₁ i₂) (sq i₂ i₃) (sq i₁ i₃)) :
    F.DescentData' sq sq₃ ≌ F.DescentData f :=
  Pseudofunctor.DescentData'.descentDataEquivalence F sq sq₃

/-- 3ULFIl_2Wis-21411 (5:56:51) [prop] The category of descent data for a family `(S'_i → S)`
depends only on the sieve generated by the family. -/
theorem prop_21411 {ι ι' : Type*} {S : C} {X : ι → C} {X' : ι' → C} (f : ∀ i, X i ⟶ S)
    (f' : ∀ i, X' i ⟶ S) (h : Sieve.ofArrows _ f = Sieve.ofArrows _ f') :
    ∃ e : F.DescentData f ≌ F.DescentData f',
      Nonempty (F.toDescentData f ⋙ e.functor ≅ F.toDescentData f') :=
  Pseudofunctor.DescentData.exists_equivalence_of_sieve_eq F f f' h

end DescentData

section Schemes

/-- 3ULFIl_2Wis-20831 (5:47:11) [prop] (for sheaves, i.e. degrees 0 and 1 of descent for
representable functors) For a finite family `(S'_i → S)` and `S' = ∐ S'_i`, a Zariski sheaf
satisfies descent for the family if and only if it does for `S' → S`. -/
theorem prop_20831 {P : MorphismProperty Scheme.{u}} {F : Scheme.{u}ᵒᵖ ⥤ Type*}
    [IsZariskiLocalAtSource P] (hF : Presieve.IsSheaf Scheme.zariskiTopology F) {S : Scheme.{u}}
    (𝒰 : S.Cover (Scheme.precoverage P)) [Finite 𝒰.I₀] :
    Presieve.IsSheafFor F (.ofArrows 𝒰.sigma.X 𝒰.sigma.f) ↔
      Presieve.IsSheafFor F (.ofArrows 𝒰.X 𝒰.f) :=
  Scheme.Cover.isSheafFor_sigma_iff hF 𝒰

/-- 3ULFIl_2Wis-21606 (6:00:06) [prop] Along a faithfully flat quasi-compact `g : S' → S`, being
an isomorphism, an open immersion, universally closed, or locally of finite type descends
(the last two make up properness, but for separatedness, which mathlib does not descend). -/
theorem prop_21606 {X Y S' : Scheme.{u}} (f : X ⟶ Y) (g : S' ⟶ Y) [Surjective g] [Flat g]
    [QuasiCompact g] :
    (IsIso (pullback.snd f g) → IsIso f) ∧
      (IsOpenImmersion (pullback.snd f g) → IsOpenImmersion f) ∧
      (UniversallyClosed (pullback.snd f g) → UniversallyClosed f) ∧
      (LocallyOfFiniteType (pullback.snd f g) → LocallyOfFiniteType f) := by
  have hg : (@Surjective ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme.{u}) g :=
    ⟨⟨‹_›, ‹_›⟩, ‹_›⟩
  refine ⟨fun h => ?_, fun h => ?_, fun h => ?_, fun h => ?_⟩
  · exact MorphismProperty.of_pullback_snd_of_descendsAlong
      (P := MorphismProperty.isomorphisms Scheme.{u}) hg h
  · exact MorphismProperty.of_pullback_snd_of_descendsAlong (P := @IsOpenImmersion) hg h
  · exact MorphismProperty.of_pullback_snd_of_descendsAlong (P := @UniversallyClosed) hg h
  · exact MorphismProperty.of_pullback_snd_of_descendsAlong (P := @LocallyOfFiniteType) hg h

/-- 3ULFIl_2Wis-21668 (6:01:08) [prop] Morphisms glue along open coverings and along faithfully
flat quasi-compact morphisms: every representable functor is a sheaf for the Zariski and the
fpqc topologies (both are subcanonical). -/
theorem prop_21668 (X : Scheme.{u}) :
    Presieve.IsSheaf Scheme.zariskiTopology (yoneda.obj X) ∧
      Presieve.IsSheaf Scheme.fpqcTopology (yoneda.obj X) :=
  ⟨GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _,
    GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _⟩

/-- 3ULFIl_2Wis-21857 (6:04:17) [cex] (no Zariski local section) `λ ↦ λ^n`, `n ≥ 2`, has no
section over any non-empty open set of `𝔾_m` over a field `K`: such a section would be a rational
function `f` with `f^n = X`, which has degree `1`, not divisible by `n`. -/
theorem cex_21857 (K : Type*) [Field K] (n : ℕ) (hn : 2 ≤ n) (f : RatFunc K) :
    f ^ n ≠ RatFunc.X := by
  intro h
  have hf : f ≠ 0 := by
    rintro rfl
    rw [zero_pow (by omega)] at h
    exact RatFunc.X_ne_zero h.symm
  have hdeg : ∀ m : ℕ, (f ^ m).intDegree = m * f.intDegree := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
      rw [pow_succ, RatFunc.intDegree_mul (pow_ne_zero _ hf) hf, ih]
      push_cast
      ring
  have h1 : (n : ℤ) * f.intDegree = 1 := by rw [← hdeg, h, RatFunc.intDegree_X]
  have := Int.eq_one_of_mul_eq_one_right (Int.natCast_nonneg n) h1
  omega

/-- 3ULFIl_2Wis-22049 (6:07:29) [prop] A faithfully flat quasi-compact `T → S` has a section after
the base change `T → S` itself (the diagonal), and it is an fpqc covering: it has a section
locally for the fpqc topology. -/
theorem prop_22049 {T S : Scheme.{u}} (f : T ⟶ S) [Flat f] [Surjective f] [QuasiCompact f] :
    pullback.diagonal f ≫ pullback.fst f f = 𝟙 T ∧
      Presieve.singleton f ∈ Scheme.fpqcPrecoverage S :=
  ⟨pullback.diagonal_fst f, Scheme.Hom.singleton_mem_fpqcPrecoverage f⟩

/-- 3ULFIl_2Wis-22241 (6:10:41) [def] The fpqc topology: mathlib's `Scheme.fpqcPrecoverage`
(jointly surjective families of flat morphisms, quasi-compact in the sense that every affine open
of the base is covered by finitely many images of quasi-compact opens) and the topology it
generates; it contains the Zariski topology. -/
example : Scheme.zariskiTopology.{u} ≤ Scheme.fpqcTopology := Scheme.zariskiTopology_le_fpqcTopology

/-- 3ULFIl_2Wis-22369 (6:12:49) [prop] (mathlib's reduction) A pseudofunctor has effective descent
(resp. descent of degrees `0, 1`) for all fpqc coverings as soon as it has it for the families of
the fpqc precoverage. -/
theorem prop_22369 (F : Pseudofunctor (LocallyDiscrete Scheme.{u}ᵒᵖ) Cat.{w, w})
    (hF : ∀ (S : Scheme.{u}) (R : Presieve S), R ∈ Scheme.fpqcPrecoverage.coverings S →
      F.IsStackFor R) :
    F.IsStack Scheme.fpqcTopology :=
  Pseudofunctor.IsStack.of_precoverage hF

/-- 3ULFIl_2Wis-22433 (6:13:53) [prop] fpqc coverings are stable under base change and
composition: the category of schemes is a site. -/
theorem prop_22433 : Scheme.fpqcPrecoverage.{u}.IsStableUnderBaseChange ∧
    Scheme.fpqcPrecoverage.{u}.IsStableUnderComposition :=
  ⟨inferInstance, inferInstance⟩

/-- 3ULFIl_2Wis-22497 (6:14:57) [def] An fpqc sheaf: a presheaf satisfying the (equalizer) sheaf
condition for the fpqc coverings. -/
def IsFpqcSheaf (F : Scheme.{u}ᵒᵖ ⥤ Type u) : Prop :=
  Presieve.IsSheaf Scheme.fpqcTopology F

/-- 3ULFIl_2Wis-22562 (6:16:02) [prop] A presheaf is an fpqc sheaf if and only if it is a Zariski
sheaf and satisfies the sheaf condition for every faithfully flat `Spec S → Spec R` (mathlib's
form, even with affine source and target). -/
theorem prop_22562 (F : Scheme.{u}ᵒᵖ ⥤ Type u) :
    Presieve.IsSheaf Scheme.fpqcTopology F ↔
      Presieve.IsSheaf Scheme.zariskiTopology F ∧
        ∀ {R S : CommRingCat.{u}} (f : R ⟶ S), Flat (Spec.map f) → Surjective (Spec.map f) →
          Presieve.IsSheafFor F (.singleton (Spec.map f)) := by
  have : HasRingHomProperty (@Flat : MorphismProperty Scheme.{u}) RingHom.Flat := inferInstance
  have : IsZariskiLocalAtSource (@Flat : MorphismProperty Scheme.{u}) :=
    HasRingHomProperty.instIsZariskiLocalAtSource
  exact isSheaf_type_propQCTopology_iff (P := @Flat) F

/-- 3ULFIl_2Wis-22847 (6:20:47) [prop] For every scheme `X`, `S ↦ Hom(S, X)` is an fpqc sheaf. -/
theorem prop_22847 (X : Scheme.{u}) : Presieve.IsSheaf Scheme.fpqcTopology (yoneda.obj X) :=
  (prop_21668 X).2

/-- 3ULFIl_2Wis-22976 (6:22:56) [prop] A faithfully flat quasi-compact morphism is a universal
effective epimorphism: it is an effective epimorphism, and so are its base changes. -/
theorem prop_22976 {S' S : Scheme.{u}} (f : S' ⟶ S) [Flat f] [Surjective f] [QuasiCompact f]
    {T : Scheme.{u}} (g : T ⟶ S) : EffectiveEpi f ∧ EffectiveEpi (pullback.snd f g) :=
  ⟨inferInstance, inferInstance⟩

/-- 3ULFIl_2Wis-23307 (6:28:27) [def] The fppf topology: jointly surjective families of flat
morphisms locally of finite presentation (mathlib's `Scheme.fppfPrecoverage`); it is finer than
the Zariski topology and coarser than the fpqc topology. -/
example : Scheme.fppfPrecoverage.{u} ≤ Scheme.fpqcPrecoverage ∧
    Scheme.zariskiPrecoverage.{u} ≤ Scheme.fppfPrecoverage :=
  ⟨Scheme.fppfPrecoverage_le_fpqcPrecoverage, Scheme.zariskiPrecoverage_le_fppfPrecoverage⟩

/-- 3ULFIl_2Wis-23499 (6:31:39) [def] The étale topology: jointly surjective families of étale
morphisms (mathlib's `Scheme.etaleTopology`), finer than the Zariski topology. -/
example : Scheme.zariskiTopology.{u} ≤ Scheme.etaleTopology := Scheme.zariskiTopology_le_etaleTopology

end Schemes

/-! ### Topologies and sheaves on a site -/

section Sites

variable {C : Type u} [Category.{v} C]

/-- 3ULFIl_2Wis-23180 (6:26:20) [prop] The finest topology for which representable functors are
sheaves (the canonical topology) has as covering sieves the universally strictly epimorphic ones:
those all of whose pullbacks are effective epimorphic. -/
theorem prop_23180 {X : C} (S : Sieve X) :
    S ∈ Sheaf.canonicalTopology C X ↔ ∀ ⦃Y : C⦄ (f : Y ⟶ X), (S.pullback f).EffectiveEpimorphic := by
  constructor
  · intro hS Y f
    rw [Sieve.EffectiveEpimorphic.iff_forall_isSheafFor_yoneda]
    intro Z
    exact Sheaf.isSheaf_yoneda_obj Z _ ((Sheaf.canonicalTopology C).pullback_stable f hS)
  · intro h
    refine Sheaf.mem_finestTopology_of_forall_isSheafFor ?_
    rintro P ⟨Z, rfl⟩ Y f
    exact (Sieve.EffectiveEpimorphic.iff_forall_isSheafFor_yoneda _).1 (h f) Z

/-- 3ULFIl_2Wis-23437 (6:30:37) [def] The topology whose covering families are those with a member
admitting a section: the coarsest topology `⊥` (only sieves containing the identity cover). -/
theorem def_23437 {ι : Type*} {S : C} {X : ι → C} (f : ∀ i, X i ⟶ S) :
    Sieve.generate (Presieve.ofArrows X f) ∈ (⊥ : GrothendieckTopology C) S ↔
      ∃ i, ∃ s : S ⟶ X i, s ≫ f i = 𝟙 S := by
  rw [GrothendieckTopology.bot_covering, ← Sieve.id_mem_iff_eq_top]
  constructor
  · rintro ⟨Y, h, g, ⟨i⟩, e⟩
    exact ⟨i, h, e⟩
  · rintro ⟨i, s, e⟩
    exact ⟨_, s, f i, ⟨i⟩, e⟩

/-- 3ULFIl_2Wis-22691 (6:18:11) [prop] (effectivity) In the category of sheaves of sets on a
site, every epimorphism is effective (regular). -/
theorem prop_22691 (J : GrothendieckTopology C) : IsRegularEpiCategory (Sheaf J (Type (max u v))) :=
  inferInstance

/-- 3ULFIl_2Wis-24410 (6:46:50) [prop] (on a site with sheafification, e.g. a small one) Every
equivalence relation `R ⇉ X` of sheaves has a quotient sheaf: sheaves have all colimits, in
particular coequalizers. -/
theorem prop_24410 (J : GrothendieckTopology C) : HasCoequalizers (Sheaf J (Type (max u v))) :=
  inferInstance

end Sites

/-! ### Quotients and algebraic spaces -/

section Quotients

/-- 3ULFIl_2Wis-23692 (6:34:52) [prop] (affine target, uniqueness) If `A` is Hausdorff for the
`I`-adic topology (e.g. complete noetherian local with `I = 𝔪`), a morphism `Spec A → Spec B` is
determined by its restrictions to the `Spec A/I^n`: `F(A) → lim F(A/I^n)` is injective. -/
theorem prop_23692 {A B : Type*} [CommRing A] [CommRing B] (I : Ideal A) [IsHausdorff I A]
    (φ ψ : B →+* A)
    (h : ∀ n : ℕ, (Ideal.Quotient.mk (I ^ n)).comp φ = (Ideal.Quotient.mk (I ^ n)).comp ψ) :
    φ = ψ := by
  ext b
  refine sub_eq_zero.1 (IsHausdorff.haus ‹_› (φ b - ψ b) fun n => ?_)
  rw [SModEq.sub_mem, sub_zero, smul_eq_mul, Ideal.mul_top]
  exact Ideal.Quotient.eq.1 (RingHom.congr_fun (h n) b)

/-- 3ULFIl_2Wis-25060 (6:57:40) [thm] (flatness) Over a field `k`, every subgroup scheme `H`
of `G` is flat (every `k`-algebra is flat), so the equivalence relation `G × H ⇉ G` it defines
is flat. -/
theorem thm_25060 (k R : Type*) [Field k] [CommRing R] [Algebra k R] : Module.Flat k R :=
  inferInstance

end Quotients

end

