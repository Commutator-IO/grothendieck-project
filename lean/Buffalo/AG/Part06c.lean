import Buffalo.AG.Part06b

/-!
# Buffalo, algebraic geometry, part 06 (c): 26 June 1973, to 4:35:38

The entries of `docs/buffalo-ag/index.tex` lines 847–879 (video `Oqhr-Gt66es`, 3:23:46–4:35:38):
diagonals, separated, quasi-separated and coherent morphisms.

Conventions. The kernel of a pair `u, v : X → Y` of `S`-morphisms is the base change of the
diagonal `Δ : Y → Y ×_S Y` along `(u, v)`, and the graph of `f` is `pullback.lift (𝟙 X) f`, as in
`Part06b` (`prop_10536`, `prop_10860`), which gives the equivalent forms of separatedness and
quasi-separatedness. A scheme `X` is separated (quasi-separated, quasi-compact) when
`X → Spec ℤ` is, that is mathlib's `X.IsSeparated` (`QuasiSeparatedSpace X`, `CompactSpace X`).
A coherent morphism is a quasi-compact quasi-separated one.
-/

open CategoryTheory Limits AlgebraicGeometry Topology TensorProduct

universe u

namespace Buffalo.AG.Part06

noncomputable section

/-! ### Diagonals -/

section Diagonals

variable {X Y Z S : Scheme.{u}}

/-- Oqhr-Gt66es-12226 (3:23:46) [prop] The diagonal of `Spec B` over `Spec A` is the closed
immersion given by `B ⊗_A B → B`, `x ⊗ y ↦ xy`; it follows that every diagonal is an immersion. -/
theorem prop_12226 (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (f : X ⟶ Y) :
    IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.lmul' A : B ⊗[A] B →ₐ[A] B).toRingHom)) ∧
    IsImmersion (pullback.diagonal f) :=
  ⟨IsClosedImmersion.spec_of_surjective _ fun b => ⟨b ⊗ₜ 1, by simp⟩, inferInstance⟩

/-- Oqhr-Gt66es-12294 (3:24:54) [prop] If `g ∘ f` is an immersion, then `f` is one (mathlib:
`IsImmersion.of_comp`). -/
theorem prop_12294 (f : X ⟶ Y) (g : Y ⟶ Z) [IsImmersion (f ≫ g)] : IsImmersion f :=
  IsImmersion.of_comp f g

/-- Oqhr-Gt66es-12483 (3:28:03) [prop] An immersion is locally of finite type; the diagonal of
every morphism is therefore locally of finite type. -/
theorem prop_12483 (f : X ⟶ Y) [IsImmersion f] (g : Y ⟶ Z) :
    LocallyOfFiniteType f ∧ LocallyOfFiniteType (pullback.diagonal g) :=
  ⟨inferInstance, inferInstance⟩

/-- Oqhr-Gt66es-12547 (3:29:07) [prop] An immersion is locally of finite presentation iff the ideal
`J` defining it is of finite type. Affine case (the property being local): `A → A/J` is of finite
presentation iff `J` is finitely generated. -/
theorem prop_12547 {A : Type u} [CommRing A] (J : Ideal A) :
    Algebra.FinitePresentation A (A ⧸ J) ↔ J.FG := by
  constructor
  · intro _
    have := Algebra.FinitePresentation.ker_fG_of_surjective (Algebra.ofId A (A ⧸ J))
      Ideal.Quotient.mk_surjective
    convert this
    ext x
    simp
  · intro h
    exact Algebra.FinitePresentation.quotient h

/-- Oqhr-Gt66es-12804 (3:33:24) [prop] If `B` is generated as an `A`-algebra by elements `b_i`, the
kernel of `B ⊗_A B → B` is generated by the `b_i ⊗ 1 - 1 ⊗ b_i`. -/
theorem prop_12804 (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (s : Set B)
    (hs : Algebra.adjoin A s = ⊤) :
    RingHom.ker (Algebra.TensorProduct.lmul' A : B ⊗[A] B →ₐ[A] B) =
      Ideal.span ((fun b => b ⊗ₜ[A] (1 : B) - 1 ⊗ₜ b) '' s) := by
  set I := Ideal.span ((fun b => b ⊗ₜ[A] (1 : B) - 1 ⊗ₜ b) '' s)
  have key : ∀ x : B, (1 : B) ⊗ₜ[A] x - x ⊗ₜ 1 ∈ I := by
    intro x
    have hx : x ∈ Algebra.adjoin A s := hs ▸ Algebra.mem_top
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      have : x ⊗ₜ[A] (1 : B) - 1 ⊗ₜ x ∈ I := Ideal.subset_span ⟨x, hx, rfl⟩
      have := I.neg_mem this
      rwa [neg_sub] at this
    | algebraMap a =>
      rw [Algebra.algebraMap_eq_smul_one, TensorProduct.tmul_smul, TensorProduct.smul_tmul',
        sub_self]
      exact I.zero_mem
    | add x y _ _ hx hy =>
      rw [TensorProduct.tmul_add, TensorProduct.add_tmul]
      have := I.add_mem hx hy
      convert this using 1
      abel
    | mul x y _ _ hx hy =>
      have h1 : ((1 : B) ⊗ₜ[A] x) * (1 ⊗ₜ y) = 1 ⊗ₜ (x * y) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
      have h2 : (y ⊗ₜ[A] (1 : B)) * (1 ⊗ₜ x) = y ⊗ₜ x := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
      have h3 : ((1 : B) ⊗ₜ[A] x) * (y ⊗ₜ 1) = y ⊗ₜ x := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
      have h4 : (y ⊗ₜ[A] (1 : B)) * (x ⊗ₜ 1) = (x * y) ⊗ₜ 1 := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_comm]
      have := I.add_mem (I.mul_mem_left ((1 : B) ⊗ₜ[A] x) hy) (I.mul_mem_left (y ⊗ₜ[A] 1) hx)
      convert this using 1
      linear_combination (-1 : B ⊗[A] B) * h1 + h3 - h2 + h4
  apply le_antisymm
  · rw [← KaehlerDifferential.ideal, ← KaehlerDifferential.span_range_eq_ideal, Ideal.span_le]
    rintro _ ⟨x, rfl⟩
    exact key x
  · rw [Ideal.span_le]
    rintro _ ⟨b, -, rfl⟩
    simp [RingHom.mem_ker]

/-- Oqhr-Gt66es-12611 (3:30:11) [prop] If `f` is locally of finite type, its diagonal is locally of
finite presentation. Affine case: for `B` of finite type over `A`, the kernel of `B ⊗_A B → B` is
finitely generated (by 12804), so `B` is a finitely presented `B ⊗_A B`-algebra. -/
theorem prop_12611 (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    [Algebra.FiniteType A B] :
    (RingHom.ker (Algebra.TensorProduct.lmul' A : B ⊗[A] B →ₐ[A] B)).FG := by
  classical
  obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := A) (A := B)
  rw [prop_12804 A B s hs]
  exact ⟨(s.image fun b => b ⊗ₜ[A] (1 : B) - 1 ⊗ₜ b), by simp⟩

end Diagonals

/-! ### Separated morphisms -/

section Separated

variable {X Y Z S : Scheme.{u}}

/-- Oqhr-Gt66es-12999 (3:36:39) [def] `f` is separated if its diagonal is a closed immersion
(mathlib: `IsSeparated`). -/
example (f : X ⟶ S) : IsSeparated f ↔ IsClosedImmersion (pullback.diagonal f) :=
  ⟨fun h => h.1, fun h => ⟨h⟩⟩

/-- Oqhr-Gt66es-13063 (3:37:43) [prop] Equivalent: the graph of every `S`-morphism into `X` is a
closed immersion; the kernel of every pair `(u, v) : Y → X` is a closed subscheme of `Y`; after
any base change, every section is a closed immersion (`prop_10536`, `prop_10860` for the class of
closed immersions). -/
theorem prop_13063 (g : X ⟶ S) :
    List.TFAE [IsSeparated g,
      ∀ (Y : Scheme.{u}) (p : Y ⟶ S) (f : Y ⟶ X) (h : f ≫ g = p),
        IsClosedImmersion (pullback.lift (𝟙 Y) f (by simp [h]) : Y ⟶ pullback p g),
      ∀ (Y : Scheme.{u}) (u v : Y ⟶ X) (h : u ≫ g = v ≫ g),
        IsClosedImmersion (pullback.fst (pullback.lift u v h) (pullback.diagonal g)),
      ∀ (S' : Scheme.{u}) (φ : S' ⟶ S) (s : S' ⟶ pullback g φ),
        s ≫ pullback.snd g φ = 𝟙 S' → IsClosedImmersion s] := by
  have h := prop_10536 (@IsClosedImmersion : MorphismProperty Scheme.{u}) g
  have e : IsSeparated g ↔ IsClosedImmersion (pullback.diagonal g) := ⟨fun h => h.1, fun h => ⟨h⟩⟩
  tfae_have 1 ↔ 2 := e.trans (h.out 1 2)
  tfae_have 1 ↔ 3 := e.trans (h.out 1 3)
  tfae_have 1 ↔ 4 := e.trans (prop_10860 (@IsClosedImmersion : MorphismProperty Scheme.{u}) g)
  tfae_finish

/-- Oqhr-Gt66es-13255 (3:40:55) [prop] Extension of identities: if `X` is separated over `S`, `Y`
reduced, and two `S`-morphisms `u, v : Y → X` coincide on a dense open set `U`, then `u = v`. -/
theorem prop_13255 [IsReduced Y] (s : X ⟶ S) [IsSeparated s] (u v : Y ⟶ X) (h : u ≫ s = v ≫ s)
    (U : Y.Opens) (hU : Dense (U : Set Y)) (huv : U.ι ≫ u = U.ι ≫ v) : u = v := by
  have : IsDominant U.ι := ⟨by rw [DenseRange, U.range_ι]; exact hU⟩
  exact ext_of_isDominant_of_isSeparated s h U.ι huv

/-- Oqhr-Gt66es-13384 (3:43:04) [prop] Same conclusion if `u ∘ i = v ∘ i` for a morphism
`i : U → Y` with dense image (mathlib: `ext_of_isDominant_of_isSeparated`). -/
theorem prop_13384 {W : Scheme.{u}} [IsReduced Y] (s : X ⟶ S) [IsSeparated s] (u v : Y ⟶ X)
    (h : u ≫ s = v ≫ s) (i : W ⟶ Y) (hi : DenseRange i) (huv : i ≫ u = i ≫ v) : u = v := by
  have : IsDominant i := ⟨hi⟩
  exact ext_of_isDominant_of_isSeparated s h i huv

/-- Oqhr-Gt66es-13576 (3:46:16) [prop] A surjective immersion is a closed immersion, defined by a
nil ideal (affine case: `Spec(A/J) → Spec A` is surjective iff `J` is contained in the nilradical);
if `Y` is reduced, it is an isomorphism. -/
theorem prop_13576 (f : X ⟶ Y) [IsImmersion f] [Surjective f] :
    IsClosedImmersion f ∧ (IsReduced Y → IsIso f) ∧
    ∀ {A : Type u} [CommRing A] (J : Ideal A),
      Function.Surjective (PrimeSpectrum.comap (Ideal.Quotient.mk J)) ↔ J ≤ nilradical A := by
  have hr : IsClosed (Set.range f) := by
    rw [Set.range_eq_univ.2 f.surjective]
    exact isClosed_univ
  have hc : IsClosedImmersion f := IsClosedImmersion.of_isPreimmersion f hr
  refine ⟨hc, fun _ => isIso_of_isClosedImmersion_of_surjective f, fun J => ?_⟩
  rw [← Set.range_eq_univ, range_comap_of_surjective _ _ Ideal.Quotient.mk_surjective,
    Ideal.mk_ker, PrimeSpectrum.zeroLocus_eq_univ_iff]
  exact ⟨fun h x hx => h hx, fun h x hx => h hx⟩

/-- Oqhr-Gt66es-13639 (3:47:19) [prop] Every monomorphism is separated (its diagonal is an
isomorphism), in particular every immersion is separated. -/
theorem prop_13639 (f : X ⟶ Y) (g : Z ⟶ Y) [Mono f] [IsImmersion g] :
    IsIso (pullback.diagonal f) ∧ IsSeparated f ∧ IsSeparated g :=
  ⟨inferInstance, inferInstance, inferInstance⟩

/-- Oqhr-Gt66es-13704 (3:48:24) [prop] If `g ∘ f` is separated, then `f` is separated. -/
theorem prop_13704 (f : X ⟶ Y) (g : Y ⟶ Z) [IsSeparated (f ≫ g)] : IsSeparated f :=
  IsSeparated.of_comp f g

/-- Oqhr-Gt66es-13770 (3:49:30) [def] A scheme is separated if it is separated over `Spec ℤ` (mathlib:
`Scheme.IsSeparated`, i.e. `X → ⊤_ Scheme` separated); an affine scheme is separated. -/
example (X : Scheme.{u}) [IsAffine X] : X.IsSeparated ∧ IsSeparated (terminal.from X) :=
  ⟨inferInstance, inferInstance⟩

/-- Oqhr-Gt66es-13832 (3:50:32) [prop] If `S` is separated, an `S`-scheme `X` is separated iff it is
separated over `S`. -/
theorem prop_13832 [S.IsSeparated] (f : X ⟶ S) : X.IsSeparated ↔ IsSeparated f := by
  rw [Scheme.isSeparated_iff]
  rw [show terminal.from X = f ≫ terminal.from S from terminal.hom_ext _ _]
  exact IsSeparated.comp_iff

/-- Oqhr-Gt66es-13961 (3:52:41) [prop] If `S` is separated, every morphism from an affine scheme to
`S` is affine; in particular `X ×_S Y` is affine for `X, Y` affine over `S`. -/
theorem prop_13961 [S.IsSeparated] (f : X ⟶ S) (g : Y ⟶ S) [IsAffine X] [IsAffine Y] :
    IsAffineHom f ∧ IsAffine (pullback f g) := by
  have hf : IsAffineHom f := by
    have : IsAffineHom (f ≫ terminal.from S) := by
      rw [show f ≫ terminal.from S = terminal.from X from terminal.hom_ext _ _]
      infer_instance
    exact IsAffineHom.of_comp f (terminal.from S)
  have hg : IsAffineHom g := by
    have : IsAffineHom (g ≫ terminal.from S) := by
      rw [show g ≫ terminal.from S = terminal.from Y from terminal.hom_ext _ _]
      infer_instance
    exact IsAffineHom.of_comp g (terminal.from S)
  exact ⟨hf, isAffine_of_isAffineHom (pullback.fst f g)⟩

/-- Oqhr-Gt66es-14155 (3:55:55) [prop] In a separated scheme, the intersection of two affine open
sets is affine (mathlib: `IsAffineOpen.inf`); the converse (false) is not formalised. -/
theorem prop_14155 [X.IsSeparated] {U V : X.Opens} (hU : IsAffineOpen U) (hV : IsAffineOpen V) :
    IsAffineOpen (U ⊓ V) :=
  hU.inf hV

/-- Oqhr-Gt66es-14698 (4:04:58) [ex] The complement of the zero section of `𝔸¹_S` is affine (`S`
affine): it is the basic open `D(t)` of `Spec A[t]`, i.e. `Spec A[t, t⁻¹]`. (Not affine for
`n ≥ 2`: not formalised.) -/
theorem ex_14698 (A : CommRingCat.{u}) :
    IsAffineOpen ((Spec (CommRingCat.of (Polynomial A))).basicOpen
      ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial A))).inv Polynomial.X)) :=
  (isAffineOpen_top (Spec (CommRingCat.of (Polynomial A)))).basicOpen _

end Separated

/-! ### Quasi-separated and coherent morphisms -/

section QuasiSeparated

variable {X Y Z S : Scheme.{u}}

/-- Oqhr-Gt66es-14833 (4:07:13) [def] `f` is quasi-separated if its diagonal is quasi-compact
(mathlib: `QuasiSeparated`, `quasiSeparated_eq_diagonal_is_quasiCompact`). -/
example (f : X ⟶ S) : QuasiSeparated f ↔ QuasiCompact (pullback.diagonal f) :=
  ⟨fun h => h.1, fun h => ⟨h⟩⟩

/-- Oqhr-Gt66es-14898 (4:08:18) [prop] Equivalent: after any base change, every section is
quasi-compact; the kernel of any pair `(u, v) : Y → X` of `S`-morphisms is quasi-compact over `Y`
(`prop_10536`, `prop_10860` for the class of quasi-compact morphisms). -/
theorem prop_14898 (g : X ⟶ S) :
    List.TFAE [QuasiSeparated g,
      ∀ (Y : Scheme.{u}) (u v : Y ⟶ X) (h : u ≫ g = v ≫ g),
        QuasiCompact (pullback.fst (pullback.lift u v h) (pullback.diagonal g)),
      ∀ (S' : Scheme.{u}) (φ : S' ⟶ S) (s : S' ⟶ pullback g φ),
        s ≫ pullback.snd g φ = 𝟙 S' → QuasiCompact s] := by
  have : MorphismProperty.RespectsIso (@QuasiCompact : MorphismProperty Scheme.{u}) :=
    MorphismProperty.IsStableUnderBaseChange.respectsIso
  have h := prop_10536 (@QuasiCompact : MorphismProperty Scheme.{u}) g
  have e : QuasiSeparated g ↔ QuasiCompact (pullback.diagonal g) := ⟨fun h => h.1, fun h => ⟨h⟩⟩
  tfae_have 1 ↔ 2 := e.trans (h.out 1 3)
  tfae_have 1 ↔ 3 := e.trans (prop_10860 (@QuasiCompact : MorphismProperty Scheme.{u}) g)
  tfae_finish

/-- Oqhr-Gt66es-14967 (4:09:27) [prop] A separated morphism is quasi-separated; every monomorphism,
hence every diagonal, is quasi-separated; if `g ∘ f` is quasi-separated, `f` is. -/
theorem prop_14967 (f : X ⟶ Y) (g : Y ⟶ Z) :
    (IsSeparated f → QuasiSeparated f) ∧ (Mono f → QuasiSeparated f) ∧
    QuasiSeparated (pullback.diagonal g) ∧ (QuasiSeparated (f ≫ g) → QuasiSeparated f) :=
  ⟨fun _ => inferInstance, fun _ => inferInstance, inferInstance,
    fun _ => QuasiSeparated.of_comp f g⟩

/-- Oqhr-Gt66es-15031 (4:10:31) [def] A scheme is quasi-separated if it is so over `Spec ℤ`
(mathlib: `QuasiSeparatedSpace X ↔ QuasiSeparated (terminal.from X)`); it is then so over every
scheme beneath it. -/
theorem def_15031 (f : X ⟶ S) :
    (QuasiSeparatedSpace X ↔ QuasiSeparated (terminal.from X)) ∧
    (QuasiSeparatedSpace X → QuasiSeparated f) := by
  refine ⟨quasiSeparatedSpace_iff_quasiSeparated X, fun h => ?_⟩
  have : QuasiSeparated (f ≫ terminal.from S) := by
    rw [show f ≫ terminal.from S = terminal.from X from terminal.hom_ext _ _]
    exact (quasiSeparatedSpace_iff_quasiSeparated X).1 h
  exact QuasiSeparated.of_comp f (terminal.from S)

/-- Oqhr-Gt66es-15094 (4:11:34) [prop] If `S` is quasi-separated, an `S`-scheme is quasi-separated
iff it is so over `S`. -/
theorem prop_15094 [QuasiSeparatedSpace S] (f : X ⟶ S) : QuasiSeparatedSpace X ↔ QuasiSeparated f := by
  refine ⟨(def_15031 f).2, fun _ => ?_⟩
  have : QuasiSeparated (terminal.from S) := (quasiSeparatedSpace_iff_quasiSeparated S).1 ‹_›
  rw [quasiSeparatedSpace_iff_quasiSeparated,
    show terminal.from X = f ≫ terminal.from S from terminal.hom_ext _ _]
  infer_instance

/-- Oqhr-Gt66es-15158 (4:12:38) [prop] A scheme is quasi-separated iff the intersection of two
quasi-compact open sets is quasi-compact (mathlib's definition of `QuasiSeparatedSpace`). -/
theorem prop_15158 (X : Scheme.{u}) :
    QuasiSeparatedSpace X ↔ ∀ U V : Set X, IsOpen U → IsCompact U → IsOpen V → IsCompact V →
      IsCompact (U ∩ V) :=
  ⟨fun h => h.inter_isCompact, fun h => ⟨h⟩⟩

/-- Oqhr-Gt66es-15289 (4:14:49) [prop] `S` is quasi-separated iff every morphism `X → S` from a
quasi-compact scheme is quasi-compact. -/
theorem prop_15289 (S : Scheme.{u}) :
    QuasiSeparatedSpace S ↔
      ∀ (X : Scheme.{u}) (f : X ⟶ S), CompactSpace X → QuasiCompact f := by
  constructor
  · intro hS X f hX
    have : QuasiSeparated (terminal.from S) := (quasiSeparatedSpace_iff_quasiSeparated S).1 hS
    have : QuasiCompact (f ≫ terminal.from S) := by
      rw [show f ≫ terminal.from S = terminal.from X from terminal.hom_ext _ _]
      exact (compactSpace_iff_quasiCompact X).1 hX
    exact QuasiCompact.of_comp f (terminal.from S)
  · intro h
    refine ⟨fun U V hU hUc hV hVc => ?_⟩
    let U' : S.Opens := ⟨U, hU⟩
    have hc : CompactSpace U'.toScheme := isCompact_iff_compactSpace.1 hUc
    have hq := h U'.toScheme U'.ι hc
    have hpre : IsCompact (U'.ι ⁻¹' V) := hq.isCompact_preimage V hV hVc
    have := hpre.image U'.ι.continuous
    rwa [Set.image_preimage_eq_inter_range, U'.range_ι, Set.inter_comm] at this

/-- Oqhr-Gt66es-15416 (4:16:56) [prop] `S` is quasi-separated iff `X ×_S Y` is quasi-compact for all
`X, Y` quasi-compact over `S`. -/
theorem prop_15416 (S : Scheme.{u}) :
    QuasiSeparatedSpace S ↔ ∀ (X Y : Scheme.{u}) (f : X ⟶ S) (g : Y ⟶ S),
      CompactSpace X → CompactSpace Y → CompactSpace ↥(pullback f g) := by
  constructor
  · intro hS X Y f g hX hY
    have : QuasiCompact g := (prop_15289 S).1 hS Y g hY
    infer_instance
  · intro h
    refine ⟨fun U V hU hUc hV hVc => ?_⟩
    let U' : S.Opens := ⟨U, hU⟩
    let V' : S.Opens := ⟨V, hV⟩
    have hP := h U'.toScheme V'.toScheme U'.ι V'.ι (isCompact_iff_compactSpace.1 hUc)
      (isCompact_iff_compactSpace.1 hVc)
    have := ((isCompact_univ (X := ↥(pullback U'.ι V'.ι))).image
      (pullback.fst U'.ι V'.ι).continuous).image U'.ι.continuous
    rwa [Set.image_univ, Scheme.Pullback.range_fst, V'.range_ι,
      Set.image_preimage_eq_inter_range, U'.range_ι, Set.inter_comm] at this

/-- Oqhr-Gt66es-15613 (4:20:13) [prop] If `S` is covered by affine open sets `S_i`, `S` is
quasi-separated iff the `S_i ∩ S_j` are quasi-compact (mathlib:
`Scheme.quasiSeparatedSpace_of_isOpenCover`). -/
theorem prop_15613 {ι : Type*} (U : ι → S.Opens) (hU : TopologicalSpace.IsOpenCover U)
    (hA : ∀ i, IsAffineOpen (U i)) :
    QuasiSeparatedSpace S ↔ ∀ i j, IsCompact ((U i : Set S) ∩ U j) :=
  ⟨fun h i j => h.inter_isCompact _ _ (U i).isOpen (hA i).isCompact (U j).isOpen (hA j).isCompact,
    Scheme.quasiSeparatedSpace_of_isOpenCover U hU hA⟩

/-- The origin of `Spec k[t₀, t₁, …]`: the prime (maximal) ideal of polynomials without constant
term. -/
def origin (k : Type u) [Field k] : PrimeSpectrum (MvPolynomial ℕ k) :=
  ⟨RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial ℕ k →+* k), RingHom.ker_isPrime _⟩

theorem origin_isMaximal (k : Type u) [Field k] : (origin k).asIdeal.IsMaximal :=
  RingHom.ker_isMaximal_of_surjective _ fun a => ⟨MvPolynomial.C a, by simp⟩

/-- A prime ideal containing all the `t_i` is the origin. -/
theorem eq_origin_of_X_mem {k : Type u} [Field k] (p : PrimeSpectrum (MvPolynomial ℕ k))
    (h : ∀ i, MvPolynomial.X i ∈ p.asIdeal) : p = origin k := by
  have hle : (origin k).asIdeal ≤ p.asIdeal := by
    intro f hf
    have hf' : f ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set ℕ)) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro d hd
      by_contra hcon
      push Not at hcon
      have hd0 : d = 0 := Finsupp.ext fun i => hcon i (Set.mem_univ i)
      subst hd0
      exact (MvPolynomial.mem_support_iff.1 hd) (by
        rw [← MvPolynomial.constantCoeff_eq]; exact RingHom.mem_ker.1 hf)
    refine (Ideal.span_le.2 ?_) hf'
    rintro _ ⟨i, -, rfl⟩
    exact h i
  exact PrimeSpectrum.ext ((origin_isMaximal k).eq_of_le p.isPrime.ne_top hle).symm

/-- Oqhr-Gt66es-15677 (4:21:17) [cex] The complement of the origin in `Spec k[t₁, t₂, …]` is not
quasi-compact. (That two copies glued along it form a non-quasi-separated scheme: not formalised,
for want of the glued scheme.) -/
theorem cex_15677 (k : Type u) [Field k] : ¬ IsCompact ({origin k}ᶜ : Set _) := by
  intro hc
  have hcov : ({origin k}ᶜ : Set (PrimeSpectrum (MvPolynomial ℕ k))) ⊆
      ⋃ i, (PrimeSpectrum.basicOpen (MvPolynomial.X i : MvPolynomial ℕ k) : Set _) := by
    intro p hp
    by_contra hn
    simp only [Set.mem_iUnion, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, not_exists,
      not_not] at hn
    exact hp (eq_origin_of_X_mem p hn)
  obtain ⟨F, hF⟩ := hc.elim_finite_subcover _ (fun i => (PrimeSpectrum.basicOpen _).isOpen) hcov
  set N := F.sup id + 1
  let φ : MvPolynomial ℕ k →ₐ[k] MvPolynomial ℕ k :=
    MvPolynomial.aeval fun i => if i < N then 0 else MvPolynomial.X i
  let q : PrimeSpectrum (MvPolynomial ℕ k) := ⟨RingHom.ker φ, RingHom.ker_isPrime _⟩
  have hqN : MvPolynomial.X N ∉ q.asIdeal := by
    change φ (MvPolynomial.X N) ≠ 0
    simp [φ, MvPolynomial.X_ne_zero]
  have hq : q ∈ ({origin k}ᶜ : Set _) := by
    intro hq
    apply hqN
    rw [Set.mem_singleton_iff.1 hq]
    change MvPolynomial.constantCoeff (MvPolynomial.X N : MvPolynomial ℕ k) = 0
    simp
  obtain ⟨i, hi, hqi⟩ := Set.mem_iUnion₂.1 (hF hq)
  have hiN : i < N := Nat.lt_succ_of_le (Finset.le_sup (f := id) hi)
  apply (PrimeSpectrum.mem_basicOpen _ _).1 hqi
  change φ (MvPolynomial.X i) = 0
  simp [φ, hiN]

/-- Oqhr-Gt66es-16003 (4:26:43) [prop] If `g ∘ f` is quasi-compact (resp. of finite type) and `g`
quasi-separated, then `f` is quasi-compact (resp. of finite type); the diagonal of a morphism
locally of finite type is quasi-compact iff it is of finite type (it is locally of finite type). -/
theorem prop_16003 (f : X ⟶ Y) (g : Y ⟶ Z) [QuasiSeparated g] :
    (QuasiCompact (f ≫ g) → QuasiCompact f) ∧
    (QuasiCompact (f ≫ g) ∧ LocallyOfFiniteType (f ≫ g) →
      QuasiCompact f ∧ LocallyOfFiniteType f) ∧
    (QuasiCompact (pullback.diagonal g) ↔
      QuasiCompact (pullback.diagonal g) ∧ LocallyOfFiniteType (pullback.diagonal g)) := by
  refine ⟨fun _ => QuasiCompact.of_comp f g, fun ⟨_, _⟩ => ⟨QuasiCompact.of_comp f g,
    locallyOfFiniteType_of_comp f g⟩, fun h => ⟨h, inferInstance⟩, fun h => h.1⟩

/-- Oqhr-Gt66es-16068 (4:27:48) [def] A morphism is coherent if it is quasi-compact and
quasi-separated; a scheme is coherent if it is so over `Spec ℤ` (quasi-compact and
quasi-separated). -/
def IsCoherentHom (f : X ⟶ Y) : Prop := QuasiCompact f ∧ QuasiSeparated f

/-- Oqhr-Gt66es-16201 (4:30:01) [prop] Coherent morphisms are stable under base change and under
composition. -/
theorem prop_16201 :
    (∀ {X Y S : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S), IsCoherentHom g →
      IsCoherentHom (pullback.fst f g)) ∧
    (∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z), IsCoherentHom f → IsCoherentHom g →
      IsCoherentHom (f ≫ g)) :=
  ⟨fun _ _ ⟨_, _⟩ => ⟨inferInstance, inferInstance⟩,
    fun _ _ ⟨_, _⟩ ⟨_, _⟩ => ⟨inferInstance, inferInstance⟩⟩

/-- Oqhr-Gt66es-16267 (4:31:07) [prop] If `g ∘ f` is coherent and `g` quasi-separated, then `f` is
coherent. -/
theorem prop_16267 (f : X ⟶ Y) (g : Y ⟶ Z) [QuasiSeparated g] (h : IsCoherentHom (f ≫ g)) :
    IsCoherentHom f := by
  obtain ⟨_, _⟩ := h
  exact ⟨QuasiCompact.of_comp f g, QuasiSeparated.of_comp f g⟩

/-- Oqhr-Gt66es-16329 (4:32:09) [rem] Nothing can be concluded about `g` from `g ∘ f` coherent alone:
for `f` from the empty scheme, `g ∘ f` is always coherent. -/
theorem rem_16329 [IsEmpty X] (h : X ⟶ Z) : IsCoherentHom h :=
  ⟨⟨fun U _ _ => by simp [Set.eq_empty_of_isEmpty]⟩, inferInstance⟩

/-- The open subscheme `Spec k[t₀, t₁, …] ∖ {origin}`, quasi-separated and not quasi-compact. -/
def puncturedSpec (k : Type u) [Field k] : (Spec (CommRingCat.of (MvPolynomial ℕ k))).Opens :=
  ⟨({origin k}ᶜ : Set (PrimeSpectrum (MvPolynomial ℕ k))),
    ((PrimeSpectrum.isClosed_singleton_iff_isMaximal _).2 (origin_isMaximal k)).isOpen_compl⟩

/-- Oqhr-Gt66es-16396 (4:33:16) [prop] (corrected) If `S` is coherent, an `S`-scheme is coherent iff
it is coherent over `S`. As stated (`S` only quasi-separated) it is false: for `S` the punctured
`Spec k[t₀, t₁, …]` (quasi-separated, not quasi-compact), `𝟙 S` is coherent but `S` is not. -/
theorem prop_16396 [CompactSpace S] [QuasiSeparatedSpace S] (f : X ⟶ S) :
    (CompactSpace X ∧ QuasiSeparatedSpace X) ↔ IsCoherentHom f := by
  have hqs : QuasiSeparated (terminal.from S) := (quasiSeparatedSpace_iff_quasiSeparated S).1 ‹_›
  constructor
  · rintro ⟨hc, hq⟩
    exact ⟨(prop_15289 S).1 ‹_› X f hc, (def_15031 f).2 hq⟩
  · rintro ⟨_, _⟩
    refine ⟨?_, (prop_15094 f).2 ‹_›⟩
    have : QuasiCompact (terminal.from S) := (compactSpace_iff_quasiCompact S).1 ‹_›
    rw [compactSpace_iff_quasiCompact,
      show terminal.from X = f ≫ terminal.from S from terminal.hom_ext _ _]
    infer_instance

/-- The counterexample to 16396 as stated. -/
theorem cex_16396 (k : Type u) [Field k] :
    QuasiSeparatedSpace (puncturedSpec k).toScheme ∧
      IsCoherentHom (𝟙 (puncturedSpec k).toScheme) ∧
      ¬ CompactSpace (puncturedSpec k).toScheme := by
  refine ⟨?_, ⟨inferInstance, inferInstance⟩, fun h => ?_⟩
  · have : IsQuasiSeparated ((puncturedSpec k : Set (Spec (CommRingCat.of (MvPolynomial ℕ k))))) :=
      isQuasiSeparated_univ.of_subset (Set.subset_univ _)
    exact (isQuasiSeparated_iff_quasiSeparatedSpace _ (puncturedSpec k).isOpen).1 this
  · exact cex_15677 k (isCompact_iff_compactSpace.2 h)

end QuasiSeparated

