import Mathlib

/-!
# Quillen, notebook 1971-10: commutators of displaced elements (p. 1), Artin–Schreier equations (p. 8)

Daniel Quillen's research notebook 1971-10 (Clay Mathematics Institute,
<https://www.claymath.org/library/Quillen/Working_papers/quillen%201971/1971-10.pdf>).

**p. 1 (June 6, 1971).** For the group `G` of compactly supported diffeomorphisms of `ℝ`, the
page shows that the commutator subgroup is perfect. Given `g₁, g₂` with supports in an
interval `K`, it multiplies them by conjugates `a' = u g₁⁻¹ u⁻¹`, `b' = v g₂⁻¹ v⁻¹` supported in
translates `uK`, `vK` disjoint from `K` and from each other, so that `g₁ a'` and `g₂ b'` are
« elementary », and observes that the commutator `(g₁ a', g₂ b')` is still `(g₁, g₂)`. Hence
`(G, G) ⊆ (E, E)` for the normal subgroup `E` generated by elementary elements, and since
`E ⊆ (G, G)`, `E = (G, G)` and `E` is perfect.

The geometry (supports, disjoint translates) only serves to produce elements that commute;
this file proves the group theory, in any group:

* `commutator_mul_mul`: if `a'` commutes with `b` and `b'`, and `b'` commutes with `a`, then
  `⁅a a', b b'⁆ = ⁅a, b⁆` (the identity displayed on the page);
* `commutator_le_commutator`: if every pair `g₁, g₂` admits such `a'`, `b'` with `g₁ a'` and
  `g₂ b'` in a subgroup `E`, then `(G, G) ≤ (E, E)`;
* `eq_commutator_of_le`: **the conclusion of the page**: if moreover `E ≤ (G, G)`, then
  `E = (G, G)` and `(E, E) = E`.

**p. 8.** In the direct proof of Lang's theorem for `GL_n` the page solves `x^q − x + a = 0`
over an algebraically closed field of characteristic `p`, `q` a power of `p`.

* `exists_pow_sub_eq`: over an algebraically closed field, `x ↦ x^q − x` is onto for `q ≥ 2`;
* `card_rootSet_pow_sub`: if moreover `p ∣ q` in characteristic `p`, the equation
  `x^q − x = y` has exactly `q` solutions.
-/

namespace Quillen.Notebook1971_10

open scoped commutatorElement

section Commutators

variable {G : Type*} [Group G]

/-- **Quillen, notebook 1971-10, p. 1, the displayed identity.** If `a'` commutes with `b` and
`b'`, and `b'` commutes with `a`, then `⁅a a', b b'⁆ = ⁅a, b⁆`. (On the page `a = g₁`,
`a' = u g₁⁻¹ u⁻¹`, `b = g₂`, `b' = v g₂⁻¹ v⁻¹`, and the commutations come from disjoint
supports.) -/
theorem commutator_mul_mul {a a' b b' : G} (h1 : Commute a' b) (h2 : Commute a' b')
    (h3 : Commute b' a) : ⁅a * a', b * b'⁆ = ⁅a, b⁆ := by
  simp only [commutatorElement_def, mul_inv_rev]
  have e1 : a' * (b * b') = b * b' * a' := by
    rw [← mul_assoc, h1.eq, mul_assoc, h2.eq, mul_assoc]
  have e2 : b' * a⁻¹ = a⁻¹ * b' := (h3.inv_right).eq
  calc a * a' * (b * b') * (a'⁻¹ * a⁻¹) * (b'⁻¹ * b⁻¹)
      = a * (a' * (b * b')) * a'⁻¹ * a⁻¹ * b'⁻¹ * b⁻¹ := by group
    _ = a * b * (b' * a⁻¹) * b'⁻¹ * b⁻¹ := by rw [e1]; group
    _ = a * b * a⁻¹ * b⁻¹ := by rw [e2]; group

/-- If every pair `g₁, g₂` admits `a'`, `b'` as in `commutator_mul_mul` with `g₁ a'` and `g₂ b'`
in `E`, then the commutator subgroup of `G` lies in `⁅E, E⁆`. -/
theorem commutator_le_commutator (E : Subgroup G)
    (hE : ∀ g₁ g₂ : G, ∃ a' b' : G, Commute a' g₂ ∧ Commute a' b' ∧ Commute b' g₁ ∧
      g₁ * a' ∈ E ∧ g₂ * b' ∈ E) :
    commutator G ≤ ⁅E, E⁆ := by
  rw [commutator_def, Subgroup.commutator_le]
  intro g₁ _ g₂ _
  obtain ⟨a', b', h1, h2, h3, ha, hb⟩ := hE g₁ g₂
  rw [← commutator_mul_mul h1 h2 h3]
  exact Subgroup.commutator_mem_commutator ha hb

/-- **Quillen, notebook 1971-10, p. 1.** Under the hypothesis of `commutator_le_commutator`,
if `E` lies in the commutator subgroup, then `E` is the commutator subgroup and is perfect. -/
theorem eq_commutator_of_le (E : Subgroup G)
    (hE : ∀ g₁ g₂ : G, ∃ a' b' : G, Commute a' g₂ ∧ Commute a' b' ∧ Commute b' g₁ ∧
      g₁ * a' ∈ E ∧ g₂ * b' ∈ E)
    (hle : E ≤ commutator G) :
    E = commutator G ∧ ⁅E, E⁆ = E := by
  have h1 := commutator_le_commutator E hE
  have h2 : ⁅E, E⁆ ≤ E := Subgroup.commutator_le.mpr fun g₁ h₁ g₂ h₂ => by
    rw [commutatorElement_def]
    exact E.mul_mem (E.mul_mem (E.mul_mem h₁ h₂) (E.inv_mem h₁)) (E.inv_mem h₂)
  exact ⟨le_antisymm hle (h1.trans h2), le_antisymm h2 (hle.trans h1)⟩

end Commutators

section ArtinSchreier

open Polynomial

variable {K : Type*} [Field K]

theorem natDegree_pow_sub (q : ℕ) (hq : 2 ≤ q) (y : K) :
    (X ^ q - X - C y : K[X]).natDegree = q := by
  rw [natDegree_sub_C, FiniteField.X_pow_card_sub_X_natDegree_eq K (by omega)]

/-- **Quillen, notebook 1971-10, p. 8.** Over an algebraically closed field, every `y` is of
the form `x ^ q - x`, for `q ≥ 2`. -/
theorem exists_pow_sub_eq [IsAlgClosed K] (q : ℕ) (hq : 2 ≤ q) (y : K) :
    ∃ x : K, x ^ q - x = y := by
  obtain ⟨x, hx⟩ := IsAlgClosed.exists_root (X ^ q - X - C y : K[X]) (by
    rw [degree_eq_natDegree, natDegree_pow_sub q hq y]
    · exact_mod_cast (by omega : q ≠ 0)
    · intro h0
      have := natDegree_pow_sub q hq y
      rw [h0, natDegree_zero] at this
      omega)
  exact ⟨x, by simpa [sub_eq_zero] using hx⟩

/-- In characteristic `p` with `p ∣ q`, `q ≥ 2`, over an algebraically closed field, the
equation `x ^ q - x = y` has exactly `q` roots: the polynomial is separable, its derivative
being `-1`. -/
theorem card_rootSet_pow_sub [IsAlgClosed K] (p : ℕ) [CharP K p] (q : ℕ) (hpq : p ∣ q)
    (hq : 2 ≤ q) (y : K) :
    Fintype.card ((X ^ q - X - C y : K[X]).rootSet K) = q := by
  have hq0 : (q : K) = 0 := (CharP.cast_eq_zero_iff K p q).mpr hpq
  have hsep : (X ^ q - X - C y : K[X]).Separable := by
    rw [Polynomial.separable_def]
    have hd : derivative (X ^ q - X - C y : K[X]) = -1 := by
      simp [derivative_X_pow, hq0]
    rw [hd]
    exact isCoprime_one_right.neg_right
  rw [card_rootSet_eq_natDegree hsep (IsAlgClosed.splits _), natDegree_pow_sub q hq y]

end ArtinSchreier

end Quillen.Notebook1971_10
