import Mathlib
import Quillen.Upstream.MulPowCommutator

/-!
# Quillen, notebook 1971-11, pp. 70–71: the quotient of a `p`-central group by `Ω₁`

Daniel Quillen's research notebook 1971-11 (Clay Mathematics Institute,
<https://www.claymath.org/library/Quillen/Working_papers/quillen%201971/1971-11.pdf>), in the run
dated August 24, 1971 and headed « p odd », closes (pp. 70–71) with a proposition on `p`-groups
in which every element of order `p` is central. In our words: for `p` odd, if the subgroup
`Ω₁(P)` generated by the elements of order `p` of a finite `p`-group `P` is central, then the
quotient `P / Ω₁(P)` has the same property. (This is Theorem B of González-Sánchez and Weigel,
2011, for `p` odd.)

His proof takes a maximal normal elementary abelian subgroup `B / A` of `P / A`, `A = Ω₁(P)`,
shows that it is central because the `p`-th power map `B / A → A` is an injective homomorphism
commuting with conjugation, and concludes by the preceding proposition of p. 69 (a maximal normal
elementary abelian subgroup is maximal elementary abelian, `p` odd), whose proof rests on the
lemma of p. 68 formalised in `Quillen.Notebook1971_11`.

We keep his first step and replace the appeal to the proposition of p. 69 by an induction on the
order of `P`. Let `x` be such that `x ^ p ∈ A`, i.e. `x ^ (p * p) = 1`, and let `g ∈ P`. If `x`
generates `P` there is nothing to prove. Otherwise `x` lies in a maximal subgroup `M`, which is
normal; `u = g x g⁻¹` lies in `M`, and the induction hypothesis in `M` says that `x⁻¹` and `u`
commute modulo `A`. Their commutator `d` has order dividing `p`, hence is central, so the
subgroup they generate has class at most 2 and, `p` being odd, `(u x⁻¹) ^ p = u ^ p x⁻ᵖ = 1`
(Quillen's injectivity of the `p`-th power map). Hence `g x g⁻¹ x⁻¹ ∈ A`. The lemma of p. 68 is
therefore not needed for this proposition.

* `omega1`: the subgroup generated by the elements `x` with `x ^ p = 1`; it is normal in any
  group (`omega1_normal`);
* `pow_mul_eq_mul_pow`, `mul_pow_eq_mul_pow_mul_pow_choose`: commutation rules in a group
  generated by two elements whose commutator `d` commutes with both, ending in
  `(u * v) ^ n = u ^ n * v ^ n * d ^ n.choose 2`;
* `mul_pow_eq_of_commutator_pow`: hence, for `p` an odd prime and `d ^ p = 1`,
  `(u * v) ^ p = u ^ p * v ^ p`;
* `mem_omega1_iff`: when every element of order dividing `p` is central, `Ω₁` consists exactly
  of the elements with `x ^ p = 1`;
* `conj_commutator_pow_eq_one_aux`, `conj_commutator_pow_eq_one`: the core statement, for a
  finite `p`-group whose elements of order `p` are central (`p` odd): if `(x ^ p) ^ p = 1`, then
  `(g * x * g⁻¹ * x⁻¹) ^ p = 1` for every `g`;
* `pCentral_quotient`: Quillen's proposition, elementwise: every element of order dividing `p`
  of `P ⧸ omega1 p P` is central;
* `omega1_quotient_le_center`: the same, as on the page: `Ω₁(P) ≤ Z(P)` implies
  `Ω₁(P / Ω₁(P)) ≤ Z(P / Ω₁(P))`.

The commutation rules are general and live in `Quillen.Upstream.MulPowCommutator`
(`mul_pow_eq_of_commute_commutator`, …); the declarations of the section `Commutation` below keep
the names of this page. `Ω₁` and the `p`-central quotient stay here.
-/

universe u

namespace Quillen.Notebook1971_11Central

open Subgroup

section Commutation

variable {G : Type*} [Group G]

/-- If `v * u = d * u * v` and `d` commutes with `v`, then `v ^ n * u = d ^ n * u * v ^ n`. -/
theorem pow_mul_eq_mul_pow {u v d : G} (hd : v * u = d * u * v) (hdv : Commute d v) (n : ℕ) :
    v ^ n * u = d ^ n * u * v ^ n :=
  pow_mul_eq_of_commute_commutator hd hdv n

/-- The power formula in class 2: if `v * u = d * u * v` and `d` commutes with `u` and `v`, then
`(u * v) ^ n = u ^ n * v ^ n * d ^ n.choose 2`. -/
theorem mul_pow_eq_mul_pow_mul_pow_choose {u v d : G} (hd : v * u = d * u * v)
    (hdu : Commute d u) (hdv : Commute d v) (n : ℕ) :
    (u * v) ^ n = u ^ n * v ^ n * d ^ n.choose 2 :=
  mul_pow_eq_of_commute_commutator hd hdu hdv n

/-- For `p` an odd prime, if the commutator `d` of `u` and `v` commutes with both and satisfies
`d ^ p = 1`, then `(u * v) ^ p = u ^ p * v ^ p`. -/
theorem mul_pow_eq_of_commutator_pow {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {u v d : G}
    (hd : v * u = d * u * v) (hdu : Commute d u) (hdv : Commute d v) (hdp : d ^ p = 1) :
    (u * v) ^ p = u ^ p * v ^ p :=
  mul_pow_eq_mul_pow_of_commute_commutator hp hp2 hd hdu hdv hdp

end Commutation

section Omega

variable (p : ℕ) (P : Type*) [Group P]

/-- `Ω₁(P)`: the subgroup generated by the elements `x` with `x ^ p = 1`. -/
def omega1 : Subgroup P := closure {x : P | x ^ p = 1}

/-- `Ω₁(P)` is normal: the set of elements with `x ^ p = 1` is stable under conjugation. -/
instance omega1_normal : (omega1 p P).Normal where
  conj_mem n hn g := by
    induction hn using closure_induction with
    | mem x hx =>
      apply Subgroup.subset_closure
      change (g * x * g⁻¹) ^ p = 1
      rw [conj_pow, show x ^ p = 1 from hx, mul_one, mul_inv_cancel]
    | one => simp
    | mul a b _ _ ha hb =>
      rw [show g * (a * b) * g⁻¹ = (g * a * g⁻¹) * (g * b * g⁻¹) by group]
      exact mul_mem ha hb
    | inv a _ ha =>
      rw [show g * a⁻¹ * g⁻¹ = (g * a * g⁻¹)⁻¹ by group]
      exact inv_mem ha

variable {p P}

/-- When every element with `x ^ p = 1` is central, `Ω₁(P)` consists exactly of these
elements. -/
theorem mem_omega1_iff (hc : ∀ z : P, z ^ p = 1 → z ∈ center P) {x : P} :
    x ∈ omega1 p P ↔ x ^ p = 1 := by
  refine ⟨fun hx => ?_, fun hx => subset_closure hx⟩
  induction hx using closure_induction with
  | mem x hx => exact hx
  | one => exact one_pow p
  | mul a b _ _ ha hb =>
    have hab : Commute a b := (mem_center_iff.mp (hc a ha) b).symm
    rw [hab.mul_pow, ha, hb, one_mul]
  | inv a _ ha => rw [inv_pow, ha, inv_one]

end Omega

section Core

variable {p : ℕ}

/-- The core statement, by induction on the order `n` of the group: in a finite `p`-group whose
elements of order dividing `p` are central (`p` odd), if `(x ^ p) ^ p = 1` then
`(g * x * g⁻¹ * x⁻¹) ^ p = 1` for every `g`. -/
theorem conj_commutator_pow_eq_one_aux (hp : p.Prime) (hp2 : p ≠ 2) (n : ℕ) :
    ∀ (P : Type u) [Group P] [Finite P], Nat.card P = n → IsPGroup p P →
      (∀ z : P, z ^ p = 1 → z ∈ center P) →
      ∀ x g : P, (x ^ p) ^ p = 1 → (g * x * g⁻¹ * x⁻¹) ^ p = 1 := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro P _ _ hn hP hc x g hx
  have : Fact p.Prime := ⟨hp⟩
  by_cases htop : zpowers x = ⊤
  · -- `x` generates `P`, which is then commutative.
    have hg : g ∈ zpowers x := htop ▸ mem_top g
    obtain ⟨i, rfl⟩ := mem_zpowers_iff.mp hg
    rw [(Commute.zpow_self x i).eq]
    simp
  · obtain ⟨M, hM, hxM⟩ := (eq_top_or_exists_le_coatom (zpowers x)).resolve_left htop
    have := hP.isNilpotent
    have hMn : M.Normal := Group.normalizerCondition_of_isNilpotent.normal_of_coatom M hM
    have hxM' : x ∈ M := hxM (mem_zpowers x)
    have huM : g * x * g⁻¹ ∈ M := hMn.conj_mem x hxM' g
    have hup : (g * x * g⁻¹) ^ p = x ^ p := by
      rw [conj_pow, (mem_center_iff.mp (hc _ hx)) g, mul_inv_cancel_right]
    have hlt : Nat.card M < n := by
      rw [← hn, ← card_top (G := P)]
      exact card_lt_of_lt hM.lt_top
    have hcM : ∀ z : M, z ^ p = 1 → z ∈ center M := by
      intro z hz
      rw [mem_center_iff]
      intro w
      have hz' : (z : P) ^ p = 1 := by
        have := congrArg Subtype.val hz
        simpa using this
      exact Subtype.ext (mem_center_iff.mp (hc _ hz') w)
    have hupp : ((g * x * g⁻¹) ^ p) ^ p = 1 := by rw [hup, hx]
    generalize g * x * g⁻¹ = u at huM hup hupp ⊢
    -- The induction hypothesis in `M`, for the elements `u` and `x⁻¹`.
    have hdM := ih _ hlt M rfl (hP.to_subgroup M) hcM ⟨u, huM⟩ ⟨x⁻¹, inv_mem hxM'⟩
      (Subtype.ext (by simpa using hupp))
    have hdp : (x⁻¹ * u * x * u⁻¹) ^ p = 1 := by
      have := congrArg Subtype.val hdM
      simpa using this
    have hdc := mem_center_iff.mp (hc _ hdp)
    rw [mul_pow_eq_of_commutator_pow hp hp2 (d := x⁻¹ * u * x * u⁻¹) (by group)
      (hdc u).symm (hdc x⁻¹).symm hdp, hup, inv_pow, mul_inv_cancel]

/-- **Core of Quillen's proposition (notebook 1971-11, pp. 70–71).** Let `p` be an odd prime and
`P` a finite `p`-group in which every element `z` with `z ^ p = 1` is central. If
`(x ^ p) ^ p = 1`, that is if `x ^ p ∈ Ω₁(P)`, then `g * x * g⁻¹ * x⁻¹ ∈ Ω₁(P)` for every `g`,
that is `(g * x * g⁻¹ * x⁻¹) ^ p = 1`. -/
theorem conj_commutator_pow_eq_one (hp : p.Prime) (hp2 : p ≠ 2) {P : Type u} [Group P]
    [Finite P] (hP : IsPGroup p P) (hc : ∀ z : P, z ^ p = 1 → z ∈ center P) {x : P}
    (hx : (x ^ p) ^ p = 1) (g : P) : (g * x * g⁻¹ * x⁻¹) ^ p = 1 :=
  conj_commutator_pow_eq_one_aux hp hp2 _ P rfl hP hc x g hx

end Core

section Quotient

variable {p : ℕ} {P : Type u} [Group P] [Finite P]

/-- **Quillen, notebook 1971-11, pp. 70–71**, elementwise. Let `p` be an odd prime and `P` a
finite `p`-group whose elements of order dividing `p` are central. Then every element of order
dividing `p` of `P ⧸ Ω₁(P)` is central. -/
theorem pCentral_quotient (hp : p.Prime) (hp2 : p ≠ 2) (hP : IsPGroup p P)
    (hc : ∀ z : P, z ^ p = 1 → z ∈ center P) :
    ∀ y : P ⧸ omega1 p P, y ^ p = 1 → y ∈ center (P ⧸ omega1 p P) := by
  intro y hy
  induction y using QuotientGroup.induction_on with
  | H x =>
  rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, mem_omega1_iff hc] at hy
  rw [mem_center_iff]
  intro z
  induction z using QuotientGroup.induction_on with
  | H g =>
  rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq_iff_div_mem,
    mem_omega1_iff hc, div_eq_mul_inv, mul_inv_rev, ← mul_assoc]
  exact conj_commutator_pow_eq_one hp hp2 hP hc hy g

/-- **Quillen, notebook 1971-11, pp. 70–71**, as stated on the page: for `p` odd and `P` a finite
`p`-group, `Ω₁(P) ≤ Z(P)` implies `Ω₁(P / Ω₁(P)) ≤ Z(P / Ω₁(P))`. -/
theorem omega1_quotient_le_center (hp : p.Prime) (hp2 : p ≠ 2) (hP : IsPGroup p P)
    (h : omega1 p P ≤ center P) :
    omega1 p (P ⧸ omega1 p P) ≤ center (P ⧸ omega1 p P) := by
  have hc : ∀ z : P, z ^ p = 1 → z ∈ center P := fun z hz => h (Subgroup.subset_closure hz)
  exact (closure_le _).mpr fun y hy => pCentral_quotient hp hp2 hP hc y hy

end Quotient

end Quillen.Notebook1971_11Central
