import Mathlib

/-!
# Quillen, notebook 1974-16, pp. 5–6: the largest perfect subgroup, and perfect subgroups in a central extension

Daniel Quillen's research notebook 1974-16 (Clay Mathematics Institute,
<https://www.claymath.org/library/Quillen/Working_papers/quillen%201974/1974-16.pdf>) reviews the
plus construction.

**p. 5.** He takes the largest perfect subgroup `N` of `π₁ X`, with the remark that a group
generated by perfect subgroups is perfect (« consider a homomorphism to any abelian group »).

**p. 6.** For a fibration `F → E → B`, `π₁ F` is a central extension of its image in `π₁ E`,
and he uses that, for a central extension `E → Q` and a perfect subgroup `N` of `Q`, there is
a unique perfect subgroup of `E` mapping onto `N`, the commutator subgroup of the preimage.

A subgroup `H` is perfect when `⁅H, H⁆ = H` (mathlib's `Subgroup.isPerfect_iff`). This file
proves:

* `commutator_iSup_eq`: **p. 5**: the subgroup generated by a family of perfect subgroups is
  perfect;
* `perfectRadical`, `commutator_perfectRadical`, `le_perfectRadical`,
  `perfectRadical_normal`: the subgroup generated by all perfect subgroups is the largest perfect
  subgroup, and it is normal;
* `commutator_comap_le`, `commutator_comap_perfect`, `map_commutator_comap`,
  `eq_commutator_comap`: **p. 6**: for `f : E →* Q` onto with central kernel and `N ≤ Q` perfect,
  `M = ⁅f⁻¹ N, f⁻¹ N⁆` is perfect, maps onto `N`, and is the only perfect subgroup of `E` that
  maps onto `N`.
-/

namespace Quillen.Notebook1974_16

open Subgroup
open scoped commutatorElement

variable {G : Type*} [Group G]

theorem commutator_self_le (H : Subgroup G) : ⁅H, H⁆ ≤ H :=
  commutator_le.mpr fun a ha b hb => by
    rw [commutatorElement_def]
    exact H.mul_mem (H.mul_mem (H.mul_mem ha hb) (H.inv_mem ha)) (H.inv_mem hb)

/-- **Quillen, notebook 1974-16, p. 5.** A subgroup generated by perfect subgroups is perfect. -/
theorem commutator_iSup_eq {ι : Type*} (H : ι → Subgroup G) (hH : ∀ i, ⁅H i, H i⁆ = H i) :
    ⁅⨆ i, H i, ⨆ i, H i⁆ = ⨆ i, H i := by
  refine le_antisymm (commutator_self_le _) (iSup_le fun i => ?_)
  rw [← hH i]
  exact commutator_mono (le_iSup H i) (le_iSup H i)

variable (G) in
/-- The subgroup generated by all perfect subgroups. -/
def perfectRadical : Subgroup G := ⨆ H : {H : Subgroup G // ⁅H, H⁆ = H}, (H : Subgroup G)

/-- The subgroup generated by all perfect subgroups is perfect. -/
theorem commutator_perfectRadical : ⁅perfectRadical G, perfectRadical G⁆ = perfectRadical G :=
  commutator_iSup_eq _ fun H => H.2

/-- Every perfect subgroup lies in `perfectRadical G`: it is the largest perfect subgroup. -/
theorem le_perfectRadical {H : Subgroup G} (hH : ⁅H, H⁆ = H) : H ≤ perfectRadical G :=
  le_iSup (fun H : {H : Subgroup G // ⁅H, H⁆ = H} => (H : Subgroup G)) ⟨H, hH⟩

/-- The largest perfect subgroup is normal: its conjugates are perfect. -/
theorem perfectRadical_normal : (perfectRadical G).Normal := by
  constructor
  intro n hn g
  have hmap : ((perfectRadical G).map (MulAut.conj g).toMonoidHom) ≤ perfectRadical G := by
    apply le_perfectRadical
    rw [← map_commutator, commutator_perfectRadical]
  exact hmap ⟨n, hn, rfl⟩

section Central

variable {E Q : Type*} [Group E] [Group Q] (f : E →* Q)

/-- The key step: if `f` has central kernel and `M'` maps onto `f(f⁻¹ N)`, then the commutator
subgroup of `f⁻¹ N` lies in that of `M'`: an element of `f⁻¹ N` is an element of `M'` times a
central element, and central factors do not change commutators. -/
theorem commutator_comap_le (hc : f.ker ≤ center E) {N : Subgroup Q} {M' : Subgroup E}
    (hmap : ∀ x ∈ N.comap f, ∃ m ∈ M', f m = f x) :
    ⁅N.comap f, N.comap f⁆ ≤ ⁅M', M'⁆ := by
  have hdec : ∀ x ∈ N.comap f, ∃ m ∈ M', ∃ c ∈ center E, x = m * c := by
    intro x hx
    obtain ⟨m, hm, hmx⟩ := hmap x hx
    refine ⟨m, hm, m⁻¹ * x, hc ?_, by group⟩
    rw [MonoidHom.mem_ker, map_mul, map_inv, hmx, inv_mul_cancel]
  rw [commutator_le]
  intro x hx y hy
  obtain ⟨m₁, hm₁, c₁, hc₁, rfl⟩ := hdec x hx
  obtain ⟨m₂, hm₂, c₂, hc₂, rfl⟩ := hdec y hy
  have e : ⁅m₁ * c₁, m₂ * c₂⁆ = ⁅m₁, m₂⁆ := by
    have h1 := mem_center_iff.mp hc₁
    have h2 := mem_center_iff.mp hc₂
    simp only [commutatorElement_def, mul_inv_rev]
    calc m₁ * c₁ * (m₂ * c₂) * (c₁⁻¹ * m₁⁻¹) * (c₂⁻¹ * m₂⁻¹)
        = m₁ * (c₁ * (m₂ * c₂)) * (c₁⁻¹ * m₁⁻¹) * (c₂⁻¹ * m₂⁻¹) := by group
      _ = m₁ * (m₂ * c₂ * c₁) * (c₁⁻¹ * m₁⁻¹) * (c₂⁻¹ * m₂⁻¹) := by rw [h1]
      _ = m₁ * m₂ * (c₂ * m₁⁻¹) * c₂⁻¹ * m₂⁻¹ := by group
      _ = m₁ * m₂ * (m₁⁻¹ * c₂) * c₂⁻¹ * m₂⁻¹ := by rw [← (h2 m₁⁻¹)]
      _ = m₁ * m₂ * m₁⁻¹ * m₂⁻¹ := by group
  rw [e]
  exact commutator_mem_commutator hm₁ hm₂

variable {f}

theorem exists_of_map_eq {N : Subgroup Q} {M' : Subgroup E} (hM' : M'.map f = N) :
    ∀ x ∈ N.comap f, ∃ m ∈ M', f m = f x := by
  intro x hx
  rw [mem_comap, ← hM'] at hx
  obtain ⟨m, hm, hmx⟩ := hx
  exact ⟨m, hm, hmx⟩

/-- `f(⁅f⁻¹ N, f⁻¹ N⁆) = N` for `f` onto and `N` perfect. -/
theorem map_commutator_comap (hf : Function.Surjective f) {N : Subgroup Q} (hN : ⁅N, N⁆ = N) :
    ⁅N.comap f, N.comap f⁆.map f = N := by
  rw [map_commutator, map_comap_eq_self_of_surjective hf, hN]

/-- **Quillen, notebook 1974-16, p. 6.** For `f` onto with central kernel and `N` perfect,
`⁅f⁻¹ N, f⁻¹ N⁆` is perfect. -/
theorem commutator_comap_perfect (hf : Function.Surjective f) (hc : f.ker ≤ center E)
    {N : Subgroup Q} (hN : ⁅N, N⁆ = N) :
    ⁅⁅N.comap f, N.comap f⁆, ⁅N.comap f, N.comap f⁆⁆ = ⁅N.comap f, N.comap f⁆ :=
  le_antisymm (commutator_self_le _)
    (commutator_comap_le f hc (exists_of_map_eq (map_commutator_comap hf hN)))

/-- **Quillen, notebook 1974-16, p. 6, uniqueness.** For `f` onto with central kernel and `N`
perfect, a perfect subgroup `M'` of `E` with `f(M') = N` is `⁅f⁻¹ N, f⁻¹ N⁆`. -/
theorem eq_commutator_comap (hc : f.ker ≤ center E) {N : Subgroup Q} {M' : Subgroup E}
    (hM' : ⁅M', M'⁆ = M') (hmap : M'.map f = N) :
    M' = ⁅N.comap f, N.comap f⁆ := by
  have hle : M' ≤ N.comap f := by rw [← hmap]; exact le_comap_map f M'
  refine le_antisymm ?_ ?_
  · rw [← hM']; exact commutator_mono hle hle
  · rw [← hM']; exact commutator_comap_le f hc (exists_of_map_eq hmap)

end Central

end Quillen.Notebook1974_16
