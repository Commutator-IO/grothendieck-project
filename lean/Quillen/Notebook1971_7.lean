import Mathlib

/-!
# Quillen, notebook 1971-7, p. 14: the monoid of injections of an infinite set has trivial
# group completion

Daniel Quillen's research notebook 1971-7 (Clay Mathematics Institute,
<https://www.claymath.org/library/Quillen/Working_papers/quillen%201971/1971-7.pdf>), in an entry
dated May 5, 1971, builds a category with the homotopy type of `BΣ∞⁺` out of the monoid `M` of
injective self-maps of an infinite set `S`. One step (p. 14) is that the fundamental group of
the one-object category of `M` vanishes, that is: the group generated by the monoid `M` is
trivial. In our words, his argument: an injection `u` whose image has a complement as large as
`S` defines a « transport » `u_*(θ)` of every `θ ∈ M`, equal to `u θ u⁻¹` on the image of `u` and
to the identity off it; then `u_*(θ) u = u θ`, while `u_*(θ)` agrees with the identity on a large
set and so becomes trivial in the group, whence `θ` does too.

The same statement, for `S = ℕ`, is the first step of Lemma 5.2 of S. Schwede, *On the
homotopy groups of symmetric spectra*, Geom. Topol. 12 (2008), whose proof (credited there to
N. Strickland) uses the same transport. We formalise the statement for an arbitrary infinite
type, with the shortcut of that proof: a second injection `s` with image in the complement of the
image of `u` satisfies `u_*(θ) s = s`, which kills `u_*(θ)` in any group at once.

* `injMonoid S`: the injective maps `S → S`, a submonoid of `Function.End S`;
* `transport t f`: the map equal to `t ∘ f ∘ t⁻¹` on the range of `t`, the identity elsewhere;
* `transport_comp_self`, `transport_apply_of_disjoint`, `transport_injective`: its properties;
* `monoidHom_eq_one`: **every monoid homomorphism from `injMonoid S` to a group is trivial**
  when `S` is infinite;
* `monoidHom_eq_one'`: the same, as an equality of homomorphisms.
-/

namespace Quillen.Notebook1971_7

open Function Cardinal

/-- The monoid of injective self-maps of `S`, under composition, as a submonoid of
`Function.End S`. -/
def injMonoid (S : Type*) : Submonoid (Function.End S) where
  carrier := {f | Injective f}
  one_mem' := injective_id
  mul_mem' := fun {f g} hf hg => by
    change Injective (f ∘ g)
    exact hf.comp hg

variable {S : Type*}

theorem mem_injMonoid {f : Function.End S} : f ∈ injMonoid S ↔ Injective f := Iff.rfl

/-- The transport of `f` along `t` (Quillen's `t_*(f)`, notebook 1971-7, pp. 9 and 14): it acts as
`t ∘ f ∘ t⁻¹` on the range of `t` and as the identity off the range. -/
noncomputable def transport (t f : S → S) : S → S := extend t (t ∘ f) id

/-- `t_*(f) ∘ t = t ∘ f`: the transport behaves like conjugation by `t`. -/
theorem transport_comp_self {t : S → S} (ht : Injective t) (f : S → S) :
    transport t f ∘ t = t ∘ f := by
  funext x
  exact ht.extend_apply _ _ x

/-- The transport fixes every point outside the range of `t`. -/
theorem transport_apply_of_not_mem {t : S → S} (f : S → S) {y : S} (hy : ¬∃ a, t a = y) :
    transport t f y = y :=
  extend_apply' _ _ _ hy

/-- If `s` has image disjoint from that of `t`, then `t_*(f) ∘ s = s`. -/
theorem transport_comp_of_disjoint {t s : S → S} (hts : ∀ a b, t a ≠ s b) (f : S → S) :
    transport t f ∘ s = s := by
  funext b
  exact transport_apply_of_not_mem f (fun ⟨a, ha⟩ => hts a b ha)

/-- The transport of an injection along an injection is injective. -/
theorem transport_injective {t f : S → S} (ht : Injective t) (hf : Injective f) :
    Injective (transport t f) := by
  intro x y hxy
  by_cases hx : ∃ a, t a = x
  · obtain ⟨a, rfl⟩ := hx
    by_cases hy : ∃ b, t b = y
    · obtain ⟨b, rfl⟩ := hy
      have h := hxy
      simp only [transport, ht.extend_apply, comp_apply] at h
      rw [hf (ht h)]
    · rw [transport_apply_of_not_mem f hy, transport, ht.extend_apply, comp_apply] at hxy
      exact absurd ⟨f a, hxy⟩ hy
  · rw [transport_apply_of_not_mem f hx] at hxy
    by_cases hy : ∃ b, t b = y
    · obtain ⟨b, rfl⟩ := hy
      rw [transport, ht.extend_apply, comp_apply] at hxy
      exact absurd ⟨f b, hxy.symm⟩ hx
    · rwa [transport_apply_of_not_mem f hy] at hxy

/-- An infinite type has two injective self-maps with disjoint ranges. -/
theorem exists_disjoint_injections [Infinite S] :
    ∃ t s : S → S, Injective t ∧ Injective s ∧ ∀ a b, t a ≠ s b := by
  have h : #(S ⊕ S) = #S := by
    rw [mk_sum, lift_id, add_eq_self (aleph0_le_mk S)]
  obtain ⟨e⟩ := Cardinal.eq.1 h
  refine ⟨e ∘ Sum.inl, e ∘ Sum.inr, e.injective.comp Sum.inl_injective,
    e.injective.comp Sum.inr_injective, fun a b hab => ?_⟩
  exact Sum.inl_ne_inr (e.injective hab)

/-- **Quillen, notebook 1971-7, p. 14.** If `S` is infinite, every monoid homomorphism from the
monoid of injective self-maps of `S` to a group is trivial: the group generated by this monoid
(the fundamental group of its one-object category) is trivial. -/
theorem monoidHom_eq_one [Infinite S] {G : Type*} [Group G] (φ : injMonoid S →* G)
    (f : injMonoid S) : φ f = 1 := by
  obtain ⟨t, s, ht, hs, hts⟩ := exists_disjoint_injections (S := S)
  let T : injMonoid S := ⟨t, ht⟩
  let Sm : injMonoid S := ⟨s, hs⟩
  let c : injMonoid S := ⟨transport t f.1, transport_injective ht f.2⟩
  -- `c * T = T * f` and `c * Sm = Sm` in the monoid of injections.
  have h1 : c * T = T * f := Subtype.ext (transport_comp_self ht f.1)
  have h2 : c * Sm = Sm := Subtype.ext (transport_comp_of_disjoint hts f.1)
  have hc : φ c = 1 := by
    have := congrArg φ h2
    rw [map_mul] at this
    exact mul_right_cancel (this.trans (one_mul _).symm)
  have := congrArg φ h1
  rw [map_mul, map_mul, hc, one_mul] at this
  exact (mul_left_cancel (this.symm.trans (mul_one _).symm))

/-- **Quillen, notebook 1971-7, p. 14**, as an equality of homomorphisms. -/
theorem monoidHom_eq_one' [Infinite S] {G : Type*} [Group G] (φ : injMonoid S →* G) :
    φ = 1 :=
  MonoidHom.ext fun f => monoidHom_eq_one φ f

end Quillen.Notebook1971_7
