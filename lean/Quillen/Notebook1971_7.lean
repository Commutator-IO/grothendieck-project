import Mathlib

/-!
# Quillen, notebook 1971-7, p. 14: the monoid of injections of an infinite set has trivial
# group completion

Daniel Quillen's research notebook 1971-7 (Clay Mathematics Institute,
<https://www.claymath.org/library/Quillen/Working_papers/quillen%201971/1971-7.pdf>), in an entry
dated May 5, 1971, builds a category with the homotopy type of `BΣ∞⁺` out of the monoid `M` of
injective self-maps of an infinite set `S`. One step (p. 14) is that the fundamental group of
the one-object category of `M` vanishes, that is: the group generated by the monoid `M` is
trivial. In our words, his argument: an injection `u` whose image has a complement as large as
`S` defines a « transport » `u_*(θ)` of every `θ ∈ M`, equal to `u θ u⁻¹` on the image of `u` and
to the identity off it; then `u_*(θ) u = u θ`, while `u_*(θ)` agrees with the identity on a large
set and so becomes trivial in the group, whence `θ` does too.

The same statement, for `S = ℕ`, is the first step of Lemma 5.2 of S. Schwede, *On the
homotopy groups of symmetric spectra*, Geom. Topol. 12 (2008), whose proof (credited there to
N. Strickland) uses the same transport. We formalise the statement for an arbitrary infinite
type, with the shortcut of that proof: a second injection `s` with image in the complement of the
image of `u` satisfies `u_*(θ) s = s`, which kills `u_*(θ)` in any group at once.

* `injMonoid S`: the injective maps `S → S`, a submonoid of `Function.End S`;
* `transport t f`: the map equal to `t ∘ f ∘ t⁻¹` on the range of `t`, the identity elsewhere;
* `transport_comp_self`, `transport_apply_of_disjoint`, `transport_injective`: its properties;
* `monoidHom_eq_one`: **every monoid homomorphism from `injMonoid S` to a group is trivial**
  when `S` is infinite;
* `monoidHom_eq_one'`: the same, as an equality of homomorphisms.
-/

namespace Quillen.Notebook1971_7

open Function Cardinal

/-- The monoid of injective self-maps of `S`, under composition, as a submonoid of
`Function.End S`. -/
def injMonoid (S : Type*) : Submonoid (Function.End S) where
  carrier := {f | Injective f}
  one_mem' := injective_id
  mul_mem' := fun hf hg => hf.comp hg

variable {S : Type*}

theorem mem_injMonoid {f : Function.End S} : f ∈ injMonoid S ↔ Injective f := Iff.rfl

/-- The transport of `f` along `t` (Quillen's `t_*(f)`, notebook 1971-7, pp. 9 and 14): it acts as
`t ∘ f ∘ t⁻¹` on the range of `t` and as the identity off the range. -/
noncomputable def transport (t f : S → S) : S → S := extend t (t ∘ f) id

/-- `t_*(f) ∘ t = t ∘ f`: the transport behaves like conjugation by `t`. -/
theorem transport_comp_self {t : S → S} (ht : Injective t) (f : S → S) :
    transport t f ∘ t = t ∘ f :=
  funext fun x => ht.extend_apply _ _ x

/-- The transport fixes every point outside the range of `t`. -/
theorem transport_apply_of_not_mem {t : S → S} (f : S → S) {y : S} (hy : ¬∃ a, t a = y) :
    transport t f y = y :=
  extend_apply' _ _ _ hy

/-- If `s` has image disjoint from that of `t`, then `t_*(f) ∘ s = s`. -/
theorem transport_comp_of_disjoint {t s : S → S} (hts : ∀ a b, t a ≠ s b) (f : S → S) :
    transport t f ∘ s = s :=
  funext fun b => transport_apply_of_not_mem f fun ⟨a, ha⟩ => hts a b ha

/-- The transport of an injection along an injection is injective. -/
theorem transport_injective {t f : S → S} (ht : Injective t) (hf : Injective f) :
    Injective (transport t f) := by
  intro x y hxy
  by_cases hx : ∃ a, t a = x
  · obtain ⟨a, rfl⟩ := hx
    by_cases hy : ∃ b, t b = y
    · obtain ⟨b, rfl⟩ := hy
      simp only [transport, ht.extend_apply, comp_apply] at hxy
      rw [hf (ht hxy)]
    · rw [transport_apply_of_not_mem f hy, transport, ht.extend_apply, comp_apply] at hxy
      exact absurd ⟨f a, hxy⟩ hy
  · rw [transport_apply_of_not_mem f hx] at hxy
    by_cases hy : ∃ b, t b = y
    · obtain ⟨b, rfl⟩ := hy
      rw [transport, ht.extend_apply, comp_apply] at hxy
      exact absurd ⟨f b, hxy.symm⟩ hx
    · rwa [transport_apply_of_not_mem f hy] at hxy

/-- An infinite type has two injective self-maps with disjoint ranges. -/
theorem exists_disjoint_injections [Infinite S] :
    ∃ t s : S → S, Injective t ∧ Injective s ∧ ∀ a b, t a ≠ s b := by
  obtain ⟨e⟩ := Cardinal.eq.1 (by rw [mk_sum, lift_id, add_eq_self (aleph0_le_mk S)] :
    #(S ⊕ S) = #S)
  exact ⟨e ∘ Sum.inl, e ∘ Sum.inr, e.injective.comp Sum.inl_injective,
    e.injective.comp Sum.inr_injective, fun a b hab => Sum.inl_ne_inr (e.injective hab)⟩

/-- **Quillen, notebook 1971-7, p. 14.** If `S` is infinite, every monoid homomorphism from the
monoid of injective self-maps of `S` to a group is trivial: the group generated by this monoid
(the fundamental group of its one-object category) is trivial. -/
theorem monoidHom_eq_one [Infinite S] {G : Type*} [Group G] (φ : injMonoid S →* G)
    (f : injMonoid S) : φ f = 1 := by
  obtain ⟨t, s, ht, hs, hts⟩ := exists_disjoint_injections (S := S)
  let T : injMonoid S := ⟨t, ht⟩
  let Sm : injMonoid S := ⟨s, hs⟩
  let c : injMonoid S := ⟨transport t f.1, transport_injective ht f.2⟩
  -- `c * T = T * f` and `c * Sm = Sm` in the monoid of injections.
  have h1 : c * T = T * f := Subtype.ext (transport_comp_self ht f.1)
  have h2 : c * Sm = Sm := Subtype.ext (transport_comp_of_disjoint hts f.1)
  have hc : φ c = 1 := by simpa using congrArg φ h2
  simpa [hc] using congrArg φ h1

/-- **Quillen, notebook 1971-7, p. 14**, as an equality of homomorphisms. -/
theorem monoidHom_eq_one' [Infinite S] {G : Type*} [Group G] (φ : injMonoid S →* G) :
    φ = 1 :=
  MonoidHom.ext fun f => monoidHom_eq_one φ f

/-! ## Notebook 1971-7, pp. 21–24: injective monotone self-maps of `ℚ`

In an entry on `BGL(R)^+` built from the category of finite linearly ordered sets and injective
monotone maps, Quillen takes `S = ℚ` and the monoid `M` of injective monotone self-maps of `S`,
and shows (p. 23) that `π₁` of its one-object category vanishes, with the transport argument of
p. 14 along an embedding whose image is an interval. We prove: for every countable dense linear
order without endpoints (in particular `ℚ`), every monoid homomorphism from `M` to a group is
trivial. For a linear order, the injective monotone maps are the strictly monotone ones.

The key point beyond the unordered case: if the range of `t` is order-convex, the transport
`t_*(f)` is again strictly monotone. Two embeddings with disjoint ranges are obtained from
Cantor's back-and-forth isomorphisms `α ≃o Iio a` and `α ≃o Ioi a`.

* `strictMonoMonoid α`: the strictly monotone self-maps of `α`, a submonoid of `Function.End α`;
* `transport_strictMono`: transport along an embedding with convex range is strictly monotone;
* `strictMono_monoidHom_eq_one_of_embeddings`: the conclusion, from a pair of such embeddings;
* `strictMono_monoidHom_eq_one`: **every monoid homomorphism from `strictMonoMonoid α` to a group
  is trivial**, for `α` countable, densely ordered, without endpoints and nonempty;
* `rat_monoidHom_eq_one`: the case `α = ℚ` of the notebook.
-/

/-- The monoid of strictly monotone (for a linear order: injective monotone) self-maps of `α`,
as a submonoid of `Function.End α`. -/
def strictMonoMonoid (α : Type*) [Preorder α] : Submonoid (Function.End α) where
  carrier := {f | StrictMono f}
  one_mem' := strictMono_id
  mul_mem' := fun hf hg => hf.comp hg

section Ordered

variable {α : Type*} [LinearOrder α]

theorem mem_strictMonoMonoid {f : Function.End α} : f ∈ strictMonoMonoid α ↔ StrictMono f :=
  Iff.rfl

/-- Transport along a strictly monotone `t` whose range is order-convex (every point off the
range lies below all of it or above all of it) preserves strict monotonicity. -/
theorem transport_strictMono {t f : α → α} (ht : StrictMono t) (hf : StrictMono f)
    (hconv : ∀ y, (¬∃ a, t a = y) → (∀ a, y < t a) ∨ (∀ a, t a < y)) :
    StrictMono (transport t f) := by
  intro x y hxy
  by_cases hx : ∃ a, t a = x
  · obtain ⟨a, rfl⟩ := hx
    rw [transport, ht.injective.extend_apply, comp_apply]
    by_cases hy : ∃ b, t b = y
    · obtain ⟨b, rfl⟩ := hy
      rw [ht.injective.extend_apply, comp_apply]
      exact ht (hf (ht.lt_iff_lt.1 hxy))
    · rw [extend_apply' _ _ _ hy, id]
      rcases hconv y hy with h | h
      · exact absurd hxy (lt_asymm (h a))
      · exact h _
  · rw [transport_apply_of_not_mem f hx]
    by_cases hy : ∃ b, t b = y
    · obtain ⟨b, rfl⟩ := hy
      rw [transport, ht.injective.extend_apply, comp_apply]
      rcases hconv x hx with h | h
      · exact h _
      · exact absurd hxy (lt_asymm (h b))
    · rwa [transport_apply_of_not_mem f hy]

/-- If `α` has two strictly monotone self-maps with disjoint ranges, the first with order-convex
range, then every monoid homomorphism from `strictMonoMonoid α` to a group is trivial. -/
theorem strictMono_monoidHom_eq_one_of_embeddings {t s : α → α} (ht : StrictMono t)
    (hs : StrictMono s) (hts : ∀ a b, t a ≠ s b)
    (hconv : ∀ y, (¬∃ a, t a = y) → (∀ a, y < t a) ∨ (∀ a, t a < y))
    {G : Type*} [Group G] (φ : strictMonoMonoid α →* G) (f : strictMonoMonoid α) : φ f = 1 := by
  let T : strictMonoMonoid α := ⟨t, ht⟩
  let Sm : strictMonoMonoid α := ⟨s, hs⟩
  let c : strictMonoMonoid α := ⟨transport t f.1, transport_strictMono ht f.2 hconv⟩
  have h1 : c * T = T * f := Subtype.ext (transport_comp_self ht.injective f.1)
  have h2 : c * Sm = Sm := Subtype.ext (transport_comp_of_disjoint hts f.1)
  have hc : φ c = 1 := by simpa using congrArg φ h2
  simpa [hc] using congrArg φ h1

variable [Countable α] [DenselyOrdered α] [NoMinOrder α] [NoMaxOrder α] [Nonempty α]

/-- A countable dense linear order without endpoints has two order embeddings into itself with
disjoint ranges, the first onto an initial ray `Iio a`. -/
theorem exists_disjoint_strictMono :
    ∃ t s : α → α, StrictMono t ∧ StrictMono s ∧ (∀ a b, t a ≠ s b) ∧
      ∀ y, (¬∃ a, t a = y) → (∀ a, y < t a) ∨ (∀ a, t a < y) := by
  obtain ⟨a⟩ := ‹Nonempty α›
  obtain ⟨e⟩ := Order.iso_of_countable_dense α (Set.Iio a)
  obtain ⟨e'⟩ := Order.iso_of_countable_dense α (Set.Ioi a)
  refine ⟨fun x => (e x : α), fun x => (e' x : α), fun x y h => e.strictMono h,
    fun x y h => e'.strictMono h, fun x y h => ?_, fun y hy => Or.inr fun x => ?_⟩
  · exact (lt_trans (e x).2 (e' y).2).ne h
  · -- `y` is not in `Iio a`, so `a ≤ y`
    exact lt_of_lt_of_le (e x).2 (not_lt.1 fun hlt => hy ⟨e.symm ⟨y, hlt⟩, by simp⟩)

/-- **Quillen, notebook 1971-7, p. 23.** For a countable dense linear order `α` without endpoints
(Quillen's case: `α = ℚ`), every monoid homomorphism from the monoid of injective monotone
self-maps of `α` to a group is trivial: `π₁` of its one-object category vanishes. -/
theorem strictMono_monoidHom_eq_one {G : Type*} [Group G] (φ : strictMonoMonoid α →* G)
    (f : strictMonoMonoid α) : φ f = 1 := by
  obtain ⟨t, s, ht, hs, hts, hconv⟩ := exists_disjoint_strictMono (α := α)
  exact strictMono_monoidHom_eq_one_of_embeddings ht hs hts hconv φ f

/-- **Quillen, notebook 1971-7, p. 23**, for `ℚ`, as an equality of homomorphisms. -/
theorem rat_monoidHom_eq_one {G : Type*} [Group G] (φ : strictMonoMonoid ℚ →* G) : φ = 1 :=
  MonoidHom.ext fun f => strictMono_monoidHom_eq_one φ f

end Ordered

end Quillen.Notebook1971_7
