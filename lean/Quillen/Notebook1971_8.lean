import Mathlib

/-!
# Quillen, notebook 1971-8, p. 8: `G × G` modulo the normal closure of the diagonal is `G` made abelian

Daniel Quillen's research notebook 1971-8 (Clay Mathematics Institute,
<https://www.claymath.org/library/Quillen/Working_papers/quillen%201971/1971-8.pdf>) studies, in
its first pages, the group completion of a topological monoid `M` through a space built from
`M × M` and the diagonal action of `M`. On p. 8 he shows that, on a local system there, the two
copies of the fundamental group act through a quotient in which the diagonal is killed, and
concludes that the action is abelian, because the quotient of `G × G` by the normal subgroup
generated by the diagonal `ΔG` is the abelianization of `G`.

This file proves that group-theoretic statement, for any group `G`.

* `diagClosure G`: the normal closure of the diagonal `{(g, g)}` in `G × G`;
* `toAb G`: the homomorphism `(x, y) ↦ [x] [y]⁻¹` from `G × G` to the abelianization;
* `commutator_le_comap`: `(c, 1)` lies in `diagClosure G` for `c` in the commutator subgroup,
  from `(a, 1) (b, b) (a, 1)⁻¹ (b, b)⁻¹ = ([a, b], 1)`;
* `ker_toAb`, `toAb_surjective`: the kernel of `toAb G` is `diagClosure G`, and it is onto;
* `quotientEquiv`: **the statement of the page**, `(G × G) ⧸ diagClosure G ≃* Abelianization G`.
-/

namespace Quillen.Notebook1971_8

variable (G : Type*) [Group G]

/-- The normal subgroup of `G × G` generated by the diagonal. -/
abbrev diagClosure : Subgroup (G × G) :=
  Subgroup.normalClosure (Set.range fun g : G => (g, g))

/-- The homomorphism `(x, y) ↦ [x] [y]⁻¹` from `G × G` to the abelianization of `G`. -/
def toAb : G × G →* Abelianization G :=
  (Abelianization.of.comp (MonoidHom.fst G G)) * (Abelianization.of.comp (MonoidHom.snd G G))⁻¹

@[simp]
theorem toAb_apply (x y : G) :
    toAb G (x, y) = Abelianization.of x * (Abelianization.of y)⁻¹ := rfl

/-- For `c` in the commutator subgroup, `(c, 1)` lies in the normal closure of the diagonal. -/
theorem commutator_le_comap :
    commutator G ≤ (diagClosure G).comap (MonoidHom.inl G G) := by
  rw [commutator_eq_closure, Subgroup.closure_le]
  rintro _ ⟨a, b, rfl⟩
  have hb : (b, b) ∈ diagClosure G := Subgroup.subset_normalClosure ⟨b, rfl⟩
  simpa [commutatorElement_def] using (diagClosure G).mul_mem
    (Subgroup.normalClosure_normal.conj_mem _ hb (a, 1)) ((diagClosure G).inv_mem hb)

/-- The kernel of `(x, y) ↦ [x] [y]⁻¹` is the normal closure of the diagonal. -/
theorem ker_toAb : (toAb G).ker = diagClosure G := by
  refine le_antisymm ?_ (Subgroup.normalClosure_le_normal (by rintro _ ⟨g, rfl⟩; simp))
  rintro ⟨x, y⟩ h
  have h1 : (x * y⁻¹, (1 : G)) ∈ diagClosure G := commutator_le_comap G
    (by rwa [← Abelianization.ker_of, MonoidHom.mem_ker, map_mul, map_inv])
  simpa using (diagClosure G).mul_mem h1 (Subgroup.subset_normalClosure ⟨y, rfl⟩)

/-- The homomorphism `(x, y) ↦ [x] [y]⁻¹` is onto. -/
theorem toAb_surjective : Function.Surjective (toAb G) := by
  intro z
  obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective z
  exact ⟨(x, 1), by simp; rfl⟩

/-- **Quillen, notebook 1971-8, p. 8.** The quotient of `G × G` by the normal subgroup
generated by the diagonal is the abelianization of `G`, by `(x, y) ↦ [x] [y]⁻¹`. -/
noncomputable def quotientEquiv : (G × G) ⧸ diagClosure G ≃* Abelianization G :=
  (QuotientGroup.quotientMulEquivOfEq (ker_toAb G).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective (toAb G) (toAb_surjective G))

@[simp]
theorem quotientEquiv_mk (x y : G) :
    quotientEquiv G (QuotientGroup.mk (x, y)) =
      Abelianization.of x * (Abelianization.of y)⁻¹ := rfl

end Quillen.Notebook1971_8
