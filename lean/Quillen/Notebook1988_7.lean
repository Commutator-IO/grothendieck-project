import Mathlib

/-!
# Quillen, notebook 1988-7: the idempotent of an index problem; two involutions

Daniel Quillen's research notebook 1988-7 (Clay Mathematics Institute,
<https://www.claymath.org/library/Quillen/Working_papers/quillen%201988/1988-7.pdf>) builds, on
p. 30, the idempotent representing the index of `p` when `qp = 1 − x` and `pq = 1 − y` (`x, y`
"small", e.g. trace class), and compares on p. 33 two involutions `F, ε`.

* `mul_x`, `x_mul`: `px = yp` and `xq = qy`;
* `qt_mul`, `mul_qt`: with `q̃ = (1 + x + ⋯ + x^{2n−1}) q`, `q̃p = 1 − x^{2n}` and
  `pq̃ = 1 − y^{2n}`;
* `row_mul_col`: the row `(q̃, xⁿ)` times the column `(p; xⁿ)` is `1`;
* `isIdempotentElem_e`: hence `e = (p; xⁿ)(q̃, xⁿ)` is idempotent, and `e_entries` lists its
  entries `pq̃ = 1 − y^{2n}`, `pxⁿ`, `xⁿq̃`, `x^{2n}`, so that `e − diag(1, 0)` has entries in the
  ideal generated by `x` and `y`.
* p. 33: for `F² = ε² = 1`, `(F − ε)² = 2 − Fε − εF`, and `F`, `ε` commute with `(F − ε)²`
  (`sub_sq_eq`, `commute_sub_sq_left`, `commute_sub_sq_right`).

Any ring; `x` and `y` need not commute with anything.
-/

namespace Quillen.Notebook1988_7

open Matrix

variable {R : Type*} [Ring R] {p q x y : R}

theorem mul_x (hx : q * p = 1 - x) (hy : p * q = 1 - y) : p * x = y * p := by
  have ex : x = 1 - q * p := by rw [hx]; abel
  have ey : y = 1 - p * q := by rw [hy]; abel
  rw [ex, ey]
  noncomm_ring

theorem x_mul (hx : q * p = 1 - x) (hy : p * q = 1 - y) : x * q = q * y := by
  have ex : x = 1 - q * p := by rw [hx]; abel
  have ey : y = 1 - p * q := by rw [hy]; abel
  rw [ex, ey]
  noncomm_ring

/-- `q̃ = (1 + x + ⋯ + x^{2n−1}) q`. -/
def qt (q x : R) (n : ℕ) : R := (∑ k ∈ Finset.range (2 * n), x ^ k) * q

theorem qt_mul (hx : q * p = 1 - x) (n : ℕ) : qt q x n * p = 1 - x ^ (2 * n) := by
  rw [qt, mul_assoc, hx, geom_sum_mul_neg]

theorem mul_qt (hx : q * p = 1 - x) (hy : p * q = 1 - y) (n : ℕ) :
    p * qt q x n = 1 - y ^ (2 * n) := by
  have hs : SemiconjBy p x y := mul_x hx hy
  rw [qt, ← mul_assoc, Finset.mul_sum]
  have : ∀ k, p * x ^ k = y ^ k * p := fun k => (hs.pow_right k).eq
  simp_rw [this]
  rw [← Finset.sum_mul, mul_assoc, hy, geom_sum_mul_neg]

/-- The column `(p; xⁿ)`. -/
def col (p x : R) (n : ℕ) : Matrix (Fin 2) (Fin 1) R := !![p; x ^ n]

/-- The row `(q̃, xⁿ)`. -/
def row (q x : R) (n : ℕ) : Matrix (Fin 1) (Fin 2) R := !![qt q x n, x ^ n]

theorem row_mul_col (hx : q * p = 1 - x) (n : ℕ) : row q x n * col p x n = 1 := by
  ext i j
  fin_cases i; fin_cases j
  simp [row, col, Matrix.mul_apply, Fin.sum_univ_two, qt_mul hx, ← pow_add, two_mul]

/-- The idempotent `e = (p; xⁿ)(q̃, xⁿ)`. -/
def e (p q x : R) (n : ℕ) : Matrix (Fin 2) (Fin 2) R := col p x n * row q x n

theorem isIdempotentElem_e (hx : q * p = 1 - x) (n : ℕ) : IsIdempotentElem (e p q x n) := by
  unfold IsIdempotentElem e
  rw [Matrix.mul_assoc, ← Matrix.mul_assoc (row q x n), row_mul_col hx, Matrix.one_mul]

theorem e_entries (hx : q * p = 1 - x) (hy : p * q = 1 - y) (n : ℕ) :
    e p q x n = !![1 - y ^ (2 * n), p * x ^ n; x ^ n * qt q x n, x ^ (2 * n)] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [e, row, col, Matrix.mul_apply, mul_qt hx hy, ← pow_add, two_mul]

section Involutions

variable {F ε : R}

theorem sub_sq_eq (hF : F * F = 1) (hε : ε * ε = 1) :
    (F - ε) * (F - ε) = 2 - F * ε - ε * F := by
  have : (F - ε) * (F - ε) = F * F + ε * ε - F * ε - ε * F := by noncomm_ring
  rw [this, hF, hε, one_add_one_eq_two]

theorem commute_sub_sq_left (hF : F * F = 1) (hε : ε * ε = 1) :
    Commute F ((F - ε) * (F - ε)) := by
  rw [Commute, SemiconjBy, sub_sq_eq hF hε]
  have e1 : F * (2 - F * ε - ε * F) = 2 * F - (F * F) * ε - F * ε * F := by noncomm_ring
  have e2 : (2 - F * ε - ε * F) * F = 2 * F - F * ε * F - ε * (F * F) := by noncomm_ring
  rw [e1, e2, hF]
  noncomm_ring

theorem commute_sub_sq_right (hF : F * F = 1) (hε : ε * ε = 1) :
    Commute ε ((F - ε) * (F - ε)) := by
  rw [Commute, SemiconjBy, sub_sq_eq hF hε]
  have e1 : ε * (2 - F * ε - ε * F) = 2 * ε - ε * F * ε - (ε * ε) * F := by noncomm_ring
  have e2 : (2 - F * ε - ε * F) * ε = 2 * ε - F * (ε * ε) - ε * F * ε := by noncomm_ring
  rw [e1, e2, hε]
  noncomm_ring

end Involutions

end Quillen.Notebook1988_7
