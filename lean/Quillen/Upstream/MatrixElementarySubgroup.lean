import Mathlib

/-!
# Elementary matrices over a noncommutative ring: perfectness and the Whitehead lemma

Declarations proofs of this repository (`Quillen.Notebook1968_15` and `Quillen.Notebook1968_16`,
the plus construction applied to `E(A)`) needed and that Mathlib does not have at the pinned
revision. Mathlib's `Matrix.transvection` and `Matrix.TransvectionStruct` require a commutative
ring; here the ring `A` is any ring with unit.

* `one_add_mul_one_add_mul_one_sub_mul_one_sub`: the ring identity
  `(1 + X)(1 + Y)(1 - X)(1 - Y) = 1 + XY` when `X² = Y² = YX = 0` and `XYX = XYY = 0`;
* `Matrix.transvectionUnit`: the elementary matrix `1 + a eᵢⱼ`, `i ≠ j`, as a unit;
* `Matrix.commutator_transvectionUnit`: `⁅e_ik(a), e_kj(b)⁆ = e_ij(a b)` for `i, k, j` distinct;
* `Matrix.elementarySubgroup`: the subgroup `E(n, A)` generated by the elementary matrices;
* `Matrix.isPerfect_elementarySubgroup`: `E(n, A)` is perfect when `n` has at least three
  elements;
* `Matrix.blockUpperUnit`, `Matrix.blockLowerUnit`: the block unipotent matrices
  `[[1, B], [0, 1]]` and `[[1, 0], [C, 1]]`, as units, which lie in `E(n ⊕ n, A)`;
* `Matrix.exists_mem_elementarySubgroup_fromBlocks_inv`: the Whitehead lemma,
  `diag(θ, θ⁻¹) ∈ E(n ⊕ n, A)` for a unit `θ`;
* `Matrix.exists_mem_elementarySubgroup_fromBlocks_commutator`: `diag(θ η θ⁻¹ η⁻¹, 1)` lies in
  `E(n ⊕ n, A)`.

Drop a declaration once Mathlib has it.
-/

open scoped commutatorElement

/-- The ring identity behind the commutator formula: if `X² = Y² = YX = 0`, `XY = Z` and
`ZX = ZY = 0`, then `(1 + X)(1 + Y)(1 - X)(1 - Y) = 1 + Z`. -/
theorem one_add_mul_one_add_mul_one_sub_mul_one_sub {R : Type*} [Ring R] {X Y Z : R}
    (hXX : X * X = 0) (hYY : Y * Y = 0) (hYX : Y * X = 0) (hXY : X * Y = Z) (hZX : Z * X = 0)
    (hZY : Z * Y = 0) : (1 + X) * (1 + Y) * (1 - X) * (1 - Y) = 1 + Z := by
  have h1 : (1 + X) * (1 + Y) = 1 + X + Y + Z := by
    rw [← hXY]; noncomm_ring
  have h2 : (1 + X + Y + Z) * (1 - X) = 1 + Y + Z := by
    simp only [add_mul, mul_sub, one_mul, mul_one, hXX, hYX, hZX]; abel
  have h3 : (1 + Y + Z) * (1 - Y) = 1 + Z := by
    simp only [add_mul, mul_sub, one_mul, mul_one, hYY, hZY]; abel
  rw [h1, h2, h3]

namespace Matrix

section Elementary

variable {n : Type*} [DecidableEq n] [Fintype n] {A : Type*} [Ring A]

/-- The elementary matrix `1 + a eᵢⱼ`, `i ≠ j`, as a unit of the matrix ring; its inverse is
`1 - a eᵢⱼ`. -/
def transvectionUnit {i j : n} (h : i ≠ j) (a : A) : (Matrix n n A)ˣ where
  val := 1 + single i j a
  inv := 1 + single i j (-a)
  val_inv := by
    have h0 : single i j a * single i j (-a) = (0 : Matrix n n A) :=
      single_mul_single_of_ne (h := h.symm) ..
    rw [add_mul, mul_add, mul_add, one_mul, mul_one, one_mul, h0, add_zero, add_assoc,
      ← single_add, neg_add_cancel, single_zero, add_zero]
  inv_val := by
    have h0 : single i j (-a) * single i j a = (0 : Matrix n n A) :=
      single_mul_single_of_ne (h := h.symm) ..
    rw [add_mul, mul_add, mul_add, one_mul, mul_one, one_mul, h0, add_zero, add_assoc,
      ← single_add, add_neg_cancel, single_zero, add_zero]

@[simp] theorem transvectionUnit_val {i j : n} (h : i ≠ j) (a : A) :
    ((transvectionUnit h a : (Matrix n n A)ˣ) : Matrix n n A) = 1 + single i j a := rfl

@[simp] theorem transvectionUnit_inv_val {i j : n} (h : i ≠ j) (a : A) :
    (((transvectionUnit h a)⁻¹ : (Matrix n n A)ˣ) : Matrix n n A) = 1 - single i j a := by
  show 1 + single i j (-a) = _
  rw [← single_neg, ← sub_eq_add_neg]

/-- The commutator formula: for `i, k, j` pairwise distinct,
`⁅1 + a eᵢₖ, 1 + b eₖⱼ⁆ = 1 + a b eᵢⱼ`. -/
theorem commutator_transvectionUnit {i j k : n} (hik : i ≠ k) (hkj : k ≠ j) (hij : i ≠ j)
    (a b : A) :
    ⁅transvectionUnit hik a, transvectionUnit hkj b⁆ = transvectionUnit hij (a * b) := by
  ext : 1
  rw [commutatorElement_def]
  simp only [Units.val_mul, transvectionUnit_val, transvectionUnit_inv_val]
  exact one_add_mul_one_add_mul_one_sub_mul_one_sub (single_mul_single_of_ne (h := hik.symm) ..)
    (single_mul_single_of_ne (h := hkj.symm) ..) (single_mul_single_of_ne (h := hij.symm) ..)
    (single_mul_single_same ..) (single_mul_single_of_ne (h := hij.symm) ..)
    (single_mul_single_of_ne (h := hkj.symm) ..)

variable (n A) in
/-- The elementary subgroup `E(n, A)` of the units of `Matrix n n A`, generated by the
`1 + a eᵢⱼ`, `i ≠ j`. -/
def elementarySubgroup : Subgroup (Matrix n n A)ˣ :=
  Subgroup.closure {g | ∃ (i j : n) (h : i ≠ j) (a : A), g = transvectionUnit h a}

theorem transvectionUnit_mem_elementarySubgroup {i j : n} (h : i ≠ j) (a : A) :
    transvectionUnit h a ∈ elementarySubgroup n A :=
  Subgroup.subset_closure ⟨i, j, h, a, rfl⟩

/-- `E(n, A)` is perfect as soon as `n` has at least three elements: every generator
`1 + a eᵢⱼ` is the commutator of `1 + a eᵢₖ` and `1 + eₖⱼ` for a third index `k`. -/
theorem isPerfect_elementarySubgroup (h3 : 3 ≤ Fintype.card n) :
    Group.IsPerfect (elementarySubgroup n A) := by
  rw [Subgroup.isPerfect_iff]
  refine le_antisymm (Subgroup.commutator_le.2 fun g hg h hh => ?_) ((Subgroup.closure_le _).2 ?_)
  · exact mul_mem (mul_mem (mul_mem hg hh) (inv_mem hg)) (inv_mem hh)
  rintro g ⟨i, j, hij, a, rfl⟩
  obtain ⟨k, hki, hkj⟩ : ∃ k, k ≠ i ∧ k ≠ j := by
    by_contra hcon
    push Not at hcon
    have hsub : (Finset.univ : Finset n) ⊆ {i, j} := fun x _ => by
      by_cases hx : x = i
      · simp [hx]
      · simp [hcon x hx]
    have := (Finset.card_le_card hsub).trans (Finset.card_insert_le _ _)
    rw [Finset.card_univ, Finset.card_singleton] at this
    omega
  rw [← mul_one a, ← commutator_transvectionUnit hki.symm hkj hij a 1]
  exact Subgroup.commutator_mem_commutator (transvectionUnit_mem_elementarySubgroup _ a)
    (transvectionUnit_mem_elementarySubgroup _ 1)

end Elementary

section Whitehead

variable {n : Type*} [DecidableEq n] [Fintype n] {A : Type*} [Ring A]

/-- The unipotent block matrix `[[1, B], [0, 1]]`, a unit with inverse `[[1, -B], [0, 1]]`. -/
def blockUpperUnit (B : Matrix n n A) : (Matrix (n ⊕ n) (n ⊕ n) A)ˣ where
  val := fromBlocks 1 B 0 1
  inv := fromBlocks 1 (-B) 0 1
  val_inv := by simp [fromBlocks_multiply, ← fromBlocks_one]
  inv_val := by simp [fromBlocks_multiply, ← fromBlocks_one]

/-- The unipotent block matrix `[[1, 0], [C, 1]]`, a unit with inverse `[[1, 0], [-C, 1]]`. -/
def blockLowerUnit (C : Matrix n n A) : (Matrix (n ⊕ n) (n ⊕ n) A)ˣ where
  val := fromBlocks 1 0 C 1
  inv := fromBlocks 1 0 (-C) 1
  val_inv := by simp [fromBlocks_multiply, ← fromBlocks_one]
  inv_val := by simp [fromBlocks_multiply, ← fromBlocks_one]

@[simp] theorem blockUpperUnit_val (B : Matrix n n A) :
    ((blockUpperUnit B : (Matrix (n ⊕ n) (n ⊕ n) A)ˣ) : Matrix (n ⊕ n) (n ⊕ n) A) =
      fromBlocks 1 B 0 1 :=
  rfl

@[simp] theorem blockLowerUnit_val (C : Matrix n n A) :
    ((blockLowerUnit C : (Matrix (n ⊕ n) (n ⊕ n) A)ˣ) : Matrix (n ⊕ n) (n ⊕ n) A) =
      fromBlocks 1 0 C 1 :=
  rfl

theorem blockUpperUnit_add (B C : Matrix n n A) :
    blockUpperUnit (B + C) = blockUpperUnit B * blockUpperUnit C := by
  ext : 1; simp [fromBlocks_multiply, add_comm]

theorem blockLowerUnit_add (B C : Matrix n n A) :
    blockLowerUnit (B + C) = blockLowerUnit B * blockLowerUnit C := by
  ext : 1; simp [fromBlocks_multiply, add_comm]

theorem blockUpperUnit_single (i j : n) (a : A) :
    blockUpperUnit (single i j a) =
      transvectionUnit (Sum.inl_ne_inr : (Sum.inl i : n ⊕ n) ≠ Sum.inr j) a := by
  ext : 1
  ext p q
  rcases p with p | p <;> rcases q with q | q <;>
    simp [fromBlocks, single_apply, one_apply, eq_comm]

theorem blockLowerUnit_single (i j : n) (a : A) :
    blockLowerUnit (single i j a) =
      transvectionUnit (Sum.inr_ne_inl : (Sum.inr i : n ⊕ n) ≠ Sum.inl j) a := by
  ext : 1
  ext p q
  rcases p with p | p <;> rcases q with q | q <;>
    simp [fromBlocks, single_apply, one_apply, eq_comm]

@[simp] theorem blockUpperUnit_zero : blockUpperUnit (0 : Matrix n n A) = 1 := by
  ext : 1; simp [← fromBlocks_one]

@[simp] theorem blockLowerUnit_zero : blockLowerUnit (0 : Matrix n n A) = 1 := by
  ext : 1; simp [← fromBlocks_one]

theorem blockUpperUnit_sum_mem_elementarySubgroup {ι : Type*} (s : Finset ι)
    (f : ι → Matrix n n A) (hf : ∀ i, blockUpperUnit (f i) ∈ elementarySubgroup (n ⊕ n) A) :
    blockUpperUnit (∑ i ∈ s, f i) ∈ elementarySubgroup (n ⊕ n) A := by
  classical
  induction s using Finset.induction_on with
  | empty => rw [Finset.sum_empty, blockUpperUnit_zero]; exact one_mem _
  | insert i s hi ih => rw [Finset.sum_insert hi, blockUpperUnit_add]; exact mul_mem (hf i) ih

theorem blockLowerUnit_sum_mem_elementarySubgroup {ι : Type*} (s : Finset ι)
    (f : ι → Matrix n n A) (hf : ∀ i, blockLowerUnit (f i) ∈ elementarySubgroup (n ⊕ n) A) :
    blockLowerUnit (∑ i ∈ s, f i) ∈ elementarySubgroup (n ⊕ n) A := by
  classical
  induction s using Finset.induction_on with
  | empty => rw [Finset.sum_empty, blockLowerUnit_zero]; exact one_mem _
  | insert i s hi ih => rw [Finset.sum_insert hi, blockLowerUnit_add]; exact mul_mem (hf i) ih

/-- `[[1, B], [0, 1]]` is elementary: it is the product of the `1 + B_ij e_{i, n+j}`. -/
theorem blockUpperUnit_mem_elementarySubgroup (B : Matrix n n A) :
    blockUpperUnit B ∈ elementarySubgroup (n ⊕ n) A := by
  rw [matrix_eq_sum_single B]
  exact blockUpperUnit_sum_mem_elementarySubgroup _ _ fun i =>
    blockUpperUnit_sum_mem_elementarySubgroup _ _ fun j => by
      rw [blockUpperUnit_single]; exact transvectionUnit_mem_elementarySubgroup _ _

/-- `[[1, 0], [C, 1]]` is elementary. -/
theorem blockLowerUnit_mem_elementarySubgroup (C : Matrix n n A) :
    blockLowerUnit C ∈ elementarySubgroup (n ⊕ n) A := by
  rw [matrix_eq_sum_single C]
  exact blockLowerUnit_sum_mem_elementarySubgroup _ _ fun i =>
    blockLowerUnit_sum_mem_elementarySubgroup _ _ fun j => by
      rw [blockLowerUnit_single]; exact transvectionUnit_mem_elementarySubgroup _ _

/-- `[[1, θ], [0, 1]] [[1, 0], [-θ⁻¹, 1]] [[1, θ], [0, 1]] = [[0, θ], [-θ⁻¹, 0]]` for a unit
`θ`. -/
theorem blockUpperUnit_mul_blockLowerUnit_mul_blockUpperUnit (θ : (Matrix n n A)ˣ) :
    ((blockUpperUnit (θ : Matrix n n A) *
      blockLowerUnit (-(θ⁻¹ : (Matrix n n A)ˣ) : Matrix n n A) *
      blockUpperUnit (θ : Matrix n n A) : (Matrix (n ⊕ n) (n ⊕ n) A)ˣ) : Matrix _ _ A) =
      fromBlocks 0 (θ : Matrix n n A) (-(θ⁻¹ : (Matrix n n A)ˣ) : Matrix n n A) 0 := by
  simp [fromBlocks_multiply]

/-- **The Whitehead lemma.** For a unit `θ` of `Matrix n n A`, `diag(θ, θ⁻¹)` is elementary in
`GL (n ⊕ n) A`: it is `[[0, θ], [-θ⁻¹, 0]] [[0, -1], [1, 0]]`, two products of block unipotent
matrices. -/
theorem exists_mem_elementarySubgroup_fromBlocks_inv (θ : (Matrix n n A)ˣ) :
    ∃ g ∈ elementarySubgroup (n ⊕ n) A, (g : Matrix (n ⊕ n) (n ⊕ n) A) =
      fromBlocks (θ : Matrix n n A) 0 0 ((θ⁻¹ : (Matrix n n A)ˣ) : Matrix n n A) := by
  let w : (Matrix n n A)ˣ → (Matrix (n ⊕ n) (n ⊕ n) A)ˣ := fun u =>
    blockUpperUnit (u : Matrix n n A) * blockLowerUnit (-(u⁻¹ : (Matrix n n A)ˣ) : Matrix n n A) *
      blockUpperUnit (u : Matrix n n A)
  have hw : ∀ u, w u ∈ elementarySubgroup (n ⊕ n) A := fun u =>
    mul_mem (mul_mem (blockUpperUnit_mem_elementarySubgroup _)
      (blockLowerUnit_mem_elementarySubgroup _)) (blockUpperUnit_mem_elementarySubgroup _)
  refine ⟨w θ * w (-1), mul_mem (hw θ) (hw (-1)), ?_⟩
  rw [Units.val_mul, blockUpperUnit_mul_blockLowerUnit_mul_blockUpperUnit,
    blockUpperUnit_mul_blockLowerUnit_mul_blockUpperUnit]
  simp [fromBlocks_multiply]

/-- Commutators are elementary in the corner: for units `θ, η` of `Matrix n n A`,
`diag(θ η θ⁻¹ η⁻¹, 1)` lies in `E(n ⊕ n, A)`, as `diag(θ, θ⁻¹) diag(η, η⁻¹) diag((ηθ)⁻¹, ηθ)`. -/
theorem exists_mem_elementarySubgroup_fromBlocks_commutator (θ η : (Matrix n n A)ˣ) :
    ∃ g ∈ elementarySubgroup (n ⊕ n) A, (g : Matrix (n ⊕ n) (n ⊕ n) A) =
      fromBlocks ((θ * η * θ⁻¹ * η⁻¹ : (Matrix n n A)ˣ) : Matrix n n A) 0 0 1 := by
  obtain ⟨g₁, hg₁, e₁⟩ := exists_mem_elementarySubgroup_fromBlocks_inv θ
  obtain ⟨g₂, hg₂, e₂⟩ := exists_mem_elementarySubgroup_fromBlocks_inv η
  obtain ⟨g₃, hg₃, e₃⟩ := exists_mem_elementarySubgroup_fromBlocks_inv (η * θ)⁻¹
  refine ⟨g₁ * g₂ * g₃, mul_mem (mul_mem hg₁ hg₂) hg₃, ?_⟩
  rw [Units.val_mul, Units.val_mul, e₁, e₂, e₃]
  simp only [fromBlocks_multiply, Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, inv_inv]
  congr 1
  · simp [_root_.mul_inv_rev, mul_assoc]
  · rw [← Units.val_mul, ← Units.val_mul]
    simp [mul_assoc]

end Whitehead

end Matrix
