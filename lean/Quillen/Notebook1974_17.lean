import Mathlib

/-!
# Quillen, notebook 1974-17, p. 3: the commutator trick of the Whitehead lemma

Daniel Quillen's research notebook 1974-17 (Clay Mathematics Institute,
<https://www.claymath.org/library/Quillen/Working_papers/quillen%201974/1974-17.pdf>), p. 3.
To show that the commutator subgroup of `GL(A)` lies in the normal subgroup generated by the
alternating groups, Quillen writes, for `α, β ∈ GL_n(A)` placed in the first of three diagonal
blocks of `GL_{3n}(A)` and even permutations `σ, τ` of the coordinates moving the first block to
the second and to the third, `(α, β) = (ασα⁻¹σ⁻¹, βτβ⁻¹τ⁻¹)`.

* `commutator_mul_mul`: in any group, `⁅x a, y b⁆ = ⁅x, y⁆` when `a` commutes with `y` and `b`,
  and `b` with `x` — the group-theoretic content;
* `blockUnit k`: `GL_n(A) → GL_{3n}(A)`, `M ↦ diag(…, M, …)` in block `k` (index `ι × Fin 3`);
  units in different blocks commute (`commute_blockUnit`);
* `blockPerm e`: the permutation matrix of `(i, k) ↦ (i, e k)`; it conjugates block `k` to block
  `e⁻¹ k` (`blockPerm_conj`), and it is an even permutation when `e` is a `3`-cycle
  (`sign_blockPerm_finRotate`);
* `commutator_eq` (p. 3): `⁅α, β⁆ = ⁅α σ α⁻¹ σ⁻¹, β τ β⁻¹ τ⁻¹⁆` in `GL_{3n}(A)` for any
  ring `A` (not necessarily commutative), with `σ`, `τ` the block permutations of
  `(finRotate 3)⁻¹` and `finRotate 3`, which send block `0` to blocks `1` and `2`;
* `commutator_mem_normalClosure`, `commutator_mem_normalClosure_swap` (p. 3, « Proof 2 »): if
  `σβσ⁻¹` commutes with `α` then `⁅α, β⁆` lies in the normal closure of `σ`; so `(GL_n, GL_n)`
  lies in the normal subgroup of `GL_{2n}(A)` generated by the block swap.

The embeddings and permutations are stated for `r` blocks, `ι × Fin r`.
-/

namespace Quillen.Notebook1974_17

open Matrix Equiv
open scoped commutatorElement

/-- `⁅x a, y b⁆ = ⁅x, y⁆` when `a` commutes with `y` and `b`, and `b` with `x`. -/
theorem commutator_mul_mul {G : Type*} [Group G] {x y a b : G}
    (hay : Commute a y) (hab : Commute a b) (hbx : Commute b x) :
    ⁅x * a, y * b⁆ = ⁅x, y⁆ := by
  have h1 : Commute a (y * b) := hay.mul_right hab
  have h2 : Commute b x⁻¹ := hbx.inv_right
  rw [commutatorElement_def, commutatorElement_def, _root_.mul_inv_rev, _root_.mul_inv_rev,
    show x * a * (y * b) * (a⁻¹ * x⁻¹) * (b⁻¹ * y⁻¹) =
      x * (a * (y * b) * a⁻¹) * x⁻¹ * b⁻¹ * y⁻¹ by group,
    h1.eq, mul_inv_cancel_right,
    show x * (y * b) * x⁻¹ * b⁻¹ * y⁻¹ = x * y * (b * x⁻¹ * b⁻¹) * y⁻¹ by group,
    h2.eq, mul_inv_cancel_right]

variable {ι A : Type*} [Fintype ι] [DecidableEq ι] [Ring A] {r : ℕ}

/-- The block-`k` embedding of matrices, `M ↦ diag(1, …, M, …, 1)`. -/
def blockHom (k : Fin r) : Matrix ι ι A →* Matrix (ι × Fin r) (ι × Fin r) A :=
  (blockDiagonalRingHom ι (Fin r) A).toMonoidHom.comp
    (MonoidHom.mulSingle (fun _ : Fin r => Matrix ι ι A) k)

/-- The block-`k` embedding `GL_n(A) → GL_{3n}(A)`. -/
def blockUnit (k : Fin r) : (Matrix ι ι A)ˣ →* (Matrix (ι × Fin r) (ι × Fin r) A)ˣ :=
  Units.map (blockHom k)

theorem blockHom_apply (k : Fin r) (M : Matrix ι ι A) :
    blockHom k M = blockDiagonal (Pi.mulSingle k M) := by
  simp [blockHom]

theorem commute_blockHom {k l : Fin r} (h : k ≠ l) (M N : Matrix ι ι A) :
    Commute (blockHom k M) (blockHom l N) := by
  rw [blockHom_apply, blockHom_apply, Commute, SemiconjBy, ← blockDiagonal_mul,
    ← blockDiagonal_mul]
  congr 1
  funext m
  simp only [Pi.mulSingle_apply]
  by_cases hk : m = k
  · subst hk; simp [h]
  · by_cases hl : m = l
    · subst hl; simp [hk]
    · simp [hk, hl]

theorem commute_blockUnit {k l : Fin r} (h : k ≠ l) (α β : (Matrix ι ι A)ˣ) :
    Commute (blockUnit k α) (blockUnit l β) :=
  Units.ext (by simpa [blockUnit] using (commute_blockHom h α.val β.val).eq)

/-- The permutation `(i, k) ↦ (i, e k)` of the coordinates `ι × Fin r`. -/
def blockEquiv (e : Perm (Fin r)) : Perm (ι × Fin r) := prodCongrRight fun _ => e

/-- Its permutation matrix, as a unit of `M_{3n}(A)`. -/
def blockPerm (e : Perm (Fin r)) : (Matrix (ι × Fin r) (ι × Fin r) A)ˣ where
  val := (blockEquiv (ι := ι) e).permMatrix A
  inv := (blockEquiv (ι := ι) e⁻¹).permMatrix A
  val_inv := by
    rw [← permMatrix_mul]
    convert permMatrix_one (n := ι × Fin r) (R := A)
    ext ⟨i, k⟩ <;> simp [blockEquiv]
  inv_val := by
    rw [← permMatrix_mul]
    convert permMatrix_one (n := ι × Fin r) (R := A)
    ext ⟨i, k⟩ <;> simp [blockEquiv]

/-- `blockPerm e` conjugates block `k` to block `e⁻¹ k`. -/
theorem blockPerm_conj (e : Perm (Fin r)) (k : Fin r) (α : (Matrix ι ι A)ˣ) :
    blockPerm e * blockUnit k α * (blockPerm e)⁻¹ = blockUnit (e⁻¹ k) α := by
  ext1
  simp only [Units.val_mul, blockPerm, Units.inv_mk, blockUnit, Units.coe_map, 
    blockHom_apply, Perm.permMatrix, PEquiv.toMatrix_toPEquiv_mul, PEquiv.mul_toMatrix_toPEquiv]
  ext ⟨i, m⟩ ⟨j, m'⟩
  simp only [submatrix_apply, id_eq, blockEquiv, blockDiagonal_apply']
  have hs : (prodCongrRight fun _ : ι => e⁻¹).symm (j, m') = (j, e m') := by
    simp [prodCongrRight, Perm.inv_def]
  rw [hs, prodCongrRight_apply, blockDiagonal_apply']
  by_cases hm : m = m'
  · subst hm
    simp only [ite_true, Pi.mulSingle_apply]
    have : (e m = k) ↔ (m = e⁻¹ k) := by
      rw [Perm.eq_inv_iff_eq]
    by_cases h : e m = k
    · simp [this.mp h]
    · have h' : ¬ m = e⁻¹ k := fun h' => h (this.mpr h')
      rw [Perm.inv_def] at h'
      simp [h, h']
  · have : e m ≠ e m' := fun h => hm (e.injective h)
    simp [hm, this]

/-- The block permutations of the `3`-cycles are even, so lie in the alternating group
`𝔄_{3n}` (as on the page). -/
theorem sign_blockPerm_finRotate : Perm.sign (blockEquiv (ι := ι) (finRotate 3)) = 1 := by
  rw [blockEquiv, Perm.sign_prodCongrRight, sign_finRotate]
  simp

/-- **Quillen, notebook 1974-17, p. 3**: for `α, β ∈ GL_n(A)` in the first block of
`GL_{3n}(A)` and the block permutations `σ`, `τ` moving the first block to the second and to
the third, `⁅α, β⁆ = ⁅α σ α⁻¹ σ⁻¹, β τ β⁻¹ τ⁻¹⁆`. -/
theorem commutator_eq (α β : (Matrix ι ι A)ˣ) :
    blockUnit (r := 3) 0 ⁅α, β⁆ =
      ⁅blockUnit 0 α * blockPerm (finRotate 3)⁻¹ * (blockUnit 0 α)⁻¹ *
          (blockPerm (finRotate 3)⁻¹)⁻¹,
        blockUnit 0 β * blockPerm (finRotate 3) * (blockUnit 0 β)⁻¹ *
          (blockPerm (finRotate 3))⁻¹⁆ := by
  have hσ : blockPerm (ι := ι) (A := A) (finRotate 3)⁻¹ * blockUnit 0 α⁻¹ *
      (blockPerm (finRotate 3)⁻¹)⁻¹ = blockUnit 1 α⁻¹ := by
    rw [blockPerm_conj]; rfl
  have hτ : blockPerm (ι := ι) (A := A) (finRotate 3) * blockUnit 0 β⁻¹ *
      (blockPerm (finRotate 3))⁻¹ = blockUnit 2 β⁻¹ := by
    rw [blockPerm_conj]; rfl
  have hg : ∀ x s y : (Matrix (ι × Fin 3) (ι × Fin 3) A)ˣ,
      x * s * y * s⁻¹ = x * (s * y * s⁻¹) := fun _ _ _ => by group
  rw [map_commutatorElement, ← map_inv, ← map_inv, hg, hg, hσ, hτ]
  exact (commutator_mul_mul (commute_blockUnit (by decide) _ _)
    (commute_blockUnit (by decide) _ _) (commute_blockUnit (by decide) _ _)).symm

/-- **Proof 2** (p. 3), group-theoretic part: if `σβσ⁻¹` commutes with `α`, then `⁅α, β⁆` lies
in the normal subgroup generated by `σ`. -/
theorem commutator_mem_normalClosure {G : Type*} [Group G] {α β σ : G}
    (h : Commute α (σ * β * σ⁻¹)) : ⁅α, β⁆ ∈ Subgroup.normalClosure {σ} := by
  set N := Subgroup.normalClosure ({σ} : Set G)
  have hσ : (σ : G ⧸ N) = 1 :=
    (QuotientGroup.eq_one_iff σ).mpr (Subgroup.subset_normalClosure rfl)
  have hβ : ((σ * β * σ⁻¹ : G) : G ⧸ N) = (β : G ⧸ N) := by
    rw [QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_inv, hσ]; group
  rw [← QuotientGroup.eq_one_iff, ← QuotientGroup.mk'_apply, map_commutatorElement,
    QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, ← hβ, commutatorElement_eq_one_iff_commute]
  exact h.map (QuotientGroup.mk' N)

/-- **Proof 2** (p. 3): `(GL_n, GL_n)` lies in the normal subgroup of `GL_{2n}(A)` generated by
the block swap `σ`, which conjugates the first block to the second. -/
theorem commutator_mem_normalClosure_swap (α β : (Matrix ι ι A)ˣ) :
    blockUnit (r := 2) 0 ⁅α, β⁆ ∈ Subgroup.normalClosure {blockPerm (Equiv.swap 0 1)} := by
  rw [map_commutatorElement]
  apply commutator_mem_normalClosure
  rw [blockPerm_conj]
  exact commute_blockUnit (by decide) _ _

end Quillen.Notebook1974_17
