import Mathlib

/-!
# Quillen, notebook 1972-11, p. 36: an extension of finitely presented modules

Daniel Quillen's research notebook 1972-11 (Clay Mathematics Institute,
<https://www.claymath.org/library/Quillen/Working_papers/quillen%201972/1972-11.pdf>) has, in a
run dated December 23, 1972 on Gersten's theorem and coherence, a short sorites on finitely
presented modules (p. 36, his p. 3), used for coherent rings on pp. 36–38. In our words: for a
short exact sequence `0 → M' → M → M'' → 0` of modules,

* (a) if `M''` is finitely presented and `M` is finitely generated, then `M'` is finitely
  generated;
* (b) if `M` is finitely presented and `M'` is finitely generated, then `M''` is finitely
  presented;
* (c) if `M'` and `M''` are finitely presented, then so is `M`.

His proof of (c) maps `M' ⊕ A^p` onto `M`, where `A^p → M''` is a finite free cover lifted to
`M`, and applies (b): the kernel is identified with the kernel of `A^p → M''`, finitely
generated by (a).

Parts (a) and (b) are in mathlib (`Module.FinitePresentation.fg_ker` and
`Module.finitePresentation_of_surjective`); part (c) is, as far as we found, only there for split
sequences (`Module.finitePresentation_of_split_exact`). This file proves it in general, along the
notebook's route:

* `fg_ker_coprod`: the kernel of `f.coprod σ : M' × F → M` is finitely generated when the
  composite `g ∘ σ : F → M''` is onto a finitely presented module, `F` is finite and the
  sequence is exact;
* `finitePresentation_of_exact`: (c), the extension of a finitely presented module by a finitely
  presented module is finitely presented.
-/

namespace Quillen.Notebook1972_11

open Function

variable {R : Type*} [Ring R]
  {M' M M'' : Type*} [AddCommGroup M'] [Module R M'] [AddCommGroup M] [Module R M]
  [AddCommGroup M''] [Module R M'']

/-- The kernel step of the notebook's proof (p. 36): if `f : M' → M` is injective with image the
kernel of `g : M → M''`, and `σ : F → M` is such that `g ∘ σ` is onto the finitely presented
module `M''`, with `F` finite, then the kernel of `(m', v) ↦ f m' + σ v` is finitely generated.
The second projection identifies it with the kernel of `g ∘ σ`. -/
theorem fg_ker_coprod {F : Type*} [AddCommGroup F] [Module R F] [Module.Finite R F]
    [Module.FinitePresentation R M''] (f : M' →ₗ[R] M) (g : M →ₗ[R] M'') (σ : F →ₗ[R] M)
    (hf : Injective f) (H : Exact f g) (hgσ : Surjective (g ∘ₗ σ)) :
    (LinearMap.ker (f.coprod σ)).FG := by
  apply Submodule.fg_of_fg_map_of_fg_inf_ker (LinearMap.snd R M' F)
  · -- the image under the second projection is the kernel of `g ∘ σ`
    have : (LinearMap.ker (f.coprod σ)).map (LinearMap.snd R M' F) =
        LinearMap.ker (g ∘ₗ σ) := by
      ext v
      simp only [Submodule.mem_map, LinearMap.mem_ker, LinearMap.coprod_apply,
        LinearMap.snd_apply, LinearMap.comp_apply, Prod.exists, exists_eq_right]
      constructor
      · rintro ⟨m', hm'⟩
        have : g (f m' + σ v) = 0 := by rw [hm', map_zero]
        rwa [map_add, H.apply_apply_eq_zero, zero_add] at this
      · intro hv
        obtain ⟨m', hm'⟩ := (H (σ v)).mp hv
        exact ⟨-m', by rw [map_neg, hm', neg_add_cancel]⟩
    rw [this]
    exact Module.FinitePresentation.fg_ker (g ∘ₗ σ) hgσ
  · -- on the kernel the second projection is injective
    have : LinearMap.ker (f.coprod σ) ⊓ LinearMap.ker (LinearMap.snd R M' F) = ⊥ := by
      rw [eq_bot_iff]
      rintro ⟨m', v⟩ ⟨h1, h2⟩
      simp only [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.coprod_apply,
        LinearMap.snd_apply] at h1 h2
      subst h2
      rw [map_zero, add_zero] at h1
      have : m' = 0 := hf (by rw [h1, map_zero])
      simp [this]
    rw [this]
    exact Submodule.fg_bot

/-- **Quillen, notebook 1972-11, p. 36, (c).** In a short exact sequence `0 → M' → M → M'' → 0`
of modules over a ring, if `M'` and `M''` are finitely presented, then `M` is finitely
presented. -/
theorem finitePresentation_of_exact [Module.FinitePresentation R M']
    [Module.FinitePresentation R M''] (f : M' →ₗ[R] M) (g : M →ₗ[R] M'')
    (hf : Injective f) (hg : Surjective g) (H : Exact f g) :
    Module.FinitePresentation R M := by
  -- a finite free cover `π : R^n → M''`, lifted to `σ : R^n → M`
  obtain ⟨n, π, hπ⟩ := Module.Finite.exists_fin' R M''
  obtain ⟨σ, hσ⟩ := Module.projective_lifting_property g π hg
  have hgσ : Surjective (g ∘ₗ σ) := by rw [hσ]; exact hπ
  -- `M' × R^n → M` is onto, with finitely generated kernel
  have hsurj : Surjective (f.coprod σ) := by
    intro m
    obtain ⟨v, hv⟩ := hgσ (g m)
    have : g (m - σ v) = 0 := by
      rw [map_sub]; rw [LinearMap.comp_apply] at hv; rw [hv, sub_self]
    obtain ⟨m', hm'⟩ := (H (m - σ v)).mp this
    exact ⟨(m', v), by rw [LinearMap.coprod_apply, hm', sub_add_cancel]⟩
  exact Module.finitePresentation_of_surjective (f.coprod σ) hsurj
    (fg_ker_coprod f g σ hf H hgσ)

end Quillen.Notebook1972_11
