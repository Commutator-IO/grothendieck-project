module

public import Mathlib.CategoryTheory.SingleObj
public import Mathlib.CategoryTheory.Sites.Coverage
public import Mathlib.SetTheory.Cardinal.Finite

import Bridges.Monoids
import Mathlib.Tactic.FinCases

/-!
# The Grothendieck topologies on the monoid `(ℕ, +)`

Let `NatCat` be the one-object category of the additive monoid `ℕ`, `SingleObj (Multiplicative ℕ)`;
its presheaves are the sets with an endomorphism, the action of the generator `1`. A morphism
`f` has a length `len f : ℕ`, and `len (f ≫ g) = len f + len g`. A sieve on the object is a set of
lengths closed upwards: the empty sieve, or `{n, n + 1, …}` for some `n`.

* `eq_bot_or_eq_finalTopology_or_eq_top`, `nat_card_grothendieckTopology_natCat`: `NatCat` has
  exactly three Grothendieck topologies: the trivial one `⊥` (only the maximal sieve covers), the
  final topology `finalTopology` (all non-empty sieves cover), and the degenerate one `⊤` (all
  sieves cover, the empty sieve included). The final topology is Mathlib's atomic topology,
  defined thanks to the right Ore condition (`rightOreCondition_natCat`): `NatCat` is
  commutative. If a topology contains a non-maximal sieve, it contains the sieve
  `positiveSieve` of non-identity morphisms, and then every non-empty sieve, by induction on
  the length of one of its morphisms (`mem_of_positiveSieve_mem`);
* `isSheaf_finalTopology_iff`: a presheaf is a sheaf for the final topology iff the generator acts
  bijectively. The final topology is generated by the single morphism `1`
  (`toGrothendieck_finalCoverage`), whose matching families are arbitrary elements, since the
  generator is cancellable.
-/

@[expose] public section

namespace LeanPool.ToposTheoreticBridges.Examples

open CategoryTheory

universe w

/-- The one-object category of the additive monoid `ℕ`. -/
abbrev NatCat : Type := SingleObj (Multiplicative ℕ)

namespace NatCat

/-- The length of a morphism of `NatCat`, the natural number it stands for. -/
def len {X Y : NatCat} (f : X ⟶ Y) : ℕ :=
  Multiplicative.toAdd (show Multiplicative ℕ from f)

/-- The generator `1` of `NatCat`. -/
def gen (X : NatCat) : X ⟶ X :=
  Multiplicative.ofAdd 1

/-- The morphism of length `n` between two objects of `NatCat`. -/
def ofLen (X Y : NatCat) (n : ℕ) : X ⟶ Y :=
  Multiplicative.ofAdd n

@[simp]
theorem len_ofLen (X Y : NatCat) (n : ℕ) : len (ofLen X Y n) = n :=
  rfl

@[simp]
theorem len_gen (X : NatCat) : len (gen X) = 1 :=
  rfl

@[simp]
theorem len_id (X : NatCat) : len (𝟙 X) = 0 :=
  rfl

@[simp]
theorem len_comp {X Y Z : NatCat} (f : X ⟶ Y) (g : Y ⟶ Z) : len (f ≫ g) = len f + len g := by
  unfold len
  rw [SingleObj.comp_as_mul, toAdd_mul, Nat.add_comm]

/-- Morphisms of `NatCat` are determined by their length. -/
theorem hom_ext {X Y : NatCat} {f g : X ⟶ Y} (h : len f = len g) : f = g :=
  Multiplicative.toAdd.injective h

/-- A sieve on the object of `NatCat` is closed under lengthening. -/
theorem Sieve.apply_of_len_le {X Y Z : NatCat} (S : Sieve X) {f : Y ⟶ X} (hf : S f)
    {g : Z ⟶ X} (h : len f ≤ len g) : S g := by
  have : ofLen Z Y (len g - len f) ≫ f = g := hom_ext (by simp; omega)
  exact this ▸ S.downward_closed hf _

/-- The sieve of the non-identity morphisms, of length at least `1`. -/
def positiveSieve (X : NatCat) : Sieve X where
  arrows _ f := 1 ≤ len f
  downward_closed {_ _ f} hf g := by simp only [len_comp]; omega

/-- The sieve of non-identity morphisms is not the maximal sieve. -/
theorem positiveSieve_ne_top (X : NatCat) : positiveSieve X ≠ ⊤ := by
  intro h
  have : (positiveSieve X) (𝟙 X) := h ▸ trivial
  exact absurd this (by simp [positiveSieve])

/-- `NatCat` satisfies the right Ore condition, being commutative. -/
theorem rightOreCondition_natCat : GrothendieckTopology.RightOreCondition NatCat :=
  rightOreCondition_singleObj_iff.2 fun a b => ⟨b, a, mul_comm a b⟩

/-- The final topology of `NatCat`: a sieve covers iff it is non-empty, that is, contains all
morphisms of length at least some `n`. It is the atomic topology. -/
def finalTopology : GrothendieckTopology NatCat :=
  GrothendieckTopology.atomic rightOreCondition_natCat

theorem mem_finalTopology {X : NatCat} {S : Sieve X} :
    S ∈ finalTopology X ↔ ∃ (Y : NatCat) (f : Y ⟶ X), S f :=
  Iff.rfl

variable {J : GrothendieckTopology NatCat}

/-- A topology containing the sieves of non-identity morphisms contains every non-empty
sieve. -/
theorem mem_of_positiveSieve_mem (hJ : ∀ X, positiveSieve X ∈ J X) {X Y : NatCat}
    (S : Sieve X) (f : Y ⟶ X) (hf : S f) : S ∈ J X := by
  obtain ⟨n, hn⟩ : ∃ n, len f = n := ⟨_, rfl⟩
  induction n generalizing X Y S f with
  | zero =>
    apply J.covering_of_eq_top
    rw [← Sieve.id_mem_iff_eq_top]
    exact Sieve.apply_of_len_le S hf (by simp [hn])
  | succ n ih =>
    refine J.transitive (hJ X) S fun Z g hg => ?_
    refine ih (S.pullback g) (ofLen Z Z n) ?_ rfl
    change S (ofLen Z Z n ≫ g)
    have hg' : 1 ≤ len g := hg
    exact Sieve.apply_of_len_le S hf (by simp only [len_comp, len_ofLen]; omega)

/-- A topology containing a non-maximal sieve contains the sieve of non-identity morphisms. -/
theorem positiveSieve_mem_of_mem {X : NatCat} {S : Sieve X} (hS : S ∈ J X) (hne : S ≠ ⊤) :
    positiveSieve X ∈ J X := by
  refine J.superset_covering (fun Y f hf => ?_) hS
  by_contra h
  apply hne
  rw [← Sieve.id_mem_iff_eq_top]
  exact Sieve.apply_of_len_le S hf (by simp only [positiveSieve] at h; simp; omega)

/-- **Topologies on `(ℕ, +)`.** Every Grothendieck topology on `NatCat` is the trivial topology,
the final topology, or the degenerate topology. -/
theorem eq_bot_or_eq_finalTopology_or_eq_top (J : GrothendieckTopology NatCat) :
    J = ⊥ ∨ J = finalTopology ∨ J = ⊤ := by
  by_cases h0 : ∀ X, (⊥ : Sieve X) ∈ J X
  · refine Or.inr (Or.inr (GrothendieckTopology.ext (funext fun X => Set.ext fun S => ?_)))
    exact iff_of_true (J.superset_covering bot_le (h0 X)) GrothendieckTopology.top_covering
  simp only [not_forall] at h0
  obtain ⟨X₀, hX₀⟩ := h0
  by_cases hI : ∀ X, positiveSieve X ∈ J X
  · refine Or.inr (Or.inl (GrothendieckTopology.ext (funext fun X => Set.ext fun S => ?_)))
    rw [mem_finalTopology]
    refine ⟨fun hS => ?_, fun ⟨Y, f, hf⟩ => mem_of_positiveSieve_mem hI S f hf⟩
    by_contra hne
    simp only [not_exists] at hne
    have : S = ⊥ := by
      ext Y f
      simpa using hne Y f
    exact hX₀ (this ▸ hS : (⊥ : Sieve X) ∈ J X)
  · refine Or.inl (GrothendieckTopology.ext (funext fun X => Set.ext fun S => ?_))
    rw [GrothendieckTopology.bot_covering]
    refine ⟨fun hS => ?_, fun h => h ▸ J.top_mem X⟩
    by_contra hne
    exact hI fun _ => positiveSieve_mem_of_mem hS hne

theorem finalTopology_ne_bot : finalTopology ≠ ⊥ := by
  intro h
  have : positiveSieve (SingleObj.star _) ∈ finalTopology (SingleObj.star _) :=
    ⟨_, gen _, by simp [positiveSieve]⟩
  rw [h, GrothendieckTopology.bot_covering] at this
  exact positiveSieve_ne_top _ this

theorem finalTopology_ne_top : finalTopology ≠ ⊤ := by
  intro h
  have : (⊥ : Sieve (SingleObj.star (Multiplicative ℕ))) ∈ finalTopology (SingleObj.star _) := by
    rw [h]
    exact GrothendieckTopology.top_covering
  obtain ⟨_, _, hf⟩ := this
  exact hf

theorem bot_ne_top_natCat : (⊥ : GrothendieckTopology NatCat) ≠ ⊤ := by
  intro h
  have : (⊥ : Sieve (SingleObj.star (Multiplicative ℕ))) ∈
      (⊥ : GrothendieckTopology NatCat) (SingleObj.star _) := by
    rw [h]
    exact GrothendieckTopology.top_covering
  rw [GrothendieckTopology.bot_covering, ← Sieve.id_mem_iff_eq_top] at this
  exact this

/-- **Topologies on `(ℕ, +)`.** The one-object category of the additive monoid `ℕ` has exactly
three Grothendieck topologies. -/
theorem nat_card_grothendieckTopology_natCat : Nat.card (GrothendieckTopology NatCat) = 3 := by
  have hf : Function.Bijective
      ![(⊥ : GrothendieckTopology NatCat), finalTopology, (⊤ : GrothendieckTopology NatCat)] := by
    refine ⟨fun i j h => ?_, fun J => ?_⟩
    · fin_cases i <;> fin_cases j <;>
        simp_all [finalTopology_ne_bot, finalTopology_ne_top, finalTopology_ne_bot.symm,
          finalTopology_ne_top.symm, bot_ne_top_natCat.symm]
    · rcases eq_bot_or_eq_finalTopology_or_eq_top J with rfl | rfl | rfl
      exacts [⟨0, rfl⟩, ⟨1, rfl⟩, ⟨2, rfl⟩]
  rw [← Nat.card_eq_of_bijective _ hf, Nat.card_eq_fintype_card, Fintype.card_fin]

/-- The coverage of `NatCat` by the generator alone. -/
def finalCoverage : Coverage NatCat where
  coverings X := {Presieve.singleton (gen X)}
  pullback := by
    rintro X Y f S rfl
    refine ⟨Presieve.singleton (gen Y), rfl, ?_⟩
    rintro Z g ⟨⟩
    exact ⟨X, f, gen X, Presieve.singleton_self _, hom_ext (by simp [Nat.add_comm])⟩

/-- The final topology is generated by the generator `1`. -/
theorem toGrothendieck_finalCoverage : finalCoverage.toGrothendieck = finalTopology := by
  apply le_antisymm
  · refine ((Coverage.gi NatCat).gc _ _).2 fun X R hR => ?_
    obtain rfl : R = Presieve.singleton (gen X) := hR
    exact ⟨X, gen X, Sieve.le_generate _ _ _ (Presieve.singleton_self _)⟩
  · rintro X S ⟨Y, f, hf⟩
    refine mem_of_positiveSieve_mem (fun X => ?_) S f hf
    refine finalCoverage.mem_toGrothendieck_sieves_of_superset ?_ (Set.mem_singleton _)
    rintro _ _ ⟨⟩
    simp [positiveSieve]

/-- **Sheaves for the final topology.** A presheaf on `(ℕ, +)`, a set with an endomorphism, is a
sheaf for the final topology iff the endomorphism is bijective. -/
theorem isSheaf_finalTopology_iff (F : NatCatᵒᵖ ⥤ Type w) :
    Presieve.IsSheaf finalTopology F ↔
      Function.Bijective (F.map (gen (SingleObj.star (Multiplicative ℕ))).op) := by
  rw [← toGrothendieck_finalCoverage, Presieve.isSheaf_coverage]
  have compatible : ∀ {X : NatCat} (x : F.obj (Opposite.op X)) {Z : NatCat} (p₁ p₂ : Z ⟶ X),
      p₁ ≫ gen X = p₂ ≫ gen X → F.map p₁.op x = F.map p₂.op x := by
    intro X x Z p₁ p₂ h
    obtain rfl : p₁ = p₂ := hom_ext (by simpa using congrArg len h)
    rfl
  constructor
  · intro h
    have h' := Presieve.isSheafFor_singleton.1 (h (X := SingleObj.star _) _ (Set.mem_singleton _))
    refine ⟨fun y₁ y₂ hy => ?_, fun x => (h' x (compatible x)).exists⟩
    exact (h' _ (compatible _)).unique rfl hy.symm
  · rintro hb X R rfl
    exact Presieve.isSheafFor_singleton.2 fun x _ => hb.existsUnique x

end NatCat

end LeanPool.ToposTheoreticBridges.Examples
