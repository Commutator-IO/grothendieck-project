module

public import Bridges.Dualities.Density

/-!
# The points of the bridge: J-prime filters and completely prime filters

Caramello's Theorem 7.4 (arXiv:1103.3493): for a preorder `C` with a coverage `J`, the points of
the topos read on the two sites agree, that is the `J`-prime filters on `C` correspond to the
completely prime filters on the frame of `J`-ideals, by `𝔉 ↦ {c | ↓_J c ∈ 𝔉}`. This is the
step that turns a duality with locales into a duality with spaces, once enough points exist.

* `closure_inter_subset`: the closure preserves binary meets of lower sets (the frame law of the
  ideals), used for directedness.
* `primeFilterEquiv`: Theorem 7.4.
-/

@[expose] public section

namespace Bridges.Dualities

open Set

namespace PreorderCoverage

variable {α : Type*} [Preorder α] {J : PreorderCoverage α}

/-- The closure preserves binary meets of lower sets. -/
theorem closure_inter_subset {A B : Set α} (hA : IsLowerSet A) (hB : IsLowerSet B) :
    closure (J := J) A ∩ closure (J := J) B ⊆ closure (J := J) (A ∩ B) := by
  -- first below an element of `A`
  have step1 : ∀ a ∈ A, ∀ z ∈ closure (J := J) B, z ≤ a → z ∈ closure (J := J) (A ∩ B) := by
    intro a ha
    let N : Set α := {y | ∀ z ≤ y, z ≤ a → z ∈ closure (J := J) (A ∩ B)}
    have hN : J.IsIdeal N := by
      refine ⟨fun y y' hyy' hy z hz hza => hy z (hz.trans hyy') hza, fun y S hS hSN z hzy hza => ?_⟩
      obtain ⟨T, hT, h⟩ := J.stable hS hzy
      refine (isIdeal_closure _).2 z T hT fun t ht => ?_
      obtain ⟨s, hs, hts⟩ := h t ht
      exact hSN hs t hts ((J.le_of_mem hT t ht).trans hza)
    have hBN : B ⊆ N := fun y hy z hzy hza =>
      subset_closure _ ⟨hA hza ha, hB hzy hy⟩
    exact fun z hz hza => closure_subset hN hBN hz z le_rfl hza
  let P : Set α := {x | ∀ z ≤ x, z ∈ closure (J := J) B → z ∈ closure (J := J) (A ∩ B)}
  have hP : J.IsIdeal P := by
    refine ⟨fun x x' hxx' hx z hz => hx z (hz.trans hxx'), fun x S hS hSP z hzx hzB => ?_⟩
    obtain ⟨T, hT, h⟩ := J.stable hS hzx
    refine (isIdeal_closure _).2 z T hT fun t ht => ?_
    obtain ⟨s, hs, hts⟩ := h t ht
    exact hSP hs t hts ((isIdeal_closure B).1 (J.le_of_mem hT t ht) hzB)
  have hAP : A ⊆ P := fun x hx z hzx hzB => step1 x hx z hzB hzx
  exact fun z ⟨hzA, hzB⟩ => closure_subset hP hAP hzA z le_rfl hzB

/-- A `J`-prime filter on `C`: a nonempty, down-directed upper set that meets every covering
sieve of each of its elements. -/
structure IsPrimeFilter (J : PreorderCoverage α) (F : Set α) : Prop where
  isUpperSet : IsUpperSet F
  nonempty : F.Nonempty
  directed : ∀ a ∈ F, ∀ b ∈ F, ∃ c ∈ F, c ≤ a ∧ c ≤ b
  prime : ∀ c ∈ F, ∀ S ∈ J.covers c, (S ∩ F).Nonempty

/-- The ideal generated by a set. -/
def closureIdeal (A : Set α) : J.Ideal := ⟨closure A, isIdeal_closure A⟩

/-- A completely prime filter on the frame of `J`-ideals: an upper set containing the top ideal,
closed under binary meets, and such that if the ideal generated by a family belongs to it then a
member of the family does. -/
structure IsCompletelyPrimeFilter (J : PreorderCoverage α) (𝔉 : Set J.Ideal) : Prop where
  mono : ∀ I I' : J.Ideal, I ≤ I' → I ∈ 𝔉 → I' ∈ 𝔉
  univ_mem : ∀ I : J.Ideal, I.1 = univ → I ∈ 𝔉
  inter_mem : ∀ I I' : J.Ideal, I ∈ 𝔉 → I' ∈ 𝔉 → ∀ K : J.Ideal, K.1 = I.1 ∩ I'.1 → K ∈ 𝔉
  prime : ∀ 𝒮 : Set J.Ideal, closureIdeal (⋃ S ∈ 𝒮, S.1) ∈ 𝔉 → ∃ S ∈ 𝒮, S ∈ 𝔉

/-- The principal `J`-ideal of an element. -/
def principal (c : α) : J.Ideal := closureIdeal (Iic c)

theorem iUnion_principal_eq {I : J.Ideal} :
    closureIdeal (⋃ S ∈ principal (J := J) '' I.1, S.1) = I := by
  refine Subtype.ext (Subset.antisymm (closure_subset I.2 ?_) fun x hx => ?_)
  · rintro x hx
    obtain ⟨S, ⟨c, hc, rfl⟩, hxS⟩ := mem_iUnion₂.1 hx
    exact closure_subset I.2 (fun y hy => I.2.1 hy hc) hxS
  · exact subset_closure _ (mem_iUnion₂.2 ⟨principal x, mem_image_of_mem _ hx,
      subset_closure _ (show x ∈ Iic x from le_rfl)⟩)

/-- From a completely prime filter of ideals, the `J`-prime filter of the elements whose
principal ideal it contains. -/
theorem isPrimeFilter_of (𝔉 : Set J.Ideal) (h : IsCompletelyPrimeFilter J 𝔉) :
    IsPrimeFilter J {c | principal c ∈ 𝔉} where
  isUpperSet a b hab ha := h.mono _ _ (closure_subset (isIdeal_closure _)
    (fun x hx => subset_closure _ ((show x ≤ a from hx).trans hab))) ha
  nonempty := by
    obtain ⟨S, ⟨c, -, rfl⟩, hc⟩ := h.prime (principal (J := J) '' univ) (h.univ_mem _
      (eq_univ_of_forall fun x => subset_closure _ (mem_iUnion₂.2 ⟨principal x,
        mem_image_of_mem _ (mem_univ x), subset_closure _ (show x ∈ Iic x from le_rfl)⟩)))
    exact ⟨c, hc⟩
  directed a ha b hb := by
    have hmeet : closureIdeal (J := J) (⋃ S ∈ principal (J := J) '' (Iic a ∩ Iic b), S.1) ∈ 𝔉 := by
      refine h.inter_mem _ _ ha hb _ (Subset.antisymm ?_ ?_)
      · refine closure_subset ⟨fun x y hxy hy => ⟨(isIdeal_closure _).1 hxy hy.1,
          (isIdeal_closure _).1 hxy hy.2⟩, fun x S hS hSI => ⟨(isIdeal_closure _).2 x S hS
          fun s hs => (hSI hs).1, (isIdeal_closure _).2 x S hS fun s hs => (hSI hs).2⟩⟩ ?_
        intro x hx
        obtain ⟨S, ⟨d, ⟨hda, hdb⟩, rfl⟩, hxS⟩ := mem_iUnion₂.1 hx
        exact ⟨closure_subset (isIdeal_closure _)
          (fun y hy => subset_closure _ ((show y ≤ d from hy).trans hda)) hxS,
          closure_subset (isIdeal_closure _)
          (fun y hy => subset_closure _ ((show y ≤ d from hy).trans hdb)) hxS⟩
      · refine (closure_inter_subset (fun x y hxy hy => hxy.trans hy)
          (fun x y hxy hy => hxy.trans hy)).trans (closure_subset (isIdeal_closure _) ?_)
        rintro x ⟨hxa, hxb⟩
        exact subset_closure _ (mem_iUnion₂.2 ⟨principal x, mem_image_of_mem _ ⟨hxa, hxb⟩,
          subset_closure _ (show x ∈ Iic x from le_rfl)⟩)
    obtain ⟨S, ⟨d, ⟨hda, hdb⟩, rfl⟩, hd⟩ := h.prime _ hmeet
    exact ⟨d, hd, hda, hdb⟩
  prime c hc S hS := by
    have hS' : closureIdeal (J := J) (⋃ T ∈ principal (J := J) '' S, T.1) ∈ 𝔉 := by
      refine h.mono _ _ (closure_subset (isIdeal_closure _) fun x hx => ?_) hc
      refine (isIdeal_closure _).1 (show x ≤ c from hx)
        ((isIdeal_closure _).2 c S hS fun s hs => ?_)
      exact subset_closure _ (mem_iUnion₂.2 ⟨principal s, mem_image_of_mem _ hs,
        subset_closure _ (show s ∈ Iic s from le_rfl)⟩)
    obtain ⟨T, ⟨s, hs, rfl⟩, hsT⟩ := h.prime _ hS'
    exact ⟨s, hs, hsT⟩

/-- From a `J`-prime filter, the completely prime filter of the ideals that meet it. -/
theorem isCompletelyPrimeFilter_of (F : Set α) (h : IsPrimeFilter J F) :
    IsCompletelyPrimeFilter J {I | (I.1 ∩ F).Nonempty} where
  mono I I' hII' := fun ⟨c, hcI, hcF⟩ => ⟨c, hII' hcI, hcF⟩
  univ_mem I hI := let ⟨c, hc⟩ := h.nonempty; ⟨c, hI ▸ mem_univ c, hc⟩
  inter_mem I I' := fun ⟨c, hcI, hcF⟩ ⟨c', hcI', hcF'⟩ K hK => by
    obtain ⟨d, hdF, hdc, hdc'⟩ := h.directed c hcF c' hcF'
    exact ⟨d, hK ▸ ⟨I.2.1 hdc hcI, I'.2.1 hdc' hcI'⟩, hdF⟩
  prime 𝒮 := by
    rintro ⟨c, hc, hcF⟩
    let K : Set α := {y | ∀ x ∈ F, x ≤ y → ∃ S ∈ 𝒮, (S.1 ∩ F).Nonempty}
    have hK : J.IsIdeal K := by
      refine ⟨fun y y' hyy' hy x hx hxy => hy x hx (hxy.trans hyy'),
        fun a S hS hSK x hx hxa => ?_⟩
      obtain ⟨T, hT, hTS⟩ := J.stable hS hxa
      obtain ⟨t, htT, htF⟩ := h.prime x hx T hT
      obtain ⟨s, hs, hts⟩ := hTS t htT
      exact hSK hs t htF hts
    have hsub : (⋃ S ∈ 𝒮, S.1) ⊆ K := by
      intro y hy x hx hxy
      obtain ⟨S, hS, hyS⟩ := mem_iUnion₂.1 hy
      exact ⟨S, hS, y, hyS, h.isUpperSet hxy hx⟩
    exact closure_subset hK hsub hc c hcF le_rfl

/-- **Caramello's Theorem 7.4**: the `J`-prime filters on `C` correspond to the completely prime
filters on the frame of `J`-ideals. -/
def primeFilterEquiv :
    {F : Set α // IsPrimeFilter J F} ≃ {𝔉 : Set J.Ideal // IsCompletelyPrimeFilter J 𝔉} where
  toFun F := ⟨{I | (I.1 ∩ F.1).Nonempty}, isCompletelyPrimeFilter_of F.1 F.2⟩
  invFun 𝔉 := ⟨{c | principal c ∈ 𝔉.1}, isPrimeFilter_of 𝔉.1 𝔉.2⟩
  left_inv F := by
    refine Subtype.ext (Subset.antisymm (fun c ⟨x, hx, hxF⟩ => ?_)
      fun c hc => ⟨c, subset_closure _ (show c ∈ Iic c from le_rfl), hc⟩)
    let K : Set α := {y | ∀ x ∈ F.1, x ≤ y → c ∈ F.1}
    have hK : J.IsIdeal K := by
      refine ⟨fun y y' hyy' hy x hx hxy => hy x hx (hxy.trans hyy'),
        fun a S hS hSK x hx hxa => ?_⟩
      obtain ⟨T, hT, hTS⟩ := J.stable hS hxa
      obtain ⟨t, htT, htF⟩ := F.2.prime x hx T hT
      obtain ⟨s, hs, hts⟩ := hTS t htT
      exact hSK hs t htF hts
    have hsub : Iic c ⊆ K := fun y hy x hx hxy => F.2.isUpperSet (hxy.trans hy) hx
    exact closure_subset hK hsub hx x hxF le_rfl
  right_inv 𝔉 := by
    refine Subtype.ext (Subset.antisymm (fun I ⟨c, hcI, hc⟩ => 𝔉.2.mono _ _
      (closure_subset I.2 fun x hx => I.2.1 hx hcI) hc) fun I hI => ?_)
    rw [← iUnion_principal_eq (I := I)] at hI
    obtain ⟨S, ⟨c, hc, rfl⟩, hcF⟩ := 𝔉.2.prime _ hI
    exact ⟨c, hc, hcF⟩

end PreorderCoverage

end Bridges.Dualities
