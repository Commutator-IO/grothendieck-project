% The preamble shared by every transcription in the Grothendieck fonds.
%
% It rests on one idea: **uncertainty compounds, it does not resolve.** A
% transcription that smooths over a doubtful word has destroyed the only thing
% it was made for — a reader must be able to tell, at every point, what was on
% the page and what was supplied. The apparatus macros below are therefore the
% critical apparatus, not decoration.
%
% The same commands are recognised by `scripts/render.mjs`, which produces the
% site's reading view. A macro added here must be added there too, or rendering
% fails loudly — which is the wanted behaviour: a silently wrong rendering is
% worse than none.
%
% Comments here are English, like the rest of the repository. The documents
% this preamble sets are French, and that is deliberate: see the skills.

\ProvidesPackage{grothendieck}[2026/08/08 Transcriptions of the Grothendieck fonds]

\usepackage{amsmath,amssymb,amsthm}
\usepackage{mathrsfs}
\usepackage{stmaryrd}
% Commutative diagrams are everywhere in this fonds: they are the very language
% of Grothendieck's algebraic geometry, and a transcription that rendered them
% as prose would be transcribing nothing.
\usepackage{tikz-cd}
% French is the main language — the last option wins — because that is the
% language of the pages and of both editions. English is still loaded because
% the modernised reading's \keywords line is English, and because a term or a
% title occasionally is; nothing calls \selectlanguage today.
\usepackage[english,french]{babel}
\usepackage{fontspec}
\usepackage{geometry}
\geometry{a4paper,margin=25mm,marginparwidth=28mm}
\usepackage{marginnote}
\usepackage{xcolor}
% ulem, not soul. `soul`'s \st and \ul are built on a character-by-character
% scan that XeLaTeX's font machinery breaks: the document fails with an
% undefined control sequence rather than degrading. ulem does the same two jobs
% and is Unicode-engine safe. `normalem` stops it hijacking \emph, which the
% transcriptions use for Grothendieck's own emphasis.
\usepackage[normalem]{ulem}
\usepackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=black,urlcolor=black,pdfborder={0 0 0}}

% --- Batch metadata ---------------------------------------------------------
% Taken as they stand by the rendering script, which shows them at the head of
% the reading view. They fix what the file claims to cover: without them a
% transcription floats unmoored in a fonds of sixteen thousand pages.

\newcommand{\folder}[1]{\gdef\grothFolder{#1}}
\newcommand{\batch}[1]{\gdef\grothBatch{#1}}
\newcommand{\pages}[2]{\gdef\grothFirst{#1}\gdef\grothLast{#2}}
\newcommand{\foldertitle}[1]{\gdef\grothFoldertitle{#1}}

% The dating, copied verbatim from Montpellier's inventory — never inferred
% here. Square brackets are the archivists' own convention for a date they
% deduced rather than read, most often from a verso, and reproducing them is
% the point: a reader must be able to tell a date Grothendieck wrote from one
% somebody worked out. « s.d. » is sans date, and is itself information.
%
% Optional, because a folder may genuinely have none — omit it rather than
% guess.
\newcommand{\dating}[1]{\gdef\grothDating{#1}}

% The legal notice, printed in the title block and repeated as a diagonal
% watermark on every page of the PDF. The fonds is under copyright and these
% editions are unauthorised working documents: every file must say so on its
% face, not only in a README nobody ships with the PDF. Two wordings exist —
% the transcription declares itself a demo edition; the modernised reading
% declares in addition that it is one reader's interpretation of the work.
% The skills write the line; a file without it gets no watermark, so leaving
% it out is visible in the output rather than silent.
\newcommand{\watermark}[1]{\gdef\grothWatermark{#1}}

\gdef\grothFolder{?}\gdef\grothBatch{?}\gdef\grothFirst{?}\gdef\grothLast{?}%
\gdef\grothFoldertitle{}\gdef\grothDating{}\gdef\grothWatermark{}

% --- The résumé -------------------------------------------------------------
%
% It opens the modernised reading, under the heading « Résumé », and is set
% small. Not an ornament: it is the one passage of the document that is not
% mathematics, and a reader must be able to recognise it before having read it
% — then skip it if the subject is already familiar, or stop there if it is
% not. The rule that follows marks the resumption of the body.

\newenvironment{resume}
  {\small\setlength{\parskip}{0.45em}}
  {\par\medskip\hrule\medskip}

% --- Keywords ---------------------------------------------------------------
%
% In English, closing the modernised reading's résumé: the modern vocabulary
% under which to search for what the pages construct. The site's manifest
% (`npm run manifest`) extracts them to tag the whole shelfmark — this line is
% the single source of the tags, there is no file alongside.
\newcommand{\keywords}[1]{\par\smallskip\noindent
  {\footnotesize\textsc{Keywords} --- \textit{#1}}\par}

% --- The critical apparatus -------------------------------------------------

% The page number, in the margin. This is the anchor that lets a disagreement
% over a formula be settled by looking at *one* page rather than a folder of
% six hundred. The site also uses it to turn the facsimile's pages as the
% transcription is scrolled.
%
% "Page" is the archivists' unit, and it is a side of a sheet, not a sheet:
% they numbered versos separately, which is why the blanks in a folder carry
% numbers of their own.
\newcommand{\page}[1]{%
  \marginnote{\footnotesize\color{gray!70}\textsf{#1}}%
  \label{page:#1}\ignorespaces}

% Illegible: never guessed. An invented word that reads like the others is the
% worst possible outcome.
\newcommand{\ill}{\textcolor{red!60!black}{[\,\ldots\,]}}

% A doubtful reading: the word is given, and flagged as uncertain.
\newcommand{\uncertain}[1]{\uline{#1}}

% An editorial addition — a missing letter, an implied word.
\newcommand{\add}[1]{\textcolor{blue!50!black}{[#1]}}

% Struck out by Grothendieck himself. What he crossed out is part of the
% document: a deletion often shows where the thought changed direction.
\newcommand{\struck}[1]{\sout{#1}}

% The transcriber's note, on the state of the page.
\newcommand{\note}[1]{\par\smallskip{\small\color{gray!60!black}\textit{[#1]}}\par\smallskip}

% A marginal note of Grothendieck's, distinct from the body of the text.
\newcommand{\marginal}[1]{\par\smallskip\noindent\hspace{1em}%
  {\small\color{gray!60!black}#1}\par\smallskip}

% --- Title ------------------------------------------------------------------
% The title block is French, like the documents themselves.

% The watermark is drawn on the shipout background so it sits under the text
% of every page, diagonal and light enough to leave the mathematics readable.
% tikz is already loaded (tikz-cd pulls it in); `remember picture` needs the
% aux-file round trip, which tectonic's multiple passes provide.
\AddToHook{shipout/background}{%
  \ifx\grothWatermark\empty\else
    \begin{tikzpicture}[remember picture, overlay]
      \node[rotate=52, scale=3.4, align=center, text=gray!18,
            font=\sffamily\bfseries]
        at (current page.center) {\grothWatermark};
    \end{tikzpicture}%
  \fi}

\AtBeginDocument{%
  \begin{center}
    {\large\bfseries Fonds Alexandre Grothendieck --- cote n\textsuperscript{o}~\grothFolder}\\[2pt]
    {\itshape\grothFoldertitle}\\[4pt]
    {\small pages \grothFirst--\grothLast\ (lot \grothBatch)}\\[2pt]
    \ifx\grothDating\empty\else
      {\small\color{gray!60!black}Datation de l'inventaire : \grothDating}\\[2pt]
    \fi
    \ifx\grothWatermark\empty\else
      {\small\bfseries\color{red!45!gray}\grothWatermark}\\[2pt]
    \fi
    {\footnotesize\color{gray!60!black}Transcription établie d'après le fac-similé numérisé
     par l'Université de Montpellier.\\
     Les lectures incertaines sont soulignées, les illisibles notées [\,\ldots\,],
     les ajouts entre crochets.}
  \end{center}
  \vspace{1em}}

\endinput
