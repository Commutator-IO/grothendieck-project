{
  "name": "grothendieck-archives",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run manifest && vite",
    "build": "npm run relay:allowlist -- --check && npm run manifest && tsc -b && vite build && npm run sitemap",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "postinstall": "node scripts/katex.mjs",
    "catalogue": "node scripts/catalogue.mjs",
    "archive": "node --max-old-space-size=8192 scripts/archive.mjs",
    "render": "node scripts/render.mjs",
    "manifest": "node scripts/manifest.mjs",
    "sitemap": "node scripts/sitemap.mjs",
    "pdf": "node scripts/pdf.mjs",
    "tiles": "node scripts/tiles.mjs",
    "lexicon": "node scripts/lexicon.mjs",
    "check-editions": "node scripts/check-editions.mjs",
    "usage": "node scripts/usage.mjs",
    "verify": "node scripts/verify.mjs",
    "headless": "node scripts/headless.mjs",
    "relay:allowlist": "node scripts/relay-allowlist.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "katex": "^0.16.11",
    "oxlint": "^1.71.0",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
