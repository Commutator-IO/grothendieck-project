node_modules
dist
.DS_Store
*.tsbuildinfo

# The local mirror of the fonds. The original PDFs run from 4 MB to 270 MB
# apiece; the four notebooks together come to several gigabytes. None of that
# belongs in a repository: `npm run archive -- <folder>` rebuilds it byte for
# byte from Montpellier.
archives/

# Vendored at install time by `npm run postinstall`, from node_modules.
public/vendor/katex/

# Derived from what is on disk, and therefore different on every machine —
# regenerated by `npm run manifest`, which `npm run build` runs first.
public/manifest.json

# Reading views are derived from transcripts/*.tex by `npm run render`;
# the .tex files themselves are the source of record and are versioned.
public/transcripts/
# …and those of the Fonds Grothendieck–Illusie, from transcripts-illusie/*.tex by
# `npm run render -- --illusie` (versioned sources, derived views).
public/transcripts-illusie/
# …and those of Quillen's notebooks and of the Bourbaki archive, from the
# git-ignored transcripts-quillen/ and transcripts-bourbaki/ by
# `npm run render:local`: local only, like their sources (#36, #50).
public/transcripts-quillen/
public/transcripts-bourbaki/

# The ODD's derived RELAX NG, and the ODD's served copy: written by
# `npm run tei:validate` from tei/grothendieck.odd, the source.
public/tei/

# Belt and braces: no PDF is versioned, anywhere. Facsimiles are mirrored from
# Montpellier on demand and compiled transcripts are rebuilt from their .tex,
# so a PDF in the tree is always either a download that should be regenerated
# or a copy of the fonds that should not be redistributed.
*.pdf

# Outreach drafts — carry named people's contact details, never committed
outreach/

# The jTEI submission file and its images, and the article as the site
# serves it: rebuilt by `npm run article-tei` from docs/study/article.tex.
# The article's own PDF is the one PDF committed — it is ours, not the
# fonds', and the deploy runner has no Charter to rebuild it with.
!docs/study/article.pdf
!docs/rhm/article.pdf
!docs/lean/article.pdf
!docs/cicm/article.pdf
!docs/conjectures/article.pdf
!docs/bnf/fiche.pdf
docs/study/submission/
public/article/

# Lean build and mathlib checkout
lean/.lake/

# LaTeX intermediates of the articles (tectonic --keep-logs / --keep-intermediates)
docs/*/article.aux
docs/*/article.bbl
docs/*/article.blg
docs/*/article.log
docs/*/article.out
docs/*/article.toc

# Transcriptions of Daniel Quillen's notebooks (skill transcribe-quillen). The
# notebooks are in copyright and this repository is public: a transcription
# pushed here would be published. They stay on the machine that made them
# until the Clay and the family agree (#36) — only the preamble is versioned.
transcripts-quillen/*
!transcripts-quillen/preamble/

# Per-folder TeX and TEI bundles for sending by mail (npm run bundle), derived.
/exports/

# Transcriptions of the Bourbaki archive (#50): local until the AHP / ACNB authorise; only the preamble is versioned.
transcripts-bourbaki/*
!transcripts-bourbaki/preamble/

# Buffalo 1973: boards reconstructed from the recordings' captions, local only (#31).
transcripts-buffalo/

# IHÉS Grothendieck–Illusie transcriptions stay local until the IHÉS agrees (#86); only the README is tracked.
transcripts-illusie/*
!transcripts-illusie/README.md

# Private reading copies of the long manuscripts (#92, #93), assembled from
# the transcriptions: local only, never committed (rights, BnF 2026-09-29).
books/
